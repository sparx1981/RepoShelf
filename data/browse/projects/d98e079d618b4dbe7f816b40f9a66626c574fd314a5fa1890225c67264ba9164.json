{"availability":"available","full":"integry/propr","name":"propr","description":"Open source, self-hosted GitHub orchestration for AI coding agents. Runs Claude Code, Codex, Antigravity, OpenCode and Mistral Vibe on your server and ships every change as a reviewed pull request: issue to PR, AI code review, automated fix loops.","category":"Developer tools","language":"TypeScript","stars":19,"forks":7,"created":"2025-05-23T13:09:47Z","updated":"2026-10-19T06:09:20Z","license":"Apache-2.0","branch":"main","homepage":"https://propr.dev","topics":["agent-orchestration","agentic-coding","ai-agents","ai-code-review","ai-coding","antigravity","claude","claude-code","code-review","codex","coding-agent","coding-agents","devtools","github-automation","github-bot","mcp","mistral","opencode","pull-requests","self-hosted"],"demo":"https://demo.propr.dev/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-19T06:19:21.817Z","lastAttemptAt":"2026-10-19T06:19:21.817Z","lastAvailableAt":"2026-10-19T06:19:21.817Z","metrics":[{"at":"2026-10-04T08:15:40.805Z","stars":14,"forks":6},{"at":"2026-10-06T15:42:52.686Z","stars":14,"forks":6},{"at":"2026-10-08T16:02:56.298Z","stars":16,"forks":7},{"at":"2026-10-11T07:26:18.006Z","stars":17,"forks":7},{"at":"2026-10-15T15:00:41.021Z","stars":17,"forks":7},{"at":"2026-10-19T06:19:21.817Z","stars":19,"forks":7}],"technologies":["Node.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Every task runs in an isolated workspace and lands as a pull request you refine in GitHub.","Quickstart · Docs · Live demo · Website · Discord · Built with ProPR","From a labeled GitHub issue to a reviewed, merged pull request in 68 seconds."],"features":["Label a GitHub issue and an agent implements it, then opens a PR linked back to the issue. State labels track progress automatically.","Turn an idea into review-sized tasks with acceptance criteria. Refine the plan in chat, then create the GitHub issues.","Comment /review on any PR for severity-grouped findings and a score. Apply them with /fix.","An automated review, repair and re-review loop that runs until the PR reaches the score you set, then hands it back for a human merge.","Five agents, selectable per issue. Several model labels on one issue produce separate PRs to compare."],"sourceUrl":"https://github.com/integry/propr/blob/main/README.md","fingerprint":"5b570f9cffefbb02a5be5e4028c25d1cce05e37a67523f73e136f0576d3b22a1","extractedAt":"2026-10-15T11:20:31.525Z"},"overviewCheckedAt":"2026-10-19T06:19:21.916Z","projectInsights":{"version":1,"whatItDoes":{"text":"Every task runs in an isolated workspace and lands as a pull request you refine in GitHub.","sourceUrl":"https://github.com/integry/propr/blob/main/README.md"},"audience":[],"requirements":[{"kind":"paid_service","status":"required","text":"The dashboard — what is running, what needs attention, and what it cost.","sourceUrl":"https://github.com/integry/propr/blob/main/README.md"},{"kind":"account","status":"required","text":"You need: a Linux amd64 host with Docker, Node.js 22 or 24, GitHub access, and an account with at least one coding-agent provider.","sourceUrl":"https://github.com/integry/propr/blob/main/README.md"},{"kind":"account","status":"required","text":"Log in to each agent you plan to run before starting it, so its credential directory holds real auth state.","sourceUrl":"https://github.com/integry/propr/blob/main/README.md"}],"fingerprint":"5b570f9cffefbb02a5be5e4028c25d1cce05e37a67523f73e136f0576d3b22a1","sourceUrl":"https://github.com/integry/propr/blob/main/README.md","checkedAt":"2026-10-19T06:19:21.917Z"},"overviewRepoUpdated":"2026-10-19T06:09:20Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/integry/propr/blob/main/README.md","checkedAt":"2026-10-19T06:19:21.918Z","hash":"5b570f9cffefbb02a5be5e4028c25d1cce05e37a67523f73e136f0576d3b22a1","originalBytes":21569,"storedBytes":21569,"truncated":false},"lastDemoCheckedAt":"2026-10-19T06:19:21.817