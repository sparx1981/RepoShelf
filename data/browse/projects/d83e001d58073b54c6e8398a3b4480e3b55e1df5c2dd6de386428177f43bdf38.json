creen, the groups sit in a sidebar."],"sourceUrl":"https://github.com/ahmadbasraa818/quits/blob/main/README.md","fingerprint":"ada7f6997015ee89b5d54faf25e0279ce590a3990d0faee36dc382e21975bb04","extractedAt":"2026-10-09T19:35:04.281Z"},"overviewCheckedAt":"2026-10-09T19:35:04.281Z","projectInsights":{"version":1,"whatItDoes":{"text":"Split costs with friends. Settle up in the fewest payments.","sourceUrl":"https://github.com/ahmadbasraa818/quits/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"Private by design, with no account, server, analytics or tracking.","sourceUrl":"https://github.com/ahmadbasraa818/quits/blob/main/README.md"}],"fingerprint":"ada7f6997015ee89b5d54faf25e0279ce590a3990d0faee36dc382e21975bb04","sourceUrl":"https://github.com/ahmadbasraa818/quits/blob/main/README.md","checkedAt":"2026-10-09T19:35:04.281Z"},"overviewRepoUpdated":"2026-10-09T19:34:56Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/ahmadbasraa818/quits/blob/main/README.md","checkedAt":"2026-10-09T19:35:04.283Z","hash":"ada7f6997015ee89b5d54faf25e0279ce590a3990d0faee36dc382e21975bb04","originalBytes":24987,"storedBytes":24987,"truncated":false},"lastDemoCheckedAt":"2026-10-09T19:35:04.146Z","subjects":["Android","Apple","Mobile"],"platforms":["Android","iOS & iPadOS"],"classification":{"version":4,"method":"local_rules","category":"Finance","subjects":["Android","Apple","Mobile"],"evidence":[{"subject":"Android","source":"metadata","match":"Android"},{"subject":"Apple","source":"metadata","match":"iOS"},{"subject":"Mobile","source":"metadata","match":"React Native"}],"platformEvidence":[{"platform":"Android","source":"metadata","match":"Android"},{"platform":"iOS & iPadOS","source":"metadata","match":"iOS"}],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Food & cooking","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://ahmadbasraa818.github.io/quits/