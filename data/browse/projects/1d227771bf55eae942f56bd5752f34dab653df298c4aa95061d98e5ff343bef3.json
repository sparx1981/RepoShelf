{"repositoryId":1062361881,"availability":"available","full":"roni-altshuler/soccer_predictor","name":"soccer_predictor","description":"Soccer Stats Predictor is a Next.js web app that lets users generate clear, data-driven soccer match predictions between teams or across leagues. Powered by machine learning on historical data, it shows intuitive win/draw/loss probabilities in an interactive, professional interface.","category":"Design","language":"Python","stars":4,"forks":1,"created":"2025-09-23T06:47:51Z","updated":"2026-10-19T04:13:57Z","license":null,"branch":"main","homepage":"https://soccer-stats-predictor-sigma.vercel.app","topics":["calibration","dixon-coles","elo","fastapi","forecasting","machine-learning","monte-carlo","nextjs","python","react","soccer","sports-analytics","tailwindcss","typescript"],"demo":"https://soccer-stats-predictor-sigma.vercel.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-19T06:19:44.952Z","lastAttemptAt":"2026-10-19T06:19:44.952Z","lastAvailableAt":"2026-10-19T06:19:44.952Z","metrics":[{"at":"2026-10-18T19:18:52.942Z","stars":4,"forks":1},{"at":"2026-10-19T06:19:44.952Z","stars":4,"forks":1}],"technologies":["React","Next.js","Python"],"overview":{"kind":"readme","version":1,"paragraphs":["A soccer prediction dashboard that publishes every number it can be judged on.","Match outcomes and season projections for the five big European leagues, plus knockout forecasts for fourteen tournaments — who advances a tie, and who lifts the trophy. Historical tests use chronological training cutoffs; season serving refits through known results. Evidence carries its sample and evaluation basis.","The goal is forecasting accuracy, not betting. The market price is used as a yardstick — it is the best public forecaster of a football match, so being measured against it is the hardest honest test available. It is not a target to beat for profit, and the repo carries the measurement that settles the question: backing this model against the price loses money in every disagreement bucket, and loses more the more confident the model is (benchmarkedgebuckets). That result is published rather than buried."],"features":[],"sourceUrl":"https://github.com/roni-altshuler/soccer_predictor/blob/main/README.md","fingerprint":"7cec89d46252a8cc91ad7c5c5464696d5a51d883e5992c4c202d03c0c56ca442","extractedAt":"2026-10-18T19:18:53.060Z"},"overviewCheckedAt":"2026-10-19T06:19:45.068Z","projectInsights":{"version":1,"whatItDoes":{"text":"A soccer prediction dashboard that publishes every number it can be judged on.","sourceUrl":"https://github.com/roni-altshuler/soccer_predictor/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"7cec89d46252a8cc91ad7c5c5464696d5a51d883e5992c4c202d03c0c56ca442","sourceUrl":"https://github.com/roni-altshuler/soccer_predictor/blob/main/README.md","checkedAt":"2026-10-19T06:19:45.068Z"},"overviewRepoUpdated":"2026-10-19T04:13:57Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/roni-altshuler/soccer_predictor/blob/main/README.md","checkedAt":"2026-10-19T06:19:45.070Z","hash":"7cec89d46252a8cc91ad7c5c5464696d5a51d883e5992c4c202d03c0c56ca442","originalBytes":28027,"storedBytes":28027,"truncated":false},"lastDemoCheckedAt":"2026-10-19T06:19:44.952Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Games & game development","Animation & motion","Simulation & physics","Automation & workflows","Templates & UI components","Maths & algorithms","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://soccer-stats-predictor-sigma.vercel.app/","attemptedAt":"2026-10-19T06:36:38.489Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T06:36:38.489Z","lastWorkingAt":"2026-10-19T06:36:38.489Z","target":"https://soccer-stats-predictor-sigma.vercel.