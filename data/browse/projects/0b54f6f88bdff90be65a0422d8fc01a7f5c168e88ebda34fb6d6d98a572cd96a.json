{"availability":"available","full":"TavoloPerUno/py-visualize-accelerometry","name":"py-visualize-accelerometry","description":"Web-based tool for visualizing and annotating accelerometry data. Supports collaborative labeling of activity segments in large time-series recordings. Built with Panel and Bokeh. Docs: https://tavoloperuno.github.io/py_visualize_accelerometry/ | Demo: https://tavoloperuno-accelerometry-viewer-demo.hf.space/","category":"Developer tools","language":"Python","stars":1,"forks":0,"created":"2021-01-07T20:26:07Z","updated":"2026-07-25T17:08:45Z","license":null,"branch":"master","homepage":"https://tavoloperuno.github.io/py-visualize-accelerometry/","topics":["accelerometry","activity-recognition","aging-research","annotation-tool","bokeh","chair-stand-test","clinical-assessment","data-visualization","gait-analysis","hdf5","nshap","panel","physical-activity","physical-performance","python","signal-visualization","time-series","timed-up-and-go","wearable-sensors","wrist-accelerometer"],"demo":"https://tavoloperuno-accelerometry-viewer-demo.hf.space/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-15T23:50:11.272Z","lastAttemptAt":"2026-10-15T23:50:11.272Z","lastAvailableAt":"2026-10-15T23:50:11.272Z","metrics":[{"at":"2026-10-06T06:44:40.833Z","stars":1,"forks":0},{"at":"2026-10-08T07:32:39.896Z","stars":1,"forks":0},{"at":"2026-10-10T17:26:41.200Z","stars":1,"forks":0},{"at":"2026-10-15T23:50:11.272Z","stars":1,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["A web app for viewing and annotating tri-axial accelerometry data. Research teams use it to label activity segments in long recordings together. Built with Panel and Bokeh. Sensor-agnostic: any HDF5 file with timestamp, x, y, z columns works."],"features":["LTTB downsampling. Renders 500K+ points smoothly by reducing each axis to 10,000 visually representative points (Largest Triangle Three Buckets).","Server-side HDF5 filtering. Loads only the visible time window via PyTables where clauses. Under 20 ms on 1 GB+ files.","Fast navigation. Previous/Next patches the plot data in place; no full figure rebuild.","Network latency indicator. Header shows live round-trip latency to the server, color-coded by speed.","Range selector. Minimap to navigate long recordings without losing context."],"sourceUrl":"https://github.com/TavoloPerUno/py-visualize-accelerometry/blob/master/README.md","fingerprint":"f5bd7a0b61883b8c28c81467272cd2fa7fb79d82b71525f7df882d653d9f64b2","extractedAt":"2026-10-06T06:44:40.973Z"},"overviewCheckedAt":"2026-10-15T23:50:11.372Z","projectInsights":{"version":1,"whatItDoes":{"text":"A web app for viewing and annotating tri-axial accelerometry data. Research teams use it to label activity segments in long recordings together. Built with Panel and Bokeh. Sensor-agnostic: any HDF5 file with timestamp, x, y, z columns works.","sourceUrl":"https://github.com/TavoloPerUno/py-visualize-accelerometry/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"f5bd7a0b61883b8c28c81467272cd2fa7fb79d82b71525f7df882d653d9f64b2","sourceUrl":"https://github.com/TavoloPerUno/py-visualize-accelerometry/blob/master/README.md","checkedAt":"2026-10-15T23:50:11.372Z"},"overviewRepoUpdated":"2026-07-25T17:08:45Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/TavoloPerUno/py-visualize-accelerometry/blob/master/README.md","checkedAt":"2026-10-15T23:50:11.373Z","hash":"f5bd7a0b61883b8c28c81467272cd2fa7fb79d82b71525f7df882d653d9f64b2","originalBytes":8576,"storedBytes":8576,"truncated":false},"lastDemoCheckedAt":"2026-10-15T23:50:11.272Z","subjects":["Data & dashboards"],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Data & dashboards"],"evidence":[{"subject":"Data & dashboards","source":"metadata","match":"data visualization"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedS