{"repositoryId":1140059019,"availability":"available","full":"zyvorai/zyvor-guestkit","name":"zyvor-guestkit","description":"Pure-Rust VM disk inspection — zero boot, zero agents, instant insight. AI-powered diagnostics explain what’s inside, what’s broken, and what to fix before you boot.","category":"AI & machine learning","language":"Rust","stars":9,"forks":2,"created":"2026-01-22T19:17:58Z","updated":"2026-10-18T13:33:17Z","license":"Apache-2.0","branch":"main","homepage":"https://zyvor.dev/guestkit","topics":["rust","virtual-machine","virtualization","vm"],"demo":"https://zyvor.dev/schedule?utm_source=github&utm_medium=guestkit&utm_campaign=readme_edition","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-19T15:52:58.090Z","lastAttemptAt":"2026-10-19T15:52:58.090Z","lastAvailableAt":"2026-10-19T15:52:58.090Z","metrics":[{"at":"2026-10-15T15:02:19.979Z","stars":9,"forks":2},{"at":"2026-10-19T15:52:58.090Z","stars":9,"forks":2}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["[]( []( []( [](LICENSE) [](Cargo.toml) []( [](","Every hypervisor exit fails the same way: you discover the disk was broken at 2am, in the cutover window, after power-on. GuestKit reads the disk while the guest is off — qcow2, VMDK, VHDX, VHD, VDI or raw — through its own pure-Rust engine (NBD or loop mount). There is no appliance daemon and no \"power it on and see\".","Fixes are never implicit. Repairs go through a plan you can read, applied with backups and rollback, and the same score drives the CI gate, the signed Cutover Passport, and assured QEMU launch."],"features":[],"sourceUrl":"https://github.com/zyvorai/zyvor-guestkit/blob/main/README.md","fingerprint":"1ee2ba72c6c8b4bc72e33fd85e1cf087bfb8f3f34dfcd174fa856091a8ba5f56","extractedAt":"2026-10-15T15:02:20.150Z"},"overviewCheckedAt":"2026-10-15T15:02:20.150Z","projectInsights":{"version":1,"whatItDoes":{"text":"[]( []( []( [](LICENSE) [](Cargo.toml) []( [](","sourceUrl":"https://github.com/zyvorai/zyvor-guestkit/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"1ee2ba72c6c8b4bc72e33fd85e1cf087bfb8f3f34dfcd174fa856091a8ba5f56","sourceUrl":"https://github.com/zyvorai/zyvor-guestkit/blob/main/README.md","checkedAt":"2026-10-15T15:02:20.150Z"},"overviewRepoUpdated":"2026-10-15T14:54:45Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/zyvorai/zyvor-guestkit/blob/main/README.md","checkedAt":"2026-10-15T15:02:20.151Z","hash":"1ee2ba72c6c8b4bc72e33fd85e1cf087bfb8f3f34dfcd174fa856091a8ba5f56","originalBytes":18819,"storedBytes":18819,"truncated":false},"lastDemoCheckedAt":"2026-10-15T15:02:19.979Z","subjects":["MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["MCP servers & agents"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"agents"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Maths & algorithms","Self-hosted apps","Privacy & security"],"reviewRequired":true},"demoHealth":{"url":"https://zyvor.dev/schedule?utm_source=github&utm_medium=guestkit&utm_campaign=readme_edition","attemptedAt":"2026-10-15T18:18:37.865Z","probeVersion":3,"status":"unknown","consecutiveTemporaryFailures":2,"error":{"reason":"challenge","at":"2026-10-15T18:18:37.865Z"},"nextCheckAt":"2026-11-14T18:18:37.865Z"},"previewAttemptAt":"2026-10-15T18:18:37.865Z","previewCheck":{"url":"https://zyvor.dev/schedule?utm_source=github&utm_medium=guestkit&utm_campaign=readme_edition","attemptedAt":"2026-10-15T18:18:37.865Z","consecutiveFailures":2,"status":"retry","reason":"challenge","nextCheckAt":"2026-11-14T18:18:37.865Z"},"qualityPriority":false,"repositoryAliases":[],"repositoryEtag":"W/\"be09344010946ecc0f0eac0b49ebd227ebc69b994a477a6133700aafcb5e78c6\"","repositoryEtagFor":"zyvorai/zyvor-guestkit","spaces":[]}