{"availability":"available","full":"HenryXiaoYang/realtime-tex","name":"realtime-tex","description":"Realtime TeX: re-typesets only the paragraph you edit in ~1 ms with an unmodified LuaTeX. Exact, embeddable.","category":"Developer tools","language":"Rust","stars":184,"forks":20,"created":"2026-10-07T11:03:31Z","updated":"2026-10-13T11:05:33Z","license":"MIT","branch":"main","homepage":"","topics":["c-api","editor","incremental-compilation","latex","library","live-preview","lualatex","luatex","pdf","real-time","rust","tex","texlive","typesetting","vscode"],"demo":"https://rustup.rs/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-15T13:02:22.634Z","lastAttemptAt":"2026-10-15T13:02:22.634Z","lastAvailableAt":"2026-10-15T13:02:22.634Z","metrics":[{"at":"2026-10-11T04:29:04.173Z","stars":79,"forks":7},{"at":"2026-10-15T13:02:22.634Z","stars":184,"forks":20}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["rtex is a library for editors. When you type, it re-typesets only the paragraph you are editing, using a LuaLaTeX process that has already loaded your preamble, and hands the editor the new lines to draw. A full compile runs in the background and takes care of what really is global: page breaks, floats, the table of contents, references and bibliographies.","The result is exactly what LuaLaTeX produces: the same line breaks, the same glyphs, at the same positions to 1/65536 pt. rtex uses an unmodified LuaTeX from TeX Live, and exported PDFs are identical to a normal LuaLaTeX build.","The approach follows Clemens Lode, Real-Time LuaTeX: Recompiling Large Documents in 1 ms (TUG 2026)."],"features":[],"sourceUrl":"https://github.com/HenryXiaoYang/realtime-tex/blob/main/README.md","fingerprint":"4005aba151a67fec577c688d76582ac5ee877f129dd7c57865359ae53b6193e7","extractedAt":"2026-10-15T13:02:22.792Z"},"overviewCheckedAt":"2026-10-15T13:02:22.792Z","projectInsights":{"version":1,"whatItDoes":{"text":"rtex is a library for editors. When you type, it re-typesets only the paragraph you are editing, using a LuaLaTeX process that has already loaded your preamble, and hands the editor the new lines to draw. A full compile runs in the background and takes care of what really is global: page breaks, floats, the table of contents, references and bibliographies.","sourceUrl":"https://github.com/HenryXiaoYang/realtime-tex/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"4005aba151a67fec577c688d76582ac5ee877f129dd7c57865359ae53b6193e7","sourceUrl":"https://github.com/HenryXiaoYang/realtime-tex/blob/main/README.md","checkedAt":"2026-10-15T13:02:22.792Z"},"overviewRepoUpdated":"2026-10-13T11:05:33Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/HenryXiaoYang/realtime-tex/blob/main/README.md","checkedAt":"2026-10-15T13:02:22.792Z","hash":"4005aba151a67fec577c688d76582ac5ee877f129dd7c57865359ae53b6193e7","originalBytes":7845,"storedBytes":7845,"truncated":false},"lastDemoCheckedAt":"2026-10-15T13:02:22.634Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://rustup.rs/","attemptedAt":"2026-10-15T13:19:48.894Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T13:19:48.894Z","lastWorkingAt":"2026-10-15T13:19:48.894Z","target":"https://rustup.rs/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T13:19:48.894Z"},"previewAttemptAt":"2026-10-15T13:19:48.894Z","previewCheck":{"url":"https://rustup.rs/","attemptedAt":"2026-10-15T13:19:48.894Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-22T13:19:48.894Z"},"screenshots":[{"src":"previews/d8c5ca3bf2dcb2186674a85f.jpg","kind":"demo","capturedAt":"2026-10-15T13:19:48.894Z","url":