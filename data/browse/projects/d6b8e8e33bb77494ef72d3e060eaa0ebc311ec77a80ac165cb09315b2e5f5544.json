{"availability":"available","full":"gojiplus/get-weather-data","name":"get-weather-data","description":"Get weather data for a list of zip codes for a range of dates","category":"Developer tools","language":"Python","stars":41,"forks":18,"created":"2015-01-30T16:30:57Z","updated":"2026-10-05T11:04:32Z","license":"MIT","branch":"master","homepage":"http://gojiplus.github.io/get-weather-data/","topics":["climate-data","ghcn","meteorology","noaa","python","weather-data"],"demo":"http://gojiplus.github.io/get-weather-data/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-12T19:07:21.005Z","lastAttemptAt":"2026-10-12T19:07:21.005Z","lastAvailableAt":"2026-10-12T19:07:21.005Z","metrics":[{"at":"2026-10-07T13:35:48.595Z","stars":41,"forks":18},{"at":"2026-10-09T15:34:22.544Z","stars":41,"forks":18},{"at":"2026-10-12T19:07:21.005Z","stars":41,"forks":18}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Historical daily weather for any US ZIP code or latitude/longitude. NOAA station data (GHCN Daily and GSOD), automatic nearest-station selection, consistent metric or imperial output.","A blank tmax could mean many things: no station nearby, a station that measures only precipitation, or a gap on that date. With explain=True, the result carries stationsconsidered and a missing map giving a reason for each requested field that came back empty:","get --explain prints the reasons on the CLI, process --explain adds stationsconsidered and missing columns to the batch CSV, and getframe(...) includes them when present. (For a data consumer, this turns a silent NaN into a diagnosable gap.)"],"features":["ZIP or lat/lon everywhere: get(), getrange(), CSV batch, and","the CLI all take either a ZIP code or coordinates","Consistent units: real metric values (°C, mm, m/s) across the","API, CLI, and CSV output — or units=\"imperial\" (°F, in, mph)","pandas-ready: Weather.getframe(...) returns a tidy DataFrame"],"sourceUrl":"https://github.com/gojiplus/get-weather-data/blob/master/README.md","fingerprint":"a2fb4a21430aa96759f68c808666dadaa552607c1747358ddee0848ef0398cf2","extractedAt":"2026-10-07T13:35:48.747Z"},"overviewCheckedAt":"2026-10-07T13:35:48.747Z","projectInsights":{"version":1,"whatItDoes":{"text":"Historical daily weather for any US ZIP code or latitude/longitude. NOAA station data (GHCN Daily and GSOD), automatic nearest-station selection, consistent metric or imperial output.","sourceUrl":"https://github.com/gojiplus/get-weather-data/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"a2fb4a21430aa96759f68c808666dadaa552607c1747358ddee0848ef0398cf2","sourceUrl":"https://github.com/gojiplus/get-weather-data/blob/master/README.md","checkedAt":"2026-10-07T13:35:48.748Z"},"overviewRepoUpdated":"2026-10-05T11:04:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/gojiplus/get-weather-data/blob/master/README.md","checkedAt":"2026-10-07T13:35:48.749Z","hash":"a2fb4a21430aa96759f68c808666dadaa552607c1747358ddee0848ef0398cf2","originalBytes":15073,"storedBytes":15073,"truncated":false},"lastDemoCheckedAt":"2026-10-07T13:35:48.595Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"qualityPriority":false,"demoHealth":{"url":"http://gojiplus.github.io/get-weather-data/","attemptedAt":"2026-10-14T18:32:50.203Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T18:32:50.203Z","lastWorkingAt":"2026-10-14T18:32:50.203Z","target":"http://gojiplus.github.io/get-weather-data/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-21T18:32:50.203Z"},"previewAttemptAt":"2026-10-14T18:32:50.203Z","previewCheck":{"url":"http://gojiplus.github.io/get-weather-data/","attemptedAt":"2026-10-14T18:32:50.203Z","consecutiveFailures":