{"availability":"available","full":"llsoftsec/llsoftsecbook","name":"llsoftsecbook","description":"Low-Level Software Security for Compiler Developers","category":"Developer tools","language":"TeX","stars":627,"forks":63,"created":"2021-04-30T07:33:53Z","updated":"2026-10-06T15:41:18Z","license":null,"branch":"main","homepage":"https://llsoftsec.github.io/llsoftsecbook/","topics":["book","compiler","compiler-development","security"],"demo":"https://llsoftsec.github.io/llsoftsecbook","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-18T15:41:50.354Z","lastAttemptAt":"2026-10-18T15:41:50.354Z","lastAvailableAt":"2026-10-18T15:41:50.354Z","metrics":[{"at":"2026-10-07T02:53:43.279Z","stars":627,"forks":63},{"at":"2026-10-09T05:49:04.075Z","stars":627,"forks":63},{"at":"2026-10-12T07:58:12.472Z","stars":627,"forks":63},{"at":"2026-10-18T15:41:50.354Z","stars":627,"forks":63}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["This book aims to provide a structured, broad overview of all attacks and security hardening techniques relevant for code generation tools.","The idea for this book emerged out of a frustration of not finding a good overview on this topic. Kristof Beyls and Georgia Kouveli, compiler engineers working on security features from time to time, wished a book like this would exist. After not finding such a book, we decided to try and write one ourselves. We immediately realized that we do not have all necessary expertise ourselves to complete such a daunting task. So we decided to try and create this book in an open source style, seeking contributions from many experts.","As you read this, the book remains unfinished. This book may well never be finished, as new vulnerabilities continue to be discovered regularly. Our hope is that developing the book as an open source project will allow it to continue to evolve and improve. It being open source increases the likelihood that it remains relevant as new vulnerabilities and mitigations emerge."],"features":[],"sourceUrl":"https://github.com/llsoftsec/llsoftsecbook/blob/main/README.md","fingerprint":"41cea76646340be803c022449e9eb9e71a7275a907c771c7ce938e21adf99a67","extractedAt":"2026-10-07T02:53:43.429Z"},"overviewCheckedAt":"2026-10-19T02:50:45.532Z","projectInsights":{"version":1,"whatItDoes":{"text":"This book aims to provide a structured, broad overview of all attacks and security hardening techniques relevant for code generation tools.","sourceUrl":"https://github.com/llsoftsec/llsoftsecbook/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"41cea76646340be803c022449e9eb9e71a7275a907c771c7ce938e21adf99a67","sourceUrl":"https://github.com/llsoftsec/llsoftsecbook/blob/main/README.md","checkedAt":"2026-10-19T02:50:45.533Z"},"overviewRepoUpdated":"2026-10-06T15:41:18Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/llsoftsec/llsoftsecbook/blob/main/README.md","checkedAt":"2026-10-19T02:50:45.533Z","hash":"41cea76646340be803c022449e9eb9e71a7275a907c771c7ce938e21adf99a67","originalBytes":19071,"storedBytes":19071,"truncated":false},"lastDemoCheckedAt":"2026-10-07T02:53:43.279Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Privacy & security"],"reviewRequired":true},"demoHealth":{"url":"https://llsoftsec.github.io/llsoftsecbook","attemptedAt":"2026-10-14T13:44:27.509Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T13:44:27.509Z","lastWorkingAt":"2026-10-14T13:44:27.509Z","target":"https://llsoftsec.github.io/llsoftsecbook/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-21T13:44:27.509Z"},"previewAttemptAt":"2026-10-14T13:44:27.509Z","previewCheck":{"url":"https://llsoftsec.github.io/llsoftsecbook","attemptedAt":"2026-10-14T13:44:27.509Z","consecutiveFailures":0,"