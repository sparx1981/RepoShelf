{"availability":"available","full":"jojin1709/SiteScout","name":"SiteScout","description":"Autonomous, stateless visual radar & directory for publicly discoverable web apps deployed across Vercel, Cloudflare, Netlify, Render, and more.","category":"Developer tools","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-02T06:08:07Z","updated":"2026-10-09T16:02:06Z","license":"MIT","branch":"main","homepage":"https://sitescout-app.vercel.app","topics":["cloudflare-pages","developer-tools","indie-hackers","netlify","radar","showcase","site-audit","stateless","vercel","web-discovery"],"demo":"https://sitescout-app.vercel.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-09T19:33:48.862Z","lastAttemptAt":"2026-10-09T19:33:48.862Z","lastAvailableAt":"2026-10-09T19:33:48.862Z","metrics":[{"at":"2026-10-06T22:54:22.337Z","stars":0,"forks":0},{"at":"2026-10-07T18:43:10.531Z","stars":0,"forks":0},{"at":"2026-10-09T19:33:48.862Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Live Web Directory: SiteScout is live and deployed at — indexing real-time public web applications across 12+ cloud platforms with zero database overhead.","Thousands of developers deploy indie projects, open-source demos, AI utilities, and portfolio experiments to subdomains on free cloud platforms daily. Most of these projects never get indexed by traditional search engines and remain hidden.","SiteScout is a lightweight, screenshot-first directory that surfaces these applications through safe public discovery, automated Lighthouse-style technical scoring, and framework fingerprinting."],"features":["No Database Lock-in: No SQL, NoSQL, or external state stores. It runs effortlessly in serverless memory.","Strictly Polite Crawling: Always checks robots.txt, respects 7-second fetch limits, never follows cross-origin redirect traps, and makes at most one homepage request per candidate.","Privacy & Simplicity: No user accounts, tracking cookies, login forms, or user data storage.","Dual-Runtime Support: Codebase runs identically on Vercel Serverless Functions (Node.js) and Cloudflare Pages/Workers (V8 isolate Edge).","🛰️ Automated Hourly Radar Discovery: Continuous multi-source crawler via GitHub Actions indexing fresh live deployments every hour."],"sourceUrl":"https://github.com/jojin1709/SiteScout/blob/main/README.md","fingerprint":"7f65cdd9c062c5317d81f3c9af38fdc393ff3683ae6f9e2267b47d44dccaa25e","extractedAt":"2026-10-06T15:45:47.860Z"},"overviewCheckedAt":"2026-10-07T18:43:10.647Z","projectInsights":{"version":1,"whatItDoes":{"text":"Live Web Directory: SiteScout is live and deployed at — indexing real-time public web applications across 12+ cloud platforms with zero database overhead.","sourceUrl":"https://github.com/jojin1709/SiteScout/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Privacy & Simplicity: No user accounts, tracking cookies, login forms, or user data storage.","sourceUrl":"https://github.com/jojin1709/SiteScout/blob/main/README.md"}],"fingerprint":"7f65cdd9c062c5317d81f3c9af38fdc393ff3683ae6f9e2267b47d44dccaa25e","sourceUrl":"https://github.com/jojin1709/SiteScout/blob/main/README.md","checkedAt":"2026-10-07T18:43:10.647Z"},"overviewRepoUpdated":"2026-10-07T15:25:12Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/jojin1709/SiteScout/blob/main/README.md","checkedAt":"2026-10-07T18:43:10.649Z","hash":"7f65cdd9c062c5317d81f3c9af38fdc393ff3683ae6f9e2267b47d44dccaa25e","originalBytes":11108,"storedBytes":11108,"truncated":false,"searchTerms":["api","tls","live","sitescout","edge","nbsp","cloud","public","get","feed","security","signals","discovery","github","hosting","platform","platforms","s-maxage","subdomains","rss","verification","web","architecture","cache","crawling","deployed","end","engine","inspect","real-time","response","robots.txt","serverless","subgraph","technical","across","applicati