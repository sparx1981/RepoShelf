{"availability":"available","full":"Hashtagsmile/react-color-tester","name":"react-color-tester","description":"Live React theme editor — design accessible color & font themes, preview them on real UI (landing, sign-in, dashboard), check WCAG contrast, and export ready-to-paste CSS. Built with Vite + chroma-js.","category":"Design","language":"JavaScript","stars":0,"forks":0,"created":"2024-10-02T21:16:10Z","updated":"2026-08-08T22:29:51Z","license":"MIT","branch":"main","homepage":"https://react-color-tester.vercel.app/","topics":["accessibility","chroma-js","color-palette","context-api","css-variables","design-tool","frontend","javascript","react","state-management","theme","theme-development","theme-switcher","theme-ui","theming","vite","vitejs","wcag"],"demo":"https://react-color-tester.vercel.app/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-19T02:45:40.716Z","lastAttemptAt":"2026-10-19T02:45:40.716Z","lastAvailableAt":"2026-10-19T02:45:40.716Z","metrics":[{"at":"2026-10-09T15:38:50.150Z","stars":0,"forks":0},{"at":"2026-10-12T23:50:41.247Z","stars":0,"forks":0},{"at":"2026-10-19T02:45:40.716Z","stars":0,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["Design a color theme, preview it on real UI, and export the CSS — instantly.","Theme Lab is a live theme editor. Pick five colors and two fonts, watch them apply in real time to a real landing page, sign‑in screen and dashboard, keep an eye on WCAG contrast as you go, then export production‑ready CSS (or Tailwind / JSON) — or share the exact theme with a link. No account, nothing to install.","▶ Live demo · Built with React + Vite + chroma‑js"],"features":["📋 Import anything — paste CSS custom properties, a Tailwind config or JSON. Alias names (brand, surface, ink, fg) and scale suffixes (-500) are understood; missing roles are reported rather than invented.","♿ Live WCAG contrast — every pairing the preview actually renders is graded AA / AAA / Fail in real time.","🎨 Five‑role palette — primary, secondary, accent, background and text, edited live with the native color picker.","🔤 Font pairing — 20+ heading/body typefaces (Google Fonts + system), with live previews.","🖥️ Real preview surfaces — a marketing landing page, a sign‑in screen and an analytics dashboard, all re‑skinned instantly."],"sourceUrl":"https://github.com/Hashtagsmile/react-color-tester/blob/main/README.md","fingerprint":"f0555ef25d4c3b963aec837f95c6883fe9f0693799baf7eb6c6341fc00ff26b3","extractedAt":"2026-10-09T15:38:50.308Z"},"overviewCheckedAt":"2026-10-09T15:38:50.308Z","projectInsights":{"version":1,"whatItDoes":{"text":"Design a color theme, preview it on real UI, and export the CSS — instantly.","sourceUrl":"https://github.com/Hashtagsmile/react-color-tester/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"No account, nothing to install.","sourceUrl":"https://github.com/Hashtagsmile/react-color-tester/blob/main/README.md"}],"fingerprint":"f0555ef25d4c3b963aec837f95c6883fe9f0693799baf7eb6c6341fc00ff26b3","sourceUrl":"https://github.com/Hashtagsmile/react-color-tester/blob/main/README.md","checkedAt":"2026-10-09T15:38:50.309Z"},"overviewRepoUpdated":"2026-08-08T22:29:51Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Hashtagsmile/react-color-tester/blob/main/README.md","checkedAt":"2026-10-09T15:38:50.309Z","hash":"f0555ef25d4c3b963aec837f95c6883fe9f0693799baf7eb6c6341fc00ff26b3","originalBytes":12214,"storedBytes":12214,"truncated":false},"lastDemoCheckedAt":"2026-10-09T15:38:50.150Z","subjects":["Templates & UI components","Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Templates & UI components","Data & dashboards"],"evidence":[{"subject":"Templates & UI components","source":"metadata","match":"theme"},{"subject":"Data & dashboards","source":"metadata","match":"dashboard"}],"platformEvi