s, email notification settings, support contacts.","Articles section with static content."],"sourceUrl":"https://github.com/Vadim-Bykov/postgres-prisma/blob/main/README.md","fingerprint":"38d5dc454351ccb47a7ef6464dee0b6dcb5a6014f1afedcadd21d407e2898515","extractedAt":"2026-10-12T08:00:10.424Z"},"overviewCheckedAt":"2026-10-12T08:00:10.424Z","projectInsights":{"version":1,"whatItDoes":{"text":"A production web app for a personal astrologer. Users browse consultations, pay by bank transfer, earn bonus points, invite friends and manage their account. The site owner has an admin panel and can send email campaigns to users.","sourceUrl":"https://github.com/Vadim-Bykov/postgres-prisma/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Sign up, log in, log out and password reset by email link.","sourceUrl":"https://github.com/Vadim-Bykov/postgres-prisma/blob/main/README.md"},{"kind":"account","status":"required","text":"Auth: on login the server signs a JWT with jose, saves it in the Token table and sets it as an httpOnly cookie.","sourceUrl":"https://github.com/Vadim-Bykov/postgres-prisma/blob/main/README.md"}],"fingerprint":"38d5dc454351ccb47a7ef6464dee0b6dcb5a6014f1afedcadd21d407e2898515","sourceUrl":"https://github.com/Vadim-Bykov/postgres-prisma/blob/main/README.md","checkedAt":"2026-10-12T08:00:10.424Z"},"overviewRepoUpdated":"2026-10-09T09:58:25Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Vadim-Bykov/postgres-prisma/blob/main/README.md","checkedAt":"2026-10-12T08:00:10.425Z","hash":"38d5dc454351ccb47a7ef6464dee0b6dcb5a6014f1afedcadd21d407e2898515","originalBytes":14932,"storedBytes":14932,"truncated":false,"searchTerms":["prisma","npm","vercel","run","email","app","consultation","database","next","admin","build","user","account","bonus","password","payment","server","smtp","users","consultations","env","points","api","bank","check","client","jwt","license","main","push","query","rese