{"availability":"available","full":"adityamittal-dot/pacemark","name":"pacemark","description":"A highlighter that moves through PDFs, Word docs and webpages at your reading speed. Web app, offline app and Chrome extension.","category":"Productivity","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-03T18:12:01Z","updated":"2026-10-11T17:26:32Z","license":"MIT","branch":"main","homepage":"https://adityamittal-dot.github.io/pacemark/","topics":["accessibility","chrome-extension","highlighter","pdf-reader","productivity","pwa","reading","speed-reading"],"demo":"https://adityamittal-dot.github.io/pacemark/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-17T19:53:58.369Z","lastAttemptAt":"2026-10-17T19:53:58.369Z","lastAvailableAt":"2026-10-17T19:53:58.369Z","metrics":[{"at":"2026-10-11T19:50:47.496Z","stars":0,"forks":0},{"at":"2026-10-17T19:53:58.369Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A highlighter that moves through your PDFs, Word documents and webpages at the reading speed you choose.","Your eyes don't glide across a line. They jump, stall and slip back to words they already passed, and on a dense document your attention drifts with them. A pacer, which used to be a finger or the edge of a card, gives your eyes something to follow. Pacemark does this with a moving highlight. You set the speed, it keeps the rhythm and remembers where you are."],"features":["Reads what you have: PDF, Word (.docx), Markdown, HTML and plain-text files, or pasted text.","PDFs keep their look: pages appear exactly as designed and the highlighter moves over the real words.","Understands layouts: multi-column papers and magazines are read column by column; running headers, footers and page numbers are skipped.","Speed from 60 to 1000 WPM, with optional longer pauses at commas and full stops so it reads like speech, not a metronome.","Your highlighter: five marker colors or any custom color; marker, underline or outline styles; one to three words at a time."],"sourceUrl":"https://github.com/adityamittal-dot/pacemark/blob/main/README.md","fingerprint":"11fa22986bf41314e9ca352fd3344d651e4a71b9dc3a64707ebd05d8f1b04f94","extractedAt":"2026-10-11T19:50:47.648Z"},"overviewCheckedAt":"2026-10-11T19:50:47.648Z","projectInsights":{"version":1,"whatItDoes":{"text":"A highlighter that moves through your PDFs, Word documents and webpages at the reading speed you choose.","sourceUrl":"https://github.com/adityamittal-dot/pacemark/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"11fa22986bf41314e9ca352fd3344d651e4a71b9dc3a64707ebd05d8f1b04f94","sourceUrl":"https://github.com/adityamittal-dot/pacemark/blob/main/README.md","checkedAt":"2026-10-11T19:50:47.648Z"},"overviewRepoUpdated":"2026-10-11T17:26:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/adityamittal-dot/pacemark/blob/main/README.md","checkedAt":"2026-10-11T19:50:47.649Z","hash":"11fa22986bf41314e9ca352fd3344d651e4a71b9dc3a64707ebd05d8f1b04f94","originalBytes":6900,"storedBytes":6900,"truncated":false},"lastDemoCheckedAt":"2026-10-11T19:50:47.496Z","subjects":["Browser extensions & PWAs","Writing & documents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Productivity","subjects":["Browser extensions & PWAs","Writing & documents"],"evidence":[{"subject":"Browser extensions & PWAs","source":"metadata","match":"Chrome extension"},{"subject":"Writing & documents","source":"metadata","match":"pdf reader"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://adityamittal-dot.github.io/pacemark/","attemptedAt":"2026-10-11T20:03:57.572Z","probeVersion":3,"status":"working","checkedAt":"2026-10-11T20:03:57.572Z","lastWorkingAt":"2026-10-11T20:03:57.572Z","target":"https://adityamittal-dot.github.io/pacemark/","failureCount":0,"consecutiveTemp