{"repositoryId":1425481104,"availability":"available","full":"reylam/MAW","name":"MAW","description":"MAW","category":"Other","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-19T10:57:58Z","updated":"2026-10-19T17:34:31Z","branch":"main","homepage":"https://maw-monitor.vercel.app","topics":[],"demo":"https://maw-monitor.vercel.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-19T18:04:11.820Z","lastAttemptAt":"2026-10-19T18:04:11.820Z","lastAvailableAt":"2026-10-19T18:04:11.820Z","metrics":[{"at":"2026-10-19T18:04:11.820Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Smart Rail Guard: an IoT early warning system for unguarded railway level crossings.","A sensor node at the crossing fuses vibration, load, magnetic and sound readings into a Fusion Score and publishes it over MQTT. The backend turns that into one clear instruction for the guard: close the barrier now, get ready, or the barrier may open. The guard sees it on the MAW Petugas phone app, and operators see the same thing on the web dashboard.","The system never operates the barrier by itself. It only instructs; the guard closes it and confirms."],"features":[],"sourceUrl":"https://github.com/reylam/MAW/blob/main/README.md","fingerprint":"a348c4e4f2e357328bc2180a3cfb51b3ba38eafdf8280e2116a6602012cca88e","extractedAt":"2026-10-19T18:04:11.898Z"},"overviewCheckedAt":"2026-10-19T18:04:11.898Z","projectInsights":{"version":1,"whatItDoes":{"text":"Smart Rail Guard: an IoT early warning system for unguarded railway level crossings.","sourceUrl":"https://github.com/reylam/MAW/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Sign in with an operator email registered in the backend, for example operator@maw.id.","sourceUrl":"https://github.com/reylam/MAW/blob/main/README.md"}],"fingerprint":"a348c4e4f2e357328bc2180a3cfb51b3ba38eafdf8280e2116a6602012cca88e","sourceUrl":"https://github.com/reylam/MAW/blob/main/README.md","checkedAt":"2026-10-19T18:04:11.898Z"},"overviewRepoUpdated":"2026-10-19T17:34:31Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/reylam/MAW/blob/main/README.md","checkedAt":"2026-10-19T18:04:11.898Z","hash":"a348c4e4f2e357328bc2180a3cfb51b3ba38eafdf8280e2116a6602012cca88e","originalBytes":8219,"storedBytes":8219,"truncated":false},"lastDemoCheckedAt":"2026-10-19T18:04:11.820Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Simulation & physics","Mobile","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://maw-monitor.vercel.app/","attemptedAt":"2026-10-19T18:23:11.491Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T18:23:11.491Z","lastWorkingAt":"2026-10-19T18:23:11.491Z","target":"https://maw-monitor.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T18:23:11.491Z"},"previewAttemptAt":"2026-10-19T18:23:11.491Z","previewCheck":{"url":"https://maw-monitor.vercel.app/","attemptedAt":"2026-10-19T18:23:11.491Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-26T18:23:11.491Z"},"screenshots":[{"src":"previews/5f85cff0f40d38c5fb3ea352.jpg","kind":"demo","capturedAt":"2026-10-19T18:23:11.491Z","url":"https://maw-monitor.vercel.app/"}],"qualityPriority":false,"spaces":[]}