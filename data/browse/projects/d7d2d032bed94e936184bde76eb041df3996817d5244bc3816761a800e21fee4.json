{"availability":"available","full":"webmaxru/webmcp-access-review-workbench","name":"webmcp-access-review-workbench","description":"WebMCP challenge demo for explainable least-privilege SaaS access reviews.","category":"AI & machine learning","language":"TypeScript","stars":0,"forks":0,"created":"2026-09-02T05:38:49Z","updated":"2026-09-04T06:52:36Z","license":"MIT","branch":"main","homepage":"https://webmaxru.github.io/webmcp-access-review-workbench/","topics":["ai-agents","least-privilege","react","typescript","webmcp","webmcp-challenge"],"demo":"https://webmaxru.github.io/webmcp-access-review-workbench/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T03:01:29.604Z","lastAttemptAt":"2026-10-18T03:01:29.604Z","lastAvailableAt":"2026-10-18T03:01:29.604Z","metrics":[{"at":"2026-10-11T22:40:05.563Z","stars":0,"forks":0},{"at":"2026-10-18T03:01:29.604Z","stars":0,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["This project was created using the WebMCP Agent Skill from the Web AI Agent Skills collection.","A small, deterministic WebMCP Challenge submission that turns a SaaS offboarding question into an inspectable least-privilege review. The app traces every effective path, simulates removal, catches one shared-service breakage, revises the plan, stages it, and stops at a visible confirmation control that is not exposed as a WebMCP tool.","Traditional access reviews force a person or agent to scrape several screens and infer how roles, groups, tokens, and projects combine. WebMCP exposes those domain operations directly while keeping the same evidence and staged plan visible to the reviewer. The agent can perform exhaustive graph traversal and simulation; the human can inspect each path, preserve the operational dependency, cancel the plan, or use the visible confirmation gate. That shared, structured workflow was difficult to achieve reliably with click automation alone."],"features":[],"sourceUrl":"https://github.com/webmaxru/webmcp-access-review-workbench/blob/main/README.md","fingerprint":"cccf0e43592357f4fda5cdf4069074ae6b27d90ebac44f7790fe642749cb6ccb","extractedAt":"2026-10-11T22:40:05.719Z"},"overviewCheckedAt":"2026-10-11T22:40:05.719Z","projectInsights":{"version":1,"whatItDoes":{"text":"This project was created using the WebMCP Agent Skill from the Web AI Agent Skills collection.","sourceUrl":"https://github.com/webmaxru/webmcp-access-review-workbench/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"No secret, login, backend, or external API is required.","sourceUrl":"https://github.com/webmaxru/webmcp-access-review-workbench/blob/main/README.md"}],"fingerprint":"cccf0e43592357f4fda5cdf4069074ae6b27d90ebac44f7790fe642749cb6ccb","sourceUrl":"https://github.com/webmaxru/webmcp-access-review-workbench/blob/main/README.md","checkedAt":"2026-10-11T22:40:05.719Z"},"overviewRepoUpdated":"2026-09-04T06:52:36Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/webmaxru/webmcp-access-review-workbench/blob/main/README.md","checkedAt":"2026-10-11T22:40:05.720Z","hash":"cccf0e43592357f4fda5cdf4069074ae6b27d90ebac44f7790fe642749cb6ccb","originalBytes":11619,"storedBytes":11619,"truncated":false},"lastDemoCheckedAt":"2026-10-11T22:40:05.563Z","subjects":["MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["MCP servers & agents"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"ai agents"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Simulation & physics","Automation & workflows"],"reviewRequired":true},"demoHealth":{"url":"https://webmaxru.github.io/webmcp-access-review-workbench/","attemptedAt":"2026-10-18T23:03:02.300Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T23:03:02.300Z","lastWorkingAt":"2026-10-18T23:03:02.300