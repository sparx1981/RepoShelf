{"availability":"available","full":"ericblade/quagga2","name":"quagga2","description":"An advanced barcode-scanner written in Javascript and TypeScript - Continuation from https://github.com/serratus/quaggajs","category":"Developer tools","language":"TypeScript","stars":911,"forks":95,"created":"2015-09-12T05:14:20Z","updated":"2026-10-19T01:36:40Z","license":"MIT","branch":"master","homepage":"","topics":["barcode","barcode-detection","barcode-reader","barcode-recognizer","barcode-scanner","barcodes","camera","ean","hacktoberfest","javascript","node","nodejs","quagga"],"demo":"https://ericblade.github.io/quagga2/examples/live_w_locator.html","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-19T09:32:51.577Z","lastAttemptAt":"2026-10-19T09:32:51.577Z","lastAvailableAt":"2026-10-19T09:32:51.577Z","metrics":[{"at":"2026-10-10T01:08:53.204Z","stars":910,"forks":95},{"at":"2026-10-15T14:58:07.225Z","stars":911,"forks":95},{"at":"2026-10-19T09:32:51.577Z","stars":911,"forks":95}],"technologies":["Node.js"],"overview":{"kind":"readme","version":1,"paragraphs":["This is a fork of the original QuaggaJS library, that will be maintained until such time as the original author and maintainer returns, or it has been completely replaced by built-in browser and node functionality.","QuaggaJS is a barcode-scanner entirely written in JavaScript supporting real-time localization and decoding of various types of barcodes such as EAN, CODE 128, CODE 39, EAN 8, UPC-A, UPC-C, I2of5, 2of5, CODE 93, CODE 32, CODABAR, and PHARMACODE. The library is also capable of using getUserMedia to get direct access to the user's camera stream. Although the code relies on heavy image-processing even recent smartphones are capable of locating and decoding barcodes in real-time.","Try some examples and check out the blog post (How barcode-localization works in QuaggaJS) if you want to dive deeper into this topic."],"features":["Every browser seems to differently implement the mediaDevices.getUserMedia API. Therefore it's highly recommended to include webrtc-adapter in your project."],"sourceUrl":"https://github.com/ericblade/quagga2/blob/master/README.md","fingerprint":"400d2fef0309476281d7ff6d39c1f4d8dffee97ec1a6df46247c9d6ac88b8a27","extractedAt":"2026-10-10T01:08:53.346Z"},"overviewCheckedAt":"2026-10-19T09:32:51.698Z","projectInsights":{"version":1,"whatItDoes":{"text":"This is a fork of the original QuaggaJS library, that will be maintained until such time as the original author and maintainer returns, or it has been completely replaced by built-in browser and node functionality.","sourceUrl":"https://github.com/ericblade/quagga2/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"400d2fef0309476281d7ff6d39c1f4d8dffee97ec1a6df46247c9d6ac88b8a27","sourceUrl":"https://github.com/ericblade/quagga2/blob/master/README.md","checkedAt":"2026-10-19T09:32:51.699Z"},"overviewRepoUpdated":"2026-10-19T01:36:40Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/ericblade/quagga2/blob/master/README.md","checkedAt":"2026-10-19T09:32:51.701Z","hash":"400d2fef0309476281d7ff6d39c1f4d8dffee97ec1a6df46247c9d6ac88b8a27","originalBytes":37984,"storedBytes":37984,"truncated":false},"lastDemoCheckedAt":"2026-10-19T09:32:51.577Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","Mobile","Streaming"],"reviewRequired":true},"demoHealth":{"url":"https://ericblade.github.io/quagga2/examples/live_w_locator.html","attemptedAt":"2026-10-19T09:59:03.742Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T09:59:03.742Z","lastWorkingAt":"2026-10-19T09:59:03.742Z","target":"https://ericblade.github.io/quagga2/examples/live_w_locator.html","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T09:59:03.742Z"},"preview