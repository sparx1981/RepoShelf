 fixed SL/TP at 1:1 risk-to-reward."],"sourceUrl":"https://github.com/vatsasr8846/PriceAction-EngulfingZone-EA/blob/main/README.md","fingerprint":"ba6fc98b628ebd5fc489033b5ea4c80325695b6546724b826630377c754abd5e","extractedAt":"2026-10-12T19:08:42.780Z"},"overviewCheckedAt":"2026-10-12T19:08:42.780Z","projectInsights":{"version":1,"whatItDoes":{"text":"A pure price-action Expert Advisor for MetaTrader 5 that trades XAUUSD on the M5 timeframe using an Engulfing Zone Retest strategy.","sourceUrl":"https://github.com/vatsasr8846/PriceAction-EngulfingZone-EA/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"ba6fc98b628ebd5fc489033b5ea4c80325695b6546724b826630377c754abd5e","sourceUrl":"https://github.com/vatsasr8846/PriceAction-EngulfingZone-EA/blob/main/README.md","checkedAt":"2026-10-12T19:08:42.780Z"},"overviewRepoUpdated":"2026-10-12T18:55:20Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/vatsasr8846/PriceAction-EngulfingZone-EA/blob/main/README.md","checkedAt":"2026-10-12T19:08:42.781Z","hash":"ba6fc98b628ebd5fc489033b5ea4c80325695b6546724b826630377c754abd5e","originalBytes":10788,"storedBytes":10788,"truncated":false},"lastDemoCheckedAt":"2026-10-12T19:08:42.638Z","subjects":["Automation & workflows"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["Automation & workflows"],"evidence":[{"subject":"Automation & workflows","source":"metadata","match":"Automate"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://vatsasr8846.github.io/","attemptedAt":"2026-10-19T01:00:53.759Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T01:00:53.759Z","lastWorkingAt":"2026-10-19T01:00:53.759Z","target":"https://vatsasr8846.github.io/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T01:00:53.759Z"},"previ