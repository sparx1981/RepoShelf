{"availability":"available","full":"llnl/fastcam","name":"fastcam","description":"A toolkit for efficent computation of saliency maps for explainable AI attribution. This tool was developed at Lawrence Livermore National Laboratory.","category":"Education","language":"Jupyter Notebook","stars":44,"forks":7,"created":"2020-01-24T22:55:41Z","updated":"2020-09-29T02:46:23Z","license":"BSD-3-Clause","branch":"master","homepage":"","topics":["cnn-visualization","deep-learning","demo","explainable-ai","gradcam","interpretability","pytorch","pytorch-gradcam","saliency","saliency-maps","visual-explanations","xai"],"demo":"https://steemitimages.com/p/DVAkPJXe6RxaMiozqQxRKBpPCPSqM5k9eEaBqfuGYnq1rZoVgJfgBwH61WPbdCwxa7N5TvBS59Jxtv?format=match&mode=fit&width=640","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-16T20:35:34.580Z","lastAttemptAt":"2026-10-16T20:35:34.580Z","lastAvailableAt":"2026-10-16T20:35:34.580Z","metrics":[{"at":"2026-10-08T11:09:02.881Z","stars":44,"forks":7},{"at":"2026-10-10T21:01:50.995Z","stars":44,"forks":7},{"at":"2026-10-16T20:35:34.580Z","stars":44,"forks":7}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["FastCAM creates a saliency map using SMOE Scale saliency maps as described in our paper on ArXiv:1911.11293. We obtain a highly significant speed-up by replacing the Guided Backprop component typically used alongside GradCAM with our SMOE Scale saliency map. Additionally, the expected accuracy of the saliency map is increased slightly. Thus, FastCAM is three orders of magnitude faster and a little bit more accurate than GradCAM+Guided Backprop with SmoothGrad."],"features":[],"sourceUrl":"https://github.com/llnl/fastcam/blob/master/README.md","fingerprint":"9926642f35acee2461276ab402fff5bc4752c7c316669c7fb6e373cab9f04029","extractedAt":"2026-10-08T11:09:03.060Z"},"overviewCheckedAt":"2026-10-16T20:35:34.682Z","projectInsights":{"version":1,"whatItDoes":{"text":"FastCAM creates a saliency map using SMOE Scale sal