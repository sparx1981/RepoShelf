 lab mode generates stereo beats entirely in the browser with focus, deep-work, calm,…"],"features":[],"sourceUrl":"https://github.com/farokhpakbaz/farokhpakbaz.github.io/blob/main/README.md","fingerprint":"10d5ffd24adba3e3bd87188a1173bdce27648ca5d1089f8d2c8014e3df0a34ac","extractedAt":"2026-10-10T05:45:01.391Z"},"overviewCheckedAt":"2026-10-10T05:45:01.391Z","projectInsights":{"version":1,"whatItDoes":{"text":"A small personal portfolio built with Hugo. Its visual language is inspired by the focused, code-editor-like atmosphere of musicForProgramming while using an original layout and interaction system.","sourceUrl":"https://github.com/farokhpakbaz/farokhpakbaz.github.io/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"10d5ffd24adba3e3bd87188a1173bdce27648ca5d1089f8d2c8014e3df0a34ac","sourceUrl":"https://github.com/farokhpakbaz/farokhpakbaz.github.io/blob/main/README.md","checkedAt":"2026-10-10T05:45:01.391Z"},"overviewRepoUpdated":"2026-09-15T06:23:40Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/farokhpakbaz/farokhpakbaz.github.io/blob/main/README.md","checkedAt":"2026-10-10T05:45:01.392Z","hash":"10d5ffd24adba3e3bd87188a1173bdce27648ca5d1089f8d2c8014e3df0a34ac","originalBytes":4573,"storedBytes":4573,"truncated":false,"searchTerms":["matrix","hugo","content","focus","site","static","app","frequency","github","notes","radio","source","while","actions","audio","build","controls","deploy","fallback","generated","locally","main","navigation","offline","open","optional","publishes","push","settings","visitors","about","after","ambient","browser","builds","canvas","character","commit","create","data","default","deployment","draft","every","file","html","icons","immersive","included","includes","instead","keeps","lab","layouts","live","local","markdown","mode","my-new-post.md","new","opens","pages","personal","playback","player","portfolio","pwa","run","runtime","server","sleep","visual","workflow","workspace","wr