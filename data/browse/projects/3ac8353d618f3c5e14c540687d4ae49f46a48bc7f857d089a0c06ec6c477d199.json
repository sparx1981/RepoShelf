{"repositoryId":1310199429,"availability":"available","full":"Adityavardhanjain/WikiCrawl","name":"WikiCrawl","description":"Interactive Wikipedia knowledge graph - crawl topics, visualize connections, and explore unexpected paths.","category":"Other","language":"TypeScript","stars":28,"forks":3,"created":"2026-07-23T17:24:46Z","updated":"2026-10-09T18:45:02Z","license":"MIT","branch":"main","homepage":"https://wiki-crawl.vercel.app","topics":["data-visualization","graph-visualization","graphology","knowledge-graph","mediawiki","nextjs","sigmajs","typescript","web-crawler","wikipedia"],"demo":"https://wiki-crawl.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-17T03:00:41.204Z","lastAttemptAt":"2026-10-17T03:00:41.204Z","lastAvailableAt":"2026-10-17T03:00:41.204Z","metrics":[{"at":"2026-10-17T03:00:41.204Z","stars":28,"forks":3}],"technologies":["Next.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Turn Wikipedia into an interactive map of knowledge.","WikiCrawl transforms the links surrounding a Wikipedia article into an interactive, explorable graph. Search for a topic, watch the crawl unfold in real time, and discover how articles connect across Wikipedia.","Wikipedia contains millions of interconnected articles. WikiCrawl makes those connections tangible by turning article links into a graph you can navigate, analyze, and explore."],"features":["Live crawling: Watch pages, connections, and crawl progress appear as results arrive.","Configurable exploration: Choose a starting article, a crawl depth of 1–3 hops, and a page limit between 50 and 500.","Interactive graph visualization: Navigate the graph with zoom, fit-to-view, reset, and edge-display controls.","Community and depth coloring: Color nodes by detected community or distance from the starting article.","Page inspection: Select a node to explore its summary, graph metrics, community assignment, and connected pages."],"sourceUrl":"https://github.com/Adityavardhanjain/WikiCrawl/blob/main/README.md","fingerprint":"2ed5ad181835f904fbd7d90dadb86f93edfebf377ac6c8b5acea884b49e981c5","extractedAt":"2026-10-17T03:00:41.341Z"},"overviewCheckedAt":"2026-10-17T03:00:41.341Z","projectInsights":{"version":1,"whatItDoes":{"text":"Turn Wikipedia into an interactive map of knowledge.","sourceUrl":"https://github.com/Adityavardhanjain/WikiCrawl/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"2ed5ad181835f904fbd7d90dadb86f93edfebf377ac6c8b5acea884b49e981c5","sourceUrl":"https://github.com/Adityavardhanjain/WikiCrawl/blob/main/README.md","checkedAt":"2026-10-17T03:00:41.341Z"},"overviewRepoUpdated":"2026-10-09T18:45:02Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Adityavardhanjain/WikiCrawl/blob/main/README.md","checkedAt":"2026-10-17T03:00:41.342Z","hash":"2ed5ad181835f904fbd7d90dadb86f93edfebf377ac6c8b5acea884b49e981c5","originalBytes":14167,"storedBytes":14167,"truncated":false},"lastDemoCheckedAt":"2026-10-17T03:00:41.204Z","subjects":["Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Data & dashboards"],"evidence":[{"subject":"Data & dashboards","source":"metadata","match":"data visualization"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows"],"reviewRequired":true},"demoHealth":{"url":"https://wiki-crawl.vercel.app/","attemptedAt":"2026-10-17T03:11:28.001Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T03:11:28.001Z","lastWorkingAt":"2026-10-17T03:11:28.001Z","target":"https://wiki-crawl.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T03:11:28.001Z"},"previewAttemptAt":"2026-10-17T03:11:28.001Z","previewCheck":{"url":"https://wiki-crawl.vercel.app/","attemptedAt":"2026-10-17T03:11:28.001Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-24T03:11:28.001Z"},"scr