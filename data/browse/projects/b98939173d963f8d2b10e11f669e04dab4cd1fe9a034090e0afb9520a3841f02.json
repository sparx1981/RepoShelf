{"availability":"available","full":"mhju0/fullcourt","name":"fullcourt","description":"An NBA schedule website for comparing how much rest teams get and how far they travel between games, with matchup views that make schedule differences easier to see","category":"Design","language":"TypeScript","stars":0,"forks":0,"created":"2026-03-30T01:51:45Z","updated":"2026-10-18T15:25:09Z","branch":"main","homepage":"https://fullcourt.fyi","topics":["basketball-analytics","data-pipeline","data-visualization","drizzle-orm","machine-learning","nba","nextjs","postgresql","predictive-modeling","python","react","scikit-learn","sports-analytics","supabase","tailwindcss","typescript","vercel"],"demo":"https://fullcourt-nba.vercel.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-18T15:42:47.766Z","lastAttemptAt":"2026-10-18T15:42:47.766Z","lastAvailableAt":"2026-10-18T15:42:47.766Z","metrics":[{"at":"2026-10-06T15:45:46.885Z","stars":0,"forks":0},{"at":"2026-10-08T16:05:24.524Z","stars":0,"forks":0},{"at":"2026-10-11T00:24:37.316Z","stars":0,"forks":0},{"at":"2026-10-12T07:59:40.243Z","stars":0,"forks":0},{"at":"2026-10-18T15:42:47.766Z","stars":0,"forks":0}],"technologies":["React","Next.js","Python"],"overview":{"kind":"readme","version":1,"paragraphs":["NBA rest and schedule findings, player shooting splits, and source-linked officiating reports.","FullCourt scores each team's schedule load, compares the two teams in a matchup, and measures how often the more-rested side won. It also examines playoff series, player shooting, shot locations, missing rotation players, and officiating patterns.","Home court matters much more than rest. The regular-season model makes a call when the more-rested team is at home; rested visitors are reported separately. Both win rates are compared with their venue baselines. These are historical associations, not estimates of what rest alone caused or a complete forecast of who will win."],"features":[],"sourceUrl":"https://github.com/mhju0/fullcourt/blob/main/README.md","fingerprint":"0fa9e16ad62537e677346aa4df3c1c533670c82d318e1455b0cde952bd498ae9","extractedAt":"2026-10-08T16:09:10.943Z"},"overviewCheckedAt":"2026-10-12T07:59:40.390Z","projectInsights":{"version":1,"whatItDoes":{"text":"NBA rest and schedule findings, player shooting splits, and source-linked officiating reports.","sourceUrl":"https://github.com/mhju0/fullcourt/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"not_required","text":"No accounts or login are needed; selected views can be shared by URL.","sourceUrl":"https://github.com/mhju0/fullcourt/blob/main/README.md"}],"fingerprint":"0fa9e16ad62537e677346aa4df3c1c533670c82d318e1455b0cde952bd498ae9","sourceUrl":"https://github.com/mhju0/fullcourt/blob/main/README.md","checkedAt":"2026-10-12T07:59:40.390Z"},"overviewRepoUpdated":"2026-10-11T17:15:39Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/mhju0/fullcourt/blob/main/README.md","checkedAt":"2026-10-12T07:59:40.390Z","hash":"0fa9e16ad62537e677346aa4df3c1c533670c82d318e1455b0cde952bd498ae9","originalBytes":9252,"storedBytes":9252,"truncated":false},"lastDemoCheckedAt":"2026-10-12T07:59:40.243Z","subjects":["Games & game development","Travel","Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Games & game development","Travel","Data & dashboards"],"evidence":[{"subject":"Games & game development","source":"metadata","match":"games"},{"subject":"Travel","source":"metadata","match":"travel"},{"subject":"Data & dashboards","source":"metadata","match":"data visualization"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Portfolios & personal sites","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://fullcourt-nba.vercel.app/","attemptedAt":"2026-10-18T16:04:20.189Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T1