{"full":"gluon-lang/gluon","name":"gluon","description":"A static, type inferred and embeddable language written in Rust.","category":"Developer tools","language":"Rust","stars":3452,"forks":154,"created":"2015-08-02T12:35:56Z","updated":"2026-08-06T10:41:39Z","license":"MIT","branch":"master","homepage":"https://gluon-lang.org","topics":["compiler","embeddable","functional","gluon","language","programming-language","repl","rust","type-inference"],"demo":"https://gluon-lang.org/try/","color":"#63362a","ink":"#f8c7a8","availability":"available","lastCheckedAt":"2026-10-17T19:54:09.348Z","lastAttemptAt":"2026-10-17T19:54:09.348Z","lastAvailableAt":"2026-10-17T19:54:09.348Z","lastDemoCheckedAt":"2026-10-11T11:06:02.041Z","metrics":[{"at":"2026-10-03T21:17:48.343Z","stars":3448,"forks":154},{"at":"2026-10-04T08:16:42.923Z","stars":3448,"forks":154},{"at":"2026-10-06T15:44:21.369Z","stars":3450,"forks":154},{"at":"2026-10-08T16:04:09.663Z","stars":3449,"forks":154},{"at":"2026-10-11T11:06:01.885Z","stars":3450,"forks":154},{"at":"2026-10-15T18:04:53.466Z","stars":3451,"forks":154},{"at":"2026-10-17T19:54:09.348Z","stars":3452,"forks":154}],"technologies":["Rust"],"overviewAttemptAt":"2026-10-11T06:16:12.661Z","overview":{"kind":"readme","version":1,"paragraphs":["Gluon is a small, statically-typed, functional programming language designed for application embedding."],"features":["Statically-typed - Static typing makes it easier to write safe and efficient interfaces between gluon and the host application.","Type inference - Type inference ensures that types rarely have to be written explicitly giving all the benefits of static types with none of the typing.","Simple embedding - Marshalling values to and from gluon requires next to no boilerplate, allowing functions defined in Rust to be directly passed to gluon.","UTF-8 by default - Gluon supports Unicode out of the box with utf-8 encoded strings and Unicode codepoints as characters.","Separate heaps - Gluon is a garbage-collected language but uses a separate heap for each executing gluon thread. This keeps each heap small, reducing the overhead of the garbage collector."],"sourceUrl":"https://github.com/gluon-lang/gluon/blob/master/README.md","fingerprint":"64687ddbb150182d9c7b95d4cbabe8ad68539195a1948b64ee0ebffc7b4825d6","extractedAt":"2026-10-03T06:27:56.022Z"},"overviewCheckedAt":"2026-10-11T11:06:02.039Z","overviewRepoUpdated":"2026-08-06T10:41:39Z","enrichmentAttemptAt":"2026-10-05T18:19:31.012Z","latestRelease":{"name":"Version 0.18.4","tag":"v0.18.4","publishedAt":"2026-08-06T10:41:39Z","url":"https://github.com/gluon-lang/gluon/releases/tag/v0.18.4"},"releaseCheckedAt":"2026-10-05T18:19:31.012Z","screenshots":[{"src":"previews/d4c5998e10a7743d29801c72.jpg","kind":"demo","capturedAt":"2026-10-11T17:07:14.593Z","url":"https://gluon-lang.org/try/"}],"projectInsights":{"version":1,"whatItDoes":{"text":"Gluon is a small, statically-typed, functional programming language designed for application embedding.","sourceUrl":"https://github.com/gluon-lang/gluon/blob/master/README.md"},"audience":[{"text":"Gluon is a small, statically-typed, functional programming language designed for application embedding.","sourceUrl":"https://github.com/gluon-lang/gluon/blob/master/README.md"}],"requirements":[],"fingerprint":"64687ddbb150182d9c7b95d4cbabe8ad68539195a1948b64ee0ebffc7b4825d6","sourceUrl":"https://github.com/gluon-lang/gluon/blob/master/README.md","checkedAt":"2026-10-11T11:06:02.039Z"},"demoHealth":{"url":"https://gluon-lang.org/try/","attemptedAt":"2026-10-11T17:07:14.593Z","status":"working","checkedAt":"2026-10-11T17:07:14.593Z","lastWorkingAt":"2026-10-11T17:07:14.593Z","target":"https://gluon-lang.org/try/","failureCount":0,"nextCheckAt":"2026-10-18T17:07:14.593Z","probeVersion":3,"consecutiveTemporaryFailures":0},"readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/gluon-lang/gluon/blob/master/README.md","checkedAt":"2026-10-11T11:06:02.040Z","hash":"