{"availability":"available","full":"LeonTOfficial/BatteryPanic","name":"BatteryPanic","description":"A native macOS menu bar app that shows red pulsing low-battery alerts with customizable overlay and sound warnings.","category":"Productivity","language":"Swift","stars":1,"forks":0,"created":"2026-06-24T16:35:49Z","updated":"2026-10-10T17:49:52Z","license":"MIT","branch":"main","homepage":"https://leontofficial.github.io/BatteryPanic/","topics":["appkit","battery","battery-alarm","battery-care","github-pages","low-battery-warning","macos","macos-app","menu-bar","menubar-app","native-macos","open-source","productivity","sparkle-upgrade-tool","swift","swift-package","utility"],"demo":"https://leontofficial.github.io/BatteryPanic/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-12T02:05:14.575Z","lastAttemptAt":"2026-10-12T02:05:14.575Z","lastAvailableAt":"2026-10-12T02:05:14.575Z","metrics":[{"at":"2026-10-12T02:05:14.575Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Battery Panic is a native macOS menu bar app that makes low battery warnings impossible to miss. When your MacBook drops below your chosen battery threshold, Battery Panic shows a red pulsing screen overlay, plays an optional warning sound, and keeps the status visible in the menu bar. Its native dashboard also shows real battery health, remaining time, and a private local history chart.","The app is built with Swift and AppKit, stays local to your Mac, and is designed as a clean open-source project rather than a one-file demo.","Battery Panic is intentionally a menu bar app. It does not install a separate Notification Center or WidgetKit widget."],"features":["Native macOS menu bar app.","Native menu dashboard with real battery percentage, remaining time, power state, health, and alarm state.","Private on-device battery history with 30-minute, one-hour, one-day, and one-week views.","Smooth history chart with exact hover values, average drain, short forecast, and real charging segments.","Green, orange, red, and charging-aware menu bar battery states."],"sourceUrl":"https://github.com/LeonTOfficial/BatteryPanic/blob/main/README.md","fingerprint":"98f2a194d715a558a33f44a1547dc584a27d45ec57d543f23fed15cdc8b8ea40","extractedAt":"2026-10-12T02:05:14.719Z"},"overviewCheckedAt":"2026-10-12T02:05:14.719Z","projectInsights":{"version":1,"whatItDoes":{"text":"Battery Panic is a native macOS menu bar app that makes low battery warnings impossible to miss. When your MacBook drops below your chosen battery threshold, Battery Panic shows a red pulsing screen overlay, plays an optional warning sound, and keeps the status visible in the menu bar. Its native dashboard also shows real battery health, remaining time, and a private local history chart.","sourceUrl":"https://github.com/LeonTOfficial/BatteryPanic/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"optional","text":"Optional launch at login.","sourceUrl":"https://github.com/LeonTOfficial/BatteryPanic/blob/main/README.md"},{"kind":"account","status":"optional","text":"Privacy-friendly behavior: no analytics, no accounts, no system profiling, and network access only for Sparkle update delivery.","sourceUrl":"https://github.com/LeonTOfficial/BatteryPanic/blob/main/README.md"}],"fingerprint":"98f2a194d715a558a33f44a1547dc584a27d45ec57d543f23fed15cdc8b8ea40","sourceUrl":"https://github.com/LeonTOfficial/BatteryPanic/blob/main/README.md","checkedAt":"2026-10-12T02:05:14.720Z"},"overviewRepoUpdated":"2026-10-10T17:49:52Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/LeonTOfficial/BatteryPanic/blob/main/README.md","checkedAt":"2026-10-12T02:05:14.721Z","hash":"98f2a194d715a558a33f44a1547dc584a27d45ec57d543f23fed15cdc8b8ea40","originalBytes":9819,"storedBytes":9819,"truncated":false,"searchTerms":["battery","panic","open","macos","app","docs","menu","overlay","red","warning","bar","settings","preview","ala