{"availability":"available","full":"wcpos/woocommerce-pos","name":"woocommerce-pos","description":"A WordPress plugin for taking WooCommerce orders at the Point of Sale.","category":"Business","language":"PHP","stars":49,"forks":23,"created":"2021-03-16T11:50:09Z","updated":"2026-10-18T17:02:22Z","license":"GPL-3.0","branch":"main","homepage":"https://wordpress.org/plugins/woocommerce-pos","topics":["ecommerce","point-of-sale","woocommerce","woocommerce-plugin","wordpress","wordpress-plugin"],"demo":"https://demo.wcpos.com/pos","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-18T18:17:54.756Z","lastAttemptAt":"2026-10-18T18:17:54.756Z","lastAvailableAt":"2026-10-18T18:17:54.756Z","metrics":[{"at":"2026-10-04T08:18:17.347Z","stars":49,"forks":21},{"at":"2026-10-06T16:31:21.993Z","stars":49,"forks":22},{"at":"2026-10-08T20:09:06.018Z","stars":49,"forks":22},{"at":"2026-10-11T07:24:20.624Z","stars":49,"forks":22},{"at":"2026-10-15T15:00:35.658Z","stars":49,"forks":23},{"at":"2026-10-18T18:17:54.756Z","stars":49,"forks":23}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["The WordPress plugin that turns a WooCommerce store into a Point of Sale.","WCPOS is a simple application for taking orders at the Point of Sale using your WooCommerce store — great for in-person sales and phone orders alike. This repository is the WordPress plugin: it provides the WooCommerce/WordPress backend, the REST API, authentication, and the server-rendered templates that the WCPOS client apps run against.","It's free and open source. A live demo is available at demo.wcpos.com/pos (login demo / demo)."],"features":["Cross-platform clients — browser, desktop (Windows/macOS/Linux) and mobile (iOS/Android, in beta).","Offline storage for fast product search and order processing.","Flexible cart — add ad-hoc products that aren't in WooCommerce, scan barcodes into the cart.","Receipts — a gallery of templates (receipts, invoices, quotes, packing slips, gift receipts, kitchen tickets) plus a custom designer.","Thermal printing to 58 mm / 80 mm printers over network, Bluetooth or USB."],"sourceUrl":"https://github.com/wcpos/woocommerce-pos/blob/main/README.md","fingerprint":"f5854a091386bebcaf6d16437d49fe5c53ec501b03a18b659ed5bfb2325a206f","extractedAt":"2026-10-04T08:18:17.494Z"},"overviewCheckedAt":"2026-10-18T18:17:54.829Z","projectInsights":{"version":1,"whatItDoes":{"text":"The WordPress plugin that turns a WooCommerce store into a Point of Sale.","sourceUrl":"https://github.com/wcpos/woocommerce-pos/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"A live demo is available at demo.wcpos.com/pos (login demo / demo).","sourceUrl":"https://github.com/wcpos/woocommerce-pos/blob/main/README.md"},{"kind":"account","status":"required","text":"CORS and frame headers are relaxed on POS routes so the desktop/mobile apps can embed login and load the bundle.","sourceUrl":"https://github.com/wcpos/woocommerce-pos/blob/main/README.md"}],"fingerprint":"f5854a091386bebcaf6d16437d49fe5c53ec501b03a18b659ed5bfb2325a206f","sourceUrl":"https://github.com/wcpos/woocommerce-pos/blob/main/README.md","checkedAt":"2026-10-18T18:17:54.829Z"},"overviewRepoUpdated":"2026-10-18T17:02:22Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/wcpos/woocommerce-pos/blob/main/README.md","checkedAt":"2026-10-18T18:17:54.830Z","hash":"f5854a091386bebcaf6d16437d49fe5c53ec501b03a18b659ed5bfb2325a206f","originalBytes":12338,"storedBytes":12338,"truncated":false},"lastDemoCheckedAt":"2026-10-18T18:17:54.756Z","qualityPriority":false,"enrichmentAttemptAt":"2026-10-04T12:21:48.694Z","latestRelease":{"name":"Release v1.10.20","tag":"v1.10.20","publishedAt":"2026-09-23T09:57:08Z","url":"https://github.com/wcpos/woocommerce-pos/releases/tag/v1.10.20"},"releaseCheckedAt":"2026-10-04T12:21:48.694Z","screenshots":[{"src":"previews/fec4f7a41ad0ab22f09f234d.jpg","kind":"demo","capturedAt":"2026-10-