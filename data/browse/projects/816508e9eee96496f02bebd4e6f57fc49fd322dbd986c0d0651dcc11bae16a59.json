{"repositoryId":1163611732,"availability":"available","full":"parallax-labs/context-harness","name":"context-harness","description":"Local-first context ingestion and retrieval for AI tools. SQLite + embeddings + MCP server for Cursor & Claude.","category":"Developer tools","language":"Rust","stars":42,"forks":4,"created":"2026-02-21T22:09:32Z","updated":"2026-10-15T14:04:15Z","license":"AGPL-3.0","branch":"main","homepage":null,"topics":["claude","cursor","embeddings","local-ai","mcp","model-context-protocol","rag","rust","sqlite"],"demo":"https://parallax-labs.github.io/context-harness/demo/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-19T11:49:52.497Z","lastAttemptAt":"2026-10-19T11:49:52.497Z","lastAvailableAt":"2026-10-19T11:49:52.497Z","metrics":[{"at":"2026-10-15T15:01:13.519Z","stars":42,"forks":4},{"at":"2026-10-19T11:49:52.497Z","stars":42,"forks":4}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["A local-first knowledge and agent runtime for AI tools.","Context Harness turns project knowledge into infrastructure AI can actually use. It ingests files, Git repositories, S3, and custom sources into an inspectable local SQLite index, then gives you two execution paths: reusable profiles for clients such as Cursor and Claude, or governed local agents with scoped tools, durable tasks, typed outcomes, checkpoints, and conservative recovery."],"features":["Connector-driven ingestion — plug in any source (filesystem, Git repos, S3 buckets, Lua scripts)","Multi-format file support — plain text (e.g. Markdown, .txt) plus PDF, Word (.docx), PowerPoint (.pptx), and Excel (.xlsx) with automatic text extraction when you include those extensions in includeglobs","Extension registries — install community connectors, tools, and profiles from Git-backed repos","Local-first storage — SQLite with FTS5 for keyword search","Embedding pipeline — local (fastembed or tract), Ollama, and OpenAI embeddings with automatic batching, retry, and staleness detection"],"sourceUrl":"https://github.com/parallax-labs/context-harness/blob/main/README.md","fingerprint":"8cdddaf5a61ad68c60ab80d31d90359f1af1e99f21558f7b036a39001395ed29","extractedAt":"2026-10-15T15:01:13.742Z"},"overviewCheckedAt":"2026-10-15T15:01:13.742Z","projectInsights":{"version":1,"whatItDoes":{"text":"A local-first knowledge and agent runtime for AI tools.","sourceUrl":"https://github.com/parallax-labs/context-harness/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"8cdddaf5a61ad68c60ab80d31d90359f1af1e99f21558f7b036a39001395ed29","sourceUrl":"https://github.com/parallax-labs/context-harness/blob/main/README.md","checkedAt":"2026-10-15T15:01:13.742Z"},"overviewRepoUpdated":"2026-10-15T14:04:15Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/parallax-labs/context-harness/blob/main/README.md","checkedAt":"2026-10-15T15:01:13.743Z","hash":"8cdddaf5a61ad68c60ab80d31d90359f1af1e99f21558f7b036a39001395ed29","originalBytes":22639,"storedBytes":22639,"truncated":false},"lastDemoCheckedAt":"2026-10-15T15:01:13.744Z","subjects":["MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["MCP servers & agents"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"MCP"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","Chatbots & assistants"],"reviewRequired":true},"demoHealth":{"url":"https://parallax-labs.github.io/context-harness/demo/","attemptedAt":"2026-10-15T15:14:33.374Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T15:14:33.374Z","lastWorkingAt":"2026-10-15T15:14:33.374Z","target":"https://parallax-labs.github.io/context-harness/demo/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T15:14:33.374Z"},"previewAttemptAt":"2026-10-15T15:14:33.374Z","previewCheck":{"url":"https://parallax-labs.githu