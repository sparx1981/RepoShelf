{"availability":"available","full":"feildrixliemdra/konbato","name":"konbato","description":"Explore this public GitHub project.","category":"Other","language":"JavaScript","stars":0,"forks":0,"created":"2026-06-19T07:42:26Z","updated":"2026-10-10T18:11:13Z","license":"MIT","branch":"master","homepage":"https://konbato.vercel.app","topics":[],"demo":"https://konbato.vercel.app/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-19T06:17:27.803Z","lastAttemptAt":"2026-10-19T06:17:27.803Z","lastAvailableAt":"2026-10-19T06:17:27.803Z","metrics":[{"at":"2026-10-09T19:34:43.635Z","stars":0,"forks":0},{"at":"2026-10-13T06:38:13.931Z","stars":0,"forks":0},{"at":"2026-10-19T06:17:27.803Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Private image and PDF tools that run entirely in your browser. No uploads, no accounts, no file-size paywalls.","Most file tools upload your document to a server, hold it there, and meter you on size. Konbato does the opposite: every tool is a static page that processes your file on your own device using WebAssembly, Web Workers, and Canvas APIs.","The full product reasoning — problem statement, competitive landscape, scope, and assumptions — lives in docs/PRD.md."],"features":["Your bytes never leave the device. No upload endpoint exists — there is no server-side file handling to trust or to leak.","Nothing to sign up for. Open a tool, drop a file, download the result.","No artificial limits. The ceiling is your browser's memory, not a paywall."],"sourceUrl":"https://github.com/feildrixliemdra/konbato/blob/master/README.md","fingerprint":"fd0304f2692cb59a8227ae342dd46c2af22505e9e4589ab53d073966e90949e6","extractedAt":"2026-10-09T19:34:43.747Z"},"overviewCheckedAt":"2026-10-09T19:34:43.747Z","projectInsights":{"version":1,"whatItDoes":{"text":"Private image and PDF tools that run entirely in your browser. No uploads, no accounts, no file-size paywalls.","sourceUrl":"https://github.com/feildrixliemdra/konbato/blob/master/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"No uploads, no accounts, no file-size paywalls.","sourceUrl":"https://github.com/feildrixliemdra/konbato/blob/master/README.md"},{"kind":"account","status":"documented","text":"Because nothing is uploaded, there is also nothing stored: no accounts, no cloud, no retention window.","sourceUrl":"https://github.com/feildrixliemdra/konbato/blob/master/README.md"}],"fingerprint":"fd0304f2692cb59a8227ae342dd46c2af22505e9e4589ab53d073966e90949e6","sourceUrl":"https://github.com/feildrixliemdra/konbato/blob/master/README.md","checkedAt":"2026-10-09T19:34:43.747Z"},"overviewRepoUpdated":"2026-10-09T18:01:59Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/feildrixliemdra/konbato/blob/master/README.md","checkedAt":"2026-10-09T19:34:43.748Z","hash":"fd0304f2692cb59a8227ae342dd46c2af22505e9e4589ab53d073966e90949e6","originalBytes":8974,"storedBytes":8974,"truncated":false},"lastDemoCheckedAt":"2026-10-09T19:34:43.635Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Image, audio & video AI","Browser extensions & PWAs","Writing & documents"],"reviewRequired":true},"demoHealth":{"url":"https://konbato.vercel.app/","attemptedAt":"2026-10-14T14:27:41.352Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T14:27:41.352Z","lastWorkingAt":"2026-10-14T14:27:41.352Z","target":"https://konbato.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-21T14:27:41.352Z"},"previewAttemptAt":"2026-10-14T14:27:41.352Z","previewCheck":{"url":"https://konbato.vercel.app/","attemptedAt":"2026-10-14T14:27:41.352Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-21T14:27:41.352Z"},"screenshots":[{"s