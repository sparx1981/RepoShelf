{"repositoryId":1233874315,"availability":"available","full":"dteichrow/epi-dossier","name":"epi-dossier","description":"Source-first infectious disease newsroom and evidence pipeline for outbreak monitoring and public health writing.","category":"Other","language":"Python","stars":1,"forks":1,"created":"2026-05-09T13:16:35Z","updated":"2026-10-12T19:02:32Z","branch":"main","homepage":"https://dteichrow.github.io/epi-dossier/","topics":["epidemiology","infectious-disease","outbreak-monitoring","public-health","science-communication"],"demo":"https://dteichrow.github.io/epi-dossier/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-12T19:08:30.520Z","lastAttemptAt":"2026-10-12T19:08:30.520Z","lastAvailableAt":"2026-10-12T19:08:30.520Z","metrics":[{"at":"2026-10-12T19:08:30.520Z","stars":1,"forks":1}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Source-first infectious disease and epidemiology monitoring system for The Edge of Epidemiology.","This project collects, filters, scores, summarizes, and publishes public-health and infectious-disease signals into a local reader and a public static site. The goal is not to replace expert judgment. The goal is to make the first pass through noisy public-health information more structured, inspectable, and useful.","Outbreak and public-health information arrives as a mess: official situation reports, state alerts, agency feeds, PubMed items, research notices, local news, and half-broken webpages. A human can read all of it, but the real bottleneck is remembering what changed, which sources are reliable, and how today’s signal fits into the longer disease story."],"features":["collect candidate items from known source classes;","score and filter them conservatively;","group related items into durable stories and topics;","render briefings and reference pages;","export structured JSON so other tools can consume the same evidence state;"],"sourceUrl":"https://github.com/dteichrow/epi-dossier/blob/main/README.md","fingerprint":"497c3eafadaab64715d33f01570868db6677508b51f9eb9ac39a7723c858d3e5","extractedAt":"2026-10-12T19:08:30.640Z"},"overviewCheckedAt":"2026-10-12T19:08:30.640Z","projectInsights":{"version":1,"whatItDoes":{"text":"Source-first infectious disease and epidemiology monitoring system for The Edge of Epidemiology.","sourceUrl":"https://github.com/dteichrow/epi-dossier/blob/main/README.md"},"audience":[],"requirements":[{"kind":"paid_service","status":"required","text":"No database migration, credential change, email send, or new paid service is required.","sourceUrl":"https://github.com/dteichrow/epi-dossier/blob/main/README.md"}],"fingerprint":"497c3eafadaab64715d33f01570868db6677508b51f9eb9ac39a7723c858d3e5","sourceUrl":"https://github.com/dteichrow/epi-dossier/blob/main/README.md","checkedAt":"2026-10-12T19:08:30.640Z"},"overviewRepoUpdated":"2026-10-12T19:02:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/dteichrow/epi-dossier/blob/main/README.md","checkedAt":"2026-10-12T19:08:30.641Z","hash":"497c3eafadaab64715d33f01570868db6677508b51f9eb9ac39a7723c858d3e5","originalBytes":9649,"storedBytes":9649,"truncated":false},"lastDemoCheckedAt":"2026-10-12T19:08:30.520Z","subjects":["Science"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Science"],"evidence":[{"subject":"Science","source":"metadata","match":"science"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows","Portfolios & personal sites","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://dteichrow.github.io/epi-dossier/","attemptedAt":"2026-10-12T19:19:16.822Z","probeVersion":3,"status":"working","checkedAt":"2026-10-12T19:19:16.822Z","lastWorkingAt":"2026-10-12T19:19:16.822Z","target":"https://dteichrow.github.io/epi-dossier/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-