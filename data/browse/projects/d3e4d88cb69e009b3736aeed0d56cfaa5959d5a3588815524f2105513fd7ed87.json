{"availability":"available","full":"selfishprimate/gerillass","name":"gerillass","description":"Gerillass is a Sass mixin library containing a set of Sass mixins and functions to help front-end developers generate scalable CSS outputs.","category":"Design","language":"SCSS","stars":171,"forks":17,"created":"2019-12-23T19:14:05Z","updated":"2026-09-30T09:02:19Z","license":null,"branch":"main","homepage":"https://gerillass.com/","topics":["ai","ai-tools","claude-code","css","developer-tools","development-tools","front-end-development","gerillass","sass","sass-boilerplate","sass-files","sass-framework","sass-functions","sass-library","sass-mixin-library","sass-mixins","sass-toolkit","scss","web-development"],"demo":"https://gerillass.com/playground","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-12T13:36:52.104Z","lastAttemptAt":"2026-10-12T13:36:52.104Z","lastAvailableAt":"2026-10-12T13:36:52.104Z","metrics":[{"at":"2026-10-06T21:08:01.636Z","stars":171,"forks":17},{"at":"2026-10-09T03:33:37.021Z","stars":171,"forks":17},{"at":"2026-10-12T13:36:52.104Z","stars":171,"forks":17}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Gerillass is a library built on top of Sass (Syntactically Awesome Style Sheets) to give you flexibility for your projects and accelerate your performance and creativity.","It is also built to be read by coding agents. Every mixin and function ships with a machine-readable manifest, and the test suite compiles every documented example and asserts every documented refusal. So what the manifest says the library does is what the library does. The docs cannot drift away from the code, because a stale manifest fails the build.","Many of the utilities that come with Gerillass are the solutions I have come up with for the challenges I have faced as a frontend developer over the years. These solutions have been shaped by the inspiration of other popular libraries and frameworks like Bourbon, Susy, Scut, Bootstrap, etc. over time and helped me create Gerillass."],"features":["Gerillass Documentation"],"sourceUrl":"https://github.com/selfishprimate/gerillass/blob/main/README.md","fingerprint":"c7b9e9b97c8d5265020a6d74eef9f25ba3eb2dd763aa97eefc2baff35b7a9c36","extractedAt":"2026-10-06T21:08:01.807Z"},"overviewCheckedAt":"2026-10-12T13:36:52.305Z","projectInsights":{"version":1,"whatItDoes":{"text":"Gerillass is a library built on top of Sass (Syntactically Awesome Style Sheets) to give you flexibility for your projects and accelerate your performance and creativity.","sourceUrl":"https://github.com/selfishprimate/gerillass/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"c7b9e9b97c8d5265020a6d74eef9f25ba3eb2dd763aa97eefc2baff35b7a9c36","sourceUrl":"https://github.com/selfishprimate/gerillass/blob/main/README.md","checkedAt":"2026-10-12T13:36:52.305Z"},"overviewRepoUpdated":"2026-09-30T09:02:19Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/selfishprimate/gerillass/blob/main/README.md","checkedAt":"2026-10-12T13:36:52.306Z","hash":"c7b9e9b97c8d5265020a6d74eef9f25ba3eb2dd763aa97eefc2baff35b7a9c36","originalBytes":15386,"storedBytes":15386,"truncated":false},"lastDemoCheckedAt":"2026-10-12T13:36:52.104Z","subjects":["Templates & UI components"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Templates & UI components"],"evidence":[{"subject":"Templates & UI components","source":"metadata","match":"boilerplate"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["MCP servers & agents","Music & audio"],"reviewRequired":true},"demoHealth":{"url":"https://gerillass.com/playground","attemptedAt":"2026-10-14T14:27:48.237Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T14:27:48.237Z","lastWorkingAt":"2026-10-14T14:27:48.237Z","target":"https://gerillass.com/playground","failureCount":0,"consecutiveTemporaryFailures":0,"nextChe