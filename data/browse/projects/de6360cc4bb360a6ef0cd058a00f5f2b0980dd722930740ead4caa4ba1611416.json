 MLX; keys in Keychain; explicit consent before data leaves the Mac."],"sourceUrl":"https://github.com/alex-cova/Penumbra/blob/main/README.md","fingerprint":"0e4b8b3e6a095a28f25c8c67898ad8067b6541733579b4eb2566cf606ddb4d44","extractedAt":"2026-10-17T18:53:30.770Z"},"overviewCheckedAt":"2026-10-17T18:53:30.770Z","projectInsights":{"version":1,"whatItDoes":{"text":"Repository: github.com/alex-cova/Penumbra · Website: alex-cova.github.io/Penumbra","sourceUrl":"https://github.com/alex-cova/Penumbra/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"0e4b8b3e6a095a28f25c8c67898ad8067b6541733579b4eb2566cf606ddb4d44","sourceUrl":"https://github.com/alex-cova/Penumbra/blob/main/README.md","checkedAt":"2026-10-17T18:53:30.771Z"},"overviewRepoUpdated":"2026-10-17T17:17:53Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/alex-cova/Penumbra/blob/main/README.md","checkedAt":"2026-10-17T18:53:30.772Z","hash":"0e4b8b3e6a095a28f25c8c67898ad8067b6541733579b4eb2566cf606ddb4d44","originalBytes":15740,"storedBytes":15740,"truncated":false},"lastDemoCheckedAt":"2026-10-17T18:53:30.701Z","subjects":["Apple","Writing & documents"],"platforms":["macOS"],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Apple","Writing & documents"],"evidence":[{"subject":"Apple","source":"metadata","match":"macos"},{"subject":"Writing & documents","source":"metadata","match":"text editor"}],"platformEvidence":[{"platform":"macOS","source":"metadata","match":"macos"}],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Simulation & physics","Mobile","MCP servers & agents","Templates & UI components"],"reviewRequired":true},"demoHealth":{"url":"https://alex-cova.github.io/Penumbra/","attemptedAt":"2026-10-17T19:06:09.104Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T19:06:09.104Z","lastWorkingAt":"2026-10-17T19:06:09.104Z","target":"https://alex-cova.github.io/Penumbra/","fai