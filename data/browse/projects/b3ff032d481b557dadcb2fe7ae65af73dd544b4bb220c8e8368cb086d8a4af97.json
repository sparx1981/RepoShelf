{"repositoryId":1425191213,"availability":"available","full":"BrunoBeck940/ai-rules-sync","name":"ai-rules-sync","description":"Keep one source of truth for your AI coding-agent rules. Convert and sync between AGENTS.md, CLAUDE.md, .cursorrules, Copilot, Windsurf, Cline, Aider & Gemini — or scaffold a fresh AGENTS.md. Zero dependencies.","category":"Developer tools","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-19T06:14:47Z","updated":"2026-10-19T06:18:06Z","license":null,"branch":"main","homepage":"https://panishandsome.github.io/ai-rules-sync/","topics":["agents-md","ai","claude","cli","codex","coding-agent","copilot","cursor","developer-tools","llm"],"demo":"https://panishandsome.github.io/ai-rules-sync/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-19T07:22:08.561Z","lastAttemptAt":"2026-10-19T07:22:08.561Z","lastAvailableAt":"2026-10-19T07:22:08.561Z","metrics":[{"at":"2026-10-19T07:22:08.561Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["One source of truth for your AI coding-agent rules.","Codex reads AGENTS.md. Claude Code reads CLAUDE.md. Cursor reads .cursorrules. Copilot reads .github/copilot-instructions.md. Keeping them in sync by hand is tedious and they drift. agentsync converts between all of them — or generates a clean AGENTS.md from a short spec.","Zero dependencies. The exact same engine (src/core/agentsync.js) powers both the CLI and the browser playground."],"features":[],"sourceUrl":"https://github.com/BrunoBeck940/ai-rules-sync/blob/main/README.md","fingerprint":"a7b8f600039a54132fea885985b7f37fe84326e89baf6aea50490d157d9df38c","extractedAt":"2026-10-19T07:22:08.665Z"},"overviewCheckedAt":"2026-10-19T07:22:08.665Z","projectInsights":{"version":1,"whatItDoes":{"text":"One source of truth for your AI coding-agent rules.","sourceUrl":"https://github.com/BrunoBeck940/ai-rules-sync/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"a7b8f600039a54132fe