{"repositoryId":363908235,"availability":"available","full":"Fraud-Detection-Handbook/fraud-detection-handbook","name":"fraud-detection-handbook","description":"Reproducible Machine Learning for Credit Card Fraud Detection - Practical Handbook","category":"Education","language":"Jupyter Notebook","stars":744,"forks":225,"created":"2021-05-03T11:33:12Z","updated":"2024-02-07T15:28:44Z","license":null,"branch":"main","homepage":"https://fraud-detection-handbook.github.io/fraud-detection-handbook/Foreword.html","topics":["credit-card","credit-card-fraud","data-mining","data-science","fraud-detection","machine-learning","open-data"],"demo":"https://fraud-detection-handbook.github.io/fraud-detection-handbook/Foreword.html","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T22:42:29.155Z","lastAttemptAt":"2026-10-18T22:42:29.155Z","lastAvailableAt":"2026-10-18T22:42:29.155Z","metrics":[{"at":"2026-10-12T13:37:45.390Z","stars":743,"forks":225},{"at":"2026-10-18T22:42:29.155Z","stars":744,"forks":225}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Machine learning for credit card fraud detection (ML for CCFD) has become an active research field. This is illustrated by the remarkable amount of publications on the topic in the last decade.","It makes no doubt that the integration of machine learning techniques in payment card fraud detection systems has greatly improved their ability to more efficiently detect frauds. At the same time, a major issue in this new research field is the lack of reproducibility. There do not exist any recognized benchmarks, nor methodologies, to compare and assess the proposed techniques.","This book aims at making a first step in this direction. All the techniques and results provided in this book are reproducible. Sections that include code are Jupyter notebooks, which can be executed either locally, or on the cloud using Google Colab or Binder."],"features":["Chapter 1: Book overview","Chapter 2: Background","Chapter 3: Getting started","Chapter 4: Performance metrics","Chapter 5: Model selection"],"sourceUrl":"https://github.com/Fraud-Detection-Handbook/fraud-detection-handbook/blob/main/README.md","fingerprint":"2de18d70d4681cfa0107aca61dd2d338013794084aa130575d80a0f8b1b429cd","extractedAt":"2026-10-12T13:37:45.551Z"},"overviewCheckedAt":"2026-10-12T13:37:45.551Z","projectInsights":{"version":1,"whatItDoes":{"text":"Machine learning for credit card fraud detection (ML for CCFD) has become an active research field. This is illustrated by the remarkable amount of publications on the topic in the last decade.","sourceUrl":"https://github.com/Fraud-Detection-Handbook/fraud-detection-handbook/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"2de18d70d4681cfa0107aca61dd2d338013794084aa130575d80a0f8b1b429cd","sourceUrl":"https://github.com/Fraud-Detection-Handbook/fraud-detection-handbook/blob/main/README.md","checkedAt":"2026-10-12T13:37:45.552Z"},"overviewRepoUpdated":"2024-02-07T15:28:44Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Fraud-Detection-Handbook/fraud-detection-handbook/blob/main/README.md","checkedAt":"2026-10-17T05:18:53.885Z","hash":"2de18d70d4681cfa0107aca61dd2d338013794084aa130575d80a0f8b1b429cd","originalBytes":6128,"storedBytes":6128,"truncated":false},"lastDemoCheckedAt":"2026-10-12T13:37:45.390Z","enrichmentAttemptAt":"2026-10-12T13:38:21.563Z","latestRelease":null,"releaseCheckedAt":"2026-10-12T13:38:21.563Z","screenshots":[{"src":"previews/6df4896ce4d05c775869105d.jpg","kind":"demo","capturedAt":"2026-10-19T14:03:33.289Z","url":"https://fraud-detection-handbook.github.io/fraud-detection-handbook/Foreword.html"}],"subjects":["Science"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Education","subjects":["Science"],"evidence":[{"subject":"Science","source":"metadata","match":"science"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested",