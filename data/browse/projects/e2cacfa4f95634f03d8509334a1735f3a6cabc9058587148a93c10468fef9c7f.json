{"repositoryId":1211110869,"availability":"available","full":"runyaga/dart_monty_core","name":"dart_monty_core","description":"Dart binding for pydantic/monty","category":"AI & machine learning","language":"Dart","stars":2,"forks":1,"created":"2026-04-15T04:36:33Z","updated":"2026-10-15T14:57:39Z","license":"MIT","branch":"main","homepage":"https://runyaga.github.io/dart_monty_core/","topics":["dart","flutter","interpreter","javascript","llm","python","wasm"],"demo":"https://runyaga.github.io/dart_monty_core/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-15T15:02:05.770Z","lastAttemptAt":"2026-10-15T15:02:05.770Z","lastAvailableAt":"2026-10-15T15:02:05.770Z","metrics":[{"at":"2026-10-15T15:02:05.770Z","stars":2,"forks":1}],"technologies":["Python","Flutter"],"overview":{"kind":"readme","version":1,"paragraphs":["The interpreter never runs in your process. Each session runs in a worker: a child process on native platforms, a Web Worker in the browser. A crash in the sandbox kills that worker, not your app, and a pool replaces it. This is the model of upstream's own bindings (pydanticmonty's AsyncMonty), and the API follows theirs.","Dart is compiled, with no reflection: fast and tree-shakeable, but you cannot ship new behaviour without shipping a new binary. Monty is a sandboxed Python subset under hard resource limits, on native and on the web.","LLMs write good Python. Let them script your Dart app through code your app type-checks, runs in a sandbox, lets reach only the host functions and OS calls you provide, and reads back as typed values. Pydantic runs a bug bounty at hackmonty.com for the underlying interpreter."],"features":[],"sourceUrl":"https://github.com/runyaga/dart_monty_core/blob/main/README.md","fingerprint":"453f4b77b2ad4b57f670b07dc07bcc7bcc5ff8a66c82fc19866846fed09b9c32","extractedAt":"2026-10-15T15:02:05.962Z"},"overviewCheckedAt":"2026-10-15T15:02:05.962Z","projectInsights":{"version":1,"whatItDoes":{"text":"The interpreter never runs in your process. Each session runs in a worker: a child process on native platforms, a Web Worker in the browser. A crash in the sandbox kills that worker, not your app, and a pool replaces it. This is the model of upstream's own bindings (pydanticmonty's AsyncMonty), and the API follows theirs.","sourceUrl":"https://github.com/runyaga/dart_monty_core/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"453f4b77b2ad4b57f670b07dc07bcc7bcc5ff8a66c82fc19866846fed09b9c32","sourceUrl":"https://github.com/runyaga/dart_monty_core/blob/main/README.md","checkedAt":"2026-10-15T15:02:05.962Z"},"overviewRepoUpdated":"2026-10-15T14:57:39Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/runyaga/dart_monty_core/blob/main/README.md","checkedAt":"2026-10-15T15:02:05.963Z","hash":"453f4b77b2ad4b57f670b07dc07bcc7bcc5ff8a66c82fc19866846fed09b9c32","originalBytes":15130,"storedBytes":15130,"truncated":false},"lastDemoCheckedAt":"2026-10-15T15:02:05.770Z","subjects":["Mobile"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["Mobile"],"evidence":[{"subject":"Mobile","source":"metadata","match":"flutter"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://runyaga.github.io/dart_monty_core/","attemptedAt":"2026-10-15T15:16:12.739Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T15:16:12.739Z","lastWorkingAt":"2026-10-15T15:16:12.739Z","target":"https://runyaga.github.io/dart_monty_core/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T15:16:12.739Z"},"previewAttemptAt":"2026-10-15T15:16:12.739Z","previewCheck":{"url":"https://runyaga.github.io/dart_monty_core/","attemptedAt":"2026-10-15T15:16:12.739Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-22T15:16:12.739Z"},"screenshots":[{"src":"previews/e2