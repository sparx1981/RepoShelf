{"repositoryId":1290056540,"availability":"available","full":"AkankshaD2/veriride","name":"veriride","description":"ANPR-based vehicle plate verification for ride-hailing safety.  EasyOCR + Flask API + Streamlit frontend. Live demo ↓","category":"Developer tools","language":"Jupyter Notebook","stars":2,"forks":0,"created":"2026-07-05T14:29:28Z","updated":"2026-10-14T14:06:06Z","license":"MIT","branch":"main","homepage":"https://veriride-gbtapjwvoka8nhx5vi62kr.streamlit.app/","topics":["anpr","computer-vision","easyocr","flask","ocr","opencv","python","ride-hailing","safety","streamlit"],"demo":"https://veriride-gbtapjwvoka8nhx5vi62kr.streamlit.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-19T02:49:13.945Z","lastAttemptAt":"2026-10-19T02:49:13.945Z","lastAvailableAt":"2026-10-19T02:49:13.945Z","metrics":[{"at":"2026-10-19T02:49:13.945Z","stars":2,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["You book a ride. The app shows a vehicle number. The auto that pulls up has a different one. You get in anyway — because what else are you supposed to do, stand there comparing digits at 11pm?","That gap is the problem. VeriRide closes it — point your camera at the actual plate, it reads the number, checks it against what you booked, tells you in under a second if something's off.","Vehicle-number mismatches in ride-hailing bookings are a real, reported safety gap — small enough to ignore, big enough to matter at 11pm alone. This isn't a toy dataset project; it's an end-to-end CV pipeline (detection → OCR → fuzzy matching) aimed at an actual problem, with honestly benchmarked results."],"features":[],"sourceUrl":"https://github.com/AkankshaD2/veriride/blob/main/README.md","fingerprint":"dbde2f18d04a0f07d077957f20e81be149aaf78211c17493ab5bc21052690609","extractedAt":"2026-10-19T02:49:14.031Z"},"overviewCheckedAt":"2026-10-19T02:49:14.031Z","projectInsights":{"version":1,"whatItDoes":{"text":"You book a ride. The app shows a vehicle number. The auto that pulls up has a different one. You get in anyway — because what else are you supposed to do, stand there comparing digits at 11pm?","sourceUrl":"https://github.com/AkankshaD2/veriride/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"dbde2f18d04a0f07d077957f20e81be149aaf78211c17493ab5bc21052690609","sourceUrl":"https://github.com/AkankshaD2/veriride/blob/main/README.md","checkedAt":"2026-10-19T02:49:14.032Z"},"overviewRepoUpdated":"2026-10-14T14:06:06Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/AkankshaD2/veriride/blob/main/README.md","checkedAt":"2026-10-19T02:49:14.032Z","hash":"dbde2f18d04a0f07d077957f20e81be149aaf78211c17493ab5bc21052690609","originalBytes":5370,"storedBytes":5370,"truncated":false},"lastDemoCheckedAt":"2026-10-19T02:49:13.945Z","subjects":["Automotive","Writing & documents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Automotive","Writing & documents"],"evidence":[{"subject":"Automotive","source":"metadata","match":"vehicle"},{"subject":"Writing & documents","source":"metadata","match":"ocr"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://veriride-gbtapjwvoka8nhx5vi62kr.streamlit.app/","attemptedAt":"2026-10-19T03:03:02.531Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T03:03:02.531Z","lastWorkingAt":"2026-10-19T03:03:02.531Z","target":"https://veriride-gbtapjwvoka8nhx5vi62kr.streamlit.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T03:03:02.531Z"},"previewAttemptAt":"2026-10-19T03:03:02.531Z","previewCheck":{"url":"https://veriride-gbtapjwvoka8nhx5vi62kr.streamlit.app/","attemptedAt":"2026-10-19T03:03:02.531Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-26T03:03:02.531Z"},"screenshots":[{"src":"pr