{"availability":"available","full":"tomer2208/household-ledger","name":"household-ledger","description":"Shared household budget app: Apple Pay capture, smart categorization, budgets and alerts, real-time sync. Expo + Supabase PWA.","category":"Finance","language":"TypeScript","stars":0,"forks":0,"created":"2026-09-27T11:55:41Z","updated":"2026-10-12T06:43:42Z","branch":"main","homepage":"https://household-ledger-murex.vercel.app","topics":["budgeting","expo","github-actions","postgresql","pwa","react-native","supabase","typescript"],"demo":"https://household-ledger-murex.vercel.app/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-17T19:53:53.846Z","lastAttemptAt":"2026-10-17T19:53:53.846Z","lastAvailableAt":"2026-10-17T19:53:53.846Z","metrics":[{"at":"2026-10-11T19:50:46.747Z","stars":0,"forks":0},{"at":"2026-10-17T19:53:53.846Z","stars":0,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["A budget app I built for my wife and me, so we could stop keeping track of expenses in a spreadsheet.","When one of us pays with Apple Pay, an iOS Shortcut sends the purchase to the app. If we've bought from that store before, it's filed automatically. If it's a new store, the phone asks once which category it belongs to and remembers the answer. Everything syncs between our phones, and we get a notification when a category gets close to its monthly budget.","Live version: household-ledger-murex.vercel.app"],"features":["Automatic capture of Apple Pay purchases through an iOS Shortcut","Category guessing: exact match on known stores first, then fuzzy matching in Postgres (pgtrgm), and only then an LLM suggestion","Monthly budget per category, with a push notification at 90% and at 100%","Month close: on the 1st, whatever's left over (or overspent) goes into a running savings balance","Recurring payments like rent and bills, including ones where the amount changes every month"],"sourceUrl":"https://github.com/tomer2208/household-ledger/blob/main/README.md","fingerprint":"deae48277fa6fe65a3ed01d18dcf47a76ae577a05a8dcce67aa787cc83bb5f9f","extractedAt":"2026-10-11T19:50:46.874Z"},"overviewCheckedAt":"2026-10-11T19:50:46.874Z","projectInsights":{"version":1,"whatItDoes":{"text":"A budget app I built for my wife and me, so we could stop keeping track of expenses in a spreadsheet.","sourceUrl":"https://github.com/tomer2208/household-ledger/blob/main/README.md"},"audience":[{"text":"A budget app I built for my wife and me, so we could stop keeping track of expenses in a spreadsheet.","sourceUrl":"https://github.com/tomer2208/household-ledger/blob/main/README.md"}],"requirements":[],"fingerprint":"deae48277fa6fe65a3ed01d18dcf47a76ae577a05a8dcce67aa787cc83bb5f9f","sourceUrl":"https://github.com/tomer2208/household-ledger/blob/main/README.md","checkedAt":"2026-10-11T19:50:46.874Z"},"overviewRepoUpdated":"2026-10-11T17:48:52Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/tomer2208/household-ledger/blob/main/README.md","checkedAt":"2026-10-11T19:50:46.874Z","hash":"deae48277fa6fe65a3ed01d18dcf47a76ae577a05a8dcce67aa787cc83bb5f9f","originalBytes":2652,"storedBytes":2652,"truncated":false},"lastDemoCheckedAt":"2026-10-11T19:50:46.747Z","subjects":["Mobile","Browser extensions & PWAs"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Finance","subjects":["Mobile","Browser extensions & PWAs"],"evidence":[{"subject":"Mobile","source":"metadata","match":"react native"},{"subject":"Browser extensions & PWAs","source":"metadata","match":"PWA"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://household-ledger-murex.vercel.app/","attemptedAt":"2026-10-17T20:12:35.130Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T20:12:35.130Z","lastWorkingAt":"2026-10-17T20:12:35.130Z","target":"https://household-ledger