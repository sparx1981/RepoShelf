{"availability":"available","full":"growgraph/graflo","name":"graflo","description":"Describe a labeled property graph once in a YAML manifest; GraFlo builds the schema and ingests records from CSV, JSON, Parquet, SQL, RDF/SPARQL, REST APIs or Kafka into ArangoDB, Neo4j, TigerGraph, FalkorDB, Memgraph, NebulaGraph, PostgreSQL or a directory on disk.","category":"Developer tools","language":"Python","stars":37,"forks":4,"created":"2021-06-25T15:33:21Z","updated":"2026-10-11T00:04:20Z","license":"Apache-2.0","branch":"main","homepage":"https://growgraph.github.io/graflo/","topics":["arangodb","digital-twin","etl","graph-database","graph-schema","knowledge-graph","labeled-property-graph","neo4j","property-graph","rdf","schema-inference","schema-migration","sparql"],"demo":"https://growgraph.github.io/graflo/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-12T06:28:04.796Z","lastAttemptAt":"2026-10-12T06:28:04.796Z","lastAvailableAt":"2026-10-12T06:28:04.796Z","metrics":[{"at":"2026-10-07T02:54:50.171Z","stars":36,"forks":4},{"at":"2026-10-09T03:37:50.006Z","stars":36,"forks":4},{"at":"2026-10-12T06:28:04.796Z","stars":37,"forks":4}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Describe a property graph once in YAML; load it from files, SQL, RDF, APIs or Kafka into the database of your choice.","GraFlo is a Python library that turns records from files, SQL databases, RDF, REST APIs or Kafka topics into a labeled property graph. You describe the graph once, in a YAML file called a manifest, and GraFlo creates the schema and writes the vertices and edges into the graph database of your choice, or into a directory on disk.","It is for engineers who build a graph from several sources and want its description in one reviewable file rather than spread across load scripts."],"features":["Describe a graph once and load data into it. A manifest names the vertex","Change the description over time, with a recorded history. Renaming a","Check and infer descriptions. GraFlo infers a manifest from a PostgreSQL"],"sourceUrl":"https://github.com/growgraph/graflo/blob/main/README.md","fingerprint":"63a2ade4a1ce6e2b91339beddb3d23f01abcf8164b35d0020ed0f51ecc771fac","extractedAt":"2026-10-07T02:54:50.316Z"},"overviewCheckedAt":"2026-10-09T03:37:50.151Z","projectInsights":{"version":1,"whatItDoes":{"text":"Describe a property graph once in YAML; load it from files, SQL, RDF, APIs or Kafka into the database of your choice.","sourceUrl":"https://github.com/growgraph/graflo/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"63a2ade4a1ce6e2b91339beddb3d23f01abcf8164b35d0020ed0f51ecc771fac","sourceUrl":"https://github.com/growgraph/graflo/blob/main/README.md","checkedAt":"2026-10-09T03:37:50.151Z"},"overviewRepoUpdated":"2026-10-08T21:36:23Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/growgraph/graflo/blob/main/README.md","checkedAt":"2026-10-09T03:37:50.152Z","hash":"63a2ade4a1ce6e2b91339beddb3d23f01abcf8164b35d0020ed0f51ecc771fac","originalBytes":8131,"storedBytes":8131,"truncated":false},"lastDemoCheckedAt":"2026-10-09T03:37:50.006Z","subjects":["Simulation & physics"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Simulation & physics"],"evidence":[{"subject":"Simulation & physics","source":"metadata","match":"digital twin"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows"],"reviewRequired":true},"demoHealth":{"url":"https://growgraph.github.io/graflo/","attemptedAt":"2026-10-12T06:47:52.837Z","probeVersion":3,"status":"working","checkedAt":"2026-10-12T06:47:52.837Z","lastWorkingAt":"2026-10-12T06:47:52.837Z","target":"https://growgraph.github.io/graflo/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-19T06:47:52.837Z"},"previewAttemptAt":"2026-10-12T06:47:52.837Z","previewCheck":{"url":"htt