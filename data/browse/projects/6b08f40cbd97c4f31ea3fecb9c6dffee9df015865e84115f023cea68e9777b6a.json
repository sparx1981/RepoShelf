{"availability":"available","full":"miroslavpejic85/mirotalkc2c","name":"mirotalkc2c","description":"📹 Open-source, self-hosted WebRTC 1-to-1 video calling for private real-time communication. Build secure browser-based consultations, coaching, support, telehealth, and other video call experiences with peer-to-peer communication and screen sharing.","category":"Other","language":"JavaScript","stars":516,"forks":98,"created":"2022-12-04T07:55:24Z","updated":"2026-10-07T19:22:25Z","license":"AGPL-3.0","branch":"main","homepage":"https://c2c.mirotalk.com","topics":["e2e-encryption","embedable","end-to-end-encryption","iframe","low-latency","mirotalk","one-to-one","online-meeting","open-source","p2p","peer-to-peer","real-time-communication","screen-sharing","self-hosted","video-call","video-chat","video-conferencing","webrtc"],"demo":"https://c2c.mirotalk.com/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-08T00:28:04.251Z","lastAttemptAt":"2026-10-08T00:28:04.251Z","lastAvailableAt":"2026-10-08T00:28:04.251Z","lastDemoCheckedAt":"2026-10-05T21:33:04.388Z","discoveredVia":[{"kind":"curated-list","name":"Awesome Selfhosted","url":"https://github.com/awesome-selfhosted/awesome-selfhosted"}],"metrics":[{"at":"2026-10-04T06:50:11.116Z","stars":513,"forks":98},{"at":"2026-10-05T21:33:04.388Z","stars":512,"forks":98},{"at":"2026-10-08T00:28:04.251Z","stars":516,"forks":98}],"technologies":["Node.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Self-hosted, open-source WebRTC cam-to-cam peer-to-peer video calling for private 1-to-1 real-time communication, with screen sharing and end-to-end encryption.","MiroTalk C2C is a self-hosted, open-source WebRTC platform for secure cam-to-cam peer-to-peer video calls and screen sharing. It enables immersive 1-to-1 real-time communication with full end-to-end encryption and can be easily embedded into any website via a simple iframe integration.","In Settings > Video > Background, select Off, Blur, or Image. PNG, JPEG, and WebP images up to 10 MB are processed locally in your browser and are not uploaded. Effects appear in the camera preview, outgoing camera video, and camera recordings. Screen sharing is unaffected; the selected effect resumes when returning to the camera. Background changes are blocked while recording."],"features":["REST API Documentation","Create your feature branch","Submit a pull request"],"sourceUrl":"https://github.com/miroslavpejic85/mirotalkc2c/blob/main/README.md","fingerprint":"a3d00c15c726e288726529e43c53c76a9f1904d7844641a33d9471c99e08f205","extractedAt":"2026-10-04T06:50:11.116Z"},"overviewCheckedAt":"2026-10-08T00:31:18.600Z","projectInsights":{"version":1,"whatItDoes":{"text":"Self-hosted, open-source WebRTC cam-to-cam peer-to-peer video calling for private 1-to-1 real-time communication, with screen sharing and end-to-end encryption.","sourceUrl":"https://github.com/miroslavpejic85/mirotalkc2c/blob/main/README.md"},"audience":[],"requirements":[{"kind":"hosting","status":"required","text":"To set up your own instance of MiroTalk C2C on a dedicated cloud server, please refer to our comprehensive self-hosting documentation.","sourceUrl":"https://github.com/miroslavpejic85/mirotalkc2c/blob/main/README.md"}],"fingerprint":"a3d00c15c726e288726529e43c53c76a9f1904d7844641a33d9471c99e08f205","sourceUrl":"https://github.com/miroslavpejic85/mirotalkc2c/blob/main/README.md","checkedAt":"2026-10-08T00:31:18.601Z"},"overviewRepoUpdated":"2026-10-07T19:22:25Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/miroslavpejic85/mirotalkc2c/blob/main/README.md","checkedAt":"2026-10-08T00:31:18.602Z","hash":"a3d00c15c726e288726529e43c53c76a9f1904d7844641a33d9471c99e08f205","originalBytes":9363,"storedBytes":9363,"truncated":false,"searchTerms":["mirotalk","c2c","images","license","frontend","camera","docker","documentation","video","background","explore","hosting","image","open","agplv3","dedicated","env","join","open-source","pu