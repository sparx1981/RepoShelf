{"repositoryId":1329783611,"availability":"available","full":"Biswajit1999/AETHER","name":"AETHER","description":"Interactive astronomy visualization project combining astrophysical animations, scientific storytelling, WebGL/Three.js scenes and browser-based simulations to make research concepts and space data easier to explore visually.","category":"Design","language":"JavaScript","stars":1,"forks":0,"created":"2026-08-10T12:07:28Z","updated":"2026-10-14T23:52:10Z","branch":"master","homepage":"https://biswajit1999.github.io/AETHER/","topics":["animation","astronomy","astrophysics","creative-coding","data-visualization","github-pages","interactive-visualization","research-software","scientific-computing","scientific-visualization","simulation","space-science","threejs","webgl"],"demo":"https://biswajit1999.github.io/AETHER/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-17T22:40:21.209Z","lastAttemptAt":"2026-10-17T22:40:21.209Z","lastAvailableAt":"2026-10-17T22:40:21.209Z","metrics":[{"at":"2026-10-17T22:40:21.209Z","stars":1,"forks":0}],"technologies":["Three.js"],"overview":{"kind":"readme","version":1,"paragraphs":["AETHER is my personal place for learning, experimenting and developing computational visual art. I study how mathematics, physics, sound and code can become living visual experiences—forms that can be observed, rotated, heard, tested and refined in real time.","This is not a single finished artwork. It is a growing catalogue of investigations: particle systems, galactic encounters, mathematical structures, emergent motion, generative shaders and audiovisual compositions. Each study is a record of curiosity becoming form."],"features":["The first deeper scientific revision replaces a static galaxy-shaped particle field with a time-evolving restricted N-body encounter. Two mutually interacting softened galactic potentials guide massless stellar tracers…","It is an educational merger-compatible realisation—not a precision forecast of the Local Group’s future."],"sourceUrl":"https://github.com/Biswajit1999/AETHER/blob/master/README.md","fingerprint":"bc474a4d13e3028a3c788b591bd0221176fc44eec5892ebea4f06ba475b225d4","extractedAt":"2026-10-17T22:40:21.317Z"},"overviewCheckedAt":"2026-10-17T22:40:21.317Z","projectInsights":{"version":1,"whatItDoes":{"text":"AETHER is my personal place for learning, experimenting and developing computational visual art. I study how mathematics, physics, sound and code can become living visual experiences—forms that can be observed, rotated, heard, tested and refined in real time.","sourceUrl":"https://github.com/Biswajit1999/AETHER/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"bc474a4d13e3028a3c788b591bd0221176fc44eec5892ebea4f06ba475b225d4","sourceUrl":"https://github.com/Biswajit1999/AETHER/blob/master/README.md","checkedAt":"2026-10-17T22:40:21.318Z"},"overviewRepoUpdated":"2026-10-14T23:52:10Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Biswajit1999/AETHER/blob/master/README.md","checkedAt":"2026-10-17T22:40:21.318Z","hash":"bc474a4d13e3028a3c788b591bd0221176fc44eec5892ebea4f06ba475b225d4","originalBytes":6819,"storedBytes":6819,"truncated":false},"lastDemoCheckedAt":"2026-10-17T22:40:21.209Z","subjects":["Animation & motion","Simulation & physics","Science","Data & dashboards","3D & graphics"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Animation & motion","Simulation & physics","Science","Data & dashboards","3D & graphics"],"evidence":[{"subject":"Animation & motion","source":"metadata","match":"animation"},{"subject":"Simulation & physics","source":"metadata","match":"simulation"},{"subject":"Science","source":"metadata","match":"astronomy"},{"subject":"Data & dashboards","source":"metadata","match":"data visualization"},{"subject":"3D & graphics","source":"metadata","match":"WebGL"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runt