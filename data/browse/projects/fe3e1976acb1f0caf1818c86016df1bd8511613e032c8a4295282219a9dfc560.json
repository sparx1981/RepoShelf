{"repositoryId":1056359242,"availability":"available","full":"smresponsibilities/Xeno2","name":"Xeno2","description":"Shopify Insights - E-commerce analytics and customer segmentation dashboard built with Next.js 15, React 19, Supabase, and Recharts","category":"Business","language":"TypeScript","stars":1,"forks":0,"created":"2025-09-13T23:21:15Z","updated":"2026-10-15T10:26:41Z","branch":"main","homepage":"https://xeno2-df3z.vercel.app","topics":["customer-segmentation","ecommerce-analytics","nextjs15-app-router","react19","recharts","shopify-customer-segments","shopify-segmentation-api","supabase"],"demo":"https://xeno2-df3z.vercel.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-15T11:20:40.400Z","lastAttemptAt":"2026-10-15T11:20:40.400Z","lastAvailableAt":"2026-10-15T11:20:40.400Z","metrics":[{"at":"2026-10-15T11:20:40.400Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A modern, high-performance e-commerce analytics and customer relationship intelligence dashboard. Synchronizes order streams and customer cohorts from Shopify stores into Supabase PostgreSQL to compute Customer Lifetime Value (LTV), repeat purchase frequency, average order value (AOV), and retention decay curves.","Shopify's default analytics portal provides surface-level sales metrics but restricts advanced cohort segmentation, time-decay customer behavior modeling, and customized SQL aggregations behind expensive enterprise tiers (Shopify Plus).","Shopify Insights is a standalone, self-hosted analytics engine. Built on Next.js 15 Turbopack and React 19, it combines Supabase Row-Level Security (RLS) with responsive Recharts data visualizations to empower direct-to-consumer (DTC) brands with real-time business intelligence."],"features":["Cohort Retention Analysis: Visual heatmap matrices tracking customer retention over 12-month cohorts.","Dynamic LTV & AOV Calculation: Real-time aggregation of Customer Lifetime Value (LTV) and Average Order Value (AOV).","Interactive Recharts Visualizations: Responsive line charts, bar charts, and area graphs with tooltips and date-range pickers (date-fns).","Supabase SSR Authentication: Secure, session-based merchant authentication powered by @supabase/ssr with middleware route guarding.","Turbopack Build Optimization: Lightning-fast hot module reloading and sub-second page compilation in Next.js 15."],"sourceUrl":"https://github.com/smresponsibilities/Xeno2/blob/main/README.md","fingerprint":"0dbcae1ff13fc543f44f9d23c5e2f7da07cd9fc428461d1dc3a291f0ee6c8a9b","extractedAt":"2026-10-15T11:20:40.492Z"},"overviewCheckedAt":"2026-10-15T11:20:40.492Z","projectInsights":{"version":1,"whatItDoes":{"text":"A modern, high-performance e-commerce analytics and customer relationship intelligence dashboard. Synchronizes order streams and customer cohorts from Shopify stores into Supabase PostgreSQL to compute Customer Lifetime Value (LTV), repeat purchase frequency, average order value (AOV), and retention decay curves.","sourceUrl":"https://github.com/smresponsibilities/Xeno2/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"0dbcae1ff13fc543f44f9d23c5e2f7da07cd9fc428461d1dc3a291f0ee6c8a9b","sourceUrl":"https://github.com/smresponsibilities/Xeno2/blob/main/README.md","checkedAt":"2026-10-15T11:20:40.493Z"},"overviewRepoUpdated":"2026-10-15T10:26:41Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/smresponsibilities/Xeno2/blob/main/README.md","checkedAt":"2026-10-15T11:20:40.493Z","hash":"0dbcae1ff13fc543f44f9d23c5e2f7da07cd9fc428461d1dc3a291f0ee6c8a9b","originalBytes":9972,"storedBytes":9972,"truncated":false,"searchTerms":["supabase","customer","next.js","shopify","analytics","data","ltv","order","recharts","dashboard","react","server","sql","value","architecture","customers","key","overview","postgresql","ssr","supabase-setup.sql","webhook","analytical","aov","app","average","cohorts","database","e-commerce","features"