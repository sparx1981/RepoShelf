{"repositoryId":1227251615,"availability":"available","full":"roboflow/supervision-js","name":"supervision-js","description":"Explore this public GitHub project.","category":"Other","language":"TypeScript","stars":13,"forks":6,"created":"2026-05-02T12:26:06Z","updated":"2026-10-19T20:49:42Z","license":"MIT","branch":"main","homepage":null,"topics":[],"demo":"https://supervision-js-demo.onrender.com/demo/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-19T22:20:26.144Z","lastAttemptAt":"2026-10-19T22:20:26.144Z","lastAvailableAt":"2026-10-19T22:20:26.144Z","metrics":[{"at":"2026-10-19T22:20:26.144Z","stars":13,"forks":6}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Browser-native tools for building interactive computer vision applications.","supervision-js is the TypeScript-first, browser-focused subset of Roboflow Supervision. It provides renderer-owned media sessions, detection rendering, styling, interaction, and editing for images, video, and browser media streams.","It does not aim for one-to-one API parity with Python Supervision. Python Supervision remains the broad toolkit for computer vision workflows; this package focuses on the browser runtime needed to build rich CV media UIs."],"features":["media viewers where playback and annotations share one timing source;","interactive boxes, masks, polygons, polylines, keypoints, and labels;","model demos, review tooling, and browser-native CV applications;","streaming or static detection overlays with app-owned data and persistence."],"sourceUrl":"https://github.com/roboflow/supervision-js/blob/main/README.md","fingerprint":"c08eca72391a7573ac78aa6a2774ed9d0efacef5d4bbdacd1a5cffaa0c0198ef","extractedAt":"2026-10-19T22:20:26.214Z"},"overviewCheckedAt":"2026-10-19T22:20:26.214Z","projectInsights":{"version":1,"whatItDoes":{"text":"Browser-native tools for building interactive computer vision applications.","sourceUrl":"https://github.com/roboflow/supervision-js/blob/main/READM