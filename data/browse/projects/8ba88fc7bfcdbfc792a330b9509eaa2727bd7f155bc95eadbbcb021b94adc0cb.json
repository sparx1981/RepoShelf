rix, joined dates, and the departing/new-hire timing) is clearly marked as…"],"features":[],"sourceUrl":"https://github.com/build-with-dhiraj/labos-prototype/blob/main/README.md","fingerprint":"f0ff8037ee1c46346afd42ce6339c4b5ca7372589e379a8f6f4f0291c0f3b1a6","extractedAt":"2026-10-08T18:23:23.355Z"},"overviewCheckedAt":"2026-10-08T18:23:23.355Z","projectInsights":{"version":1,"whatItDoes":{"text":"The AI-native system of record for how a lab actually works.","sourceUrl":"https://github.com/build-with-dhiraj/labos-prototype/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"f0ff8037ee1c46346afd42ce6339c4b5ca7372589e379a8f6f4f0291c0f3b1a6","sourceUrl":"https://github.com/build-with-dhiraj/labos-prototype/blob/main/README.md","checkedAt":"2026-10-08T18:23:23.355Z"},"overviewRepoUpdated":"2026-08-02T10:22:23Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/build-with-dhiraj/labos-prototype/blob/main/README.md","checkedAt":"2026-10-08T18:23:23.356Z","hash":"f0ff8037ee1c46346afd42ce6339c4b5ca7372589e379a8f6f4f0291c0f3b1a6","originalBytes":6730,"storedBytes":6730,"truncated":false},"lastDemoCheckedAt":"2026-10-08T18:23:23.207Z","subjects":["Templates & UI components"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Templates & UI components"],"evidence":[{"subject":"Templates & UI components","source":"metadata","match":"design system"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Data & dashboards","Self-hosted apps"],"reviewRequired":true},"demoHealth":{"url":"https://labos-prototype.vercel.app/","attemptedAt":"2026-10-15T19:49:31.650Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T19:49:31.650Z","lastWorkingAt":"2026-10-15T19:49:31.650Z","target":"https://labos-prototype.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T19:49:31.650Z"},"prev