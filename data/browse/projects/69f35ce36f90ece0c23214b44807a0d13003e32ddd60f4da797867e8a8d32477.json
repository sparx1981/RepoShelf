{"repositoryId":1275263639,"availability":"available","full":"creationsofm7/localtv-remote","name":"localtv-remote","description":"Control your Windows PC from your phone - free, open-source wireless mouse, keyboard & volume remote over Wi-Fi. No app to install on the phone.","category":"Developer tools","language":"JavaScript","stars":6,"forks":1,"created":"2026-06-20T13:16:15Z","updated":"2026-10-02T21:34:11Z","license":null,"branch":"main","homepage":"https://creationsofm7.github.io/localtv-remote/","topics":["koffi","lan","nodejs","open-source","pc-remote","phone-remote","pwa","qr-code","remote-control","remote-keyboard","remote-mouse","self-hosted","trackpad","typescript","unified-remote","volume-control","websocket","windows","wireless-keyboard","wireless-mouse"],"demo":"https://creationsofm7.github.io/localtv-remote/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-12T23:47:56.786Z","lastAttemptAt":"2026-10-12T23:47:56.786Z","lastAvailableAt":"2026-10-12T23:47:56.786Z","lastDemoCheckedAt":"2026-10-12T23:47:56.786Z","discoveredVia":[],"metrics":[{"at":"2026-10-12T23:47:56.786Z","stars":6,"forks":1}],"technologies":["Node.js"],"overview":{"kind":"readme","version":1,"paragraphs":["LocalTV Remote is a free, open-source app that turns your phone into a wireless mouse, keyboard, and volume remote for any Windows 10/11 PC or laptop — over your local Wi-Fi.","You only install it on the PC. Your phone just opens a web page (a PWA in the browser), so there's nothing to install on the phone — or on any other device you use to control the PC. No app store, no second download.","Multiple people can control one PC at the same time — everyone uses their own phone as their own remote, so there's no single remote to pass around the room. It's LAN-only: no cloud relay, no accounts, and your data never leaves your network. The PC runs a single Node process at 25–40 MB RAM with no bundled Chromium."],"features":[],"sourceUrl":"https://github.com/creationsofm7/localtv-remote/blob/main/README.md","fingerprint":"9543b1d51c730e1cc8303bb9c1d201c6e04975d1505e8ab3df2d94a669b33227","extractedAt":"2026-10-12T23:47:56.786Z"},"overviewCheckedAt":"2026-10-12T23:47:56.786Z","projectInsights":{"version":1,"whatItDoes":{"text":"LocalTV Remote is a free, open-source app that turns your phone into a wireless mouse, keyboard, and volume remote for any Windows 10/11 PC or laptop — over your local Wi-Fi.","sourceUrl":"https://github.com/creationsofm7/localtv-remote/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"It's LAN-only: no cloud relay, no accounts, and your data never leaves your network.","sourceUrl":"https://github.com/creationsofm7/localtv-remote/blob/main/README.md"},{"kind":"account","status":"optional","text":"Optionally create a desktop shortcut and enable start-on-login","sourceUrl":"https://github.com/creationsofm7/localtv-remote/blob/main/README.md"}],"fingerprint":"9543b1d51c730e1cc8303bb9c1d201c6e04975d1505e8ab3df2d94a669b33227","sourceUrl":"https://github.com/creationsofm7/localtv-remote/blob/main/README.md","checkedAt":"2026-10-12T23:47:56.786Z"},"overviewRepoUpdated":"2026-10-02T21:34:11Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/creationsofm7/localtv-remote/blob/main/README.md","checkedAt":"2026-10-12T23:47:56.786Z","hash":"9543b1d51c730e1cc8303bb9c1d201c6e04975d1505e8ab3df2d94a669b33227","originalBytes":12550,"storedBytes":12550,"truncated":false},"subjects":["Browser extensions & PWAs","Self-hosted apps"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Browser extensions & PWAs","Self-hosted apps"],"evidence":[{"subject":"Browser extensions & PWAs","source":"metadata","match":"pwa"},{"subject":"Self-hosted apps","source":"metadata","match":"self hosted"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Games & game developm