 on strong multi-market steam.…"],"features":[],"sourceUrl":"https://github.com/DanielTomaro13/RacingBoard/blob/main/README.md","fingerprint":"de493480cdfd7d10620938d97479c2d0afe199b2b7deb279f43ce3212e97aa44","extractedAt":"2026-10-06T06:44:24.486Z"},"overviewCheckedAt":"2026-10-06T06:44:24.486Z","projectInsights":{"version":1,"whatItDoes":{"text":"Status, September 2026: GitHub Actions are currently paused on this repo, so automated data refreshes and deploys are not running. The data and any live site reflect the last build.","sourceUrl":"https://github.com/DanielTomaro13/RacingBoard/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"not_required","text":"No API keys needed — TAB runs off its public feed, Betfair off public read-only endpoints. (No TAB secrets are used.)","sourceUrl":"https://github.com/DanielTomaro13/RacingBoard/blob/main/README.md"}],"fingerprint":"de493480cdfd7d10620938d97479c2d0afe199b2b7deb279f43ce3212e97aa44","sourceUrl":"https://github.com/DanielTomaro13/RacingBoard/blob/main/README.md","checkedAt":"2026-10-06T06:44:24.486Z"},"overviewRepoUpdated":"2026-09-21T22:02:11Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/DanielTomaro13/RacingBoard/blob/main/README.md","checkedAt":"2026-10-06T06:44:24.486Z","hash":"de493480cdfd7d10620938d97479c2d0afe199b2b7deb279f43ce3212e97aa44","originalBytes":3210,"storedBytes":3210,"truncated":false,"searchTerms":["live","betfair","public","racingboard","tab","data","demo","page","price","python","shortening","value","backend","bash","best","docker","git","local","money","src","tote","venv","across","api","book","build","dabble","de-vigged","deploy","docs","fair","github","how","make","mcp","off","only","pages","per","per-race","pick","push","repo","run","run.py","runners","runs","scripts","sportsbet","sportsdata","tunnel","url","actions","activate","active","add","agree","alert","any","anywhere","apibase","aren","assets","auth","automated","availab