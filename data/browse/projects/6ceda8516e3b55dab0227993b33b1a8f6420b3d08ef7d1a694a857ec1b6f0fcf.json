{"repositoryId":1273972989,"availability":"available","full":"prisharai/Interdict","name":"Interdict","description":"Explore this public GitHub project.","category":"Developer tools","language":"Python","stars":9,"forks":1,"created":"2026-06-19T04:08:54Z","updated":"2026-08-12T02:24:06Z","license":"MIT","branch":"main","homepage":"https://interdict.vercel.app","topics":["ai-agents","database-management","infrastructure","postgresql"],"demo":"https://interdict.vercel.app/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-20T05:27:52.651Z","lastAttemptAt":"2026-10-20T05:27:52.651Z","lastAvailableAt":"2026-10-20T05:27:52.651Z","metrics":[{"at":"2026-10-20T05:27:52.651Z","stars":9,"forks":1}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Interdict is an alpha developer preview and under active development.","Interdict is the safety layer between AI agents and Postgres. Agents can now issue real SQL against real databases; ordinary permissions answer \"may this role touch this table?\", but not \"how much will this statement change?\" or \"can I undo it if the agent is wrong?\" Interdict answers those questions before damage is done.","It parses SQL into a Postgres AST, applies deterministic policy, measures every write without executing it, holds high-impact changes for operator approval, and records supported writes so a human can approve reverting them. Blocks return structured explanations and repair hints so the agent can correct itself and retry."],"features":[],"sourceUrl":"https://github.com/prisharai/Interdict/blob/main/README.md","fingerprint":"c82a779c939fb2562aaaed722c9276458b89a6639c47f77abddef6226ce3a470","extractedAt":"2026-10-20T05:27:52.773Z"},"overviewCheckedAt":"2026-10-20T05:27:52.773Z","projectInsights":{"version":1,"whatItDoes":{"text":"Interdict is an alpha developer preview and under active development.","sourceUrl":"https://github.com/prisharai/Interdict/blob/main/README.md"},"audience":[],"requirement