{"availability":"available","full":"prisms-center/phaseField","name":"phaseField","description":"PRISMS-PF: An Open-Source Phase-Field Modeling Framework","category":"Developer tools","language":"C++","stars":348,"forks":146,"created":"2014-08-04T11:53:24Z","updated":"2026-10-10T20:41:29Z","license":null,"branch":"master","homepage":"https://prisms-center.github.io/phaseField/","topics":["c-plus-plus","finite-elements","partial-differential-equations","pde","pde-solver","phase-field"],"demo":"https://prisms-center.github.io/phaseField/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-12T06:26:30.823Z","lastAttemptAt":"2026-10-12T06:26:30.823Z","lastAvailableAt":"2026-10-12T06:26:30.823Z","metrics":[{"at":"2026-10-09T03:36:50.344Z","stars":348,"forks":146},{"at":"2026-10-12T06:26:30.823Z","stars":348,"forks":146}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Website \\ Code \\ Manual \\ Discussions \\ Training slides \\ PFHub phase-field community \\ DOI","PRISMS-PF is a powerful, massively parallel finite element code for conducting phase field and other related simulations of microstructural evolution. The phase field method is commonly used for predicting the evolution in microstructures under a wide range of conditions and material systems. PRISMS-PF provides a simple interface for solving customizable systems of partial differential equations of the type commonly found in phase field models, and has pre-built application modules, including precipitate evolution, grain growth, and solidification.","With PRISMS-PF, you have access to adaptive meshing and parallelization with near-ideal scaling for over a thousand processors. Moreover, the matrix-free framework from the deal.II library allows much larger than simulations than typical finite element programs – PRISMS-PF has been used for simulations with over one billion degrees of freedom. PRISMS-PF also provides performance competitive with, and often exceeding single-purpose codes."],"features":[],"sourceUrl":"https://github.com/prisms-center/phaseField/blob/master/README.md","fingerprint":"d07341c1706061128cc92826b89ef7c038fb9cb550ba4dcea16ca870d0678995","extractedAt":"2026-10-09T03:36:50.492Z"},"overviewCheckedAt":"2026-10-09T03:36:50.492Z","projectInsights":{"version":1,"whatItDoes":{"text":"Website \\ Code \\ Manual \\ Discussions \\ Training slides \\ PFHub phase-field community \\ DOI","sourceUrl":"https://github.com/prisms-center/phaseField/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"d07341c1706061128cc92826b89ef7c038fb9cb550ba4dcea16ca870d0678995","sourceUrl":"https://github.com/prisms-center/phaseField/blob/master/README.md","checkedAt":"2026-10-09T03:36:50.492Z"},"overviewRepoUpdated":"2026-10-09T03:12:36Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/prisms-center/phaseField/blob/master/README.md","checkedAt":"2026-10-09T03:36:50.493Z","hash":"d07341c1706061128cc92826b89ef7c038fb9cb550ba4dcea16ca870d0678995","originalBytes":5814,"storedBytes":5814,"truncated":false},"lastDemoCheckedAt":"2026-10-09T03:36:50.344Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Science"],"reviewRequired":true},"demoHealth":{"url":"https://prisms-center.github.io/phaseField/","attemptedAt":"2026-10-12T06:46:09.818Z","probeVersion":3,"status":"working","checkedAt":"2026-10-12T06:46:09.818Z","lastWorkingAt":"2026-10-12T06:46:09.818Z","target":"https://prisms-center.github.io/phaseField/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-19T06:46:09.818Z"},"previewAttemptAt":"2026-10-12T06:46:09.818Z","previewCheck":{"url":"https://prisms-center.github.io/phaseField/","attemptedAt":"2026-10-12T06:46:09.818Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt"