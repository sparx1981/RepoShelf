lect our SA-V dataset, the largest video segmentation dataset to date. SAM 2 trained on our data provides strong performance across a wide range of tasks and visual domains."],"features":[],"sourceUrl":"https://github.com/facebookresearch/segment-anything/blob/main/README.md","fingerprint":"cab2c4900910c9e4afd64833f57d106b8fc1a27fca963d4439ae5b8f94cdbce1","extractedAt":"2026-10-03T06:01:31.825Z"},"overviewCheckedAt":"2026-10-10T09:09:44.485Z","overviewRepoUpdated":"2024-09-18T17:46:55Z","demoHealth":{"url":"https://segment-anything.com/demo","attemptedAt":"2026-10-06T16:39:50.882Z","status":"unknown","error":{"reason":"dns_not_found","at":"2026-10-06T16:39:50.882Z"},"nextCheckAt":"2026-11-05T16:39:50.882Z","consecutiveTemporaryFailures":6,"probeVersion":3},"projectInsights":{"version":1,"whatItDoes":{"text":"Please check out our new release on Segment Anything Model 2 (SAM 2).","sourceUrl":"https://github.com/facebookresearch/segment-anything/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"cab2c4900910c9e4afd64833f57d106b8fc1a27fca963d4439ae5b8f94cdbce1","sourceUrl":"https://github.com/facebookresearch/segment-anything/blob/main/README.md","checkedAt":"2026-10-10T09:09:44.485Z"},"agentContextAttemptAt":"2026-10-03T10:41:40.018Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/facebookresearch/segment-anything/blob/main/README.md","checkedAt":"2026-10-10T09:09:44.486Z","hash":"cab2c4900910c9e4afd64833f57d106b8fc1a27fca963d4439ae5b8f94cdbce1","originalBytes":9621,"storedBytes":9621,"truncated":false},"agentContext":{"version":1,"checkedAt":"2026-10-03T10:41:42.210Z","documents":[{"name":"LICENSE","sourceUrl":"https://github.com/facebookresearch/segment-anything/blob/main/LICENSE","hash":"c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4","originalBytes":11357,"truncated":false}]},"agentContextRepoUpdated":"2024-09-18T17:46:55Z","qualityPriority":false,"previewCheck":{"url":"https://segment-anything.com