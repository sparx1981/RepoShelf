{"full":"TBSten/compose-preview-lab","name":"compose-preview-lab","description":"Elevate your debugging — with smarter, interactive Preview. Catalog Library that adds interactivity to previews.","category":"Other","language":"Kotlin","stars":6,"forks":1,"created":"2025-04-25T16:27:46Z","updated":"2026-05-24T21:23:33Z","license":"Apache-2.0","branch":"main","homepage":"","topics":["android","compose"],"demo":"https://help.figma.com/hc/en-us/articles/15023124644247-Guide-to-Dev-Mode#try-component-variations-in-the-component-playground","color":"#302e55","ink":"#dbd2ff","availability":"available","lastCheckedAt":"2026-10-03T21:17:56.465Z","lastAttemptAt":"2026-10-03T21:17:56.465Z","lastAvailableAt":"2026-10-03T21:17:56.465Z","lastDemoCheckedAt":"2026-10-03T08:24:57.373Z","metrics":[{"at":"2026-10-03T21:17:56.465Z","stars":6,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["English | 日本語 | Sample | Documentation | DeepWiki","This project is still a work in progress, and its API is unstable and may change without any notice. Using this plugin for a hobby project is fine, but we do not recommend using it for production projects yet.","Compose Preview Lab turns @Preview into an interactive Component Playground. You can pass parameters to components, enabling more than just static snapshots—making manual testing easier and helping new developers understand components faster. Compose Multiplatform is supported."],"features":[],"sourceUrl":"https://github.com/TBSten/compose-preview-lab/blob/main/README.md","fingerprint":"463e4c47afb6c204d3616ac0e1fc40c12ba042d57d98ed67ff583b0549951725","extractedAt":"2026-10-03T08:24:57.372Z"},"overviewCheckedAt":"2026-10-03T21:20:17.263Z","projectInsights":{"version":1,"whatItDoes":{"text":"English | 日本語 | Sample | Documentation | DeepWiki","sourceUrl":"https://github.com/TBSten/compose-preview-lab/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"463e4c47afb6c204d3616ac0e1fc40c12ba042d57