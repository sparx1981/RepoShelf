{"availability":"available","full":"rnaga/wp-next","name":"wp-next","description":"TypeScript/React page editor and admin dashboard for WordPress — no PHP, drag-and-drop canvas, dynamic data binding, and AI-native template authoring via Agent Skills.","category":"Design","language":"TypeScript","stars":14,"forks":3,"created":"2024-07-10T02:09:55Z","updated":"2026-07-26T20:17:33Z","license":"MIT","branch":"main","homepage":"https://rnaga.github.io/wp-next/","topics":["admin-panel","cms","full-stack","headless-ui","material-ui","nextjs","react","typescript","web-builder","web-development","wordpress","wp-node"],"demo":"https://rnaga.github.io/wp-next/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-16T23:45:30.533Z","lastAttemptAt":"2026-10-16T23:45:30.533Z","lastAvailableAt":"2026-10-16T23:45:30.533Z","metrics":[{"at":"2026-10-11T00:26:00.689Z","stars":14,"forks":3},{"at":"2026-10-16T23:45:30.533Z","stars":14,"forks":3}],"technologies":["React","Next.js"],"overview":{"kind":"readme","version":1,"paragraphs":["For guides, concepts, and examples, the documentation site is the best starting point.","WP-Next is a TypeScript-first toolkit for building WordPress-powered Next.js applications — with a visual drag-and-drop editor, a modern React admin dashboard, and first-class AI support built in from day one."],"features":["Drag-and-drop canvas — build pages visually with a live preview. Select, resize, nest, and animate elements directly on the canvas.","Responsive design — set per-device breakpoints (desktop, tablet, mobile) and CSS states (hover, focus, etc.). Each device gets its own @media query at render time.","Dynamic data binding — pull posts, users, taxonomies, and options directly from the WordPress database into any element. No custom API endpoints required.","Widget system — embed sub-templates (widgets) inside other templates for reusable headers, footers, and components. Widget variants let the same widget render different content per embedding.","CSS variables — define design tokens at the template level and reference them across all elements for consistent theming."],"sourceUrl":"https://github.com/rnaga/wp-next/blob/main/README.md","fingerprint":"0f1064e925829d80ebfb2f5d01833756d31fcd28f7ab1afe3a3766259aedb0c8","extractedAt":"2026-10-11T00:26:00.770Z"},"overviewCheckedAt":"2026-10-11T00:26:00.770Z","projectInsights":{"version":1,"whatItDoes":{"text":"For guides, concepts, and examples, the documentation site is the best starting point.","sourceUrl":"https://github.com/rnaga/wp-next/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"0f1064e925829d80ebfb2f5d01833756d31fcd28f7ab1afe3a3766259aedb0c8","sourceUrl":"https://github.com/rnaga/wp-next/blob/main/README.md","checkedAt":"2026-10-11T00:26:00.770Z"},"overviewRepoUpdated":"2026-07-26T20:17:33Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/rnaga/wp-next/blob/main/README.md","checkedAt":"2026-10-11T00:26:00.771Z","hash":"0f1064e925829d80ebfb2f5d01833756d31fcd28f7ab1afe3a3766259aedb0c8","originalBytes":7037,"storedBytes":7037,"truncated":false},"lastDemoCheckedAt":"2026-10-11T00:26:00.689Z","subjects":["MCP servers & agents","Templates & UI components","Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["MCP servers & agents","Templates & UI components","Data & dashboards"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"Agent"},{"subject":"Templates & UI components","source":"metadata","match":"admin dashboard"},{"subject":"Data & dashboards","source":"metadata","match":"dashboard"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Mobile"],"reviewRequired":true},"demoHealth":{"url":"https://rnaga.github.io/wp-next/","attemptedAt":"2026-10-18T01:11:44.653Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T01:11:44.653Z","lastWorkingAt":"2026-10-18T01: