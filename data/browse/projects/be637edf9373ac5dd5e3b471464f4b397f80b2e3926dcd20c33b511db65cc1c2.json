{"availability":"available","full":"brittytino/podlink","name":"podlink","description":"PodLink: small accountability pods with real-time chat, streaks, crisis tools, and AI-assisted moderation/matching","category":"Design","language":"TypeScript","stars":6,"forks":2,"created":"2025-10-30T08:10:37Z","updated":"2026-01-17T04:32:17Z","license":"MIT","branch":"main","homepage":"https://podlink-chi.vercel.app","topics":["accountability","mental-health","nextauth","nextjs","postgresql","socket-io","tailwindcss","typescript","webapp"],"demo":"https://podlink-chi.vercel.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-11T13:40:24.995Z","lastAttemptAt":"2026-10-11T13:40:24.995Z","lastAvailableAt":"2026-10-11T13:40:24.995Z","metrics":[{"at":"2026-10-11T13:40:24.995Z","stars":6,"forks":2}],"technologies":["Next.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Connect. Support. Grow together. Small accountability pods with real-time chat, streaks, crisis tools, and AI guidance.","PodLink connects people in small pods (4-6 members) to pursue personal growth goals with structured check-ins, real-time collaboration, and supportive interventions. AI is used for pod matching, safety checks, and supportive messaging while keeping user identity private."],"features":["Authentication & Identity: Email/password (bcrypt), Google OAuth, NextAuth.js JWT sessions, email verification, protected routes, rate limits, reCAPTCHA v2.","Pods & Matching: AI-powered matching on goal type, category, timezone, and availability; AI-generated pod names; demo pods auto-filled by bots.","Chat & Real-Time: Socket.IO messaging with presence, typing indicators, read receipts, reactions, image uploads (Cloudinary), connection status, separators, auto-scroll.","Streaks & Gamification: Daily check-ins, longest/current streaks, restoration (1 per 30 days), calendars, pod/global leaderboards, badges.","Crisis Toolkit: One-click alerts to pods, AI companion responses, coping strategies, hotline directory, alert resolution tracking."],"sourceUrl":"https://github.com/brittytino/podlink/blob/main/README.md","fingerprint":"43b1bd5a01c5a60097b1c7ab87422d7a2d4390dc981b443a11edb54f370763df","extractedAt":"2026-10-11T13:40:25.129Z"},"overviewCheckedAt":"2026-10-11T13:40:25.129Z","projectInsights":{"version":1,"whatItDoes":{"text":"Connect. Support. Grow together. Small accountability pods with real-time chat, streaks, crisis tools, and AI guidance.","sourceUrl":"https://github.com/brittytino/podlink/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"optional","text":"Optional: Google OAuth credentials, Gemini API key (fallback), reCAPTCHA v2 keys","sourceUrl":"https://github.com/brittytino/podlink/blob/main/README.md"}],"fingerprint":"43b1bd5a01c5a60097b1c7ab87422d7a2d4390dc981b443a11edb54f370763df","sourceUrl":"https://github.com/brittytino/podlink/blob/main/README.md","checkedAt":"2026-10-11T13:40:25.129Z"},"overviewRepoUpdated":"2026-01-17T04:32:17Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/brittytino/podlink/blob/main/README.md","checkedAt":"2026-10-11T13:40:25.130Z","hash":"43b1bd5a01c5a60097b1c7ab87422d7a2d4390dc981b443a11edb54f370763df","originalBytes":7231,"storedBytes":7231,"truncated":false,"searchTerms":["npm","run","prisma","next.js","api","cloudinary","key","url","mobile","seed","database","deployment","openrouter","optional","pod","podlink","pods","recaptcha","socket.io","app","auth","bash","build","client","gemini","google","license","migrations","open","production","project","public","push","real-time","scripts","secret","server","vercel","architecture","chat","components","contributing","cron","demo","direct","email","env","environment","features","matching","names","overview","postgresql","routes","schema","security","see","start","streaks","studio","supportive","typescript","variables","abuse","accountability","android","assets","attribution","before","capacitor","check-