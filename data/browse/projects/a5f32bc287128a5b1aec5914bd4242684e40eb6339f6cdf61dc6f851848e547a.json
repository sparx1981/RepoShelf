{"availability":"available","full":"KruxAI/ragbuilder","name":"ragbuilder","description":"A toolkit to create optimal Production-readyRetrieval Augmented Generation(RAG) setup for your data","category":"Developer tools","language":"Python","stars":1539,"forks":127,"created":"2024-06-24T07:25:00Z","updated":"2026-10-02T02:28:43Z","license":"Apache-2.0","branch":"main","homepage":"https://ragbuilder.pages.dev","topics":["developer-tools","genai","rag"],"demo":"https://ragbuilder.pages.dev/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-12T04:06:33.315Z","lastAttemptAt":"2026-10-12T04:06:33.315Z","lastAvailableAt":"2026-10-12T04:06:33.315Z","metrics":[{"at":"2026-10-09T03:36:32.702Z","stars":1539,"forks":127},{"at":"2026-10-12T04:06:33.315Z","stars":1539,"forks":127}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Maintenance status: RAGBuilder is no longer actively maintained. This repository is kept for reference. Ongoing updates and support are not planned.","RagBuilder is a toolkit that helps you create optimal Production-ready Retrieval-Augmented-Generation (RAG) setup for your data automatically. By performing hyperparameter tuning on various RAG parameters (Eg: chunking strategy: semantic, character etc., chunk size: 1000, 2000 etc.), RagBuilder evaluates these configurations against a test dataset to identify the best-performing setup for your data. Additionally, RagBuilder includes several state-of-the-art, pre-defined RAG templates that have shown strong performance across diverse datasets. So just bring your data, and RagBuilder will…"],"features":["Hyperparameter Tuning: Efficiently optimize your RAG configurations using Bayesian optimization","Pre-defined RAG Templates: Use state-of-the-art templates that have demonstrated strong performance Eg: Graph retriever, Contextual chunker etc.)","Evaluation Dataset Options: Generate synthetic test dataset or provide your own","Component Access: Direct access to vectorstore, retriever, and generator components","API Deployment: Easily deploy as an API service"],"sourceUrl":"https://github.com/KruxAI/ragbuilder/blob/main/README.md","fingerprint":"b90899f9173be0dd9a3d8ea90bdc933bd39310239d7442a8730d6cb94b1a4f71","extractedAt":"2026-10-09T03:36:32.869Z"},"overviewCheckedAt":"2026-10-09T03:36:32.869Z","projectInsights":{"version":1,"whatItDoes":{"text":"Maintenance status: RAGBuilder is no longer actively maintained. This repository is kept for reference. Ongoing updates and support are not planned.","sourceUrl":"https://github.com/KruxAI/ragbuilder/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"b90899f9173be0dd9a3d8ea90bdc933bd39310239d7442a8730d6cb94b1a4f71","sourceUrl":"https://github.com/KruxAI/ragbuilder/blob/main/README.md","checkedAt":"2026-10-09T03:36:32.869Z"},"overviewRepoUpdated":"2026-10-02T02:28:43Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/KruxAI/ragbuilder/blob/main/README.md","checkedAt":"2026-10-16T00:59:17.037Z","hash":"b90899f9173be0dd9a3d8ea90bdc933bd39310239d7442a8730d6cb94b1a4f71","originalBytes":11775,"storedBytes":11775,"truncated":false},"lastDemoCheckedAt":"2026-10-09T03:36:32.702Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["MCP servers & agents","Templates & UI components"],"reviewRequired":true},"demoHealth":{"url":"https://ragbuilder.pages.dev/","attemptedAt":"2026-10-16T05:23:11.553Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T05:23:11.553Z","lastWorkingAt":"2026-10-16T05:23:11.553Z","target":"https://ragbuilder.pages.dev/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-23T05:23:11.553Z"},"previewAttemptAt":"2026-10-16T05:23:11.553Z","previewCheck":{"url":"https://ragbuilder.pages.dev/","attemptedAt":"2026-10-16