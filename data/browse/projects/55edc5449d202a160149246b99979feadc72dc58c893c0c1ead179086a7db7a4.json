{"availability":"available","full":"creativetimofficial/paper-dashboard","name":"paper-dashboard","description":"Paper Dashboard is a Bootstrap Admin Panel which combines soft colors with beautiful typography and spacious cards and graphics.","category":"Design","language":"CSS","stars":368,"forks":474,"created":"2016-05-23T11:29:08Z","updated":"2024-09-17T07:23:57Z","license":"MIT","branch":"master","homepage":null,"topics":[],"demo":"https://demos.creative-tim.com/paper-dashboard/examples/dashboard.html","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-15T18:03:32.419Z","lastAttemptAt":"2026-10-15T18:03:32.419Z","lastAvailableAt":"2026-10-15T18:03:32.419Z","metrics":[{"at":"2026-10-03T14:33:25.568Z","stars":368,"forks":475},{"at":"2026-10-04T16:12:49.719Z","stars":368,"forks":475},{"at":"2026-10-06T17:12:49.423Z","stars":368,"forks":474},{"at":"2026-10-08T22:30:48.142Z","stars":368,"forks":474},{"at":"2026-10-11T14:49:43.944Z","stars":368,"forks":474},{"at":"2026-10-15T18:03:32.419Z","stars":368,"forks":474}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["If you are a developer or a website owner that needs to work within a dashboard and want to have a pretty sight while doing so, Paper Dashboard 2 is for you. Paper Dashboard is a Bootstrap Admin Panel which combines soft colours with beautiful typography and spacious cards and graphics. It is a powerful tool, but it is light and easy to use. It has enough features to allow you to get the job done, but it is not crowded to the point where you can't find the files for a specific plugin.","We like consistency and design that blends into its purpose. Paper Dashboard is a perfect example of our most thoughtful work. It combines over a dozen components and plugins, while looking like everything fits together. For an easy start or inspiration for you project, we have also create a set of example pages, like the user settings or usage graphics.","Paper Dashboard is built using the same design language as Paper Kit. You can easily use them together, or pick between them depending on the project you have."],"features":[],"sourceUrl":"https://github.com/creativetimofficial/paper-dashboard/blob/master/README.md","fingerprint":"d1e0c5b1f5979ea020797d8adbb83852c28d8ea27553eb0723dd7b629b42fb61","extractedAt":"2026-10-03T07:02:03.699Z"},"overviewCheckedAt":"2026-10-15T18:03:32.574Z","projectInsights":{"version":1,"whatItDoes":{"text":"If you are a developer or a website owner that needs to work within a dashboard and want to have a pretty sight while doing so, Paper Dashboard 2 is for you. Paper Dashboard is a Bootstrap Admin Panel which combines soft colours with beautiful typography and spacious cards and graphics. It is a powerful tool, but it is light and easy to use. It has enough features to allow you to get the job done, but it is not crowded to the point where you can't find the files for a specific plugin.","sourceUrl":"https://github.com/creativetimofficial/paper-dashboard/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"d1e0c5b1f5979ea020797d8adbb83852c28d8ea27553eb0723dd7b629b42fb61","sourceUrl":"https://github.com/creativetimofficial/paper-dashboard/blob/master/README.md","checkedAt":"2026-10-15T18:03:32.574Z"},"overviewRepoUpdated":"2024-09-17T07:23:57Z","lastDemoCheckedAt":"2026-10-15T18:03:32.419Z","overviewAttemptAt":"2026-10-11T02:11:44.227Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/creativetimofficial/paper-dashboard/blob/master/README.md","checkedAt":"2026-10-15T18:03:32.575Z","hash":"d1e0c5b1f5979ea020797d8adbb83852c28d8ea27553eb0723dd7b629b42fb61","originalBytes":6163,"storedBytes":6163,"truncated":false},"enrichmentAttemptAt":"2026-10-03T14:17:17.645Z","latestRelease":{"name":"v2.0.1","tag":"v2.0.1","publishedAt":"2020-03-27T18:01:02Z","url":"https://github.com/creativetimofficial/paper-dashboard/releases/tag/v2.0.1"},"releaseCheckedAt":"2026-10-03T14:17:17.645Z","screensh