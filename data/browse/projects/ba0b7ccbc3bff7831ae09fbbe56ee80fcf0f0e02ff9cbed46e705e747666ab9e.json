Terrace/weather/blob/main/README.md"}],"fingerprint":"1ab915d2cae2338bee40eccfec46ee58d4977cd858c9bad81801506c1aa2c1cb","sourceUrl":"https://github.com/CloverTerrace/weather/blob/main/README.md","checkedAt":"2026-10-10T15:05:50.679Z"},"overviewRepoUpdated":"2026-10-10T15:02:12Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/CloverTerrace/weather/blob/main/README.md","checkedAt":"2026-10-10T15:05:50.680Z","hash":"1ab915d2cae2338bee40eccfec46ee58d4977cd858c9bad81801506c1aa2c1cb","originalBytes":24265,"storedBytes":24265,"truncated":false,"searchTerms":["data","fetch","lightning","repo","weather","dashboard","only","weewx","action","camera","api","every","index.html","url","one","station","home","key","own","site","both","script","history.json","push","time-lapse","worker","cloud","ecowitt","github","live","radar","just","pages","run","server","build","cape","card","client-side","feed","minutes","near","nws","runs","see","sensor","separate","set","storm","theme","two","update","weather-data","weather.json","alerts","any","block","commit","endpoint","home-server","overlay","public","reading","scripts","snapshot","today","actions","air","aurora","automatic","auxiliary","back","box","button","center","chart","conditions","current","directly","ever","fetches","fresh","glm","interval","mesoscale","need","never","once","path","refresh","repo.","satellite","since","step","still","systemd","top","trigger","underground","update-weather.yml","vapid","video","workflow","above","above.","active","already","backfill","backup.py","block.","camera.py","change","check","cloudflare","cloverterrace","count","cron","day","deno","driver","each","enough","field","forecast","get","glm.json","history","humidity","independent","local","logic","min","minutes.","needs","new","project","rather","raw","readings","refreshed","river","running","seconds","served","service","should","show","single","snapshots","solar","something","source","stale","standalone","strike"