{"repositoryId":1035860176,"availability":"available","full":"iamsomraj/vue-qs","name":"vue-qs","description":"Type-safe search params state manager for Vue 3 and Nuxt - a port of nuqs","category":"Developer tools","language":"TypeScript","stars":24,"forks":2,"created":"2025-08-11T07:45:53Z","updated":"2026-10-15T04:57:12Z","license":"MIT","branch":"main","homepage":"https://iamsomraj.github.io/vue-qs/","topics":["composables","composition-api","history-api","nuqs","nuxt","nuxt3","query-params","query-string","search-params","serial","serialization","state-management","typescript","url-search-params","url-state","vite","vue","vue-composable","vue-router","vue3"],"demo":"https://stackblitz.com/github/iamsomraj/vue-qs/tree/main/examples/vite-vue-router","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-15T11:21:12.545Z","lastAttemptAt":"2026-10-15T11:21:12.545Z","lastAvailableAt":"2026-10-15T11:21:12.545Z","metrics":[{"at":"2026-10-15T11:21:12.545Z","stars":24,"forks":2}],"technologies":["Vue"],"overview":{"kind":"readme","version":1,"paragraphs":["Type-safe search params state manager for Vue 3. A port of nuqs that uses Vue idioms: writable refs, v-model, reactive objects and a plugin.","Filters, search terms, tabs, pagination and sort orders are state your users expect to share, bookmark and restore with the Back button. Storing that state in the URL makes it all work, but parsing and serializing query strings by hand is tedious and error-prone.","vue-qs gives you URL state that feels like regular Vue state: a ref you can bind with v-model, typed by parsers, and kept in sync with the router. It follows nuqs, the popular React library, so its docs, patterns and ideas apply here too."],"features":["🧩 The nuqs API: the same parsers, options and behaviour, adapted to Vue","🔒 Type-safe: typed state from parsers, with null removed by .withDefault()","✍️ Writable refs: assign .value or use v-model; .set() for options and promises","📦 Batched updates: changes in the same tick produce a single URL update","⏱️ Throttle & debounce: state is instant, URL writes are rate-limited"],"sourceUrl":"https://github.com/iamsomraj/vue-qs/blob/main/README.md","fingerprint":"cda6cd09a98d856adf5641c7c27df0ef89868853080fbade33bfe91dd792c728","extractedAt":"2026-10-15T11:21:12.645Z"},"overviewCheckedAt":"2026-10-15T11:21:12.645Z","projectInsights":{"version":1,"whatItDoes":{"text":"Type-safe search params state manager for Vue 3. A port of nuqs that uses Vue idioms: writable refs, v-model, reactive objects and a plugin.","sourceUrl":"https://github.com/iamsomraj/vue-qs/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"cda6cd09a98d856adf5641c7c27df0ef89868853080fbade33bfe91dd792c728","sourceUrl":"https://github.com/iamsomraj/vue-qs/blob/main/README.md","checkedAt":"2026-10-15T11:21:12.645Z"},"overviewRepoUpdated":"2026-10-15T04:57:12Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/iamsomraj/vue-qs/blob/main/README.md","checkedAt":"2026-10-15T11:21:12.646Z","hash":"cda6cd09a98d856adf5641c7c27df0ef89868853080fbade33bfe91dd792c728","originalBytes":7263,"storedBytes":7263,"truncated":false},"lastDemoCheckedAt":"2026-10-15T11:21:12.545Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://stackblitz.com/github/iamsomraj/vue-qs/tree/main/examples/vite-vue-router","attemptedAt":"2026-10-15T11:33:05.159Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T11:33:05.159Z","lastWorkingAt":"2026-10-15T11:33:05.159Z","target":"https://stackblitz.com/github/iamsomraj/vue-qs/tree/main/examples/vite-vue-router?file=README.md","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T11:33:05.159Z"},"previewAttemptAt":"2026-10-15T11:33:05.159Z","pre