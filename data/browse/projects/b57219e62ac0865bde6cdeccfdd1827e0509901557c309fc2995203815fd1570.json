{"repositoryId":1261689736,"availability":"available","full":"juliannzhu/personal-website","name":"personal-website","description":"Tetris-themed personal website and portfolio. React 19, TypeScript, Vite, and Vercel functions for the contact form and leaderboard.","category":"Design","language":"TypeScript","stars":1,"forks":0,"created":"2026-06-07T03:00:08Z","updated":"2026-10-17T01:59:27Z","branch":"main","homepage":"https://juliannzhu.vercel.app","topics":["personal-website","portfolio","react","tetris","typescript","vercel","vite"],"demo":"https://juliannzhu.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-19T02:48:42.903Z","lastAttemptAt":"2026-10-19T02:48:42.903Z","lastAvailableAt":"2026-10-19T02:48:42.903Z","metrics":[{"at":"2026-10-19T02:48:42.903Z","stars":1,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["My Tetris-themed personal website, including my projects, resume, and a few other side quests.","A few years ago I was obsessed with Tetris, to the point where I would close my eyes and still see pieces falling. Somewhere in those hundreds of hours it started shaping how I think, like staying calm under pressure when things stack up. So when I built this site, I knew I didn't want a generic, flat digital business card. I wanted people to get a sense of my personality, so I designed the whole thing around Tetris and hid references in the layout, the colour palette, the animations, and the interactions.","The hardest part was capturing the feeling that made me love Tetris in the first place. Every version came out slightly off, and I lost hours to small details nobody will ever notice. To me, this project represents more than a portfolio. It's a reflection of my personal journey as someone who loves building, enjoys the process, and won't stop until I create exactly what I was picturing."],"features":[],"sourceUrl":"https://github.com/juliannzhu/personal-website/blob/main/README.md","fingerprint":"68ed85cd04f6dcb4e5b8dd5b4438bf62d5f2a6ebf93b5abdf9598ab216495927","extractedAt":"2026-10-19T02:48:42.998Z"},"overviewCheckedAt":"2026-10-19T02:48:42.998Z","projectInsights":{"version":1,"whatItDoes":{"text":"My Tetris-themed personal website, including my projects, resume, and a few other side quests.","sourceUrl":"https://github.com/juliannzhu/personal-website/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"68ed85cd04f6dcb4e5b8dd5b4438bf62d5f2a6ebf93b5abdf9598ab216495927","sourceUrl":"https://github.com/juliannzhu/personal-website/blob/main/README.md","checkedAt":"2026-10-19T02:48:42.998Z"},"overviewRepoUpdated":"2026-10-17T01:59:27Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/juliannzhu/personal-website/blob/main/README.md","checkedAt":"2026-10-19T02:48:42.998Z","hash":"68ed85cd04f6dcb4e5b8dd5b4438bf62d5f2a6ebf93b5abdf9598ab216495927","originalBytes":3595,"storedBytes":3595,"truncated":false},"lastDemoCheckedAt":"2026-10-19T02:48:42.903Z","subjects":["Games & game development","Portfolios & personal sites"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Games & game development","Portfolios & personal sites"],"evidence":[{"subject":"Games & game development","source":"metadata","match":"Tetris"},{"subject":"Portfolios & personal sites","source":"metadata","match":"personal website"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Self-hosted apps"],"reviewRequired":true},"demoHealth":{"url":"https://juliannzhu.vercel.app/","attemptedAt":"2026-10-19T03:04:20.144Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T03:04:20.144Z","lastWorkingAt":"2026-10-19T03:04:20.144Z","target":"https://juliannzhu.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T03:04:20.144Z"},"previewAttemptAt":"2026-10-19T03:04:20.144Z","previewCheck":{"url":"https://juliannzhu.