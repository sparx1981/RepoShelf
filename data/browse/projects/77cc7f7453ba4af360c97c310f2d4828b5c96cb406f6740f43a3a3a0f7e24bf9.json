{"repositoryId":936290306,"availability":"available","full":"lStanev00/PvP-Scalpel-FrontEnd","name":"PvP-Scalpel-FrontEnd","description":"A high-performance React + Vite single-page application designed for World of Warcraft PvP analytics and guild engagement. The front-end provides a dynamic and immersive interface that integrates directly with the official Blizzard WoW API and a custom Express.js backend.","category":"Design","language":"JavaScript","stars":1,"forks":0,"created":"2025-02-20T20:55:33Z","updated":"2026-10-13T21:33:51Z","license":null,"branch":"main","homepage":"https://www.pvpscalpel.com","topics":["front-end"],"demo":"https://www.pvpscalpel.com/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-16T15:52:49.390Z","lastAttemptAt":"2026-10-16T15:52:49.390Z","lastAvailableAt":"2026-10-16T15:52:49.390Z","metrics":[{"at":"2026-10-16T15:52:49.390Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Fan-made World of Warcraft PvP analytics and community dashboard built with React and Vite.","PvP Scalpel is a frontend application that consumes a custom backend to display PvP rankings, character profiles, and guild data. It also ships a small Express server that renders Handlebars templates for SEO-friendly pages and then hydrates the React app on the client."],"features":["PvP leaderboards for multiple brackets","Character profile lookup with detailed stats","Guild roster and recruitment pages","Community posts and user profiles","SEO-friendly server-rendered meta tags (Handlebars) + client hydration"],"sourceUrl":"https://github.com/lStanev00/PvP-Scalpel-FrontEnd/blob/main/README.md","fingerprint":"87abbb82b3b7ac34474bcace2d56b139975e0f8f585503550322aa6b8853dac9","extractedAt":"2026-10-16T15:52:49.535Z"},"overviewCheckedAt":"2026-10-16T15:52:49.535Z","projectInsights":{"version":1,"whatItDoes":{"text":"Fan-made World of Warcraft PvP analytics and community dashboard built with React and Vite.","sourceUr