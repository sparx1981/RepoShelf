{"availability":"available","full":"datara-lang/sparks","name":"sparks","description":"The official decentralized, capability-native package registry for Datara. Statically served via GitHub Pages with ed25519 signatures and determinism receipts.","category":"Developer tools","language":"JavaScript","stars":0,"forks":0,"created":"2026-09-11T06:39:34Z","updated":"2026-09-23T08:29:18Z","license":"MIT","branch":"main","homepage":"https://datara-lang.github.io/sparks/","topics":["capabilities","datara","deterministic","ed25519","github-pages","package-manager","package-registry","sparks","systems-programming","zero-service"],"demo":"https://datara-lang.github.io/sparks/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-11T07:25:59.299Z","lastAttemptAt":"2026-10-11T07:25:59.299Z","lastAvailableAt":"2026-10-11T07:25:59.299Z","metrics":[{"at":"2026-10-08T20:10:25.120Z","stars":0,"forks":0},{"at":"2026-10-11T07:25:59.299Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["[](schema.json) []( [](#cryptographic-security--ed25519-signatures) [](LICENSE) [](","Sparks is the official decentralized package registry for the Datara programming language. Operating as a zero-service, pure-data sparse registry, Sparks delivers packages over immutable static HTTPS via GitHub Pages without relying on centralized databases or proprietary API servers."],"features":["Compile-Time Capability Sandboxing: Packages declare required system privileges in capabilities.json. dpm audits permissions prior to compilation and the Datara compiler enforces them at compile time.","ed25519 Cryptographic Signatures: Every package archive is digitally signed by its author. dpm verifies signatures and SHA-256 digests automatically on download.","Reproducible Determinism Receipts: Each release documents the exact compiler version, target architecture, and byte-for-byte checksum of its artifacts.","O(1) Sparse Protocol: Only the manifests for requested packages are downloaded—avoiding cloning multi-gigabyte index repositories.","GitHub Pages Native: Hosted on global CDN infrastructure, immutable, and accessible worldwide with zero operational overhead."],"sourceUrl":"https://github.com/datara-lang/sparks/blob/main/README.md","fingerprint":"92c6eaa43aa7e1c82cdaaee59e61c7022a61680f728bc7c8cc8d77f90079b4d5","extractedAt":"2026-10-08T20:10:25.236Z"},"overviewCheckedAt":"2026-10-08T20:10:25.236Z","projectInsights":{"version":1,"whatItDoes":{"text":"[](schema.json) []( [](#cryptographic-security--ed25519-signatures) [](LICENSE) [](","sourceUrl":"https://github.com/datara-lang/sparks/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"92c6eaa43aa7e1c82cdaaee59e61c7022a61680f728bc7c8cc8d77f90079b4d5","sourceUrl":"https://github.com/datara-lang/sparks/blob/main/README.md","checkedAt":"2026-10-08T20:10:25.236Z"},"overviewRepoUpdated":"2026-09-23T08:29:18Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/datara-lang/sparks/blob/main/README.md","checkedAt":"2026-10-08T20:10:25.237Z","hash":"92c6eaa43aa7e1c82cdaaee59e61c7022a61680f728bc7c8cc8d77f90079b4d5","originalBytes":9347,"storedBytes":9347,"truncated":false},"lastDemoCheckedAt":"2026-10-08T20:10:25.120Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://datara-lang.github.io/sparks/","attemptedAt":"2026-10-15T22:04:30.679Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T22:04:30.679Z","lastWorkingAt":"2026-10-15T22:04:30.679Z","target":"https://datara-lang.github.io/sparks/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T22:04:30.679Z"},"previewAttemptAt":"2026-10-15T22:04:30.679Z","previewCheck":{"url":"https://datara-lang.github.io/sparks/","atte