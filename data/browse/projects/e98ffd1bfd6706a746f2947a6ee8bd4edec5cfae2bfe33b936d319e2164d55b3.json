ry view and in full screen.","Markdown: You can write your entries in markdown and see a live preview.","Tags: You can add tags to your entries for better organization."],"sourceUrl":"https://github.com/PhiTux/DailyTxT/blob/main/README.md","fingerprint":"d4e7a7b5c980f49d73f1b58fa7724a0e1dee9b1fa8d05fe6c0b7ec005e56df9e","extractedAt":"2026-10-15T17:03:07.157Z"},"overviewCheckedAt":"2026-10-15T17:03:07.157Z","overviewRepoUpdated":"2026-10-10T15:03:02Z","lastDemoCheckedAt":"2026-10-05T21:33:04.818Z","overviewAttemptAt":"2026-10-15T17:02:59.085Z","projectInsights":{"version":1,"whatItDoes":{"text":"DailyTxT is an encrypted Diary/Journal WebApp with several features. It is written in Svelte and Go and meant to be run by Docker - supports AMD64 and ARM64.","sourceUrl":"https://github.com/PhiTux/DailyTxT/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"d4e7a7b5c980f49d73f1b58fa7724a0e1dee9b1fa8d05fe6c0b7ec005e56df9e","sourceUrl":"https://github.com/PhiTux/DailyTxT/blob/main/README.md","checkedAt":"2026-10-15T17:03:07.158Z"},"readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/PhiTux/DailyTxT/blob/main/README.md","checkedAt":"2026-10-15T17:03:07.159Z","hash":"d4e7a7b5c980f49d73f1b58fa7724a0e1dee9b1fa8d05fe6c0b7ec005e56df9e","originalBytes":15952,"storedBytes":15952,"truncated":false},"enrichmentAttemptAt":"2026-10-03T16:22:59.269Z","latestRelease":null,"releaseCheckedAt":"2026-10-03T16:22:59.269Z","screenshots":[{"src":"previews/af3c66ea5bb01e2d9c0fac83.jpg","kind":"demo","capturedAt":"2026-10-12T06:43:04.834Z","url":"https://dailytxt.phitux.de/"}],"qualityPriority":false,"demoHealth":{"url":"https://dailytxt.phitux.de/","attemptedAt":"2026-10-12T06:43:04.833Z","status":"working","checkedAt":"2026-10-12T06:43:04.833Z","lastWorkingAt":"2026-10-12T06:43:04.833Z","target":"https://dailytxt.phitux.de/login","failureCount":0,"nextCheckAt":"2026-10-19T06:43:04.833Z","consecutiveTemporaryFailures":0,"probeVersion":3},"previewAttemptAt"