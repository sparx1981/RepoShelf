{"repositoryId":590507253,"availability":"available","full":"sgi-demos/sgi-demos","name":"sgi-demos","description":"SGI demos from long ago, running in your browser today.","category":"Developer tools","language":"C","stars":100,"forks":8,"created":"2023-01-18T15:19:43Z","updated":"2026-09-27T18:45:08Z","license":"Apache-2.0","branch":"main","homepage":"https://sgi-demos.github.io/sgi-demos/","topics":["demo","emscripten","emscripten-port","irisgl","irix","javascript","legacy-code","old-code","opengl","opengles","retro","sdl2","sgi","silicon-graphics"],"demo":"https://sgi-demos.github.io/sgi-demos/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-19T09:34:12.607Z","lastAttemptAt":"2026-10-19T09:34:12.607Z","lastAvailableAt":"2026-10-19T09:34:12.607Z","metrics":[{"at":"2026-10-16T20:35:30.915Z","stars":100,"forks":8},{"at":"2026-10-19T09:34:12.607Z","stars":100,"forks":8}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["SGI demos from long ago, running in your browser today.","This is the original SGI demo source code, compiled for the web using Emscripten and SDL2. Rendering is done via an IRIS GL-to-GLES2/3 rasterizer or a reference software rasterizer forked from the Alice 4 project. Event handling is done by SDL2, with events translated into GL's event system.","Each demo is a separate web page, with its own Javascript + WASM compiled by Emscripten from the original C/C++ source. Native Linux, Mac, and Windows builds are also available. Minimal modifications have been made to the original source, only what is necessary to build them 30+ years later for modern hardware and the browser."],"features":[],"sourceUrl":"https://github.com/sgi-demos/sgi-demos/blob/main/README.md","fingerprint":"6b30907274b6c2347038e39a3dfe63c84277bc65dd71ad6152078224a3dd9e89","extractedAt":"2026-10-16T20:35:31.015Z"},"overviewCheckedAt":"2026-10-16T20:35:31.015Z","projectInsights":{"version":1,"whatItDoes":{"text":"SGI demos from long ago, running in y