{"availability":"available","full":"MainakVerse/Renal-Healthcare-Programme","name":"Renal-Healthcare-Programme","description":"Kidney disease is a chronic (long-lasting) health condition that affects how well your kidneys filter waste and excess fluids from your blood. ","category":"Education","language":"Python","stars":14,"forks":0,"created":"2025-02-27T04:23:57Z","updated":"2025-05-13T17:14:01Z","branch":"main","homepage":"https://renal-healthcare-programme.streamlit.app/","topics":["detection","diseases","generative-ai","kidney","machine-learning","streamlit","webapp"],"demo":"https://renal-healthcare-programme.streamlit.app/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-17T19:55:14.231Z","lastAttemptAt":"2026-10-17T19:55:14.231Z","lastAvailableAt":"2026-10-17T19:55:14.231Z","metrics":[{"at":"2026-10-10T09:07:21.474Z","stars":14,"forks":0},{"at":"2026-10-16T02:45:53.913Z","stars":14,"forks":0},{"at":"2026-10-17T19:55:14.231Z","stars":14,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Kidney disease is a chronic (long-lasting) health condition that affects how well your kidneys filter waste and excess fluids from your blood. There isn’t a complete cure yet for kidney disease, but maintaining a healthy lifestyle, eating a balanced diet, staying hydrated, and managing underlying conditions like diabetes and high blood pressure can help slow its progression. This Web app will help you predict whether a person has kidney disease or is at risk of developing it in the future by analyzing several health parameters using the Random Forest Classifier."],"features":[],"sourceUrl":"https://github.com/MainakVerse/Renal-Healthcare-Programme/blob/main/README.md","fingerprint":"a0fb3dbace4d601d090ec8e5063e8f9419073becaaf88514928b8aa0163f366a","extractedAt":"2026-10-10T09:07:21.668Z"},"overviewCheckedAt":"2026-10-17T19:55:14.304Z","projectInsights":{"version":1,"whatItDoes":{"text":"Kidney disease is a chronic (long-lasting) health condition that affects how well your kidneys filter waste and excess fluids from your blood. There isn’t a complete cure yet for kidney disease, but maintaining a healthy lifestyle, eating a balanced diet, staying hydrated, and managing underlying conditions like diabetes and high blood pressure can help slow its progression. This Web app will help you predict whether a person has kidney disease or is at risk of developing it in the future by analyzing several health parameters using the Random Forest Classifier.","sourceUrl":"https://github.com/MainakVerse/Renal-Healthcare-Programme/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"a0fb3dbace4d601d090ec8e5063e8f9419073becaaf88514928b8aa0163f366a","sourceUrl":"https://github.com/MainakVerse/Renal-Healthcare-Programme/blob/main/README.md","checkedAt":"2026-10-17T19:55:14.304Z"},"overviewRepoUpdated":"2025-05-13T17:14:01Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/MainakVerse/Renal-Healthcare-Programme/blob/main/README.md","checkedAt":"2026-10-17T19:55:14.304Z","hash":"a0fb3dbace4d601d090ec8e5063e8f9419073becaaf88514928b8aa0163f366a","originalBytes":881,"storedBytes":881,"truncated":false},"lastDemoCheckedAt":"2026-10-17T19:55:14.231Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Education","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://renal-healthcare-programme.streamlit.app/","attemptedAt":"2026-10-17T11:19:54.194Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T11:19:54.194Z","lastWorkingAt":"2026-10-17T11:19:54.194Z","target":"https://renal-healthcare-programme.streamlit.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T11:19:54.194Z"},"previewAttemptAt":"2026-10-17T11:19:54.194Z","previewCheck":{"url":"https://renal-healt