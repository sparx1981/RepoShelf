{"availability":"available","full":"ramphias/universal-ontology-definition","name":"universal-ontology-definition","description":"🌐 An open, standardized four-layer enterprise ontology framework for knowledge graphs, semantic layers, master data management, and AI Agent knowledge bases.","category":"Developer tools","language":"TypeScript","stars":13,"forks":2,"created":"2026-03-29T12:52:42Z","updated":"2026-09-23T12:41:44Z","license":"Apache-2.0","branch":"master","homepage":"https://ramphias.github.io/universal-ontology-definition/","topics":["agentic-ai","ai-agent","enterprise-architecture","json-schema","knowledge-graph","master-data","ontology","open-standard","owl","rdf","three-layer-architecture"],"demo":"https://ramphias.github.io/universal-ontology-definition/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-16T05:05:58.125Z","lastAttemptAt":"2026-10-16T05:05:58.125Z","lastAvailableAt":"2026-10-16T05:05:58.125Z","metrics":[{"at":"2026-10-10T11:07:05.989Z","stars":12,"forks":2},{"at":"2026-10-16T05:05:58.125Z","stars":13,"forks":2}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["An Open, Standardized Four-Layer Enterprise Ontology Framework","Anti-entropy by design — structured, governed, and built to scale.","Universal Ontology Definition (UOD) is an open, standardized four-layer enterprise ontology framework designed to provide a unified conceptual modeling foundation for enterprise knowledge graphs, semantic layers, master data management, and AI Agent knowledge bases."],"features":["🏗️ Four-Layer Separation — Stable semantic core, pluggable Industry and Domain Extension, free enterprise customization, and multi-platform bindings.","🛡️ Anti-Entropy by Design — 4 abstract domain roots, hard class caps, governance rules, and CI validation prevent ontology sprawl.","📐 Standardized Definition Format — Unified JSON Schema with lifecycle management (status, since, deprecatedsince).","🔗 Inheritance & Extension — L2 extends L1, L3 extends L1+L2, with generalized domain/range relations.","⚙️ Platform Bindings — L0 provides ready-to-use OWL/RDF, JSON-LD, GraphQL, and SQL mappings."],"sourceUrl":"https://github.com/ramphias/universal-ontology-definition/blob/master/README.md","fingerprint":"2d42d4aded028f299d7d38862c9a1952143e46cf87081f53b0c0d8343301b22e","extractedAt":"2026-10-10T11:07:06.075Z"},"overviewCheckedAt":"2026-10-10T11:07:06.075Z","projectInsights":{"version":1,"whatItDoes":{"text":"An Open, Standardized Four-Layer Enterprise Ontology Framework","sourceUrl":"https://github.com/ramphias/universal-ontology-definition/blob/master/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Public Read-Only Access — Anonymous users can browse the full ontology; only the admin panel requires login.","sourceUrl":"https://github.com/ramphias/universal-ontology-definition/blob/master/README.md"}],"fingerprint":"2d42d4aded028f299d7d38862c9a1952143e46cf87081f53b0c0d8343301b22e","sourceUrl":"https://github.com/ramphias/universal-ontology-definition/blob/master/README.md","checkedAt":"2026-10-10T11:07:06.075Z"},"overviewRepoUpdated":"2026-09-23T12:41:44Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/ramphias/universal-ontology-definition/blob/master/README.md","checkedAt":"2026-10-10T11:07:06.076Z","hash":"2d42d4aded028f299d7d38862c9a1952143e46cf87081f53b0c0d8343301b22e","originalBytes":16020,"storedBytes":16020,"truncated":false},"lastDemoCheckedAt":"2026-10-10T11:07:05.989Z","subjects":["MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["MCP servers & agents"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"AI Agent"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Food & cooking","Automation & workflows","Templates & UI components"],"reviewRequired":true},"demoHealth":{