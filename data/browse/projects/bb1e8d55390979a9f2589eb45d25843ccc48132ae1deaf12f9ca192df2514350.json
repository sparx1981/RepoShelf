tom amount, with a personal message.","🧾 Typed config, loud failures — Zod-validated; a typo'd UPI ID fails the build, not your donors."],"sourceUrl":"https://github.com/ShivamS136/buy-me-a-chai/blob/main/README.md","fingerprint":"bc804055562a60164aa0ec19f60703c906443f5b711fd0d44cb1e20bcb3b1b51","extractedAt":"2026-10-06T07:22:15.407Z"},"overviewCheckedAt":"2026-10-16T23:49:52.621Z","projectInsights":{"version":1,"whatItDoes":{"text":"[]( []( [](LICENSE) [](.nvmrc) [](#the-honest-fine-print)","sourceUrl":"https://github.com/ShivamS136/buy-me-a-chai/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"🔓 MIT licensed, fully static — no backend, no database, no accounts.","sourceUrl":"https://github.com/ShivamS136/buy-me-a-chai/blob/main/README.md"}],"fingerprint":"bc804055562a60164aa0ec19f60703c906443f5b711fd0d44cb1e20bcb3b1b51","sourceUrl":"https://github.com/ShivamS136/buy-me-a-chai/blob/main/README.md","checkedAt":"2026-10-16T23:49:52.622Z"},"overviewRepoUpdated":"2026-08-07T08:59:59Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/ShivamS136/buy-me-a-chai/blob/main/README.md","checkedAt":"2026-10-16T23:49:52.622Z","hash":"bc804055562a60164aa0ec19f60703c906443f5b711fd0d44cb1e20bcb3b1b51","originalBytes":6894,"storedBytes":6894,"truncated":false},"lastDemoCheckedAt":"2026-10-16T23:49:52.504Z","subjects":["Self-hosted apps"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Self-hosted apps"],"evidence":[{"subject":"Self-hosted apps","source":"metadata","match":"self hosted"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Mobile","Templates & UI components","Data & dashboards","Privacy & security"],"reviewRequired":true},"demoHealth":{"url":"https://shivams136.github.io/buy-me-a-chai/","attemptedAt":"2026-10-13T20:20:40.920Z","probeVersion":3,"status":"working","checkedAt":"2026-10-13T20: