{"full":"hf:anugrahteesdollar/drugenv","spaceId":"anugrahteesdollar/drugenv","name":"Drug Target Validation Environment","source":"huggingface","description":"An interactive AI application on Hugging Face Spaces.","category":"AI & machine learning","language":null,"topics":["docker","openenv","reinforcement-learning","drug-discovery","pharma","rl-environment","region:us"],"technologies":[],"likes":6,"created":"2026-04-26T08:01:52.000Z","updated":"2026-04-29T05:57:10.000Z","license":null,"runtime":"RUNNING","appUrl":"https://anugrahteesdollar-drugenv.hf.space/","demo":"https://huggingface.co/spaces/anugrahteesdollar/drugenv","availability":"available","lastCheckedAt":"2026-10-16T15:47:37.941Z","lastAttemptAt":"2026-10-16T15:47:37.941Z","lastAvailableAt":"2026-10-16T15:47:37.941Z","color":"#3c3250","ink":"#e4d4ff","symbol":"✦","overview":{"kind":"readme","version":1,"paragraphs":["DrugEnv — an OpenEnv RL environment that teaches LLMs to do computational drug-target validation.","This repository implements an OpenEnv-compatible reinforcement learning environment in which an agent acts as a computational drug discovery scientist. Given a proposed drug target (gene / protein) and a disease context, the agent must investigate target viability by issuing simulated bioinformatics, clinical, and experimental queries, and finally submit a calibrated go / no-go validation report with a confidence score.","The environment is designed as a partially observable Markov decision process (POMDP) with:"],"features":["a hidden ground-truth TargetProfile (expression, druggability, selectivity, toxicity, clinical precedent)","noisy database / assay outputs governed by DataQualityState","a single unified experimental credit budget per episode","visible task metadata, dossier of accumulated findings, and step history","dense step-wise reward plus terminal reward for decision quality and evidence coverage"],"sourceUrl":"https://huggingface.co/spaces/anugrahteesdollar/drugenv/blob/main/README.md","fingerprint":"45b2575357f64ce001a664464e314a3f675f949de73109d45294999e4350595b","extractedAt":"2026-10-08T13:56:09.348Z"},"overviewCheckedAt":"2026-10-16T15:47:37.993Z","projectInsights":{"version":1,"whatItDoes":{"text":"DrugEnv — an OpenEnv RL environment that teaches LLMs to do computational drug-target validation.","sourceUrl":"https://huggingface.co/spaces/anugrahteesdollar/drugenv/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"45b2575357f64ce001a664464e314a3f675f949de73109d45294999e4350595b","sourceUrl":"https://huggingface.co/spaces/anugrahteesdollar/drugenv/blob/main/README.md","checkedAt":"2026-10-16T15:47:37.993Z"},"overviewRepoUpdated":"2026-04-29T05:57:10.000Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://huggingface.co/spaces/anugrahteesdollar/drugenv/blob/main/README.md","checkedAt":"2026-10-16T15:47:37.993Z","hash":"45b2575357f64ce001a664464e314a3f675f949de73109d45294999e4350595b","originalBytes":13056,"storedBytes":13056,"truncated":false},"subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Simulation & physics","Science","Automotive","Image, audio & video AI","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://huggingface.co/spaces/anugrahteesdollar/drugenv","attemptedAt":"2026-10-15T15:23:27.283Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T15:23:27.283Z","lastWorkingAt":"2026-10-15T15:23:27.283Z","target":"https://anugrahteesdollar-drugenv.hf.space/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T15:23:27.283Z"},"previewAttemptAt":"2026-10-15T15:23:27.283Z","previewCheck":{"url":"https://huggingface.co/spaces/anugrahteesdollar/drugenv","attemptedAt":"2026-10-15T15:23:27.283Z","consecutiveFailures":0,"status":"captured","reason":null,"nextChec