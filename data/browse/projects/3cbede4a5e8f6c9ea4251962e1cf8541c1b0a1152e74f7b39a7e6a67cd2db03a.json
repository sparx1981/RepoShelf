{"repositoryId":944639370,"availability":"available","full":"stacksjs/ts-maps","name":"ts-maps","description":"🗺️ Modern & lightweight TypeScript library for creating interactive vector maps.","category":"Developer tools","language":"TypeScript","stars":10,"forks":3,"created":"2025-03-07T17:47:50Z","updated":"2026-10-18T17:19:30Z","license":"MIT","branch":"main","homepage":"https://ts-maps.stacksjs.com","topics":["framework-agnostic","interactive","library","maps","react","typescript","vector","vue"],"demo":"https://ts-maps.stacksjs.com/demos/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T19:19:22.714Z","lastAttemptAt":"2026-10-18T19:19:22.714Z","lastAvailableAt":"2026-10-18T19:19:22.714Z","metrics":[{"at":"2026-10-18T19:19:22.714Z","stars":10,"forks":3}],"technologies":["React","Vue"],"overview":{"kind":"readme","version":1,"paragraphs":["ts-maps is an interactive map library written in TypeScript, with no runtime dependencies. It draws vector tiles styled with the Mapbox GL Style Spec, tilts and rotates the camera, puts the world on a globe, raises terrain and 3D buildings. You build a map the way Leaflet does it: a map, layers you addTo it, markers with popups.","It needs no API key. Every example here draws OpenFreeMap's free vector tiles.","Documentation · Examples · Playground · API reference"],"features":[],"sourceUrl":"https://github.com/stacksjs/ts-maps/blob/main/README.md","fingerprint":"ac0292562b327670c1ff949acd30375cab8da4d1ecf0ad6eec02b88f43f4bb0a","extractedAt":"2026-10-18T19:19:22.838Z"},"overviewCheckedAt":"2026-10-18T19:19:22.838Z","projectInsights":{"version":1,"whatItDoes":{"text":"ts-maps is an interactive map library written in TypeScript, with no runtime dependencies. It draws vector tiles styled with the Mapbox GL Style Spec, tilts and rotates the camera, puts the world on a globe, raises terrain and 3D buildings. You build a map the way Leaflet does it: a map, layers you addTo it, markers with popups.","sourceUrl":"https://g