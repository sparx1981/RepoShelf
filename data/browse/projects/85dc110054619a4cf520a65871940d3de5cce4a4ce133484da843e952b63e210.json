{"repositoryId":1359846656,"availability":"available","full":"chaitmudunuri/cmx","name":"cmx","description":"A light-weight code editor with Vim mode, workspace search, and live preview. No Electron, no bundled browser. macOS, Linux, Windows.","category":"Developer tools","language":"TypeScript","stars":1,"forks":0,"created":"2026-09-07T06:25:57Z","updated":"2026-10-19T06:45:37Z","license":"MIT","branch":"main","homepage":"https://chaitmudunuri.github.io/cmx/","topics":["code-editor","codemirror","cross-platform","developer-tools","lightweight-editor","rust","solidjs","tauri","text-editor","vim"],"demo":"https://chaitmudunuri.github.io/cmx/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-19T07:22:30.921Z","lastAttemptAt":"2026-10-19T07:22:30.921Z","lastAvailableAt":"2026-10-19T07:22:30.921Z","metrics":[{"at":"2026-10-19T07:22:30.921Z","stars":1,"forks":0}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["A native-feeling code editor with Vim mode, workspace search, and live preview.","CMX is a code editor for macOS, Linux and Windows. It gives you the fundamentals you'd actually miss — Vim mode, a file explorer, Quick Open, workspace search and live preview — while staying out of your way: a 7 MB release binary, 95 MB RSS, 2.4 s cold start. CMX renders in the OS webview, so there is no browser runtime to download, patch or ship.","Most editors make you choose: a native-feeling app that is slow and heavy, or a web-based one that is fast but runs in a browser tab. CMX is built to be neither trade-off."],"features":["No browser runtime to own. CMX renders in the OS webview — WebKit on","No external rg install. Workspace search is implemented in Rust on","Language packs load on demand. Opening a Rust file never waits on the","Vim mode is off by default, and meant to be. Turn it on when you want it;","CodeMirror 6 core: multiple cursors, bracket matching/closing, folding,"],"sourceUrl":"https://github.com/chaitmudunuri/cmx/blob/main/README.md","fingerprint":"ea3f6a9a20bac29ec8bb963325e6078d53ec011eeeaa07dc4b0f0b492b39992f","extractedAt":"2026-10-19T07:22:30.986Z"},"overviewCheckedAt":"2026-10-19T07:22:30.986Z","projectInsights":{"version":1,"whatItDoes":{"text":"A native-feeling code editor with Vim mode, workspace search, and live preview.","sourceUrl":"https://github.com/chaitmudunuri/cmx/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"ea3f6a9a20bac29ec8bb963325e6078d53ec011eeeaa07dc4b0f0b492b39992f","sourceUrl":"https://github.com/chaitmudunuri/cmx/blob/main/README.md","checkedAt":"2026-10-19T07:22:30.987Z"},"overviewRepoUpdated":"2026-10-19T06:45:37Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/chaitmudunuri/cmx/blob/main/README.md","checkedAt":"2026-10-19T07:22:30.988Z","hash":"ea3f6a9a20bac29ec8bb963325e6078d53ec011eeeaa07dc4b0f0b492b39992f","originalBytes":15952,"storedBytes":15952,"truncated":false},"lastDemoCheckedAt":"2026-10-19T07:22:30.921Z","subjects":["Apple","Writing & documents"],"platforms":["macOS"],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Apple","Writing & documents"],"evidence":[{"subject":"Apple","source":"metadata","match":"macOS"},{"subject":"Writing & documents","source":"metadata","match":"text editor"}],"platformEvidence":[{"platform":"macOS","source":"metadata","match":"macOS"}],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Templates & UI components"],"reviewRequired":true},"demoHealth":{"url":"https://chaitmudunuri.github.io/cmx/","attemptedAt":"2026-10-19T07:36:44.739Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T07:36:44.739Z","lastWorkingAt":"2026-10-19T07:36:44.739Z","target":"https://chaitmudunuri.github.io/cmx/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T07:36:44.739Z"},"previewAttemptAt":"2026-10-19T07:36:44.739Z","previewCheck":{"url":"https://chaitmudunuri.github.io/c