{"repositoryId":931490221,"availability":"available","full":"SkyworkAI/SkyReels-V1","name":"SkyReels-V1","description":"SkyReels V1: The first and most advanced open-source human-centric video foundation model","category":"AI & machine learning","language":"Python","stars":2693,"forks":310,"created":"2025-02-12T11:15:46Z","updated":"2025-03-10T10:02:10Z","license":null,"branch":"main","homepage":"https://www.skyreels.ai","topics":["i2v","t2v","video-diffusion-transformers"],"demo":"https://www.skyreels.ai/home?utm_campaign=github_V1","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-15T17:01:08.236Z","lastAttemptAt":"2026-10-15T17:01:08.236Z","lastAvailableAt":"2026-10-15T17:01:08.236Z","metrics":[{"at":"2026-10-15T17:01:08.236Z","stars":2693,"forks":310}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Welcome to the SkyReels V1 repository! Here, you'll find the Text-to-Video & Image-to-Video model weights and inference code for our groundbreaking video foundation model.","SkyReels V1 is the first and most advanced open-source human-centric video foundation model. By fine-tuning HunyuanVideo on O(10M) high-quality film and television clips, SkyReels V1 offers three key advantages:"],"features":["Advanced Facial Animation: Captures 33 distinct facial expressions with over 400 natural movement combinations, accurately reflecting human emotions.","Cinematic Lighting and Aesthetics: Trained on high-quality Hollywood-level film and television data, each generated frame exhibits cinematic quality in composition, actor positioning, and camera angles.","Our model is built on a self-developed data cleaning and annotation pipeline, creating a vast dataset of high-quality film, television, and documentary content.","Expression Classification: Categorizes human facial expressions into 33 distinct types.","Character Spatial Awareness: Utilizes 3D human reconstruction technology to understand spatial relationships between multiple people in a video, enabling film-level character positioning."],"sourceUrl":"https://github.com/SkyworkAI/SkyReels-V1/blob/main/README.md","fingerprint":"5e0d4b9b0be6451b0ea51cd9010b42135502947cb16f788e41a0438955a5de12","extractedAt":"2026-10-15T17:01:08.381Z"},"overviewCheckedAt":"2026-10-15T17:01:08.381Z","projectInsights":{"version":1,"whatItDoes":{"text":"Welcome to the SkyReels V1 repository! Here, you'll find the Text-to-Video & Image-to-Video model weights and inference code for our groundbreaking video foundation model.","sourceUrl":"https://github.com/SkyworkAI/SkyReels-V1/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"5e0d4b9b0be6451b0ea51cd9010b42135502947cb16f788e41a0438955a5de12","sourceUrl":"https://github.com/SkyworkAI/SkyReels-V1/blob/main/README.md","checkedAt":"2026-10-15T17:01:08.381Z"},"overviewRepoUpdated":"2025-03-10T10:02:10Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/SkyworkAI/SkyReels-V1/blob/main/README.md","checkedAt":"2026-10-15T19:35:34.607Z","hash":"5e0d4b9b0be6451b0ea51cd9010b42135502947cb16f788e41a0438955a5de12","originalBytes":15767,"storedBytes":15767,"truncated":false},"lastDemoCheckedAt":"2026-10-15T17:01:08.236Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Fashion","Image, audio & video AI"],"reviewRequired":true},"demoHealth":{"url":"https://www.skyreels.ai/home?utm_campaign=github_V1","attemptedAt":"2026-10-15T17:14:17.688Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T17:14:17.688Z","lastWorkingAt":"2026-10-15T17:14:17.688Z","target":"https://www.skyreels.ai/home?utm_campaign=github_V1","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T17:14:17.688Z"},"previewAttemptAt":"2026-10-15T17:14:17.691Z","previewCheck":{"url"