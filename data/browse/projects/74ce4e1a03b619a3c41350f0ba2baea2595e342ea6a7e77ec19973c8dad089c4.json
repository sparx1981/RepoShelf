{"availability":"available","full":"BytesBySuyash/ReClaim","name":"ReClaim","description":"A disaster recovery demo bringing citizen reports, field verification, and relief coordination into one place. Built with React and TypeScript, with separate views for residents, field workers, organizations, and government teams.","category":"Design","language":"TypeScript","stars":0,"forks":0,"created":"2026-08-17T09:40:51Z","updated":"2026-10-07T07:24:44Z","branch":"main","homepage":"https://bytesbysuyash.github.io/ReClaim/","topics":["dashboard","disaster-management","disaster-recovery","frontend","leaflet","react","relief-coordination","tailwindcss","typescript","vite"],"demo":"https://bytesbysuyash.github.io/ReClaim/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-16T23:47:43.414Z","lastAttemptAt":"2026-10-16T23:47:43.414Z","lastAvailableAt":"2026-10-16T23:47:43.414Z","metrics":[{"at":"2026-10-11T22:39:21.799Z","stars":0,"forks":0},{"at":"2026-10-16T23:47:43.414Z","stars":0,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["A disaster recovery coordination demo built with React, TypeScript, and Vite.","RECLAIM brings four perspectives into one interface: a resident reporting losses, a field worker verifying a household, an organization coordinating response, and a government team reviewing activity across disaster events.","Demo data: This is a front-end work sample. Reports are not sent to a server, and the case records, dashboard figures, and analysis results are examples. Use fictional information only."],"features":["Citizen / Victim: Explore the reporting, evidence, household profile, recovery plan, and help resources screens. The voice control inserts a sample transcript; it is not live speech recognition.","Field Worker: Review assigned households, verification tasks, evidence capture, and field notes.","Organization: Review household priorities, recovery intelligence, map views, field workers, budgets, and schemes.","Government: Compare active events and open district, scheme, budget, and map views."],"sourceUrl":"https://github.com/BytesBySuyash/ReClaim/blob/main/README.md","fingerprint":"d2d62acb45bfe66d98af14f2de62a6a9110f9c34e80c43692dc33f5a4d9c5555","extractedAt":"2026-10-11T22:39:21.959Z"},"overviewCheckedAt":"2026-10-11T22:39:21.959Z","projectInsights":{"version":1,"whatItDoes":{"text":"A disaster recovery coordination demo built with React, TypeScript, and Vite.","sourceUrl":"https://github.com/BytesBySuyash/ReClaim/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"d2d62acb45bfe66d98af14f2de62a6a9110f9c34e80c43692dc33f5a4d9c5555","sourceUrl":"https://github.com/BytesBySuyash/ReClaim/blob/main/README.md","checkedAt":"2026-10-11T22:39:21.959Z"},"overviewRepoUpdated":"2026-10-07T07:24:44Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/BytesBySuyash/ReClaim/blob/main/README.md","checkedAt":"2026-10-11T22:39:21.960Z","hash":"d2d62acb45bfe66d98af14f2de62a6a9110f9c34e80c43692dc33f5a4d9c5555","originalBytes":4527,"storedBytes":4527,"truncated":false},"lastDemoCheckedAt":"2026-10-11T22:39:21.964Z","subjects":["Maps & geospatial","Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Maps & geospatial","Data & dashboards"],"evidence":[{"subject":"Maps & geospatial","source":"metadata","match":"leaflet"},{"subject":"Data & dashboards","source":"metadata","match":"dashboard"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows","Templates & UI components","Privacy & security"],"reviewRequired":true},"demoHealth":{"url":"https://bytesbysuyash.github.io/ReClaim/","attemptedAt":"2026-10-18T23:01:26.411Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T23:01:26.411Z","lastWorkingAt":"2026-10-18T23:01:26.411Z","target":"https://bytesbysuyash.github.io/ReClaim/","failureCount":0,"con