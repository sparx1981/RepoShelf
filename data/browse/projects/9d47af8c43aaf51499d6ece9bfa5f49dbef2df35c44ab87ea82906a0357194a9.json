soning, similarity search misses what is relevant but not similar, and returns what is similar but not relevant.","Inspired by AlphaGo, PageIndex replaces the vector index with a hierarchical tree index and lets an LLM reason its way through it, the way a human expert turns to and reads the right section of a long report. Retrieval happens in two steps:"],"features":["Index: generate a tree-structure index for each document","Retrieve: agentically search that tree with LLM reasoning"],"sourceUrl":"https://github.com/VectifyAI/PageIndex/blob/main/README.md","fingerprint":"fc08d3fad45b28810d578c1fe71859619abc06e7849daf9025982c0168a42308","extractedAt":"2026-10-03T05:59:55.770Z"},"overviewCheckedAt":"2026-10-08T09:24:52.075Z","overviewRepoUpdated":"2026-10-08T05:18:34Z","demoHealth":{"url":"https://calendly.com/pageindex/meet","attemptedAt":"2026-10-06T21:13:50.752Z","status":"working","checkedAt":"2026-10-06T21:13:50.752Z","lastWorkingAt":"2026-10-06T21:13:50.752Z","target":"https://calendly.com/pageindex/meet?month=2026-10","failureCount":0,"nextCheckAt":"2026-10-13T21:13:50.752Z","consecutiveTemporaryFailures":0,"probeVersion":3},"previewAttemptAt":"2026-10-06T21:13:50.752Z","projectInsights":{"version":1,"whatItDoes":{"text":"Reasoning-based RAG ◦ No Vector DB, No Chunking ◦ Context-Aware Retrieval ◦ Reads Like a Human","sourceUrl":"https://github.com/VectifyAI/PageIndex/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"required","text":"Moving indexing and storage from Local to Cloud only requires a PageIndex API key:","sourceUrl":"https://github.com/VectifyAI/PageIndex/blob/main/README.md"}],"fingerprint":"fc08d3fad45b28810d578c1fe71859619abc06e7849daf9025982c0168a42308","sourceUrl":"https://github.com/VectifyAI/PageIndex/blob/main/README.md","checkedAt":"2026-10-08T09:24:52.075Z"},"agentContextAttemptAt":"2026-10-03T14:17:55.676Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/VectifyAI/PageIndex/blob