{"repositoryId":1116725910,"availability":"available","full":"a-paulus/softjax","name":"softjax","description":"A library for soft differentiable relaxations of common JAX functions.","category":"Developer tools","language":"Python","stars":99,"forks":4,"created":"2025-12-15T09:42:46Z","updated":"2026-07-01T12:18:32Z","license":"Apache-2.0","branch":"main","homepage":"https://a-paulus.github.io/softjax/","topics":["differentiable-computing","differentiable-optimization","differentiable-physics","differentiable-programming","differentiable-rendering","differentiable-simulation","jax"],"demo":"https://a-paulus.github.io/softjax/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-18T05:00:56.484Z","lastAttemptAt":"2026-10-18T05:00:56.484Z","lastAvailableAt":"2026-10-18T05:00:56.484Z","metrics":[{"at":"2026-10-12T13:37:58.137Z","stars":98,"forks":4},{"at":"2026-10-18T05:00:56.484Z","stars":99,"forks":4}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["SoftJAX provides soft differentiable drop-in replacements for traditionally non-differentiable functions in JAX, including","All operators offer multiple modes and adjustable strength of softening, allowing for e.g. smoothness of the soft function or boundedness of the softened region, depending on the user needs.","Moreover, we tightly integrate functionality for deploying functions using straight-through-estimation, where we use non-differentiable functions in the forward pass and their differentiable replacements in the backward pass."],"features":["elementwise operators: abs, relu, clip, sign, round and heaviside;","array-valued operators: (arg)max, (arg)min, (arg)quantile, (arg)median, (arg)sort, (arg)topk and rank;","random sampling operators under softjax.random, including categorical, Bernoulli, choice, permutation, Rademacher, binomial, and multinomial samplers plus straight-through variants;","comparison operators such as: greater, equal or isclose;","logical operators such as: logicaland, all or any;"],"sourceUrl":"https://github.com/a-paulus/softjax/blob/main/README.md","fingerprint":"bcae4ae1506a7f5dacb99070d7b57cda0f7a9572e7caebc68519b9fd725723fc","extractedAt":"2026-10-12T13:37:58.379Z"},"overviewCheckedAt":"2026-10-12T13:37:58.379Z","projectInsights":{"version":1,"whatItDoes":{"text":"SoftJAX provides soft differentiable drop-in replacements for traditionally non-differentiable functions in JAX, including","sourceUrl":"https://github.com/a-paulus/softjax/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"bcae4ae1506a7f5dacb99070d7b57cda0f7a9572e7caebc68519b9fd725723fc","sourceUrl":"https://github.com/a-paulus/softjax/blob/main/README.md","checkedAt":"2026-10-12T13:37:58.379Z"},"overviewRepoUpdated":"2026-07-01T12:18:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/a-paulus/softjax/blob/main/README.md","checkedAt":"2026-10-12T13:37:58.380Z","hash":"bcae4ae1506a7f5dacb99070d7b57cda0f7a9572e7caebc68519b9fd725723fc","originalBytes":11984,"storedBytes":11984,"truncated":false},"lastDemoCheckedAt":"2026-10-12T13:37:58.381Z","subjects":["Simulation & physics","Science"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Simulation & physics","Science"],"evidence":[{"subject":"Simulation & physics","source":"metadata","match":"simulation"},{"subject":"Science","source":"metadata","match":"physics"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://a-paulus.github.io/softjax/","attemptedAt":"2026-10-19T14:06:16.951Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T14:06:16.951Z","lastWorkingAt":"2026-10-19T14:06:16.951Z","target":"https://a-paulus.github.io/softjax/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T14:06:16.951Z"},"previewAttemptAt":"2026-10-19T14:06