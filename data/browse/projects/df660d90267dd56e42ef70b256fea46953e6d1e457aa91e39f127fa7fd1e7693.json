{"repositoryId":1423433825,"availability":"available","full":"carlok/consculpta","name":"consculpta","description":"Consculpta: breed 3D sculptures from formulas over simplex noise, raymarched in WebGL 2, with an optional AI co-breeder.","category":"AI & machine learning","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-17T14:50:31Z","updated":"2026-10-17T19:56:42Z","license":"Apache-2.0","branch":"main","homepage":"https://carlok.github.io/consculpta/","topics":["creative-coding","evolutionary-art","generative-art","genetic-programming","github-pages","glsl","interactive-evolution","javascript","procedural-generation","raymarching","sdf","shaders","simplex-noise","webgl2"],"demo":"https://carlok.github.io/consculpta/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-17T22:40:55.999Z","lastAttemptAt":"2026-10-17T22:40:55.999Z","lastAvailableAt":"2026-10-17T22:40:55.999Z","metrics":[{"at":"2026-10-17T22:40:55.999Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Interactive evolution of 3D sculptures from formulas over simplex noise, raymarched in WebGL 2.","Each sculpture is the region where a formula over 3D simplex noise rises above an iso level inside a sphere, cube or drum. Formulas are trees of noise, trigonometry and space transforms (twist, mirror, rotate, warp). Every offspring changes its parent's tree by tweaking a number, swapping a function, grafting a new branch, wrapping a node or cutting one out. About one offspring in twelve switches to strands: thin filaments traced where the formula's surface crosses a rotated copy of itself. The page evaluates each formula on 520 sample points to normalise it, estimate a safe raymarching step…","Simplex noise by Ian McEwan, Ashima Arts and Stefan Gustavson (MIT). Colours use Inigo Quilez's cosine palettes. Shader code exports a standalone Shadertoy shader with the formula compiled in."],"features":[],"sourceUrl":"https://github.com/carlok/consculpta/blob/main/README.md","fingerprint":"8d58eeddd92310e2583bea046d8aceec30ce5e42816ba95ab8fb8de692a441fe","extractedAt":"2026-10-17T22:40:56.080Z"},"overviewCheckedAt":"2026-10-17T22:40:56.080Z","projectInsights":{"version":1,"whatItDoes":{"text":"Interactive evolution of 3D sculptures from formulas over simplex noise, raymarched in WebGL 2.","sourceUrl":"https://github.com/carlok/consculpta/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"8d58eeddd92310e2583bea046d8aceec30ce5e42816ba95ab8fb8de692a441fe","sourceUrl":"https://github.com/carlok/consculpta/blob/main/README.md","checkedAt":"2026-10-17T22:40:56.080Z"},"overviewRepoUpdated":"2026-10-17T19:56:42Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/carlok/consculpta/blob/main/README.md","checkedAt":"2026-10-17T22:40:56.081Z","hash":"8d58eeddd92310e2583bea046d8aceec30ce5e42816ba95ab8fb8de692a441fe","originalBytes":5035,"storedBytes":5035,"truncated":false},"lastDemoCheckedAt":"2026-10-17T22:40:55.999Z","subjects":["3D & graphics"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["3D & graphics"],"evidence":[{"subject":"3D & graphics","source":"metadata","match":"3D"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Templates & UI components"],"reviewRequired":true},"demoHealth":{"url":"https://carlok.github.io/consculpta/","attemptedAt":"2026-10-20T05:50:30.756Z","probeVersion":3,"status":"unknown","consecutiveTemporaryFailures":5,"error":{"reason":"network_or_timeout","at":"2026-10-20T05:50:30.756Z"},"nextCheckAt":"2026-10-21T05:50:30.756Z"},"previewAttemptAt":"2026-10-20T05:50:30.756Z","previewCheck":{"url":"https://carlok.github.io/consculpta/","attemptedAt":"2026-10-20T05:50:30.756Z","consecutiveFailures":5,"status":"retry","reason":"network_or_timeout","nextCheckAt":"2026-10-21T05:50:30.756Z"},"qualityPriority":false,"spaces":[]}