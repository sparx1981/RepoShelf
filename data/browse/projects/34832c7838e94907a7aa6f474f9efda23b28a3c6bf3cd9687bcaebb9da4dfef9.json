 Kafka sink connector kafka-connect-elasticsearch…"],"features":[],"sourceUrl":"https://github.com/confluentinc/cp-demo/blob/8.1.0-post/README.md","fingerprint":"a8246d1ced388cab268a2cb9bd1d55754d5ed419c0c21fad7e17283b05d61104","extractedAt":"2026-10-05T18:44:10.991Z"},"overviewCheckedAt":"2026-10-12T19:09:46.192Z","projectInsights":{"version":1,"whatItDoes":{"text":"This example and accompanying tutorial show users how to deploy an Apache Kafka® event streaming application using ksqlDB and Kafka Streams for stream processing. All the components in the Confluent Platform have security enabled end-to-end. Run the example with the tutorial.","sourceUrl":"https://github.com/confluentinc/cp-demo/blob/8.1.0-post/README.md"},"audience":[],"requirements":[],"fingerprint":"a8246d1ced388cab268a2cb9bd1d55754d5ed419c0c21fad7e17283b05d61104","sourceUrl":"https://github.com/confluentinc/cp-demo/blob/8.1.0-post/README.md","checkedAt":"2026-10-12T19:09:46.192Z"},"overviewRepoUpdated":"2026-09-17T09:36:00Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/confluentinc/cp-demo/blob/8.1.0-post/README.md","checkedAt":"2026-10-12T19:09:46.192Z","hash":"a8246d1ced388cab268a2cb9bd1d55754d5ed419c0c21fad7e17283b05d61104","originalBytes":2575,"storedBytes":2575,"truncated":false},"lastDemoCheckedAt":"2026-10-05T18:44:10.881Z","enrichmentAttemptAt":"2026-10-05T18:44:21.953Z","latestRelease":null,"releaseCheckedAt":"2026-10-05T18:44:21.953Z","screenshots":[{"src":"previews/34832c7838e94907a7aa6f47.jpg","kind":"demo","capturedAt":"2026-10-12T19:23:19.299Z","url":"https://docs.confluent.io/platform/current/tutorials/cp-demo/docs/index.html?utm_source=github&utm_medium=demo&utm_campaign=ch.cp-demo_type.community_content.cp-demo"}],"agentContextAttemptAt":"2026-10-05T18:44:54.883Z","agentContext":{"version":1,"checkedAt":"2026-10-05T18:44:56.784Z","documents":[{"name":"LICENSE","sourceUrl":"https://github.com/confluentinc/cp-demo/blob/8.1.0-post/LICENSE","hash":"b409