{"repositoryId":1219056921,"availability":"available","full":"apohor/rivolt","name":"rivolt","description":"Rivian Companion","category":"Other","language":"Go","stars":10,"forks":0,"created":"2026-04-23T13:39:29Z","updated":"2026-10-16T15:52:57Z","license":"MIT","branch":"main","homepage":null,"topics":[],"demo":"https://preview.rivolt.dev/demo","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-16T15:53:25.652Z","lastAttemptAt":"2026-10-16T15:53:25.652Z","lastAvailableAt":"2026-10-16T15:53:25.652Z","metrics":[{"at":"2026-10-15T15:00:55.953Z","stars":10,"forks":0},{"at":"2026-10-16T15:53:25.652Z","stars":10,"forks":0}],"technologies":["Go"],"overview":{"kind":"readme","version":1,"paragraphs":["A Rivian companion. Live telemetry, per-trip analytics, a charging cost ledger, and a route planner that estimates what a road trip will cost.","Rivolt is an open-source companion app for Rivian vehicles. It streams live telemetry from your truck, records every drive and charging session against your own electricity rate, and plans road trips with cost / weather / efficiency analysis built in.","Rivolt turns your Rivian's charging and driving into a priced ledger you own, and a planner that accounts for what a trip will cost."],"features":[],"sourceUrl":"https://github.com/apohor/rivolt/blob/main/README.md","fingerprint":"c18790ab9f90c659524ecce9acf44aa08628bcc2845789d3cbbf8ac21efa0ca4","extractedAt":"2026-10-16T15:53:25.889Z"},"overviewCheckedAt":"2026-10-16T15:53:25.889Z","projectInsights":{"version":1,"whatItDoes":{"text":"A Rivian companion. Live telemetry, per-trip analytics, a charging cost ledger, and a route planner that estimates what a road trip will cost.","sourceUrl":"https://github.com/apohor/rivolt/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"preview.rivolt.dev/demo is a read-only demo on a generated sample truck: no sign-in, no Rivian account, and no real vehicle data.","sourceUrl":"https://github.co