{"full":"AnkanMisra/MicroAI-Paygate","name":"MicroAI-Paygate","description":"A high-performance, crypto-monetized AI microservice architecture implementing the x402 Protocol","category":"AI & machine learning","language":"TypeScript","stars":97,"forks":60,"created":"2025-12-08T22:48:55Z","updated":"2026-10-13T01:00:50Z","license":"MIT","branch":"main","homepage":"https://microai-paygate.vercel.app","topics":[],"demo":"https://microai-paygate.vercel.app/","color":"#323057","ink":"#d6caff","availability":"available","lastCheckedAt":"2026-10-16T13:25:38.393Z","lastAttemptAt":"2026-10-16T13:25:38.393Z","lastAvailableAt":"2026-10-16T13:25:38.393Z","lastDemoCheckedAt":"2026-10-16T13:25:38.393Z","metrics":[{"at":"2026-10-03T21:18:03.254Z","stars":99,"forks":61},{"at":"2026-10-04T05:48:22.507Z","stars":99,"forks":61},{"at":"2026-10-05T05:10:23.921Z","stars":99,"forks":61},{"at":"2026-10-07T11:14:23.526Z","stars":98,"forks":60},{"at":"2026-10-09T13:18:10.914Z","stars":97,"forks":60},{"at":"2026-10-11T20:53:29.574Z","stars":95,"forks":60},{"at":"2026-10-16T13:25:38.393Z","stars":97,"forks":60}],"technologies":[],"overviewAttemptAt":"2026-10-07T11:16:13.503Z","overview":{"kind":"readme","version":1,"paragraphs":["Payment authorization, replay protection, and signed receipts for AI APIs.","MicroAI Paygate is an open-source reference stack for payment-gated AI requests. It combines a Go API gateway, a Rust EIP-712 verifier, a Next.js wallet experience, configurable memory or Redis state, and a local TypeScript SDK.","An unsigned request receives HTTP 402 Payment Required. The client signs the returned payment context, retries with X-402- headers, and receives an AI result plus a gateway-signed receipt."],"features":["Explicit authorization — wallets sign EIP-712 payment contexts before the AI provider is called.","Replay protection — the verifier supports process-local memory or shared Redis nonce claims.","Signed receipts — the gateway signs request and response hashes and supports receipt lookup by ID.","Operational controls — timeouts, CORS, rate limits, optional response caching, health checks, and Prometheus metrics are built in.","Two client paths — use the browser wallet flow or the repo-local TypeScript SDK."],"sourceUrl":"https://github.com/AnkanMisra/MicroAI-Paygate/blob/main/README.md","fingerprint":"62167264ba92fc34a223a909fab46ef13f2f6e968176bec082ce80e94188c6cb","extractedAt":"2026-10-03T07:15:20.366Z"},"overviewCheckedAt":"2026-10-16T13:25:38.544Z","projectInsights":{"version":1,"whatItDoes":{"text":"Payment authorization, replay protection, and signed receipts for AI APIs.","sourceUrl":"https://github.com/AnkanMisra/MicroAI-Paygate/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"62167264ba92fc34a223a909fab46ef13f2f6e968176bec082ce80e94188c6cb","sourceUrl":"https://github.com/AnkanMisra/MicroAI-Paygate/blob/main/README.md","checkedAt":"2026-10-16T13:25:38.544Z"},"overviewRepoUpdated":"2026-10-13T01:00:50Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/AnkanMisra/MicroAI-Paygate/blob/main/README.md","checkedAt":"2026-10-16T13:25:38.545Z","hash":"62167264ba92fc34a223a909fab46ef13f2f6e968176bec082ce80e94188c6cb","originalBytes":12690,"storedBytes":12690,"truncated":false},"enrichmentAttemptAt":"2026-10-04T05:15:12.317Z","latestRelease":null,"releaseCheckedAt":"2026-10-04T05:15:12.317Z","screenshots":[{"src":"previews/3e8011cd6db70bf99f8a0405.jpg","kind":"demo","capturedAt":"2026-10-14T13:49:47.986Z","url":"https://microai-paygate.vercel.app/"}],"qualityPriority":false,"previewAttemptAt":"2026-10-14T13:49:47.986Z","demoHealth":{"url":"https://microai-paygate.vercel.app/","attemptedAt":"2026-10-14T13:49:47.986Z","status":"working","checkedAt":"2026-10-14T13:49:47.986Z","lastWorkingAt":"2026-10-14T13:49:47.986Z","target":"https://microai-paygate.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-21T13:49:47.986Z","probeVersion":3},"previewChec