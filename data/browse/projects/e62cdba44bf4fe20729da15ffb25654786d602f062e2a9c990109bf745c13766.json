{"availability":"available","full":"GeiserX/Wayback-Archive","name":"Wayback-Archive","description":"Rescue whole websites from the Wayback Machine.","category":"Developer tools","language":"Python","stars":42,"forks":9,"created":"2025-12-11T20:01:44Z","updated":"2026-10-06T23:50:35Z","license":"GPL-3.0","branch":"main","homepage":"https://geiserx.github.io/Wayback-Archive/","topics":["archive","archive-org","cdn","content-preservation","digital-preservation","google-fonts","internet-archive","minification","offline-browsing","recursive-download","site-mirror","static-site-generator","url-rewriting","wayback-machine","wayback-machine-downloader","web-archiving","web-crawler","web-scraping","website-backup","website-downloader"],"demo":"https://geiserx.github.io/Wayback-Archive/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-18T16:53:49.768Z","lastAttemptAt":"2026-10-18T16:53:49.768Z","lastAvailableAt":"2026-10-18T16:53:49.768Z","metrics":[{"at":"2026-10-07T02:54:45.041Z","stars":39,"forks":8},{"at":"2026-10-09T08:56:49.979Z","stars":40,"forks":8},{"at":"2026-10-12T09:43:59.294Z","stars":41,"forks":8},{"at":"2026-10-18T16:53:49.768Z","stars":42,"forks":9}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Rescue whole websites from the Wayback Machine.","Wayback-Archive is a command-line tool that downloads an archived website from the Wayback Machine and rebuilds it as a folder you can open offline. It fetches every page and asset it can find in the snapshot, rewrites the links to local paths and removes the Wayback Machine's own toolbar, scripts and URL prefixes, so the copy looks like the site did on that day. wget --mirror and httrack do not understand Wayback Machine URLs; this does."],"features":["Saves HTML, CSS, JavaScript, images and fonts, following links in HTML, CSS and JavaScript until nothing is left to fetch.","Every link in the copy points at the local file, so pages open and lead to each other without the Wayback toolbar or its URL prefixes.","A page or file missing from the snapshot is looked up at up to three other Wayback timestamps (a day either side and a week earlier) before it is given up on.","A capture that is an archived error or a Cloudflare challenge page is replaced with the nearest good capture.","Google Fonts are saved locally, and a font the archive returns as an HTML error page is dropped instead of breaking the page."],"sourceUrl":"https://github.com/GeiserX/Wayback-Archive/blob/main/README.md","fingerprint":"df6956660ac13e2b12d31796fd7c96540cd089d89102f81e3506c2fd44bab5bb","extractedAt":"2026-10-07T02:54:45.187Z"},"overviewCheckedAt":"2026-10-19T02:50:53.491Z","projectInsights":{"version":1,"whatItDoes":{"text":"Rescue whole websites from the Wayback Machine.","sourceUrl":"https://github.com/GeiserX/Wayback-Archive/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"df6956660ac13e2b12d31796fd7c96540cd089d89102f81e3506c2fd44bab5bb","sourceUrl":"https://github.com/GeiserX/Wayback-Archive/blob/main/README.md","checkedAt":"2026-10-19T02:50:53.492Z"},"overviewRepoUpdated":"2026-10-06T23:50:35Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/GeiserX/Wayback-Archive/blob/main/README.md","checkedAt":"2026-10-19T02:50:53.492Z","hash":"df6956660ac13e2b12d31796fd7c96540cd089d89102f81e3506c2fd44bab5bb","originalBytes":5888,"storedBytes":5888,"truncated":false},"lastDemoCheckedAt":"2026-10-07T02:54:45.041Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows","Apple"],"reviewRequired":true},"demoHealth":{"url":"https://geiserx.github.io/Wayback-Archive/","attemptedAt":"2026-10-14T13:45:03.151Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T13:45:03.151Z","lastWorkingAt":"2026-10-14T13:45:03.151Z