{"repositoryId":389568562,"availability":"available","full":"lahmatiy/react-render-tracker","name":"react-render-tracker","description":"React render tracker – a tool to discover performance issues related to unintentional re-renders and unmounts","category":"Developer tools","language":"TypeScript","stars":2400,"forks":36,"created":"2021-07-26T08:50:50Z","updated":"2025-03-31T23:51:08Z","license":"MIT","branch":"main","homepage":"https://lahmatiy.github.io/react-render-tracker/","topics":["devtools","performance","react","rerender"],"demo":"https://lahmatiy.github.io/react-render-tracker/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-15T17:01:09.175Z","lastAttemptAt":"2026-10-15T17:01:09.175Z","lastAvailableAt":"2026-10-15T17:01:09.175Z","metrics":[{"at":"2026-10-15T17:01:09.175Z","stars":2400,"forks":36}],"technologies":["React","Node.js"],"overview":{"kind":"readme","version":1,"paragraphs":["React Render Tracker – a tool to discover performance issues related to unintended re-renders.","React Render Tracker (RRT) presents component’s tree state over the time and an event log related to a selected component (fiber) or its subtree. It doesn't provide a complete state of the components, but the difference between their states. It's not a replacement for React Devtools, but a compliment to it with a focus on investigation of changes in app's component tree (like mounts, updates and unmounts) and their causes.","React Render Tracker v0.6 – Overview & Instructions"],"features":["The state of component's tree over time including unmounted components (can be hidden by a toggle in the top right corner) and number of updates (re-renders)","Two types of component's tree hierarchy: owner-based (how components are created, that's better for updates tracking, selected by default) and parent-based (how components are mounted)","The matrix of props updates and update bailouts for a selected fiber","Displaying context used on fibers and locations where context is reading using hooks","Displaying consumers list for provider fibers"],"sourceUrl":"https://github.com/lahmatiy/react-render-tracker/blob/main/README.md","fingerprint":"3501bddcc5e7e7f9d2a5dffb397d1a3a4c6708ba8a3f677f127aa3bc1886636a","extractedAt":"2026-10-15T17:01:09.313Z"},"overviewCheckedAt":"2026-10-15T17:01:09.313Z","projectInsights":{"version":1,"whatItDoes":{"text":"React Render Tracker – a tool to discover performance issues related to unintended re-renders.","sourceUrl":"https://github.com/lahmatiy/react-render-tracker/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"3501bddcc5e7e7f9d2a5dffb397d1a3a4c6708ba8a3f677f127aa3bc1886636a","sourceUrl":"https://github.com/lahmatiy/react-render-tracker/blob/main/README.md","checkedAt":"2026-10-15T17:01:09.313Z"},"overviewRepoUpdated":"2025-03-31T23:51:08Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/lahmatiy/react-render-tracker/blob/main/README.md","checkedAt":"2026-10-16T05:08:57.482Z","hash":"3501bddcc5e7e7f9d2a5dffb397d1a3a4c6708ba8a3f677f127aa3bc1886636a","originalBytes":13917,"storedBytes":13917,"truncated":false},"lastDemoCheckedAt":"2026-10-15T17:01:09.175Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://lahmatiy.github.io/react-render-tracker/","attemptedAt":"2026-10-15T17:15:01.637Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T17:15:01.637Z","lastWorkingAt":"2026-10-15T17:15:01.637Z","target":"https://lahmatiy.github.io/react-render-tracker/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T17:15:01.637Z"},"previewAttemptAt":"2026-10-15T17:15:01.637Z","previewCheck":{"url":"https://lahmatiy.github.io/react-render-tracker/","attemptedAt":"2026-10-15T17:15:01.637Z","consecu