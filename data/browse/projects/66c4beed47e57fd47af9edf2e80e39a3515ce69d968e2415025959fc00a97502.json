dded, arranged, and rearranged, allowing WordPress users to create media-rich pages in a visually intuitive way -- and without workarounds like shortcodes or custom HTML."],"features":[],"sourceUrl":"https://github.com/WordPress/gutenberg/blob/trunk/README.md","fingerprint":"53ac7a16931eff5b5672fb48c7cb9eb5b4e2c458ee02ad1a180952ad9fd020d9","extractedAt":"2026-10-04T08:11:06.837Z"},"overviewCheckedAt":"2026-10-09T23:11:17.371Z","projectInsights":{"version":1,"whatItDoes":{"text":"Welcome to the development hub for the WordPress Gutenberg project!","sourceUrl":"https://github.com/WordPress/gutenberg/blob/trunk/README.md"},"audience":[],"requirements":[],"fingerprint":"53ac7a16931eff5b5672fb48c7cb9eb5b4e2c458ee02ad1a180952ad9fd020d9","sourceUrl":"https://github.com/WordPress/gutenberg/blob/trunk/README.md","checkedAt":"2026-10-09T23:11:17.371Z"},"overviewRepoUpdated":"2026-10-09T22:54:27Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/WordPress/gutenberg/blob/trunk/README.md","checkedAt":"2026-10-09T23:11:17.372Z","hash":"53ac7a16931eff5b5672fb48c7cb9eb5b4e2c458ee02ad1a180952ad9fd020d9","originalBytes":6603,"storedBytes":6603,"truncated":false},"lastDemoCheckedAt":"2026-10-09T23:11:17.281Z","enrichmentAttemptAt":"2026-10-04T08:12:54.304Z","latestRelease":{"name":"24.1.0","tag":"v24.1.0","publishedAt":"2026-09-30T09:21:10Z","url":"https://github.com/WordPress/gutenberg/releases/tag/v24.1.0"},"releaseCheckedAt":"2026-10-04T08:12:54.304Z","screenshots":[{"src":"previews/c4ee9596da97477f1c50adb6.jpg","kind":"demo","capturedAt":"2026-10-15T11:45:01.435Z","url":"https://wordpress.org/gutenberg/"},{"src":"https://user-images.githubusercontent.com/1204802/100067796-fc3e8700-2e36-11eb-993b-6b80b4310b87.png","kind":"readme","alt":"Screenshot of the Gutenberg Editor, editing a post in WordPress"}],"agentContextAttemptAt":"2026-10-04T08:13:39.612Z","agentContext":{"version":1,"checkedAt":"2026-10-04T08:13:40.424Z","documents":[{"name":"package.json