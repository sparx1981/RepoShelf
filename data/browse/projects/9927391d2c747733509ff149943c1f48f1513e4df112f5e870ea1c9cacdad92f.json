{"availability":"available","full":"DayuanJiang/next-ai-draw-io","name":"next-ai-draw-io","description":"A next.js web application that integrates AI capabilities with draw.io diagrams. This app allows you to create, modify, and enhance diagrams through natural language commands and AI-assisted visualization.","category":"Design","language":"TypeScript","stars":36260,"forks":3852,"created":"2025-03-23T15:03:48Z","updated":"2026-10-15T08:36:54Z","license":"Apache-2.0","branch":"main","homepage":"https://next-ai-drawio.jiang.jp/","topics":["ai","diagrams","productivity"],"demo":"https://next-ai-drawio.jiang.jp/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-15T13:02:44.887Z","lastAttemptAt":"2026-10-15T13:02:44.887Z","lastAvailableAt":"2026-10-15T13:02:44.887Z","lastDemoCheckedAt":"2026-10-15T13:02:44.887Z","metrics":[{"at":"2026-10-03T21:18:43.540Z","stars":36103,"forks":3851},{"at":"2026-10-04T19:20:42.641Z","stars":36105,"forks":3851},{"at":"2026-10-05T19:23:26.370Z","stars":36110,"forks":3843},{"at":"2026-10-07T20:14:01.696Z","stars":36134,"forks":3848},{"at":"2026-10-08T16:05:38.841Z","stars":36143,"forks":3851},{"at":"2026-10-11T00:24:46.334Z","stars":36163,"forks":3849},{"at":"2026-10-15T13:02:44.887Z","stars":36260,"forks":3852}],"technologies":["React","Next.js"],"enrichmentAttemptAt":"2026-10-05T15:57:30.114Z","latestRelease":{"name":"0.4.16","tag":"v0.4.16","publishedAt":"2026-05-21T00:31:59Z","url":"https://github.com/DayuanJiang/next-ai-draw-io/releases/tag/v0.4.16"},"releaseCheckedAt":"2026-10-05T15:57:30.114Z","screenshots":[{"src":"previews/339904f425fa3e3c2062d945.jpg","kind":"demo","capturedAt":"2026-10-15T13:19:38.573Z","url":"https://next-ai-drawio.jiang.jp/"}],"overview":{"kind":"readme","version":1,"paragraphs":["Draw and edit draw.io diagrams by chatting with an AI.","Describe a diagram in a sentence and the AI draws it on a real draw.io canvas. Edit it by hand like any draw.io file, or select a few shapes and tell the AI what to change. Every AI change is a version you can compare, restore or undo, and the result exports as .drawio, .png or .svg.","Available as a web app, a desktop app for Windows, macOS and Linux, and an MCP server for AI agents such as Claude Code, Cursor and VS Code."],"features":["Architecture diagrams, flowcharts, sequence diagrams and more from one sentence, with built-in AWS, Azure, GCP and Kubernetes icon libraries","Connectors can carry a flowing animation","Upload a screenshot or a sketch and the AI redraws it; upload PDF, Markdown, code and other text files and get a diagram of their content","Edit by chat: changes stream onto the canvas and the shapes the AI just changed are highlighted","Ask about a selection: select shapes on the canvas and the AI changes only those"],"sourceUrl":"https://github.com/DayuanJiang/next-ai-draw-io/blob/main/README.md","fingerprint":"fb994fad9c46a436286e71e2d00d28e4fbe2548afc2b174495baa25fbb99c1be","extractedAt":"2026-10-15T13:02:44.970Z"},"overviewCheckedAt":"2026-10-15T13:02:44.970Z","overviewRepoUpdated":"2026-10-15T08:36:54Z","previewAttemptAt":"2026-10-15T13:19:38.573Z","demoHealth":{"url":"https://next-ai-drawio.jiang.jp/","attemptedAt":"2026-10-15T13:19:38.573Z","status":"working","checkedAt":"2026-10-15T13:19:38.573Z","lastWorkingAt":"2026-10-15T13:19:38.573Z","target":"https://next-ai-drawio.jiang.jp/en","failureCount":0,"nextCheckAt":"2026-10-22T13:19:38.573Z","consecutiveTemporaryFailures":0,"probeVersion":3},"projectInsights":{"version":1,"whatItDoes":{"text":"Draw and edit draw.io diagrams by chatting with an AI.","sourceUrl":"https://github.com/DayuanJiang/next-ai-draw-io/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Then ask the AI for \"a flowchart of user authentication with login, MFA and session management\" and the diagram appears in your browser as it is drawn.","sourceUrl":"https://github.com/DayuanJiang/next-ai-draw-io/blob/main/README.md"}],"fingerprint":"fb9