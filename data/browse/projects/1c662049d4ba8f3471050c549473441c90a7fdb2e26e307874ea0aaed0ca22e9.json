{"availability":"available","full":"mohamed-khairy-5i/tossinbox","name":"tossinbox","description":"Disposable email (temp mail) CLI + MCP server for AI agents. Spawn a throwaway inbox, wait for the OTP verification code, toss it. --json on every command, exit codes 0-4, no sign-up, no API keys. Node 18+, Homebrew, npm, npx, GitHub Action.","category":"Developer tools","language":"TypeScript","stars":1,"forks":0,"created":"2026-09-10T22:56:50Z","updated":"2026-10-06T12:08:14Z","license":"MIT","branch":"main","homepage":"https://tossinbox.pages.dev/","topics":["ai-agents","cli","developer-tools","disposable-email","disposable-inbox","email-automation","email-verification","mcp","mcp-server","model-context-protocol","npm-package","otp","otp-verification","privacy","temp-email","temp-mail","temporary-email","testing","throwaway-email","verification-code"],"demo":"https://tossinbox.pages.dev/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-13T02:09:48.023Z","lastAttemptAt":"2026-10-13T02:09:48.023Z","lastAvailableAt":"2026-10-13T02:09:48.023Z","metrics":[{"at":"2026-10-07T14:48:33.277Z","stars":1,"forks":0},{"at":"2026-10-09T16:41:58.852Z","stars":1,"forks":0},{"at":"2026-10-13T02:09:48.023Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Disposable email inboxes for humans and AI agents. Spawn a temporary inbox, wait for the OTP verification code, toss it.","Built by Mohamed Khairy. If TossInbox saved you a signup form, consider starring the repo — it helps more people find it.","TossInbox is a temp-mail CLI and MCP server: it creates a brand-new throwaway email address in one command, waits for the email verification to land, extracts the OTP code, and deletes the inbox when you are done — server-side and locally. Use it for signups, QA email flows, and test automation — or let your AI agent do all of it through the built-in MCP server. No sign-up, no ads, no browser, no API keys. Humans read the output; agents parse the --json."],"features":["For humans — stop exposing your real address to every signup form.","For agents — built agent-first from day one:","--json output on every command","documented exit codes, no interactive prompts","an MCP server so Claude, Cursor, and any"],"sourceUrl":"https://github.com/mohamed-khairy-5i/tossinbox/blob/main/README.md","fingerprint":"44522f01475841e6f83248313353b92a4d09bce4497532640b5b5247d48b11ec","extractedAt":"2026-10-07T14:48:33.430Z"},"overviewCheckedAt":"2026-10-07T14:48:33.430Z","projectInsights":{"version":1,"whatItDoes":{"text":"Disposable email inboxes for humans and AI agents. Spawn a temporary inbox, wait for the OTP verification code, toss it.","sourceUrl":"https://github.com/mohamed-khairy-5i/tossinbox/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"required","text":"No sign-up, no ads, no browser, no API keys.","sourceUrl":"https://github.com/mohamed-khairy-5i/tossinbox/blob/main/README.md"}],"fingerprint":"44522f01475841e6f83248313353b92a4d09bce4497532640b5b5247d48b11ec","sourceUrl":"https://github.com/mohamed-khairy-5i/tossinbox/blob/main/README.md","checkedAt":"2026-10-07T14:48:33.430Z"},"overviewRepoUpdated":"2026-10-06T12:08:14Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/mohamed-khairy-5i/tossinbox/blob/main/README.md","checkedAt":"2026-10-07T14:48:33.431Z","hash":"44522f01475841e6f83248313353b92a4d09bce4497532640b5b5247d48b11ec","originalBytes":12677,"storedBytes":12677,"truncated":false},"lastDemoCheckedAt":"2026-10-07T14:48:33.277Z","subjects":["Automation & workflows","MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Automation & workflows","MCP servers & agents"],"evidence":[{"subject":"Automation & workflows","source":"metadata","match":"automation"},{"subject":"MCP servers & agents","source":"metadata","match":"MCP"}],"platformEvidence":[],"platformSuppor