{"availability":"available","full":"alexkroman/tiny-audio","name":"tiny-audio","description":"A speech-to-text system you can train for $25. A frozen speech encoder and a Qwen LLM joined by a small trained projector, with word timestamps, speaker diarization, a batched HTTP server, a live demo, and a free course.","category":"Developer tools","language":"Python","stars":173,"forks":18,"created":"2025-10-14T02:20:00Z","updated":"2026-10-18T07:02:32Z","license":"MIT","branch":"main","homepage":"https://huggingface.co/spaces/mazesmazes/tiny-audio","topics":["asr","audio-llm","forced-alignment","huggingface","llm","lora","multimodal","pipecat","pytorch","qwen","runpod","speaker-diarization","speech-llm","speech-recognition","speech-to-text","transformers","turn-detection","tutorial","voice-ai","word-timestamps"],"demo":"https://huggingface.co/spaces/mazesmazes/tiny-audio","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T22:45:25.255Z","lastAttemptAt":"2026-10-18T22:45:25.255Z","lastAvailableAt":"2026-10-18T22:45:25.255Z","lastDemoCheckedAt":"2026-10-18T22:45:25.255Z","discoveredVia":[],"metrics":[{"at":"2026-10-09T23:11:53.663Z","stars":153,"forks":16},{"at":"2026-10-11T19:51:34.217Z","stars":166,"forks":17},{"at":"2026-10-17T21:14:54.072Z","stars":173,"forks":18},{"at":"2026-10-18T22:45:25.255Z","stars":173,"forks":18}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Build a speech-to-text LLM from scratch, and train it on one GPU.","tiny-audio is to speech what nanoGPT is to text: a small, readable, hackable speech LLM (a pretrained audio encoder, a tiny MLP projector, and an open-source LLM decoder) plus a course that teaches you to build, train, evaluate, and ship it yourself. The model trained with this repo's default recipe gets 1.8% WER on LibriSpeech test-clean while training only 80M parameters.","It is deliberately simple. For production speech recognition, use a mature toolkit or a hosted API. This repo is for understanding how the pieces fit, and for running cheap experiments of your own."],"features":[],"sourceUrl":"https://github.com/alexkroman/tiny-audio/blob/main/README.md","fingerprint":"b5a171fb18bbc9fe23684734b834ea846aaea511eab88904c5375db5285e3a78","extractedAt":"2026-10-18T22:45:25.373Z"},"overviewCheckedAt":"2026-10-18T22:45:25.373Z","projectInsights":{"version":1,"whatItDoes":{"text":"Build a speech-to-text LLM from scratch, and train it on one GPU.","sourceUrl":"https://github.com/alexkroman/tiny-audio/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"b5a171fb18bbc9fe23684734b834ea846aaea511eab88904c5375db5285e3a78","sourceUrl":"https://github.com/alexkroman/tiny-audio/blob/main/README.md","checkedAt":"2026-10-18T22:45:25.373Z"},"overviewRepoUpdated":"2026-10-18T07:02:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/alexkroman/tiny-audio/blob/main/README.md","checkedAt":"2026-10-18T22:45:25.374Z","hash":"b5a171fb18bbc9fe23684734b834ea846aaea511eab88904c5375db5285e3a78","originalBytes":13677,"storedBytes":13677,"truncated":false},"enrichmentAttemptAt":"2026-10-09T22:07:02.941Z","latestRelease":null,"releaseCheckedAt":"2026-10-09T22:07:02.941Z","screenshots":[{"src":"previews/70170010d05bfd7ae527b96d.jpg","kind":"demo","capturedAt":"2026-10-18T23:05:38.060Z","url":"https://huggingface.co/spaces/mazesmazes/tiny-audio"}],"subjects":["Image, audio & video AI"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Image, audio & video AI"],"evidence":[{"subject":"Image, audio & video AI","source":"metadata","match":"speech to text"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Streaming"],"reviewRequired":true},"demoHealth":{"url":"https://huggingface.co/spaces/mazesmazes/tiny-audio","attemptedAt":"2026-10-18T23:05:38.060Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T23:05:38.060Z","lastWo