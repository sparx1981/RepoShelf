{"repositoryId":1423541088,"availability":"available","full":"lleoparden/WAQI-QR","name":"WAQI-QR","description":"WAQI QR awareness campaign: QR tracking, scam simulation, and admin dashboard","category":"Developer tools","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-17T16:47:48Z","updated":"2026-10-17T17:35:29Z","branch":"main","homepage":"https://lleoparden.github.io/WAQI-QR/","topics":["anti-scam","egypt","github-pages","qr-code","supabase"],"demo":"https://lleoparden.github.io/WAQI-QR/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-17T22:41:04.504Z","lastAttemptAt":"2026-10-17T22:41:04.504Z","lastAvailableAt":"2026-10-17T22:41:04.504Z","metrics":[{"at":"2026-10-17T22:41:04.504Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A free, always-online QR scan tracker and anti-scam awareness experience for WAQI, a student project fighting scams in Egypt.","The public page reads like a normal website. It shows a visitor what any site can learn from their browser, turns that profile into simulated scam messages, runs a short “spot the scam” game, and explains what actually protects them. The admin console creates QR codes, tracks human scans, compares A/B variants, and exports print-ready assets.","The flow is: QR → /?src= → web/index.html redirects to /landing/?src= while preserving the query string."],"features":["Supabase free project — Postgres, RLS, RPCs, one admin user","GitHub Pages — static frontend, no build step","GitHub Actions — deploy and keep-alive","CDN — three pinned MIT libraries, no build tooling"],"sourceUrl":"https://github.com/lleoparden/WAQI-QR/blob/main/README.md","fingerprint":"1a9b1a08fab0e5f3bf9d77ac38093d8868b72dd791e1fa86b4e8497157896575","extractedAt":"2026-10-17T22:41:04.583Z"},"overviewCheckedAt":"2026-10-17T22:41:04.583Z","projectInsights":{"version":1,"whatItDoes":{"text":"A free, always-online QR scan tracker and anti-scam awareness experience for WAQI, a student project fighting scams in Egypt.","sourceUrl":"https://github.com/lleoparden/WAQI-QR/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"This is important: the public must not be able to create an account.","sourceUrl":"https://github.com/lleoparden/WAQI-QR/blob/main/README.md"},{"kind":"account","status":"required","text":"That is the dashboard login.","sourceUrl":"https://github.com/lleoparden/WAQI-QR/blob/main/README.md"}],"fingerprint":"1a9b1a08fab0e5f3bf9d77ac38093d8868b72dd791e1fa86b4e8497157896575","sourceUrl":"https://github.com/lleoparden/WAQI-QR/blob/main/README.md","checkedAt":"2026-10-17T22:41:04.583Z"},"overviewRepoUpdated":"2026-10-17T17:35:29Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/lleoparden/WAQI-QR/blob/main/README.md","checkedAt":"2026-10-17T22:41:04.585Z","hash":"1a9b1a08fab0e5f3bf9d77ac38093d8868b72dd791e1fa86b4e8497157896575","originalBytes":18290,"storedBytes":18290,"truncated":false},"lastDemoCheckedAt":"2026-10-17T22:41:04.504Z","subjects":["Simulation & physics","Templates & UI components","Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Simulation & physics","Templates & UI components","Data & dashboards"],"evidence":[{"subject":"Simulation & physics","source":"metadata","match":"simulation"},{"subject":"Templates & UI components","source":"metadata","match":"admin dashboard"},{"subject":"Data & dashboards","source":"metadata","match":"dashboard"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Games & game development","Automation & workflows","Android","Apple","Mobile","3D & graphics","Privacy & security"],"reviewRequired":true},"demoHealth":{"url":"https://lleoparden.github.io/WAQI-QR/","attemptedAt":"2026-10-17T22:54:57.158Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T22:54:57.158Z","lastWorkingAt":