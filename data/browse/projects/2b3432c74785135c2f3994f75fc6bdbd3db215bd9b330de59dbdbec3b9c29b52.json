-Dev/stain-normalization-project/blob/main/README.md","fingerprint":"7d20d117f9f2fced2928ff04b3bcf024b0278bb19b392c6f33b2f63a660e8388","extractedAt":"2026-10-17T02:59:44.025Z"},"overviewCheckedAt":"2026-10-17T02:59:44.025Z","projectInsights":{"version":1,"whatItDoes":{"text":"▶️ Live demo: stain-normalization-pro.streamlit.app","sourceUrl":"https://github.com/Steph-The-Dev/stain-normalization-project/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"7d20d117f9f2fced2928ff04b3bcf024b0278bb19b392c6f33b2f63a660e8388","sourceUrl":"https://github.com/Steph-The-Dev/stain-normalization-project/blob/main/README.md","checkedAt":"2026-10-17T02:59:44.026Z"},"overviewRepoUpdated":"2026-10-15T07:48:12Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Steph-The-Dev/stain-normalization-project/blob/main/README.md","checkedAt":"2026-10-17T02:59:44.027Z","hash":"7d20d117f9f2fced2928ff04b3bcf024b0278bb19b392c6f33b2f63a660e8388","originalBytes":9185,"storedBytes":9185,"truncated":false},"lastDemoCheckedAt":"2026-10-17T02:59:43.847Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows","Science","Image, audio & video AI","Portfolios & personal sites"],"reviewRequired":true},"demoHealth":{"url":"https://stain-normalization-pro.streamlit.app/","attemptedAt":"2026-10-17T03:13:58.697Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T03:13:58.697Z","lastWorkingAt":"2026-10-17T03:13:58.697Z","target":"https://stain-normalization-pro.streamlit.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T03:13:58.697Z"},"previewAttemptAt":"2026-10-17T03:13:58.697Z","previewCheck":{"url":"https://stain-normalization-pro.streamlit.app/","attemptedAt":"2026-10-17T03:13:58.697Z","consecutiveFailures":0,"s