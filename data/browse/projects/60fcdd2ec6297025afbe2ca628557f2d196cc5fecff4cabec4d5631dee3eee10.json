{"availability":"available","full":"efstajas/svelte-stepper","name":"svelte-stepper","description":"🚶 A simple library for building delightfully animated stepped flows with Svelte.","category":"Design","language":"Svelte","stars":179,"forks":5,"created":"2023-04-13T13:13:10Z","updated":"2025-09-22T13:03:20Z","branch":"main","homepage":"https://svelte-stepper.jason-e.dev","topics":["animations","component","stepper","svelte","sveltekit"],"demo":"https://svelte-stepper.jason-e.dev/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-17T07:08:43.256Z","lastAttemptAt":"2026-10-17T07:08:43.256Z","lastAvailableAt":"2026-10-17T07:08:43.256Z","lastDemoCheckedAt":"2026-10-17T07:08:43.256Z","discoveredVia":[{"kind":"curated-list","name":"Awesome Svelte","url":"https://github.com/TheComputerM/awesome-svelte"}],"metrics":[{"at":"2026-10-08T20:06:34.006Z","stars":179,"forks":5},{"at":"2026-10-10T23:15:42.771Z","stars":179,"forks":5},{"at":"2026-10-12T13:32:54.058Z","stars":179,"forks":5},{"at":"2026-10-17T07:08:43.256Z","stars":179,"forks":5}],"technologies":["Svelte"],"overview":{"kind":"readme","version":1,"paragraphs":["A simple library for building delightfully animated stepped flows with Svelte. Svelte Stepper is completely \"headless\", meaning it steps through whatever components you give it, putting you in full control of container- and step layout, styles and transitions."],"features":["Svelte Stepper comes with a lot of built-in functionality, while still remaining easy-to-use at its core.","Svelte Stepper is written entirely in TypeScript, and all its interfaces are fully type-safe out of the box. To get started, all you need to do is provide a sequence of Svelte components as steps. Every step can receive…","Svelte Stepper automatically transitions steps in a delightful way, and even smoothly adjusts its height to match each new step component. Of course, you can fully customize all animations.","Svelte Stepper includes a full context API, which allows you to share data between steps. This enables advanced usecases like building up form data over several steps, and submitting it at the end."],"sourceUrl":"https://github.com/efstajas/svelte-stepper/blob/main/README.md","fingerprint":"caabf426da0b786a5824fd97369cce45ff508783870234b6bbb62e7f398df947","extractedAt":"2026-10-08T20:06:34.006Z"},"overviewCheckedAt":"2026-10-17T07:08:43.256Z","projectInsights":{"version":1,"whatItDoes":{"text":"A simple library for building delightfully animated stepped flows with Svelte. Svelte Stepper is completely \"headless\", meaning it steps through whatever components you give it, putting you in full control of container- and step layout, styles and transitions.","sourceUrl":"https://github.com/efstajas/svelte-stepper/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"caabf426da0b786a5824fd97369cce45ff508783870234b6bbb62e7f398df947","sourceUrl":"https://github.com/efstajas/svelte-stepper/blob/main/README.md","checkedAt":"2026-10-17T07:08:43.256Z"},"overviewRepoUpdated":"2025-09-22T13:03:20Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/efstajas/svelte-stepper/blob/main/README.md","checkedAt":"2026-10-17T07:08:43.256Z","hash":"caabf426da0b786a5824fd97369cce45ff508783870234b6bbb62e7f398df947","originalBytes":9497,"storedBytes":9497,"truncated":false},"subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion"],"reviewRequired":true},"demoHealth":{"url":"https://svelte-stepper.jason-e.dev/","attemptedAt":"2026-10-15T21:59:16.345Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T21:59:16.345Z","lastWorkingAt":"2026-10-15T21:59:16.345Z","target":"https://svelte-stepper.jason-e.dev/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-22T21:59:16.345Z"},"previewAttemptAt":"2