{"availability":"available","full":"YanTianlong-01/VoiceGate","name":"VoiceGate","description":"VoiceGate：跨语言视频智能配音引擎 ","category":"Other","language":null,"stars":19,"forks":4,"created":"2026-06-04T02:32:32Z","updated":"2026-07-09T02:49:10Z","branch":"main","homepage":"","topics":[],"demo":"https://voicegate.netlify.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-17T19:54:19.671Z","lastAttemptAt":"2026-10-17T19:54:19.671Z","lastAvailableAt":"2026-10-17T19:54:19.671Z","lastDemoCheckedAt":"2026-10-11T11:06:15.007Z","metrics":[{"at":"2026-10-03T21:18:38.993Z","stars":17,"forks":4},{"at":"2026-10-04T08:16:48.466Z","stars":17,"forks":4},{"at":"2026-10-06T15:44:48.595Z","stars":18,"forks":4},{"at":"2026-10-08T16:04:34.351Z","stars":18,"forks":4},{"at":"2026-10-11T11:06:14.598Z","stars":18,"forks":4},{"at":"2026-10-15T18:05:05.262Z","stars":18,"forks":4},{"at":"2026-10-17T19:54:19.671Z","stars":19,"forks":4}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A cross-language video translation & dubbing pipeline powered by VoxCPM2 and ComfyUI","VoiceGate is a cross-language video dubbing engine built on VoxCPM2 and ComfyUI. VoxCPM2 supports 30 languages (including 8 Southeast Asian languages) and 9 Chinese dialects (Cantonese, Sichuanese, Wu, Northeastern, Hokkien, etc.), with voice cloning and timbre design capabilities. The engine achieves frame-level alignment between TTS audio and SRT subtitle timestamps via the custom-built VoiceBridge plugin, ensuring dubbing stays perfectly in sync with the video.","The complete pipeline covers ASR subtitle extraction, LLM translation, multilingual TTS, and synchronized audio merging — all visually orchestrated as a drag-and-drop node graph, ready to use out of the box."],"features":["Content Going Global — One-click dubbing of Chinese educational/knowledge videos into English, Japanese, Korean, etc., for publishing on YouTube/TikTok","Content Importing — Dubbing overseas YouTube/Bilibili content into Chinese or regional dialects for the domestic market","Multilingual Localization — Producing multi-language versions of documentaries, museum guides, and educational materials"],"sourceUrl":"https://github.com/YanTianlong-01/VoiceGate/blob/main/README.md","fingerprint":"9cb284e0113c11fa2e4e90521a473c7011337d48adf6f93813eaf43decdb3d68","extractedAt":"2026-10-03T05:59:45.015Z"},"overviewCheckedAt":"2026-10-11T11:06:15.005Z","overviewRepoUpdated":"2026-07-09T02:49:10Z","projectInsights":{"version":1,"whatItDoes":{"text":"A cross-language video translation & dubbing pipeline powered by VoxCPM2 and ComfyUI","sourceUrl":"https://github.com/YanTianlong-01/VoiceGate/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"required","text":"Configure the OpenAI-compatible API URL, model name, and API key in the LLM node; upload the source audio and reference audio; then queue the workflow.","sourceUrl":"https://github.com/YanTianlong-01/VoiceGate/blob/main/README.md"}],"fingerprint":"9cb284e0113c11fa2e4e90521a473c7011337d48adf6f93813eaf43decdb3d68","sourceUrl":"https://github.com/YanTianlong-01/VoiceGate/blob/main/README.md","checkedAt":"2026-10-11T11:06:15.005Z"},"overviewAttemptAt":"2026-10-04T08:13:23.792Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/YanTianlong-01/VoiceGate/blob/main/README.md","checkedAt":"2026-10-11T11:06:15.006Z","hash":"9cb284e0113c11fa2e4e90521a473c7011337d48adf6f93813eaf43decdb3d68","originalBytes":7110,"storedBytes":7110,"truncated":false},"qualityPriority":false,"enrichmentAttemptAt":"2026-10-04T17:02:52.387Z","latestRelease":null,"releaseCheckedAt":"2026-10-04T17:02:52.387Z","screenshots":[{"src":"previews/33056d46e6b2b8a855c6c736.jpg","kind":"demo","capturedAt":"2026-10-17T20:10:56.547Z","url":"https://voicegate.netlify.app/"}],"demoHealth":{"url":"https://voicegate.netlify.app/","attemptedAt":"2026-10-17T20:10:56.547Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T