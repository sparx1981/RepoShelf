{"availability":"available","full":"pranshhu/openMeet","name":"openMeet","description":"Explore this public GitHub project.","category":"Other","language":"TypeScript","stars":0,"forks":0,"created":"2026-09-18T09:53:09Z","updated":"2026-10-16T11:16:44Z","license":"MIT","branch":"main","homepage":null,"topics":[],"demo":"https://openmeet.pages.dev/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-16T17:58:55.522Z","lastAttemptAt":"2026-10-16T17:58:55.522Z","lastAvailableAt":"2026-10-16T17:58:55.522Z","metrics":[{"at":"2026-10-10T19:04:08.730Z","stars":0,"forks":0},{"at":"2026-10-16T17:58:55.522Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Studio-quality remote recording that never uploads your footage.","Each person's camera and microphone are recorded locally at full quality and streamed peer-to-peer to the host's own disk. No media server, no cloud bucket, no upload step, no storage bill — the recording exists on the host's machine and nowhere else. Self-hostable on a free Cloudflare account. MIT licensed.","Requires a Chromium browser — Chrome, Edge, Arc or Opera on desktop (Brave works as host only after enabling brave://flags/#file-system-access-api). The host needs the File System Access API to write files, and every recorded participant needs MediaRecorder MP4 support. Firefox can do neither, so a Firefox guest joins the call but isn't recorded. Safari can't host; a Safari guest is recorded as video only (no uncompressed WAV), which is untested. Phones present a photo/video or the rear camera; a real screen comes from a second device joined with \"Present only\"."],"features":[],"sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md","fingerprint":"2a2c64813d108da2492e07570cd505a94416ae7456a6d6eb67bc02ea44bc5829","extractedAt":"2026-10-10T19:04:08.845Z"},"overviewCheckedAt":"2026-10-10T19:04:08.845Z","projectInsights":{"version":1,"whatItDoes":{"text":"Studio-quality remote recording that never uploads your footage.","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md"},"audience":[],"requirements":[{"kind":"hosting","status":"documented","text":"Try it at before you self-host.","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md"},{"kind":"account","status":"required","text":"All you need is a Cloudflare account — the free tier covers it — plus git, Node ≥ 20.11 and pnpm.","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md"},{"kind":"account","status":"required","text":"If your Cloudflare login can see more than one account, name the one to use:","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md"},{"kind":"hosting","status":"documented","text":"…or bring your own, which removes the last metered dependency — see Self-hosted TURN below.","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md"}],"fingerprint":"2a2c64813d108da2492e07570cd505a94416ae7456a6d6eb67bc02ea44bc5829","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md","checkedAt":"2026-10-10T19:04:08.846Z"},"overviewRepoUpdated":"2026-10-10T16:01:48Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/pranshhu/openMeet/blob/main/README.md","checkedAt":"2026-10-10T19:04:08.848Z","hash":"2a2c64813d108da2492e07570cd505a94416ae7456a6d6eb67bc02ea44bc5829","originalBytes":31851,"storedBytes":31851,"truncated":false},"lastDemoCheckedAt":"2026-10-10T19:04:08.730Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Streaming","Self-hosted apps"],"reviewRequired":true},"demoHealth":{"url":"https://openmeet.pages.dev/","attemptedAt":"2026-10-16T18:25:12.120Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T18:25:12.120Z","lastWorkingAt":"2026-10-16T18:25:12.120Z","target":"https: