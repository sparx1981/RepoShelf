{"repositoryId":1283746683,"availability":"available","full":"M-Ahsan-1/Safarnama","name":"Safarnama","description":"Explore this public GitHub project.","category":"Design","language":"JavaScript","stars":0,"forks":0,"created":"2026-06-29T07:45:43Z","updated":"2026-07-19T10:10:42Z","branch":"main","homepage":"https://safarnama-pak.vercel.app","topics":["css","firebase","html","javascript","pakistan","pwa","travel"],"demo":"https://safarnama-pak.vercel.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-15T21:46:23.486Z","lastAttemptAt":"2026-10-15T21:46:23.486Z","lastAvailableAt":"2026-10-15T21:46:23.486Z","metrics":[{"at":"2026-10-15T21:46:23.486Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Discover the breathtaking valleys of Northern Pakistan","An interactive travel companion for Hunza, Skardu, Swat, Naran Kaghan, Fairy Meadows, Murree/Nathiagali & more — with live weather, an AI trip planner, route planning, hotel reviews, and offline support.","Safarnama (\"travelogue\" in Urdu) is a travel discovery site for the northern regions of Pakistan. It combines a curated destination directory with live, useful tools — weather, routes, nearby services, budget planning, and community reviews — so travelers can plan a trip end-to-end without juggling ten different apps."],"features":["Interactive Map (Leaflet.js) — every destination pinned, color-coded by budget (Low/Medium/High), filterable by region (KPK, Gilgit-Baltistan, AJK, Northern Pakistan).","Destination Pages — dedicated page per place with attractions, hotels, weather, and reviews.","Nearby Services — geolocation-powered search (via OpenStreetMap/Overpass, with multiple mirror fallbacks) for petrol pumps, hospitals & pharmacies, ATMs, police stations, and food spots near any destination.","AI-Assisted Route Planner — pick a starting city, destination, and transport mode to get a complete route with stops, distance, and weather.","Trip Plan Maker — auto-picks the best-matching itinerary tier (Budget/Mid/Premium) based on your days, group size, and budget range, with a full day-by-day breakdown, tips, and hotel suggestion. Exportable as PDF or PNG…"],"sourceUrl":"https://github.com/M-Ahsan-1/Safarnama/blob/main/README.md","fingerprint":"7f6723711aacee44129ab953ea15f9d6839ad6a3f2b3ea75a63c73d47f9a6411","extractedAt":"2026-10-15T21:46:23.600Z"},"overviewCheckedAt":"2026-10-15T21:46:23.600Z","projectInsights":{"version":1,"whatItDoes":{"text":"Discover the breathtaking valleys of Northern Pakistan","sourceUrl":"https://github.com/M-Ahsan-1/Safarnama/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"EmailJS — create a free account, add a service + template, and update the public key/service ID/template ID in suggestions.js and feedback.js.","sourceUrl":"https://github.com/M-Ahsan-1/Safarnama/blob/main/README.md"},{"kind":"api_key","status":"not_required","text":"Open-Meteo — free, no API key required","sourceUrl":"https://github.com/M-Ahsan-1/Safarnama/blob/main/README.md"}],"fingerprint":"7f6723711aacee44129ab953ea15f9d6839ad6a3f2b3ea75a63c73d47f9a6411","sourceUrl":"https://github.com/M-Ahsan-1/Safarnama/blob/main/README.md","checkedAt":"2026-10-15T21:46:23.600Z"},"overviewRepoUpdated":"2026-07-19T10:10:42Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/M-Ahsan-1/Safarnama/blob/main/README.md","checkedAt":"2026-10-15T21:46:23.601Z","hash":"7f6723711aacee44129ab953ea15f9d6839ad6a3f2b3ea75a63c73d47f9a6411","originalBytes":7628,"storedBytes":7628,"truncated":false,"searchTerms":["reviews","destination","budget","hotel","trip","weather","emailjs","firestore","live","api","feedback","firebase","offline","route","app","open-meteo","overpass","per","place","png","safarnama","service","suggestions","travel","alerts","attraction","best","community","custom","emergency","free","icons","info","interactive","manifest","nearby","northern","open