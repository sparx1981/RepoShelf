{"availability":"available","full":"zoriya/Kyoo","name":"Kyoo","description":"A portable and vast media library solution.","category":"Developer tools","language":"TypeScript","stars":2542,"forks":82,"created":"2019-08-04T00:12:27Z","updated":"2026-10-19T11:06:52Z","license":"GPL-3.0","branch":"master","homepage":"https://kyoo.zoriya.dev","topics":["docker","ffmpeg","golang","jellyfin","mediabrowser","netflix","next","plex","python","react-native","self-hosted"],"demo":"https://kyoo.zoriya.dev/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-19T15:55:28.429Z","lastAttemptAt":"2026-10-19T15:55:28.429Z","lastAvailableAt":"2026-10-19T15:55:28.429Z","metrics":[{"at":"2026-10-04T08:15:53.768Z","stars":2529,"forks":78},{"at":"2026-10-05T21:32:09.096Z","stars":2529,"forks":79},{"at":"2026-10-07T23:28:56.845Z","stars":2531,"forks":79},{"at":"2026-10-08T16:05:57.527Z","stars":2531,"forks":79},{"at":"2026-10-09T23:11:25.896Z","stars":2532,"forks":79},{"at":"2026-10-11T04:25:50.874Z","stars":2535,"forks":79},{"at":"2026-10-15T17:01:08.638Z","stars":2539,"forks":80},{"at":"2026-10-19T15:55:28.429Z","stars":2542,"forks":82}],"technologies":["React","Next.js","Python","Go"],"overview":{"kind":"readme","version":1,"paragraphs":["Kyoo is a self-hosted media server focused on video content (Movies, Series & Anime). It is an alternative to Jellyfin or Plex.","It aims to have a low amount of maintenance needed (no folder structure required nor manual metadata edits). Media not being scanned correctly (even with weird names) is considered a bug.","Kyoo does not have a plugin system and aim to have every features built-in (see #Features for the list)."],"features":["Dynamic Transcoding: Transcode to any quality, support ABR (automatic quality switching based on network), even with original quality.","No folder structure: Kyoo is there to help you manage your medias, we do not require you to already have a well organized media library. Bad naming, everything in the same directory, weird anime names, everything works…","Video Preview Thumbnails: Simply hover the video's progress bar and see a preview of the video.","Vlc backed player: On android (and android tv soon), we use VLC to support as many codecs as possible (you can use exoplayer if you want to too).","Intro/Credit detection: Automatically detect intro/credits with audio fingerprinting (or chapter title matching)."],"sourceUrl":"https://github.com/zoriya/Kyoo/blob/master/README.md","fingerprint":"8171599cc56d99eeda81752c3394f42f599cccfa454c7b5258f4c76982faaad1","extractedAt":"2026-10-04T06:11:54.814Z"},"overviewCheckedAt":"2026-10-15T17:01:08.726Z","projectInsights":{"version":1,"whatItDoes":{"text":"Kyoo is a self-hosted media server focused on video content (Movies, Series & Anime). It is an alternative to Jellyfin or Plex.","sourceUrl":"https://github.com/zoriya/Kyoo/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"8171599cc56d99eeda81752c3394f42f599cccfa454c7b5258f4c76982faaad1","sourceUrl":"https://github.com/zoriya/Kyoo/blob/master/README.md","checkedAt":"2026-10-15T17:01:08.727Z"},"overviewRepoUpdated":"2026-10-14T11:26:55Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/zoriya/Kyoo/blob/master/README.md","checkedAt":"2026-10-15T17:01:08.727Z","hash":"8171599cc56d99eeda81752c3394f42f599cccfa454c7b5258f4c76982faaad1","originalBytes":5278,"storedBytes":5278,"truncated":false},"lastDemoCheckedAt":"2026-10-15T17:01:08.638Z","enrichmentAttemptAt":"2026-10-04T06:12:46.577Z","latestRelease":{"name":"v5.2.1","tag":"v5.2.1","publishedAt":"2026-08-27T23:35:27Z","url":"https://github.com/zoriya/Kyoo/releases/tag/v5.2.1"},"releaseCheckedAt":"2026-10-04T06:12:46.577Z","screenshots":[{"src":"previews/a2750b3755c2798ece2b7b50.jpg","kind":"demo","capturedAt":"2026-10-19T16:14:36.864Z","url":"https://kyoo.zoriya.dev/"}],"demoHealth":{"url":"https://kyoo.zoriya.dev/","attemptedAt":"2026-10-19T16:14:36.864Z","status":"working","checkedAt