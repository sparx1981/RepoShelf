{"repositoryId":639902873,"availability":"available","full":"siemens/wfx","name":"wfx","description":"a lightweight, general-purpose workflow executor","category":"Other","language":"Go","stars":73,"forks":12,"created":"2023-05-12T13:41:19Z","updated":"2026-10-19T12:41:43Z","license":"Apache-2.0","branch":"main","homepage":"https://siemens.github.io/wfx/","topics":["firmware-update","ota","ota-update","software-update","swupdate","wfx","workflow","workflow-engine"],"demo":"https://siemens.github.io/wfx/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-19T18:05:47.213Z","lastAttemptAt":"2026-10-19T18:05:47.213Z","lastAvailableAt":"2026-10-19T18:05:47.213Z","metrics":[{"at":"2026-10-19T18:05:47.213Z","stars":73,"forks":12}],"technologies":["Go"],"overview":{"kind":"readme","version":1,"paragraphs":["A lightweight, general-purpose workflow executor.","Workflows are modeled as finite-state machines and are instantiated as Jobs through which the wfx and a client progress in lock-step to perform a task. Such a task could be software updating the client, progressing a work item through Kanban, … in essence anything requiring cooperation and coordination.","As being general purpose, wfx is only concerned with driving the (state) machinery, the specific actions a client should perform are encoded in the client implementation(s). Hence, one wfx instance can drive a multitude of wholly different workflows. Instantiating a workflow as a job augments it with additional metadata, the Job Definition, which contains job-specific information such as, e.g., URLs or other data the client (implementation) can make use of for this particular job."],"features":["Compact, scalable core focusing on the essentials","Proper interfaces to external systems for modularity and integrability:","Extendable modularized source code architecture","Lightweight, no dependencies (statically linked binaries)","Efficient, native code for a wide variety of platforms and operating systems (as supported by the Go Language)"],"sourceUrl":"https://github.com/siemens/wfx/blob/main/README.md","fingerprint":"0d2d266703617529c5fbc41e9412e0c03077d3b1f293596fdebedfeb284863f7","extractedAt":"2026-10-19T18:05:47.327Z"},"overviewCheckedAt":"2026-10-19T18:05:47.327Z","projectInsights":{"version":1,"whatItDoes":{"text":"A lightweight, general-purpose workflow executor.","sourceUrl":"https://github.com/siemens/wfx/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"0d2d266703617529c5fbc41e9412e0c03077d3b1f293596fdebedfeb284863f7","sourceUrl":"https://github.com/siemens/wfx/blob/main/README.md","checkedAt":"2026-10-19T18:05:47.327Z"},"overviewRepoUpdated":"2026-10-19T12:41:43Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/siemens/wfx/blob/main/README.md","checkedAt":"2026-10-19T18:05:47.328Z","hash":"0d2d266703617529c5fbc41e9412e0c03077d3b1f293596fdebedfeb284863f7","originalBytes":7048,"storedBytes":7048,"truncated":false},"lastDemoCheckedAt":"2026-10-19T18:05:47.213Z","enrichmentAttemptAt":"2026-10-19T18:06:08.718Z","latestRelease":{"name":"v0.7.0","tag":"v0.7.0","publishedAt":"2026-09-15T14:51:07Z","url":"https://github.com/siemens/wfx/releases/tag/v0.7.0"},"releaseCheckedAt":"2026-10-19T18:06:08.718Z","screenshots":[{"src":"previews/02161adfd12ff95811cbbad4.jpg","kind":"demo","capturedAt":"2026-10-19T18:20:00.477Z","url":"https://siemens.github.io/wfx/"}],"subjects":["Automation & workflows"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Automation & workflows"],"evidence":[{"subject":"Automation & workflows","source":"metadata","match":"workflow"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automotive"],"reviewRequired":true},"demoHealth":{"url":"https://siemens.github.io/wfx/","attemptedAt":"2026-10-19T18:20:00.477Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T18:20:00.477Z","lastWorkingAt":"20