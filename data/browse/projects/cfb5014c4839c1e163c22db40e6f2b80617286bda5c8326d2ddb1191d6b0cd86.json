{"availability":"available","full":"MapleQuery/maple-query","name":"maple-query","description":"MapleQuery ingests open government data into a datawarehouse so an humans or an LLM agent can answer natural-language questions with cited sources","category":"AI & machine learning","language":"Python","stars":1,"forks":0,"created":"2026-05-24T21:58:20Z","updated":"2026-10-10T06:11:51Z","branch":"main","homepage":"https://maple-query.vercel.app","topics":[],"demo":"https://maple-query.vercel.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-11T20:52:33.339Z","lastAttemptAt":"2026-10-11T20:52:33.339Z","lastAvailableAt":"2026-10-11T20:52:33.339Z","metrics":[{"at":"2026-10-08T23:42:55.779Z","stars":1,"forks":0},{"at":"2026-10-11T20:52:33.339Z","stars":1,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Ask hard questions about Canada; get answers you can cite.","MapleQuery is an LLM research agent over Canadian public data. Ask in plain language (\"How much has rent gone up since 2020?\", \"How did each party vote on Bill C-4?\", \"How much did Canada give to Ukraine last year?\") and it finds the right official source, reads the actual numbers, does the arithmetic exactly, and answers with a link to every table, record or vote it used. A live evidence panel shows each step."],"features":[],"sourceUrl":"https://github.com/MapleQuery/maple-query/blob/main/README.md","fingerprint":"1d4703ff08163a212c90567513d429e8b3186ac8d33bc394b6cbf33a9eb68c80","extractedAt":"2026-10-08T23:42:55.932Z"},"overviewCheckedAt":"2026-10-08T23:42:55.932Z","projectInsights":{"version":1,"whatItDoes":{"text":"Ask hard questions about Canada; get answers you can cite.","sourceUrl":"https://github.com/MapleQuery/maple-query/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"1d4703ff08163a212c90567513d429e8b3186ac8d33bc394b6cbf33a9eb68c80","sourceUrl":"https://github.com/MapleQuery/maple-query/blob/main/README.md","checkedAt":"