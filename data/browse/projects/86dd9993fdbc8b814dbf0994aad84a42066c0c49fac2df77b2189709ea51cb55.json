{"availability":"available","full":"jacob-booth/flag-status-monitor","name":"flag-status-monitor","description":"Real-time U.S. flag status PWA: full-staff vs half-staff, 50-state coverage, history, and offline support.","category":"Other","language":"JavaScript","stars":1,"forks":0,"created":"2025-01-31T19:46:28Z","updated":"2026-10-16T22:59:58Z","license":"MIT","branch":"main","homepage":"https://jacob-booth.github.io/flag-status-monitor/","topics":["civic-tech","github-pages","javascript","pwa","united-states","vite"],"demo":"https://jacob-booth.github.io/flag-status-monitor/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-16T23:50:11.943Z","lastAttemptAt":"2026-10-16T23:50:11.943Z","lastAvailableAt":"2026-10-16T23:50:11.943Z","metrics":[{"at":"2026-10-05T19:23:07.832Z","stars":1,"forks":0},{"at":"2026-10-07T20:13:40.549Z","stars":1,"forks":0},{"at":"2026-10-08T18:25:56.904Z","stars":1,"forks":0},{"at":"2026-10-11T14:52:42.444Z","stars":1,"forks":0},{"at":"2026-10-12T02:04:50.000Z","stars":1,"forks":0},{"at":"2026-10-16T23:50:11.943Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A real-time, installable PWA that tracks whether the U.S. flag is at full-staff or half-staff — with live history, federal-holiday context, offline support, and zero backend infrastructure to run.","The U.S. flag is flown at half-staff on specific, often unannounced occasions — to mark a presidential proclamation, a national tragedy, or a memorial observance. Flag Status Monitor answers \"is it at half-staff right now?\" at a glance, then goes further: it explains why, surfaces the relevant section of the U.S. Flag Code, tracks history over time, and works offline once installed.","It's built as a fully static site — no server to provision, no database to manage — yet behaves like a real product: multi-source verification, visible data freshness, automatic deployments, status-change notifications while the app is open, keyboard shortcuts, and an accessible UI in both light and dark mode."],"features":[],"sourceUrl":"https://github.com/jacob-booth/flag-status-monitor/blob/main/README.md","fingerprint":"89e70786b6c4698225dbc0999bda6cf0570c21f481a32ee7623a5538eee2234c","extractedAt":"2026-10-05T19:23:07.986Z"},"overviewCheckedAt":"2026-10-16T23:50:12.024Z","projectInsights":{"version":1,"whatItDoes":{"text":"A real-time, installable PWA that tracks whether the U.S. flag is at full-staff or half-staff — with live history, federal-holiday context, offline support, and zero backend infrastructure to run.","sourceUrl":"https://github.com/jacob-booth/flag-status-monitor/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"89e70786b6c4698225dbc0999bda6cf0570c21f481a32ee7623a5538eee2234c","sourceUrl":"https://github.com/jacob-booth/flag-status-monitor/blob/main/README.md","checkedAt":"2026-10-16T23:50:12.025Z"},"overviewRepoUpdated":"2026-10-16T22:59:58Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/jacob-booth/flag-status-monitor/blob/main/README.md","checkedAt":"2026-10-16T23:50:12.025Z","hash":"89e70786b6c4698225dbc0999bda6cf0570c21f481a32ee7623a5538eee2234c","originalBytes":12707,"storedBytes":12707,"truncated":false},"lastDemoCheckedAt":"2026-10-16T23:50:11.943Z","demoHealth":{"url":"https://jacob-booth.github.io/flag-status-monitor/","attemptedAt":"2026-10-17T00:08:43.435Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T00:08:43.435Z","lastWorkingAt":"2026-10-17T00:08:43.435Z","target":"https://jacob-booth.github.io/flag-status-monitor/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T00:08:43.435Z"},"previewAttemptAt":"2026-10-17T00:08:43.435Z","previewCheck":{"url":"https://jacob-booth.github.io/flag-status-monitor/","attemptedAt":"2026-10-17T00:08:43.435Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-24T00:08:43.435Z"},"screenshots":[{"src":"previews/86dd9993fdbc8b