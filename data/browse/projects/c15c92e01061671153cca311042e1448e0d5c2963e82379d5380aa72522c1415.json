ot authentication."],"features":[],"sourceUrl":"https://github.com/Known-Enough/known-enough/blob/main/README.md","fingerprint":"398b35237b1866038c9c72b5fc24368450870436693d5a96b8ef5c9b3b0a74fe","extractedAt":"2026-10-08T06:39:30.178Z"},"overviewCheckedAt":"2026-10-09T22:06:39.017Z","projectInsights":{"version":1,"whatItDoes":{"text":"Decide together without everyone needing to know everything. Known Enough is an AI-first group-decision facilitator: people describe a shared objective, privately explain what matters, confirm the AI's interpretation, consider proposals and individually approve an exact outcome. A small trust kernel protects identity, consent, supported hard conditions and current approval authority.","sourceUrl":"https://github.com/Known-Enough/known-enough/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Open private owner demo opens a fixed fictional owner, not a login.","sourceUrl":"https://github.com/Known-Enough/known-enough/blob/main/README.md"}],"fingerprint":"398b35237b1866038c9c72b5fc24368450870436693d5a96b8ef5c9b3b0a74fe","sourceUrl":"https://github.com/Known-Enough/known-enough/blob/main/README.md","checkedAt":"2026-10-09T22:06:39.018Z"},"overviewRepoUpdated":"2026-10-09T22:00:12Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Known-Enough/known-enough/blob/main/README.md","checkedAt":"2026-10-09T22:06:39.018Z","hash":"398b35237b1866038c9c72b5fc24368450870436693d5a96b8ef5c9b3b0a74fe","originalBytes":6931,"storedBytes":6931,"truncated":false,"searchTerms":["npm","docs","run","check","current","local","evidence","historical","shared","api","chromium","enough","generic","known","owner","packages","playwright","application","apps","browser","build","commands","contracts","install","private","reviews","task","tests","acceptance","actual","cloud","deal-table","demo","deployment","direction","human","identity","main","node","nvm","pinned","production","public","readm