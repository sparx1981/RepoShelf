o, where it installs like an app","Speaks your language. 50 languages, with your own number and date formats."],"sourceUrl":"https://github.com/gavrilov/calccraft/blob/main/README.md","fingerprint":"1c81a2838b0d967ca307be6d0288b6a44ad09556a9488bbfb6454cc562c10d32","extractedAt":"2026-10-18T22:44:44.170Z"},"overviewCheckedAt":"2026-10-18T22:44:44.170Z","projectInsights":{"version":1,"whatItDoes":{"text":"A free, open-source calculator modeled on the Windows 11 Calculator, for your browser, Windows, macOS, Linux and Android.","sourceUrl":"https://github.com/gavrilov/calccraft/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"MIT licensed, with no ads and no account, and the app collects no data.","sourceUrl":"https://github.com/gavrilov/calccraft/blob/main/README.md"}],"fingerprint":"1c81a2838b0d967ca307be6d0288b6a44ad09556a9488bbfb6454cc562c10d32","sourceUrl":"https://github.com/gavrilov/calccraft/blob/main/README.md","checkedAt":"2026-10-18T22:44:44.170Z"},"overviewRepoUpdated":"2026-10-18T22:27:09Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/gavrilov/calccraft/blob/main/README.md","checkedAt":"2026-10-18T22:44:44.172Z","hash":"1c81a2838b0d967ca307be6d0288b6a44ad09556a9488bbfb6454cc562c10d32","originalBytes":32363,"storedBytes":32363,"truncated":false},"lastDemoCheckedAt":"2026-10-18T22:44:44.097Z","subjects":["Android","Apple","Mobile","Science","Browser extensions & PWAs"],"platforms":["Android","macOS"],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Android","Apple","Mobile","Science","Browser extensions & PWAs"],"evidence":[{"subject":"Android","source":"metadata","match":"android"},{"subject":"Apple","source":"metadata","match":"macos"},{"subject":"Mobile","source":"metadata","match":"android"},{"subject":"Science","source":"metadata","match":"Scientific"},{"subject":"Browser extensions & PWAs","source":"metadata","match":"pwa"}]