{"availability":"available","full":"AI-SDC/ACRO-R","name":"ACRO-R","description":"ACRO R Package: Tools for the Semi-Automatic Checking of Research Outputs. ","category":"Developer tools","language":"R","stars":4,"forks":2,"created":"2023-10-27T12:28:08Z","updated":"2026-10-12T08:55:17Z","license":null,"branch":"main","homepage":"","topics":["data-privacy","data-protection","privacy","privacy-tools","statistical-disclosure-control","statistical-software"],"demo":"https://mybinder.org/v2/gh/AI-SDC/ACRO-R/main?urlpath=rstudio","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-16T13:24:59.356Z","lastAttemptAt":"2026-10-16T13:24:59.356Z","lastAvailableAt":"2026-10-16T13:24:59.356Z","lastDemoCheckedAt":"2026-10-16T13:24:59.356Z","metrics":[{"at":"2026-10-03T21:18:41.313Z","stars":4,"forks":2},{"at":"2026-10-04T08:16:50.809Z","stars":4,"forks":2},{"at":"2026-10-05T18:33:01.438Z","stars":4,"forks":2},{"at":"2026-10-07T18:42:39.102Z","stars":4,"forks":2},{"at":"2026-10-09T19:33:30.107Z","stars":4,"forks":2},{"at":"2026-10-13T06:37:10.041Z","stars":4,"forks":2},{"at":"2026-10-16T13:24:59.356Z","stars":4,"forks":2}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["This repository maintains the ACRO R package, which is an interface to the Python ACRO package.","ACRO is a free and open source tool that supports the semi-automated checking of research outputs (SACRO) for privacy disclosure within secure data environments. SACRO is a framework that applies best-practice principles-based statistical disclosure control (SDC) techniques on-the-fly as researchers conduct their analysis. SACRO is designed to assist human checkers rather than seeking to replace them as with current automated rules-based approaches.","The ACRO package is a lightweight Python tool that sits over well-known analysis tools that produce outputs such as tables, plots, and statistical models. This package adds functionality to:"],"features":["automatically identify potentially disclosive outputs against a range of commonly used disclosure tests;","apply optional disclosure mitigation strategies as requested;","report reasons for applying SDC;","and produce simple summary documents trusted research environment staff can use to streamline their workflow and maintain auditable records."],"sourceUrl":"https://github.com/AI-SDC/ACRO-R/blob/main/README.md","fingerprint":"a8acfea52aed49ab4c387580bb417cf8faeccb908567a782e0e10015691f2c65","extractedAt":"2026-10-03T05:59:51.000Z"},"overviewCheckedAt":"2026-10-16T13:24:59.498Z","overviewRepoUpdated":"2026-10-12T08:55:17Z","projectInsights":{"version":1,"whatItDoes":{"text":"This repository maintains the ACRO R package, which is an interface to the Python ACRO package.","sourceUrl":"https://github.com/AI-SDC/ACRO-R/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"a8acfea52aed49ab4c387580bb417cf8faeccb908567a782e0e10015691f2c65","sourceUrl":"https://github.com/AI-SDC/ACRO-R/blob/main/README.md","checkedAt":"2026-10-16T13:24:59.498Z"},"overviewAttemptAt":"2026-10-12T19:09:39.586Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/AI-SDC/ACRO-R/blob/main/README.md","checkedAt":"2026-10-16T13:24:59.498Z","hash":"a8acfea52aed49ab4c387580bb417cf8faeccb908567a782e0e10015691f2c65","originalBytes":4248,"storedBytes":4248,"truncated":false},"qualityPriority":false,"enrichmentAttemptAt":"2026-10-05T06:37:58.729Z","latestRelease":{"name":"v1.0.0","tag":"v1.0.0","publishedAt":"2026-09-02T09:06:56Z","url":"https://github.com/AI-SDC/ACRO-R/releases/tag/v1.0.0"},"releaseCheckedAt":"2026-10-05T06:37:58.729Z","screenshots":[{"src":"previews/43f2f68925161973399b1178.jpg","kind":"demo","capturedAt":"2026-10-12T19:21:31.084Z","url":"https://mybinder.org/v2/gh/AI-SDC/ACRO-R/main?urlpath=rstudio"}],"previewAttemptAt":"2026-10-12T19:21:31.084Z","demoHealth":{"url":"https://mybinder.org/v2/gh/AI-SDC/ACRO-R/main?urlpath=rstudio","attemptedAt":"2026-10-12T19:21:31.084Z","status