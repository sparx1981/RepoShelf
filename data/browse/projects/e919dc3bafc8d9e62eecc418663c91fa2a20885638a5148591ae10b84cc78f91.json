{"availability":"available","full":"netbymatt/ws4kp","name":"ws4kp","description":"A web-based WeatherStar 4000","category":"Other","language":"JavaScript","stars":2013,"forks":264,"created":"2020-08-20T16:54:07Z","updated":"2026-10-03T14:43:46Z","license":"MIT","branch":"main","homepage":"https://weatherstar.netbymatt.com","topics":["weather-channel","weather-display"],"demo":null,"color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-04T06:51:30.925Z","lastAttemptAt":"2026-10-04T06:51:30.925Z","lastAvailableAt":"2026-10-04T06:51:30.925Z","lastDemoCheckedAt":"2026-10-04T05:05:55.794Z","metrics":[{"at":"2026-10-03T21:18:27.127Z","stars":2013,"forks":264},{"at":"2026-10-04T06:51:30.925Z","stars":2013,"forks":264}],"technologies":["Node.js"],"overview":{"kind":"readme","version":1,"paragraphs":["A live version of this project is available at","This project aims to bring back the feel of the 90s with a weather forecast that has the look and feel of The Weather Channel at that time but available in a modern way. This is by no means intended to be a perfect emulation of the WeatherStar 4000, the hardware that produced those wonderful blue and orange graphics you saw during the local forecast on The Weather Channel. If you would like a much more accurate project please see the WS4000 Simulator. Instead, this project intends to create a simple to use interface with minimal configuration fuss. Some changes have been made to the screens…"],"features":[],"sourceUrl":"https://github.com/netbymatt/ws4kp/blob/main/README.md","fingerprint":"91842374d8df3d54f660d1ee9d8c7b6ee0daee11cc0523f13c95a30d3e3e3d59","extractedAt":"2026-10-03T05:59:21.353Z"},"overviewCheckedAt":"2026-10-04T05:05:55.791Z","overviewRepoUpdated":"2026-10-03T14:43:46Z","enrichmentAttemptAt":"2026-10-03T07:14:51.784Z","latestRelease":null,"releaseCheckedAt":"2026-10-03T07:14:51.784Z","screenshots":[],"overviewAttemptAt":"2026-10-03T08:26:37.235Z","projectInsights":{"version":1,"whatItDoes":{"text":"A live ver