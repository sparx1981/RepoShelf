{"repositoryId":1271845704,"availability":"available","full":"petekp/tw-fade","name":"tw-fade","description":"Elegant, CSS-driven scroll-edge fade masking for Tailwind CSS v4. Zero JavaScript.","category":"Design","language":"JavaScript","stars":105,"forks":1,"created":"2026-06-17T04:12:38Z","updated":"2026-10-17T23:41:15Z","license":"MIT","branch":"main","homepage":"https://pete.design/tw-fade","topics":["css","css-mask","fade","mask-image","masking","plugin","scroll","scroll-driven-animations","tailwind","tailwind-plugin","tailwindcss","tailwindcss-plugin","tailwindcss-v4"],"demo":"https://pete.design/tw-fade","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-18T22:45:25.775Z","lastAttemptAt":"2026-10-18T22:45:25.775Z","lastAvailableAt":"2026-10-18T22:45:25.775Z","metrics":[{"at":"2026-10-18T22:45:25.775Z","stars":105,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Scroll-aware opacity fades and edge blur for Tailwind CSS v4. Select either effect, or combine them. Each appears while content remains beyond an edge and clears when you reach it.","Version 0.9.0 adds independent opacity and blur controls. See the migration notes for overlapping activation modes and earlier draft blur usages.","tw-fade works on the scroll container itself. Opacity fading reveals your existing surface; blur softens content near its selected edges. Neither requires a wrapper or runtime JavaScript. Size, travel, and clear-zone settings are shared by both effects. Browsers without scroll-driven animations retain static opacity fading and omit blur."],"features":[],"sourceUrl":"https://github.com/petekp/tw-fade/blob/main/README.md","fingerprint":"3a1eb040de8588e690864483cf45e27bbc14e1303e589a12bfdea26053282d3d","extractedAt":"2026-10-18T22:45:25.869Z"},"overviewCheckedAt":"2026-10-18T22:45:25.869Z","projectInsights":{"version":1,"whatItDoes":{"text":"Scroll-aware opacity fades and edge blur for Tailwind CSS v4. Select either effect, or combine them. Each appears while content remains beyond an edge and clears when you reach it.","sourceUrl":"https://github.com/petekp/tw-fade/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"3a1eb040de8588e690864483cf45e27bbc14e1303e589a12bfdea26053282d3d","sourceUrl":"https://github.com/petekp/tw-fade/blob/main/README.md","checkedAt":"2026-10-18T22:45:25.870Z"},"overviewRepoUpdated":"2026-10-17T23:41:15Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/petekp/tw-fade/blob/main/README.md","checkedAt":"2026-10-18T22:45:25.871Z","hash":"3a1eb040de8588e690864483cf45e27bbc14e1303e589a12bfdea26053282d3d","originalBytes":23908,"storedBytes":23908,"truncated":false},"lastDemoCheckedAt":"2026-10-18T22:45:25.775Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Android","Apple","Mobile","Travel","Templates & UI components","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://pete.design/tw-fade","attemptedAt":"2026-10-18T22:59:30.138Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T22:59:30.138Z","lastWorkingAt":"2026-10-18T22:59:30.138Z","target":"https://pete.design/tw-fade","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-25T22:59:30.138Z"},"previewAttemptAt":"2026-10-18T22:59:30.138Z","previewCheck":{"url":"https://pete.design/tw-fade","attemptedAt":"2026-10-18T22:59:30.138Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-25T22:59:30.138Z"},"screenshots":[{"src":"previews/90720daf29fe7e4ab3c655a5.jpg","kind":"demo","capturedAt":"2026-10-18T22:59:30.138Z","url":"https://pete.design/tw-fade"}],"qualityPriority":false,"spaces":[]}