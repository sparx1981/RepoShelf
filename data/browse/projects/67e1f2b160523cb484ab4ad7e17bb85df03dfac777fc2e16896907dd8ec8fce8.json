{"full":"hf:Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner","spaceId":"Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner","name":"AI-Tutor-and-Syllabus-Planner","source":"huggingface","description":"An interactive AI application on Hugging Face Spaces.","category":"AI & machine learning","language":"Python","topics":["gradio","agent-demo-track","region:us"],"technologies":["Python"],"likes":3,"created":"2025-06-09T04:55:09.000Z","updated":"2025-08-27T15:21:35.000Z","license":null,"runtime":"SLEEPING","appUrl":"https://agents-mcp-hackathon-ai-tutor-and-syllabus-planner.hf.space/","demo":"https://huggingface.co/spaces/Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner","availability":"available","lastCheckedAt":"2026-10-16T07:11:25.235Z","lastAttemptAt":"2026-10-16T07:11:25.235Z","lastAvailableAt":"2026-10-16T07:11:25.235Z","color":"#3c3250","ink":"#e4d4ff","symbol":"🚀","overview":{"kind":"readme","version":1,"paragraphs":["A personalized AI learning assistant that designs your learning plan with you, then tutors you through it.","This project is an AI powered tutor designed to provide a personalized learning experience. You can define what you want to learn, provide resources (like documents or books), and the AI will help generate a structured syllabus and interact with you in a specific persona to teach you the material.","Traditional Large Language Models (LLMs) are incredibly knowledgeable but can sometimes lack depth on specific topics unless guided precisely. They also tend to have a fixed interaction style once a session begins. This AI Tutor aims to address these points by:"],"features":["Why Use This AI Tutor?","How It Works (The Gist)","A Deeper Dive: How AI Tutor Works","Focused Learning: Creating a detailed syllabus based on your input and resources, ensuring the AI stays on track and provides in-depth explanations.","Adaptive Persona: Allowing you to define the teaching style (e.g., Socratic, first-principles, like a famous figure) for a more engaging and effective learning experience."],"sourceUrl":"https://huggingface.co/spaces/Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner/blob/main/README.md","fingerprint":"55d592d8a3a3a74224de53c59870b79e05c875948ac229db28ef9fbcf2a24291","extractedAt":"2026-10-10T11:03:12.658Z"},"overviewCheckedAt":"2026-10-16T07:11:25.269Z","projectInsights":{"version":1,"whatItDoes":{"text":"A personalized AI learning assistant that designs your learning plan with you, then tutors you through it.","sourceUrl":"https://huggingface.co/spaces/Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"55d592d8a3a3a74224de53c59870b79e05c875948ac229db28ef9fbcf2a24291","sourceUrl":"https://huggingface.co/spaces/Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner/blob/main/README.md","checkedAt":"2026-10-16T07:11:25.269Z"},"overviewRepoUpdated":"2025-08-27T15:21:35.000Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://huggingface.co/spaces/Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner/blob/main/README.md","checkedAt":"2026-10-16T07:11:25.269Z","hash":"55d592d8a3a3a74224de53c59870b79e05c875948ac229db28ef9fbcf2a24291","originalBytes":9172,"storedBytes":9172,"truncated":false},"subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows","Maths & algorithms","Music & audio"],"reviewRequired":true},"demoHealth":{"url":"https://huggingface.co/spaces/Agents-MCP-Hackathon/AI-Tutor-and-Syllabus-Planner","attemptedAt":"2026-10-17T19:13:53.002Z","probeVersion":3,"status":"working","consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T19:13:53.002Z","checkedAt":"2026-10-17T19:13:53.002Z","lastWorkingAt":"2026-10-17T19:13:53.002Z","target":"https://agents-mcp-hackathon-ai-tutor-and-syllabus-planner.hf.space/","f