{"availability":"available","full":"lukasbach/headless-tree","name":"headless-tree","description":"The definitive tree component for the Web","category":"Other","language":"TypeScript","stars":908,"forks":36,"created":"2023-05-01T21:54:49Z","updated":"2026-10-15T04:54:38Z","license":"MIT","branch":"main","homepage":"https://headless-tree.lukasbach.com/","topics":["a11y","accessibility","dnd","drag-and-drop","hotkeys","library","react","search","tree","ui"],"demo":"https://headless-tree.lukasbach.com/?demo=11#demogrid","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-16T20:33:39.466Z","lastAttemptAt":"2026-10-16T20:33:39.466Z","lastAvailableAt":"2026-10-16T20:33:39.466Z","lastDemoCheckedAt":"2026-10-16T20:33:39.466Z","metrics":[{"at":"2026-10-03T21:18:56.181Z","stars":905,"forks":35},{"at":"2026-10-04T19:21:08.306Z","stars":906,"forks":35},{"at":"2026-10-06T21:06:07.211Z","stars":907,"forks":35},{"at":"2026-10-09T01:07:24.725Z","stars":907,"forks":35},{"at":"2026-10-11T23:58:03.812Z","stars":907,"forks":35},{"at":"2026-10-16T20:33:39.466Z","stars":908,"forks":36}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["Super-easy integration of complex tree components into React. Supports ordered and unordered drag-and-drop, extensive keybindings, search, renaming and more. Fully customizable and accessible. Headless Tree is the official successor for react-complex-tree.","It aims to bring the many features of complex tree views, like multi-select, drag-and-drop, keyboard navigation, tree search, renaming and more, while being unopinionated about the styling and rendering of the tree itself. Accessibility is ensured by default, and the integration is extremely simple and flexible.","The interface gives you a flat list of tree nodes that you can easily render yourself, which keeps the complexity of the code low and allows you to customize the tree to your needs. This flat structure also allows you to virtualize the tree with any virtualization library you want. The library automatically provides the necessary aria tags to emulate a nested tree structure, so that accessibility requirements are met despite the flat structure."],"features":["Simple Interface: Easy integration in React with full customizability of DOM","Drag and Drop: Powerful ordered drag-and-drop, that can interact with external drag events","Scalable: Headless Tree remains performant even with large trees","Virtualization Support: Compatible with common virtualization library to support 100k+ items","Hotkeys!: Lots of hotkeys, fully customizable"],"sourceUrl":"https://github.com/lukasbach/headless-tree/blob/main/readme.md","fingerprint":"89841970efff319e6900d70436ecc23996b18c620ff0df9ee464286166b99345","extractedAt":"2026-10-16T20:33:39.599Z"},"overviewCheckedAt":"2026-10-16T20:33:39.599Z","overviewRepoUpdated":"2026-10-15T04:54:38Z","projectInsights":{"version":1,"whatItDoes":{"text":"Super-easy integration of complex tree components into React. Supports ordered and unordered drag-and-drop, extensive keybindings, search, renaming and more. Fully customizable and accessible. Headless Tree is the official successor for react-complex-tree.","sourceUrl":"https://github.com/lukasbach/headless-tree/blob/main/readme.md"},"audience":[],"requirements":[],"fingerprint":"89841970efff319e6900d70436ecc23996b18c620ff0df9ee464286166b99345","sourceUrl":"https://github.com/lukasbach/headless-tree/blob/main/readme.md","checkedAt":"2026-10-16T20:33:39.600Z"},"enrichmentAttemptAt":"2026-10-03T14:33:38.186Z","latestRelease":{"name":"@headless-tree/react@1.7.0","tag":"@headless-tree/react@1.7.0","publishedAt":"2026-05-17T22:06:19Z","url":"https://github.com/lukasbach/headless-tree/releases/tag/%40headless-tree/react%401.7.0"},"releaseCheckedAt":"2026-10-03T14:33:38.186Z","demoHealth":{"url":"https://headless-tree.lukasbach.com/?demo=11#demogrid","attemptedAt":"2026-10-16T20:52:19.414Z","status":"working","checkedAt":"2026-10-16T20:52:19.414Z","lastWo