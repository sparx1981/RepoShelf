{"availability":"available","full":"Jeramai/kobo-drop","name":"kobo-drop","description":"Send EPUBs to a Kobo as KEPUB from any phone or computer","category":"Other","language":"JavaScript","stars":0,"forks":0,"created":"2026-10-11T06:22:50Z","updated":"2026-10-11T08:49:29Z","license":"MIT","branch":"main","homepage":"https://jeramai.github.io/kobo-drop/","topics":["cloudflare-workers","epub","kepub","kobo","pwa","webassembly"],"demo":"https://jeramai.github.io/kobo-drop/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-11T19:51:01.112Z","lastAttemptAt":"2026-10-11T19:51:01.112Z","lastAvailableAt":"2026-10-11T19:51:01.112Z","metrics":[{"at":"2026-10-11T19:51:01.112Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Send EPUBs from your phone to your Kobo. They arrive as KEPUB, with a clean title, author and cover.","The Kobo picks its reader by file name. A .kepub.epub opens in Kobo's own renderer: faster page turns, reading statistics, time left in chapter, better fonts and hyphenation. A plain .epub opens in the older Adobe renderer. Kobo Drop runs kepubify in your browser, so every book arrives as KEPUB."],"features":[],"sourceUrl":"https://github.com/Jeramai/kobo-drop/blob/main/README.md","fingerprint":"0e66fcdea5e1bbbf864fd8255b29eac3e6c04198519e067c69bb1449e15eab74","extractedAt":"2026-10-11T19:51:01.345Z"},"overviewCheckedAt":"2026-10-11T19:51:01.345Z","projectInsights":{"version":1,"whatItDoes":{"text":"Send EPUBs from your phone to your Kobo. They arrive as KEPUB, with a clean title, author and cover.","sourceUrl":"https://github.com/Jeramai/kobo-drop/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"No cable, no Calibre, no account.","sourceUrl":"https://github.com/Jeramai/kobo-drop/blob/main/README.md"},{"kind":"account","status":"documented","text":"There are no accounts, cookies or analytics; the pages do load Literata from Google Fonts and ask ipify (or icanhazip.com when ipify fails) for your public address, and for a book without a cover the Worker sends its title and author to Open Library and Google Books.","sourceUrl":"https://github.com/Jeramai/kobo-drop/blob/main/README.md"}],"fingerprint":"0e66fcdea5e1bbbf864fd8255b29eac3e6c04198519e067c69bb1449e15eab74","sourceUrl":"https://github.com/Jeramai/kobo-drop/blob/main/README.md","checkedAt":"2026-10-11T19:51:01.345Z"},"overviewRepoUpdated":"2026-10-11T08:49:29Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Jeramai/kobo-drop/blob/main/README.md","checkedAt":"2026-10-11T19:51:01.346Z","hash":"0e66fcdea5e1bbbf864fd8255b29eac3e6c04198519e067c69bb1449e15eab74","originalBytes":5946,"storedBytes":5946,"truncated":false},"lastDemoCheckedAt":"2026-10-11T19:51:01.112Z","subjects":["Browser extensions & PWAs"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Browser extensions & PWAs"],"evidence":[{"subject":"Browser extensions & PWAs","source":"metadata","match":"pwa"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Android","Apple","Mobile"],"reviewRequired":true},"demoHealth":{"url":"https://jeramai.github.io/kobo-drop/","attemptedAt":"2026-10-11T20:03:23.509Z","probeVersion":3,"status":"working","checkedAt":"2026-10-11T20:03:23.509Z","lastWorkingAt":"2026-10-11T20:03:23.509Z","target":"https://jeramai.github.io/kobo-drop/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-18T20:03:23.509Z"},"previewAttemptAt":"2026-10-11T20:03:23.509Z","previewCheck":{"url":"https://jeramai.github.io/kobo-drop/","attemptedAt":"2026-10-11T20:03:23.509Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-18T20:03:23.509Z"},"screenshots":[{"src":"previews/c7d29aaae503a3288398d626.jpg","kind":"demo","capturedAt":"2026-10-11T20:03:23.509Z","url":"https://jeramai.github.io/kobo-drop/"}],"qualityPri