{"repositoryId":1121922191,"availability":"available","full":"ndrorchestration/DGAF-Framework","name":"DGAF-Framework","description":"Evidence-bound assurance for agentic AI — governance, provenance, authorization, audit, and fail-closed lifecycle controls.","category":"Developer tools","language":"Python","stars":4,"forks":0,"created":"2025-12-23T19:33:32Z","updated":"2026-10-19T06:14:08Z","license":null,"branch":"main","homepage":"https://dgaf-framework.vercel.app","topics":["agentic-ai","ai-assurance","ai-governance","apache-2-0","authorization","governance-as-code","multi-agent","nist-ai-rmf","phi-harmonic","provenance"],"demo":"https://project-7ybao.vercel.app/demo","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-19T06:19:40.094Z","lastAttemptAt":"2026-10-19T06:19:40.094Z","lastAvailableAt":"2026-10-19T06:19:40.094Z","metrics":[{"at":"2026-10-19T06:19:40.094Z","stars":4,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Dynamic Governance Agentic Formation (DGAF) is an experimental framework for governed multi-agent AI systems. It treats capability, evidence, verification, authority, and permission to act as separate machine-relevant states rather than assuming that one implies another.","In plain English: an agent may be able to do something and still be blocked from doing it; a system may pass engineering tests and still be blocked from claiming that it is empirically validated.","The repository contains substantial engineering evidence: governance logic, provenance controls, deterministic validators, CI, negative controls, source binding, custody/security machinery, experimental tooling, runtime evidence, vocabulary governance, presentation controls, a partial recurring-assurance inventory, and blinded-data infrastructure."],"features":["empirically validated as a complete framework;","independently validated;","production-certified;","High-Assurance authorized;","having established canonical DGAF efficacy;"],"sourceUrl":"https://github.com/ndrorchestration/DGAF-Framework/blob/main/README.md","fingerprint":"c75f694a00c157ded9705eb0ca2b50814670b7cbc02b55ff438f918130490164","extractedAt":"2026-10-19T06:19:40.184Z"},"overviewCheckedAt":"2026-10-19T06:19:40.184Z","projectInsights":{"version":1,"whatItDoes":{"text":"Dynamic Governance Agentic Formation (DGAF) is an experimental framework for governed multi-agent AI systems. It treats capability, evidence, verification, authority, and permission to act as separate machine-relevant states rather than assuming that one implies another.","sourceUrl":"https://github.com/ndrorchestration/DGAF-Framework/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"c75f694a00c157ded9705eb0ca2b50814670b7cbc02b55ff438f918130490164","sourceUrl":"https://github.com/ndrorchestration/DGAF-Framework/blob/main/README.md","checkedAt":"2026-10-19T06:19:40.185Z"},"overviewRepoUpdated":"2026-10-19T06:14:08Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/ndrorchestration/DGAF-Framework/blob/main/README.md","checkedAt":"2026-10-19T06:19:40.186Z","hash":"c75f694a00c157ded9705eb0ca2b50814670b7cbc02b55ff438f918130490164","originalBytes":29556,"storedBytes":29556,"truncated":false},"lastDemoCheckedAt":"2026-10-19T06:19:40.094Z","subjects":["MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["MCP servers & agents"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"agentic"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Automation & workflows","Science","Privacy & security"],"reviewRequired":true},"demoHealth":{"url":"https://project-7ybao.vercel.app/demo","attemptedAt":"2026-10-19T06:34:23.850Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T06:34:23.850Z","lastWorkingAt":"2026-10-19T06:34:23.850Z","target":"https://project-7ybao.vercel.ap