{"repositoryId":1412688302,"availability":"available","full":"bamr87/bash-365-apex","name":"bash-365-apex","description":"Client-side redirect from the bash-365.com apex domain to www, served by GitHub Pages for BASH Consulting.","category":"Other","language":"HTML","stars":0,"forks":0,"created":"2026-10-10T03:01:02Z","updated":"2026-10-17T19:55:48Z","license":"MIT","branch":"main","homepage":"https://bash-365.com","topics":["dns","github-pages","html","redirect","website"],"demo":"https://bash-365.com/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-17T22:40:56.016Z","lastAttemptAt":"2026-10-17T22:40:56.016Z","lastAvailableAt":"2026-10-17T22:40:56.016Z","metrics":[{"at":"2026-10-17T22:40:56.016Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Client-side redirect from the bash-365.com apex domain to www, served by GitHub Pages for BASH Consulting.","Redirects the bare domain bash-365.com to keeping the path.","DNS for bash-365.com is hosted in Microsoft 365, which has no ALIAS/ANAME records, so the apex cannot point at the Azure Static Web App that serves www. The apex A/AAAA records point at GitHub Pages instead, and this repo answers there with a client-side redirect (index.html for /, 404.html for every other path)."],"features":["index.html sends / to","404.html catches every other path and redirects it to the same path on www","CNAME binds this GitHub Pages site to the bash-365.com apex domain"],"sourceUrl":"https://github.com/bamr87/bash-365-apex/blob/main/README.md","fingerprint":"2765255192aee6712e5d5dd4b27c33a267b892cb35cc4503b9a0a6c500a52faf","extractedAt":"2026-10-17T22:40:56.099Z"},"overviewCheckedAt":"2026-10-17T22:40:56.099Z","projectInsights":{"version":1,"whatItDoes":{"text":"Client-side redirect from the bash-365.com apex domain to www, served by GitHub Pages for BASH Consulting.","sourceUrl":"https://github.com/bamr87/bash-365-apex/blob/main/README.md"},"audience":[],"requirements":[],"fi