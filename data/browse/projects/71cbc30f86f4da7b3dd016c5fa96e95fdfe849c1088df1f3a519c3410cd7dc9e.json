{"repositoryId":1091789929,"availability":"available","full":"KrishSachdev/promo-video-generator","name":"promo-video-generator","description":"Automatically cuts short promo videos from long footage using an EfficientNetB0 CNN for visual scoring and audio peak detection. Live Streamlit demo.","category":"Education","language":"Python","stars":0,"forks":0,"created":"2025-11-07T14:21:12Z","updated":"2026-07-15T17:27:23Z","branch":"main","homepage":"https://promo-video-generator.streamlit.app/","topics":["cnn","computer-vision","python","streamlit","tensorflow","transfer-learning","video-processing"],"demo":"https://promo-video-generator.streamlit.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-12T09:46:36.764Z","lastAttemptAt":"2026-10-12T09:46:36.764Z","lastAvailableAt":"2026-10-12T09:46:36.764Z","metrics":[{"at":"2026-10-12T09:46:36.764Z","stars":0,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Hosted on Streamlit's free tier, which sleeps when idle — the first load takes 60–90 seconds to wake up. It's not broken, just yawning.","This project automates the creation of short promotional videos from long-form video content using computer vision and audio analysis techniques. It leverages a pretrained convolutional neural network to identify visually important segments and combines them with audio-based scoring to generate high-impact video summaries.","The system uses a pretrained EfficientNetB0 CNN for visual feature extraction, along with OpenCV and NumPy for frame sampling and preprocessing. Audio features are extracted and integrated with visual scores to detect peaks representing engaging moments. Selected segments are then assembled into a concise promotional video using MoviePy."],"features":[],"sourceUrl":"https://github.com/KrishSachdev/promo-video-generator/blob/main/README.md","fingerprint":"9a31d829ff39329656074cf0d4356a8d3ed5efaf5f644472e08c56041163e553","extractedAt":"2026-10-12T09:46:36.909Z"},"overviewCheckedAt":"2026-10-12T09:46:36.909Z","projectInsights":{"version":1,"whatItDoes":{"text":"Hosted on Streamlit's free tier, which sleeps when idle — the first load takes 60–90 seconds to wake up. It's not broken, just yawning.","sourceUrl":"https://github.com/KrishSachdev/promo-video-generator/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"9a31d829ff39329656074cf0d4356a8d3ed5efaf5f644472e08c56041163e553","sourceUrl":"https://github.com/KrishSachdev/promo-video-generator/blob/main/README.md","checkedAt":"2026-10-12T09:46:36.909Z"},"overviewRepoUpdated":"2026-07-15T17:27:23Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/KrishSachdev/promo-video-generator/blob/main/README.md","checkedAt":"2026-10-12T09:46:36.909Z","hash":"9a31d829ff39329656074cf0d4356a8d3ed5efaf5f644472e08c56041163e553","originalBytes":1111,"storedBytes":1111,"truncated":false},"lastDemoCheckedAt":"2026-10-12T09:46:36.764Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Education","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://promo-video-generator.streamlit.app/","attemptedAt":"2026-10-12T10:02:01.691Z","probeVersion":3,"status":"working","checkedAt":"2026-10-12T10:02:01.691Z","lastWorkingAt":"2026-10-12T10:02:01.691Z","target":"https://promo-video-generator.streamlit.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-19T10:02:01.691Z"},"previewAttemptAt":"2026-10-12T10:02:01.691Z","previewCheck":{"url":"https://promo-video-generator.streamlit.app/","attemptedAt":"2026-10-12T10:02:01.691Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-19T10:02:01.691Z"},"screenshots":[{"src":"previews/51d085764822aa2e20e720d3.jpg","kind":"demo","capturedAt":"2026-10-12T10:02:01.691Z","url":"https://promo-video-