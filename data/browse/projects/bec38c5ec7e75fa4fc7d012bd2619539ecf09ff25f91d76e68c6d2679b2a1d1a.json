{"repositoryId":1181675564,"availability":"available","full":"shawnwang15/a2ui-vue","name":"a2ui-vue","description":"a2ui-vue | Vue 3 implementation of A2UI protocol. Enabling AI agents to render dynamic, interactive user interfaces in Vue applications.","category":"AI & machine learning","language":"TypeScript","stars":98,"forks":7,"created":"2026-03-14T13:23:35Z","updated":"2026-10-04T12:33:00Z","license":"MIT","branch":"main","homepage":"https://shawnwang15.github.io/a2ui-vue/","topics":["a2ui","a2ui-vue","agui"],"demo":"https://shawnwang15.github.io/a2ui-vue/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-15T13:01:34.039Z","lastAttemptAt":"2026-10-15T13:01:34.039Z","lastAvailableAt":"2026-10-15T13:01:34.039Z","metrics":[{"at":"2026-10-15T13:01:34.039Z","stars":98,"forks":7}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["a2ui-vue is a community Vue 3 renderer for the A2UI (Agent-to-UI) open protocol, fully supporting the official A2UI v0.9 specification. It enables AI agents to express UI intent as structured JSON and have it rendered as rich, interactive components inside any Vue 3 application — with no HTML/CSS knowledge required by the agent.","A2UI (Agent-to-UI) is an open protocol that defines how AI agents communicate UI intent to a frontend renderer. Instead of generating raw HTML/CSS, an agent emits typed JSON messages (\"show a card with title X and a list of Y\"). The renderer translates those messages into real visual components.","a2ui-vue is the community Vue 3 implementation of this protocol:"],"features":["Decouples agent logic from frontend implementation details","Lets AI agents describe interface intent with structured JSON instead of raw HTML","Gives Vue teams a native renderer with TypeScript, theming, and component reuse","Makes agent-generated UI more deterministic, inspectable, and maintainable","20+ built-in components (layout, content, media, inputs)"],"sourceUrl":"https://github.com/shawnwang15/a2ui-vue/blob/main/README.md","fingerprint":"7dc44c7db34ff1012c2ac46b090ea7bf8844dc5b6e54d068ffa2c203bbf17ce6","extractedAt":"2026-10-15T13:01:34.201Z"},"overviewCheckedAt":"2026-10-15T13:01:34.201Z","projectInsights":{"version":1,"whatItDoes":{"text":"a2ui-vue is a community Vue 3 renderer for the A2UI (Agent-to-UI) open protocol, fully supporting the official A2UI v0.9 specification. It enables AI agents to express UI intent as structured JSON and have it rendered as rich, interactive components inside any Vue 3 application — with no HTML/CSS knowledge required by the agent.","sourceUrl":"https://github.com/shawnwang15/a2ui-vue/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"7dc44c7db34ff1012c2ac46b090ea7bf8844dc5b6e54d068ffa2c203bbf17ce6","sourceUrl":"https://github.com/shawnwang15/a2ui-vue/blob/main/README.md","checkedAt":"2026-10-15T13:01:34.201Z"},"overviewRepoUpdated":"2026-10-04T12:33:00Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/shawnwang15/a2ui-vue/blob/main/README.md","checkedAt":"2026-10-15T13:01:34.201Z","hash":"7dc44c7db34ff1012c2ac46b090ea7bf8844dc5b6e54d068ffa2c203bbf17ce6","originalBytes":7221,"storedBytes":7221,"truncated":false,"searchTerms":["agent","a2ui","a2ui-vue","vue","renderer","component","structured","protocol","json","agents","catalog","components","demo","docs","import","messages","pnpm","start","app","build","client","contact","documentation","gallery","restaurant","run","frontend","html","intent","packages","samples","specification","what","agent-to-ui","any","applications","const","core","default","dev","faq","finder","implementation","installation","interactive","lookup","official","open","providea2ui","quick","raw","rendering","typescript","usemessageprocessor","v0.8","v0.9","vue-renderer","available","built-in","cases","community","components.","computed","copilots","createapp","css","defaulttheme","description","extensible","fully","generating","generative","how","images","i