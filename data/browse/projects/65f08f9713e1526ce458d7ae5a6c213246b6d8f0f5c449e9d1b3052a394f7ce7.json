or run the linked program with the same tape, panel and log; the editor doubles as the debugger — gutter breakpoints, the instruction pointer highlighted on its line, the standard library open in a read-only second tab, lint and canonical formatting from the toolchain itself. Input tapes are edited on the panel or loaded from .pmt / .tmt tape-block files. The…"],"features":[],"sourceUrl":"https://github.com/mellonis/machines-demo/blob/master/README.md","fingerprint":"d1659622a9ed702b126b4856dcb799de2874183fa0fe4093333a32fbe21f22ff","extractedAt":"2026-10-06T05:42:59.979Z"},"overviewCheckedAt":"2026-10-06T05:42:59.979Z","projectInsights":{"version":1,"whatItDoes":{"text":"Interactive in-browser playground for Turing and Post machines.","sourceUrl":"https://github.com/mellonis/machines-demo/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"d1659622a9ed702b126b4856dcb799de2874183fa0fe4093333a32fbe21f22ff","sourceUrl":"https://github.com/mellonis/machines-demo/blob/master/README.md","checkedAt":"2026-10-06T05:42:59.979Z"},"overviewRepoUpdated":"2026-09-02T20:13:51Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/mellonis/machines-demo/blob/master/README.md","checkedAt":"2026-10-06T05:42:59.980Z","hash":"d1659622a9ed702b126b4856dcb799de2874183fa0fe4093333a32fbe21f22ff","originalBytes":12831,"storedBytes":12831,"truncated":false,"searchTerms":["run","npm","worker","e2e","machine","engine","playwright","vitest","state","code","test","build","suite","log","post","turing-machine-js","user","editor","lint","one","step","tape","bundle","command","dev","helpers","inside","localstorage","only","panel","preview","showcase","tape-block","tapes","timeout","turing","two","visuals","vite","web","active","apply","builds","built","cap","caps","codemirror","column","coverage","error","graph","highlight","imports","lesson","max","mode","pause","paused","pill","program","real","runs","scripts","surface","tab","tapesnapshot","toolchains"