{"availability":"available","full":"sergiomercado19/linkbin","name":"linkbin","description":"A link storage site where users can group them by boards and share them.","category":"Other","language":"JavaScript","stars":6,"forks":0,"created":"2020-08-27T23:42:12Z","updated":"2020-09-15T02:12:02Z","license":"MIT","branch":"master","homepage":"https://linkbin-aea9b.web.app/","topics":["expressjs","firebase","react","webapp"],"demo":"https://linkbin-aea9b.web.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-11T13:40:39.171Z","lastAttemptAt":"2026-10-11T13:40:39.171Z","lastAvailableAt":"2026-10-11T13:40:39.171Z","metrics":[{"at":"2026-10-11T13:40:39.171Z","stars":6,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["Linkbin is a platform to create 'link boards' to share with people. Linkbin removes the inconvenience of sharing multiple links by using boards to group them. The board's ID or URL can then be shared with anyone to let them view the board. Additionally, Linkbin displays a preview of the link on the board to make it more informative and meaningful. This preview consists of an image, a title, a description and a domain.","Linkbin borrows the easy-sharing using a public URL functionality from services like pastebin and the concept of 'boards' from Pinterest, but using link previews instead of images.","This project is currently hosted using Firebase at linkbin-aea9b.web.app, where you can start using this web application. The site is not optimised for mobile, so for the best viewing experience access it from a desktop web browser."],"features":[],"sourceUrl":"https://github.com/sergiomercado19/linkbin/blob/master/README.md","fingerprint":"3a3a260def7a13b64c4a3ae6f2f1ef208a4a0622b0f940da9855cdf3f8bd3f39","extractedAt":"2026-10-11T13:40:39.337Z"},"overviewCheckedAt":"2026-10-11T13:40:39.337Z","projectInsights":{"version":1,"whatItDoes":{"text":"Linkbin is a platform to create 'link boards' to share with people. Linkbin removes the inconvenience of sharing multiple links by using boards to group them. The board's ID or URL can then be shared with anyone to let them view the board. Additionally, Linkbin displays a preview of the link on the board to make it more informative and meaningful. This preview consists of an image, a title, a description and a domain.","sourceUrl":"https://github.com/sergiomercado19/linkbin/blob/master/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Authentication - A Firebase service that provides easy sign-in with any platform.","sourceUrl":"https://github.com/sergiomercado19/linkbin/blob/master/README.md"},{"kind":"account","status":"required","text":"For Linkbin, the only sign-in method I have enabled is email/password.","sourceUrl":"https://github.com/sergiomercado19/linkbin/blob/master/README.md"}],"fingerprint":"3a3a260def7a13b64c4a3ae6f2f1ef208a4a0622b0f940da9855cdf3f8bd3f39","sourceUrl":"https://github.com/sergiomercado19/linkbin/blob/master/README.md","checkedAt":"2026-10-11T13:40:39.337Z"},"overviewRepoUpdated":"2020-09-15T02:12:02Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/sergiomercado19/linkbin/blob/master/README.md","checkedAt":"2026-10-11T13:40:39.338Z","hash":"3a3a260def7a13b64c4a3ae6f2f1ef208a4a0622b0f940da9855cdf3f8bd3f39","originalBytes":12008,"storedBytes":12008,"truncated":false,"searchTerms":["firebase","file","frontend","react","project","api","contains","javascript","using","linkbin","backend","component","components","create","functions","boards","cloud","directory","documentation","how","license","script","since","utils","authentication","command","development","files","folder","following","install","link","local","need","note","src","web","code","config.js","here","hosted","projects.","provides","routes","run","see","service","services","stack","tech","testing","these","url","acknowledgments","additionally","after","app","backend-as-a-service"