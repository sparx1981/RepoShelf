{"availability":"available","full":"mbettan/showroom","name":"showroom","description":"A sleek, dark-themed developer portfolio showcase and interactive analytics dashboard, automatically synced from GitHub.","category":"Design","language":"Python","stars":0,"forks":0,"created":"2026-06-19T00:31:50Z","updated":"2026-10-10T03:34:09Z","license":"Apache-2.0","branch":"main","homepage":"https://mbettan.github.io/showroom/","topics":["analytics","automation","chartjs","dashboard","developer-portfolio","github-actions","github-pages","glassmorphism","obsidian-theme","portfolio","python","serverless"],"demo":"https://mbettan.github.io/showroom/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-10T07:04:18.764Z","lastAttemptAt":"2026-10-10T07:04:18.764Z","lastAvailableAt":"2026-10-10T07:04:18.764Z","metrics":[{"at":"2026-10-10T07:04:18.764Z","stars":0,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["A sleek, dark-themed portfolio showcase and developer analytics dashboard for GitHub repositories — 100% serverless and automatically synced.","Showroom is a premium, data-driven portfolio template built with an obsidian-black and mint-green glassmorphic design system. It automatically catalogs your repositories, tracks developer adoption metrics (views, clones, stars, forks), archives historical traffic to bypass GitHub's 14-day API limits, and renders a stunning interactive analytics dashboard using Chart.js."],"features":["Dual-View SPA Architecture: Seamlessly toggle between the Showroom (project cards grid) and Analytics (interactive dashboard) via a smooth sidebar navigation menu.","Archival Traffic Ledger: Features a date-keyed Local Traffic Ledger (docs/traffichistory.json) that merges daily API hits to build a permanent, growing database of views and clones, bypassing GitHub's rolling 14-day…","Interactive Chart.js Dashboard:","Dynamic Controls: Filter charts and KPI cards by specific repository and time ranges (Last 7, 14, 30 days, or All-Time).","Set-and-Forget Cloud Automation: Pre-configured GitHub Actions workflow automatically syncs stats and redeploys your site every night at midnight."],"sourceUrl":"https://github.com/mbettan/showroom/blob/main/README.md","fingerprint":"aff95911664a11017a45480f01975bd08970f481aac600546aa59ffc8cd3b458","extractedAt":"2026-10-10T07:04:18.879Z"},"overviewCheckedAt":"2026-10-10T07:04:18.879Z","projectInsights":{"version":1,"whatItDoes":{"text":"A sleek, dark-themed portfolio showcase and developer analytics dashboard for GitHub repositories — 100% serverless and automatically synced.","sourceUrl":"https://github.com/mbettan/showroom/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"required","text":"Because the GitHub Actions runner runs in the cloud, you must securely provide your Personal Access Token as an encrypted environment secret:","sourceUrl":"https://github.com/mbettan/showroom/blob/main/README.md"}],"fingerprint":"aff95911664a11017a45480f01975bd08970f481aac600546aa59ffc8cd3b458","sourceUrl":"https://github.com/mbettan/showroom/blob/main/README.md","checkedAt":"2026-10-10T07:04:18.879Z"},"overviewRepoUpdated":"2026-10-10T03:34:09Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/mbettan/showroom/blob/main/README.md","checkedAt":"2026-10-10T07:04:18.880Z","hash":"aff95911664a11017a45480f01975bd08970f481aac600546aa59ffc8cd3b458","originalBytes":7190,"storedBytes":7190,"truncated":false,"searchTerms":["traffic","github","repository","showroom","docs","token","portfolio","actions","database","fetch","ledger","click","dashboard","local","pages","project","scripts","access","analytics","api","automatically","bash","custom","daily","day","default","interactive","license","personal","python","repos.py","repositories","showcase","skip","add","adoption","build","chart","cli","clones","cloud","developer","engine","every","grid","hide","history.json","open","run","search","secret","