ch creates inspect output with labelled values, there are multiple other styles of inspect output.","If you have a class that represents a single internal value, representing the value as { label: value } is too noisy.","You can pass multiple values to DisplayTuple as an array, and they will be comma-separated in the output.","If you have an instance that represents a singleton value, you can use DisplayUnit to create even less verbose inspect output.","You can use descriptions with unit-style inspect output. You can also use unit-style inspect output for certain instances and more verbose inspect output for others."],"sourceUrl":"https://github.com/starbeamjs/inspect-utils/blob/main/README.md","fingerprint":"61c1cc9d8e64139b0a1051e9d2b45556b592edb703e473c36fe92fd88be64e43","extractedAt":"2026-10-16T20:34:04.715Z"},"overviewCheckedAt":"2026-10-16T20:34:04.715Z","projectInsights":{"version":1,"whatItDoes":{"text":"🌅🌸 Gorgeous inspect output for your custom classes. 🌺🌄","sourceUrl":"https://github.com/starbeamjs/inspect-utils/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"61c1cc9d8e64139b0a1051e9d2b45556b592edb703e473c36fe92fd88be64e43","sourceUrl":"https://github.com/starbeamjs/inspect-utils/blob/main/README.md","checkedAt":"2026-10-16T20:34:04.715Z"},"overviewRepoUpdated":"2023-10-18T00:19:15Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/starbeamjs/inspect-utils/blob/main/README.md","checkedAt":"2026-10-16T20:34:04.716Z","hash":"61c1cc9d8e64139b0a1051e9d2b45556b592edb703e473c36fe92fd88be64e43","originalBytes":11081,"storedBytes":11081,"truncated":false},"lastDemoCheckedAt":"2026-10-16T20:34:04.600Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":true},"demoHealth":{"url":"https://play.swc.rs/?version=1.3.92&code=H4