{"availability":"available","full":"goyashek/signature-forgery-verification","name":"signature-forgery-verification","description":"Leak-audited, writer-independent signature forgery verification using Siamese metric learning and EfficientNet-B0.","category":"Education","language":"Jupyter Notebook","stars":1,"forks":0,"created":"2026-06-27T18:11:23Z","updated":"2026-07-31T10:21:42Z","license":"MIT","branch":"main","homepage":"https://huggingface.co/spaces/goyashek/signature-forgery-verification","topics":["computer-vision","efficientnet","gradio","siamese-network","signature-verification","tensorflow"],"demo":"https://huggingface.co/spaces/goyashek/signature-forgery-verification","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-20T04:05:58.918Z","lastAttemptAt":"2026-10-20T04:05:58.918Z","lastAvailableAt":"2026-10-20T04:05:58.918Z","metrics":[{"at":"2026-10-08T22:33:57.452Z","stars":1,"forks":0},{"at":"2026-10-11T19:48:23.240Z","stars":1,"forks":0},{"at":"2026-10-17T02:59:59.594Z","stars":1,"forks":0},{"at":"2026-10-20T04:05:58.918Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["🚀 Try the live demo · 📓 View notebook · ▶ Run in Colab","This project verifies whether a questioned offline signature matches an enrolled writer. Instead of training one classifier per person, it learns a distance metric over signatures, allowing the model to assess writers absent from training using a small reference set.","I built it as a learning progression: start with a naive baseline, investigate why it fails, and work toward the final metric-learning model. The final model is demonstrated in notebooks/04finaldemo.ipynb and served through a Gradio app on Hugging Face Spaces."],"features":["Task: Verify whether a questioned offline signature matches an enrolled writer.","Best model: EfficientNet-B0 + online batch-hard metric learning","Held-out benchmark: ROC-AUC 0.986 on unseen writers","External benchmark: ROC-AUC 0.877 on NFI","Main finding: A suspicious 0.999 baseline exposed two dataset leaks, so I rebuilt the pairing and evaluation protocol."],"sourceUrl":"https://github.com/goyashek/signature-forgery-verification/blob/main/README.md","fingerprint":"5f657670c9bdfd702c8d074af49243308c0779d28f283ca8c6d8fe9123444054","extractedAt":"2026-10-08T22:33:57.578Z"},"overviewCheckedAt":"2026-10-17T02:59:59.720Z","projectInsights":{"version":1,"whatItDoes":{"text":"🚀 Try the live demo · 📓 View notebook · ▶ Run in Colab","sourceUrl":"https://github.com/goyashek/signature-forgery-verification/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"5f657670c9bdfd702c8d074af49243308c0779d28f283ca8c6d8fe9123444054","sourceUrl":"https://github.com/goyashek/signature-forgery-verification/blob/main/README.md","checkedAt":"2026-10-17T02:59:59.720Z"},"overviewRepoUpdated":"2026-07-31T10:21:42Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/goyashek/signature-forgery-verification/blob/main/README.md","checkedAt":"2026-10-17T02:59:59.721Z","hash":"5f657670c9bdfd702c8d074af49243308c0779d28f283ca8c6d8fe9123444054","originalBytes":27266,"storedBytes":27266,"truncated":false},"lastDemoCheckedAt":"2026-10-17T02:59:59.723Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Education","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://huggingface.co/spaces/goyashek/signature-forgery-verification","attemptedAt":"2026-10-16T08:46:11.466Z","probeVersion":3,"status":"working","consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-23T08:46:11.466Z","checkedAt":"2026-10-16T08:46:11.466Z","lastWorkingAt":"2026-10-16T08:46:11.466Z","target":"https://huggingface.co/spaces/goyashek/signature-forgery-verification","failureCount":0},"previewAttemptAt":"2026-10-16T08:46:11.466Z","previewCheck":{"url":"https:/