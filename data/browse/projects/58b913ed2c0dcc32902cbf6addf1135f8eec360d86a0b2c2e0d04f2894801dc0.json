{"availability":"available","full":"zxcvbn-ts/zxcvbn","name":"zxcvbn","description":"Low-Budget Password Strength Estimation","category":"Finance","language":"TypeScript","stars":1232,"forks":96,"created":"2019-12-06T15:07:35Z","updated":"2026-10-09T11:55:11Z","license":"MIT","branch":"master","homepage":"https://www.usenix.org/conference/usenixsecurity16/technical-sessions/presentation/wheeler","topics":["hacktoberfest","password","password-strength"],"demo":"https://zxcvbn-ts.github.io/zxcvbn/demo/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-15T12:58:22.389Z","lastAttemptAt":"2026-10-15T12:58:22.389Z","lastAvailableAt":"2026-10-15T12:58:22.389Z","metrics":[{"at":"2026-10-09T23:11:43.967Z","stars":1231,"forks":96},{"at":"2026-10-15T12:58:22.389Z","stars":1232,"forks":96}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["This is a complete rewrite of zxcvbn into typescript which is licensed under the MIT license. Thanks to the original creators dropbox for the great work.","zxcvbn is a password strength estimator inspired by password crackers. Through pattern matching and conservative estimation, it recognizes and weighs 40k common passwords, common names surnames, popular words from Wikipedia and common word in different language from different countries, and other common patterns like dates, repeats (aaa), sequences (abcd), keyboard patterns (qwertyuiop), and l33t speak. Consider using zxcvbn as an algorithmic alternative to password composition policy — it is more secure, flexible, and usable when sites require a minimal complexity score in place of annoying…","The reason of this project is to modernize zxcvbn and make it maintainable with new features."],"features":["estimate strength of a password","get a score for the password","check passwords asynchronously for API-based matchers","i18n support, for dictionaries and feedback translations","extend existing dictionaries with your own"],"sourceUrl":"https://github.com/zxcvbn-ts/zxcvbn/blob/master/README.md","fingerprint":"9e11a396b28ed916628fede3cd8437b75fd3b060a587bc527205aed91be1cfcd","extractedAt":"2026-10-09T23:11:44.073Z"},"overviewCheckedAt":"2026-10-09T23:11:44.073Z","projectInsights":{"version":1,"whatItDoes":{"text":"This is a complete rewrite of zxcvbn into typescript which is licensed under the MIT license. Thanks to the original creators dropbox for the great work.","sourceUrl":"https://github.com/zxcvbn-ts/zxcvbn/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"9e11a396b28ed916628fede3cd8437b75fd3b060a587bc527205aed91be1cfcd","sourceUrl":"https://github.com/zxcvbn-ts/zxcvbn/blob/master/README.md","checkedAt":"2026-10-09T23:11:44.073Z"},"overviewRepoUpdated":"2026-10-09T11:55:11Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/zxcvbn-ts/zxcvbn/blob/master/README.md","checkedAt":"2026-10-16T20:36:55.529Z","hash":"9e11a396b28ed916628fede3cd8437b75fd3b060a587bc527205aed91be1cfcd","originalBytes":3880,"storedBytes":3880,"truncated":false},"lastDemoCheckedAt":"2026-10-09T23:11:43.967Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Finance","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://zxcvbn-ts.github.io/zxcvbn/demo/","attemptedAt":"2026-10-17T00:07:19.786Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T00:07:19.786Z","lastWorkingAt":"2026-10-17T00:07:19.786Z","target":"https://zxcvbn-ts.github.io/zxcvbn/demo/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T00:07:19.786Z"},"previewAttemptAt":"2026-10-17T00:07:19.788Z","previewCheck":{"url":"https://zxcvbn-ts.github.io/zxcvbn/demo/","attemptedAt":"2026-10-17T00:07:19.788Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-24T00:07:19.788Z"},"screenshots":[{"src":"previews