nce pipelines, to source the power spectra needed for two-point statistics analyses. This provides orders-of-magnitude acceleration to the inference pipeline and integrates naturally with efficient techniques for sampling very high-dimensional parameter spaces. The power spectra emulators…"],"features":[],"sourceUrl":"https://github.com/alessiospuriomancini/cosmopower/blob/main/README.md","fingerprint":"057cfe66d7b506c28634df9ec2d97638c953881d2538797f8ab1c4ad030b6dc0","extractedAt":"2026-10-09T08:59:41.666Z"},"overviewCheckedAt":"2026-10-09T08:59:41.666Z","projectInsights":{"version":1,"whatItDoes":{"text":"Overview • Documentation • Installation • Getting Started • Training • Trained Models • Likelihoods • Support • Citation","sourceUrl":"https://github.com/alessiospuriomancini/cosmopower/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"057cfe66d7b506c28634df9ec2d97638c953881d2538797f8ab1c4ad030b6dc0","sourceUrl":"https://github.com/alessiospuriomancini/cosmopower/blob/main/README.md","checkedAt":"2026-10-09T08:59:41.666Z"},"overviewRepoUpdated":"2024-12-21T11:45:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/alessiospuriomancini/cosmopower/blob/main/README.md","checkedAt":"2026-10-09T08:59:41.666Z","hash":"057cfe66d7b506c28634df9ec2d97638c953881d2538797f8ab1c4ad030b6dc0","originalBytes":14746,"storedBytes":14746,"truncated":false},"lastDemoCheckedAt":"2026-10-09T08:59:41.531Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Education","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Health & fitness","Science","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://alessiospuriomancini.github.io/cosmopower","attemptedAt":"2026-10-16T09:42:13.147Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T09:42:13.147Z","lastWorkingAt":"2026-10-16T09:42:13.147Z","targ