 authDomain, projectId, appId.","В репозитории на GitHub: Settings → Secrets and variables → Actions — добавьте секреты VITEFIREBASEAPIKEY, VITEFIREBASEAUTHDOMAIN, VITEFIREBASEPROJECTID, VITEFIREBASEAPPID."],"sourceUrl":"https://github.com/sailxx/Okto/blob/main/README.md","fingerprint":"e48d0b785d621ef060c64b627a0c71e7c0b26dcd04a40b14d700e080b2b97eba","extractedAt":"2026-10-17T22:39:58.221Z"},"overviewCheckedAt":"2026-10-17T22:39:58.221Z","projectInsights":{"version":1,"whatItDoes":{"text":"Русский · English · Español · Português · Deutsch · Français · Italiano · Türkçe · Українська · Polski","sourceUrl":"https://github.com/sailxx/Okto/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Authentication → Sign-in method — включите Google. В Settings → Authorized domains добавьте sailxx.github.io.","sourceUrl":"https://github.com/sailxx/Okto/blob/main/README.md"}],"fingerprint":"e48d0b785d621ef060c64b627a0c71e7c0b26dcd04a40b14d700e080b2b97eba","sourceUrl":"https://github.com/sailxx/Okto/blob/main/README.md","checkedAt":"2026-10-17T22:39:58.221Z"},"overviewRepoUpdated":"2026-10-17T14:47:18Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/sailxx/Okto/blob/main/README.md","checkedAt":"2026-10-17T22:39:58.221Z","hash":"e48d0b785d621ef060c64b627a0c71e7c0b26dcd04a40b14d700e080b2b97eba","originalBytes":6586,"storedBytes":6586,"truncated":false},"lastDemoCheckedAt":"2026-10-17T22:39:58.136Z","subjects":["Health & fitness","Android","Mobile","Browser extensions & PWAs"],"platforms":["Android"],"classification":{"version":4,"method":"local_rules","category":"Productivity","subjects":["Health & fitness","Android","Mobile","Browser extensions & PWAs"],"evidence":[{"subject":"Health & fitness","source":"metadata","match":"workout"},{"subject":"Android","source":"metadata","match":"android"},{"subject":"Mobile","source":"metadata","match":"android"},{"subject":"Browser extensions & PWAs","source":"metadata