{"repositoryId":1199592146,"availability":"available","full":"meridianlabs-ai/petri_bloom","name":"petri_bloom","description":"Framework for generating behavioral evaluations of frontier AI models.","category":"Developer tools","language":"Python","stars":40,"forks":6,"created":"2026-04-02T14:00:07Z","updated":"2026-10-19T14:49:18Z","license":"MIT","branch":"main","homepage":"https://meridianlabs-ai.github.io/petri_bloom/","topics":[],"demo":"https://meridianlabs-ai.github.io/petri_bloom/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-19T18:05:31.836Z","lastAttemptAt":"2026-10-19T18:05:31.836Z","lastAvailableAt":"2026-10-19T18:05:31.836Z","metrics":[{"at":"2026-10-19T18:05:31.836Z","stars":40,"forks":6}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["Welcome to Petri Bloom, an implementation of the Bloom automated evaluation tool using the Petri auditor/target framework.","Bloom generates evaluation suites that probe LLMs for specific behaviors (sycophancy, self-preservation, political bias, etc.). Given a \"seed\" configuration describing the target behavior and evaluation parameters, Bloom produces diverse test scenarios, runs conversations with the target model, and scores the results. The evaluation suite grows differently depending on how it's seeded—unlike fixed benchmarks, Bloom evaluations should be cited with their full seed configuration for reproducibility."],"features":[],"sourceUrl":"https://github.com/meridianlabs-ai/petri_bloom/blob/main/README.md","fingerprint":"f0e1d17c8c79481e3f4e38600f1f2b0962c598dbebcf18e737bfbb6823cda88f","extractedAt":"2026-10-19T18:05:31.925Z"},"overviewCheckedAt":"2026-10-19T18:05:31.925Z","projectInsights":{"version":1,"whatItDoes":{"text":"Welcome to Petri Bloom, an implementation of the Bloom automated evaluation tool using the Petri auditor/target framework.","sourceUrl":"https://github.com/meridianlabs-ai/petri_bloom/blob/main/README.md"},"audience":[],"requirements":[],"fin