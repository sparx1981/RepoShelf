{"repositoryId":1289874390,"availability":"available","full":"Ejajaka/canteen-ordering-system","name":"canteen-ordering-system","description":"A web-based tokenized canteen ordering system: React + TypeScript student app and staff dashboard on a shared Firebase backend.","category":"Design","language":"TypeScript","stars":0,"forks":0,"created":"2026-07-05T10:02:58Z","updated":"2026-10-11T05:51:33Z","branch":"main","homepage":"https://marvelous-pie-031cc1.netlify.app/","topics":["firebase","netlify","react","tailwindcss","typescript","vite"],"demo":"https://marvelous-pie-031cc1.netlify.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-18T15:44:56.654Z","lastAttemptAt":"2026-10-18T15:44:56.654Z","lastAvailableAt":"2026-10-18T15:44:56.654Z","metrics":[{"at":"2026-10-18T15:44:56.654Z","stars":0,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["A digital ordering platform for the college canteen. Students order and pay from their phone and collect a token instead of standing in line, while canteen staff get a dashboard to manage the menu, orders, and daily sales.","Peak canteen hours meant long queues, cash handling, and no easy way for staff to see what was selling or to track inventory. The project splits the problem into two applications that share one Firebase backend: one for students to order, one for staff to run the counter."],"features":["Browse the daily menu with photos, prices, and a favourites list","Add to cart and check out digitally; the cart syncs across devices","Wallet-based payment, with balance loaded at the counter","Order history and profile management","Add and manage menu items, with scheduling for availability"],"sourceUrl":"https://github.com/Ejajaka/canteen-ordering-system/blob/main/README.md","fingerprint":"24eb87a87c9edb6887fb1fa6514ba255e2743f9ffd05845ba841193b63dfaf83","extractedAt":"2026-10-18T15:44:56.771Z"},"overviewCheckedAt":"2026-10-18T15:44:56.771Z","projectInsights":{"version