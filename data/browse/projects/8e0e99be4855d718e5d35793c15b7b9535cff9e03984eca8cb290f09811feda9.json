 library of pre-built ontologies.","Build new diagrams using a visual editor.","Export your work into standard RDF/XML formats.","Create links between concepts.","Share your design diagrams with others."],"sourceUrl":"https://github.com/afrazpindari14-commits/Ontology-Playground/blob/main/README.md","fingerprint":"536d252f1895f6a96db1c51e52b05ee3ec53720220ae9654959df36e521ac283","extractedAt":"2026-10-08T07:34:43.837Z"},"overviewCheckedAt":"2026-10-11T06:14:22.277Z","projectInsights":{"version":1,"whatItDoes":{"text":"Ontology-Playground helps you learn how data models work. You can explore existing structures or build your own from scratch. The app runs directly in your web browser, which means your data stays on your computer. You do not need to install complex server software or manage databases to use this tool.","sourceUrl":"https://github.com/afrazpindari14-commits/Ontology-Playground/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"536d252f1895f6a96db1c51e52b05ee3ec53720220ae9654959df36e521ac283","sourceUrl":"https://github.com/afrazpindari14-commits/Ontology-Playground/blob/main/README.md","checkedAt":"2026-10-11T06:14:22.277Z"},"overviewRepoUpdated":"2026-10-11T05:46:00Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/afrazpindari14-commits/Ontology-Playground/blob/main/README.md","checkedAt":"2026-10-11T06:14:22.277Z","hash":"536d252f1895f6a96db1c51e52b05ee3ec53720220ae9654959df36e521ac283","originalBytes":3077,"storedBytes":3077,"truncated":false},"lastDemoCheckedAt":"2026-10-11T06:14:22.136Z","subjects":["Science"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["Science"],"evidence":[{"subject":"Science","source":"metadata","match":"science"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://afrazpindari14-commits.github.io/","attemptedAt":