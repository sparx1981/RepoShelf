{"repositoryId":885570091,"availability":"available","full":"robertwaksmunski/parse-wiki-text","name":"parse-wiki-text","description":"Explore this public GitHub project.","category":"Productivity","language":"Rust","stars":0,"forks":0,"created":"2024-11-08T21:10:34Z","updated":"2024-11-08T21:14:02Z","license":"MIT-0","branch":"master","homepage":null,"topics":[],"demo":"https://portstrom.com/parse_wiki_text_sandbox/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-17T12:30:10.205Z","lastAttemptAt":"2026-10-17T12:30:10.205Z","lastAvailableAt":"2026-10-17T12:30:10.205Z","metrics":[{"at":"2026-10-17T12:30:10.205Z","stars":0,"forks":0}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["Parse wiki text from Mediawiki into a tree of elements.","Wiki text is a format that follows the PHP maxim “Make everything as inconsistent and confusing as possible”. There are hundreds of millions of interesting documents written in this format, distributed under free licenses on sites that use the Mediawiki software, mainly Wikipedia and Wiktionary. Being able to parse wiki text and process these documents would allow access to a significant part of the world's knowledge.","The Mediawiki software itself transforms a wiki text document into an HTML document in an outdated format to be displayed in a browser for a human reader. It does so through a step by step procedure of string substitutions, with some of the steps depending on the result of previous steps. The main file for this procedure has 6200 lines of code and the second biggest file has 2000, and then there is a 1400 line file just to take options for the parser."],"features":[],"sourceUrl":"https://github.com/robertwaksmunski/parse-wiki-text/blob/master/readme.md","fingerprint":"64864b9d98c9129c57e04b7d1caa7c4e9ca626e2c2b282f65782f18b48aef396","extractedAt":"2026-10-17T12:30:10.398Z"},"overviewCheckedAt":"2026-10-17T12:30:10.398Z","projectInsights":{"version":1,"whatItDoes":{"text":"Parse wiki text from Mediawiki into a tree of elements.","sourceUrl":"https://github.com/robertwaksmunski/parse-wiki-text/blob/master/readme.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"That crate however doesn't take into account any of the astonishing amount of weirdness required to correctly parse wiki text.","sourceUrl":"https://github.com/robertwaksmunski/parse-wiki-text/blob/master/readme.md"}],"fingerprint":"64864b9d98c9129c57e04b7d1caa7c4e9ca626e2c2b282f65782f18b48aef396","sourceUrl":"https://github.com/robertwaksmunski/parse-wiki-text/blob/master/readme.md","checkedAt":"2026-10-17T12:30:10.399Z"},"overviewRepoUpdated":"2024-11-08T21:14:02Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/robertwaksmunski/parse-wiki-text/blob/master/readme.md","checkedAt":"2026-10-17T12:30:10.400Z","hash":"64864b9d98c9129c57e04b7d1caa7c4e9ca626e2c2b282f65782f18b48aef396","originalBytes":9640,"storedBytes":9640,"truncated":false},"lastDemoCheckedAt":"2026-10-17T12:30:10.205Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Productivity","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Templates & UI components","Writing & documents"],"reviewRequired":true},"demoHealth":{"url":"https://portstrom.com/parse_wiki_text_sandbox/","attemptedAt":"2026-10-17T14:47:45.346Z","probeVersion":3,"status":"unknown","consecutiveTemporaryFailures":2,"error":{"reason":"dns_not_found","at":"2026-10-17T14:47:45.346Z"},"nextCheckAt":"2026-11-16T14:47:45.346Z"},"previewAttemptAt":"2026-10-17T14:47:45.346Z","previewCheck":{"url":"https://portstrom.com/parse_wiki_text_sandbox/","attemptedAt":"2026-10-17T14:47:45.346Z","consecutiveFailures":2,"status":"retry","reason":"dns_not_found","nextCheckAt":"2026-11-16T14:47:45.346Z"},"qualityPriority":false,"spaces":[]}