 afterwards: placeholders and a generated music bed until the real"],"sourceUrl":"https://github.com/0xMadMaks/Dino-Crab/blob/main/README.md","fingerprint":"04376b40f76761d13b6d761cf38ea6f0554e99ab25c4b8a6a301510858a0aa1c","extractedAt":"2026-10-09T10:25:07.917Z"},"overviewCheckedAt":"2026-10-10T21:54:57.114Z","projectInsights":{"version":1,"whatItDoes":{"text":"一只恐龙宝宝从巨蛋中破壳而出，原来它是一只螃蟹机器人：开源 Jumper 的皮肤、动作应用与场景，一次搞定。","sourceUrl":"https://github.com/0xMadMaks/Dino-Crab/blob/main/README.md"},"audience":[{"text":"▶ Watch on X: · made for @KingKongRobo's Crab Robot Challenge","sourceUrl":"https://github.com/0xMadMaks/Dino-Crab/blob/main/README.md"}],"requirements":[],"fingerprint":"04376b40f76761d13b6d761cf38ea6f0554e99ab25c4b8a6a301510858a0aa1c","sourceUrl":"https://github.com/0xMadMaks/Dino-Crab/blob/main/README.md","checkedAt":"2026-10-10T21:54:57.114Z"},"overviewRepoUpdated":"2026-10-09T08:37:44Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/0xMadMaks/Dino-Crab/blob/main/README.md","checkedAt":"2026-10-10T21:54:57.114Z","hash":"04376b40f76761d13b6d761cf38ea6f0554e99ab25c4b8a6a301510858a0aa1c","originalBytes":7619,"storedBytes":7619,"truncated":false},"demoEvidence":{"kind":"x_link","repository":"0xMadMaks/Dino-Crab","postUrl":"https://x.com/i/web/status/2108484722263208375","url":"https://beunlimited.me/en/resources/0b4a9cfe-94c6-4336-ad34-074f73eb6b26"},"demoHealth":{"url":"https://beunlimited.me/en/resources/0b4a9cfe-94c6-4336-ad34-074f73eb6b26","attemptedAt":"2026-10-16T09:40:40.759Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T09:40:40.759Z","lastWorkingAt":"2026-10-16T09:40:40.759Z","target":"https://beunlimited.me/en/resources/0b4a9cfe-94c6-4336-ad34-074f73eb6b26","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-23T09:40:40.759Z"},"previewCheck":{"url":"https://beunlimited.me/en/resources/0b4a9cfe-94c6-4336-ad34-074f73eb6b26","attemptedAt":"2026-10-16T09:40:40.759Z","consecutiveFailures"