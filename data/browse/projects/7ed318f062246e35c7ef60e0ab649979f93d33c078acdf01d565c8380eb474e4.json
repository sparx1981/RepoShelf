r: fires, auctions, strangers,","Weather and night. Mist, fog, rain and storms; gas lamps and lit windows after dark; tides,"],"sourceUrl":"https://github.com/Steve-Sitax/Moodygame/blob/main/README.md","fingerprint":"a4e2303ed2cfa59832238ceb129ade170438a6d903b6564f61f9b9c0fede2dbd","extractedAt":"2026-10-15T23:48:12.282Z"},"overviewCheckedAt":"2026-10-15T23:48:12.282Z","projectInsights":{"version":1,"whatItDoes":{"text":"Antwerp, autumn 1873. Fog on the Scheldt, work on the quays, and a town that remembers you.","sourceUrl":"https://github.com/Steve-Sitax/Moodygame/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"a4e2303ed2cfa59832238ceb129ade170438a6d903b6564f61f9b9c0fede2dbd","sourceUrl":"https://github.com/Steve-Sitax/Moodygame/blob/main/README.md","checkedAt":"2026-10-15T23:48:12.283Z"},"overviewRepoUpdated":"2026-10-15T21:26:18Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Steve-Sitax/Moodygame/blob/main/README.md","checkedAt":"2026-10-15T23:48:12.283Z","hash":"a4e2303ed2cfa59832238ceb129ade170438a6d903b6564f61f9b9c0fede2dbd","originalBytes":9326,"storedBytes":9326,"truncated":false,"searchTerms":["game","native-godot","town","claude","native","godot","code","open","work","every","nbsp","play","server","under","were","about","made","notes","opens","rules","runs","see","start","build","full","installed","license","multiplayer","own","run","source","steve","their","version","what","written","cc0","checks","codex","fog","fonts","free","key","layouts","model","npm","people","project","readme.md","scheldemist","scheldemistpackages","scripts","services","standalone","street","townspeople","traced","uses","vuillaume","address","after","anthropic","any","assets","attribution.md","bake","browser","built","checkout","choice","conversion","counted","data","development","dialogue","docs","engine","esc","export","file","font","host","inside","join","keep","licence","licence.","main","map","map.","menu","million","most",