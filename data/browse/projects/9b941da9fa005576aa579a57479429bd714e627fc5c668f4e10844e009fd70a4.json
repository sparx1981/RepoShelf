{"availability":"available","full":"TabularisDB/explain-plan","name":"explain-plan","description":"Free online EXPLAIN plan visualizer for PostgreSQL, MySQL/MariaDB and SQLite: paste a plan, explore it as an interactive graph, diagram, table and stats. Powered by @tabularis/explain.","category":"Other","language":"TypeScript","stars":3,"forks":1,"created":"2026-07-24T21:51:23Z","updated":"2026-10-08T18:38:53Z","license":"Apache-2.0","branch":"main","homepage":"https://explain.tabularis.dev","topics":["explain-plan","mariadb","mysql","postgresql","query-optimization","query-plan","react","sql","sqlite","tabularis","typescript","visualization"],"demo":"https://explain.tabularis.dev/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-09T15:33:13.091Z","lastAttemptAt":"2026-10-09T15:33:13.091Z","lastAvailableAt":"2026-10-09T15:33:13.091Z","lastDemoCheckedAt":"2026-10-09T15:33:13.091Z","discoveredVia":[],"metrics":[{"at":"2026-10-09T15:33:13.091Z","stars":3,"forks":1}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["A free online EXPLAIN plan visualizer. Paste the EXPLAIN output of a PostgreSQL, MySQL/MariaDB, SQLite, SQL Server or Oracle query and explore it as an interactive graph, diagram, table and statistics view, with automatic performance findings.","Try it online · Use it in Tabularis · npm package · Discord"],"features":["Four views: an interactive graph, a compact diagram, a sortable table and summary statistics.","Automatic findings: hotspots, bad row estimates, disk sorts, large sequential scans and cache misses are flagged on each node.","Encrypted sharing links: the plan is encrypted in the browser before it is stored, and the key exists only in the link, so the server cannot read it. Links expire 30 days after they were last opened.","Auto-detection: the engine and format are detected from the pasted text, or you can pick them by hand.","Plans are parsed in your browser and no query is ever executed. Nothing is sent anywhere until you click Share, and a shared plan is encrypted before it leaves your browser."],"sourceUrl":"https://github.com/TabularisDB/explain-plan/blob/main/README.md","fingerprint":"b713b210f38730d96d13a6b6bdce99988a953601534c54b1d828464e3f95c7bb","extractedAt":"2026-10-09T15:33:13.091Z"},"overviewCheckedAt":"2026-10-09T15:33:13.091Z","projectInsights":{"version":1,"whatItDoes":{"text":"A free online EXPLAIN plan visualizer. Paste the EXPLAIN output of a PostgreSQL, MySQL/MariaDB, SQLite, SQL Server or Oracle query and explore it as an interactive graph, diagram, table and statistics view, with automatic performance findings.","sourceUrl":"https://github.com/TabularisDB/explain-plan/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"b713b210f38730d96d13a6b6bdce99988a953601534c54b1d828464e3f95c7bb","sourceUrl":"https://github.com/TabularisDB/explain-plan/blob/main/README.md","checkedAt":"2026-10-09T15:33:13.091Z"},"overviewRepoUpdated":"2026-10-08T18:38:53Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/TabularisDB/explain-plan/blob/main/README.md","checkedAt":"2026-10-09T15:33:13.091Z","hash":"b713b210f38730d96d13a6b6bdce99988a953601534c54b1d828464e3f95c7bb","originalBytes":7414,"storedBytes":7414,"truncated":false,"searchTerms":["value","plan","explain","object","pnpm","json","tabularis","build","oracle","sql","cost","links","server","table","worker","format","run","after","engine","name","plans","predicates","query","sharing","analyze","app","bash","browser","clob","coverage","days","dev","encrypted","graph","last","license","link","only","output","parent","returning","rows","select","seo","seo.config.json","statistics","test","text","time","vite","xml","access","alias","automatic","before","bytes","cardinality","ciphertext","cloudflare","command","cpu","css","deploy","deployed","depth","development","diagram","dist","each","expire","filter","formats","home","interactive","key","mariadb","mysql","never","n