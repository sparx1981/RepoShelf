{"repositoryId":1294564275,"availability":"available","full":"Stellar-IndigoPay/Stellar-IndigoPay","name":"Stellar-IndigoPay","description":"Stellar-IndigoPay is an open-source climate donation platform built on the Stellar network. Donors give XLM directly to verified environmental projects — funds never touch a custodian. Every donation is recorded on-chain via a Soroban smart contract, so total impact, donor reputation.","category":"Other","language":"TypeScript","stars":27,"forks":138,"created":"2026-07-09T02:43:24Z","updated":"2026-09-13T19:13:10Z","license":"MIT","branch":"main","homepage":"https://stellar-indigo-pay.vercel.app","topics":[],"demo":"https://stellar-indigo-pay.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-16T02:48:36.382Z","lastAttemptAt":"2026-10-16T02:48:36.382Z","lastAvailableAt":"2026-10-16T02:48:36.382Z","metrics":[{"at":"2026-10-16T02:48:36.382Z","stars":27,"forks":138}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["[]( []( []( []( [](#-pitch-video) []( []( []( []( []( []( [](docs/gas-optimization.md) []( []( [](","🌐 Live Demo · 📱 Mobile App · 🧩 Chrome Extension · 📚 Docs · 💬 Telegram · 🚀 Quick Start","Stellar-IndigoPay is an open-source climate donation platform built on the Stellar network. Donors give XLM (and USDC) directly to verified environmental projects — funds never touch a custodian. Every donation is recorded on-chain via a Soroban smart contract, so total impact, donor reputation, and CO₂ offsets are publicly auditable by anyone, in any language, on any device."],"features":["🔐 Custody-minimised — XLM goes directly from donor wallet to project wallet. The platform never holds funds.","📜 On-chain transparency — Soroban is the single source of truth. Anyone can read getproject(), getdonorstats(), getglobaltotal() without trusting us.","🪪 No accounts — your Stellar keypair is your identity. No email, no password, no recovery phone.","🏷 Reputation you own — Impact badges (🌱 Seedling, 🌳 Tree, 🌲 Forest, 🌍 Earth Guardian) and Impact NFTs are wallet-bound and travel with you across dApps.","💱 Multi-currency — Donate in XLM or USDC. USDC amounts are converted via a configurable on-chain price oracle."],"sourceUrl":"https://github.com/Stellar-IndigoPay/Stellar-IndigoPay/blob/main/README.md","fingerprint":"46cfaa5734282ea3e746e03a8f69ffeb923a6fa7509413ce4eb6645112ffc655","extractedAt":"2026-10-16T02:48:36.501Z"},"overviewCheckedAt":"2026-10-16T02:48:36.501Z","projectInsights":{"version":1,"whatItDoes":{"text":"[]( []( []( []( [](#-pitch-video) []( []( []( []( []( []( [](docs/gas-optimization.md) []( []( [](","sourceUrl":"https://github.com/Stellar-IndigoPay/Stellar-IndigoPay/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"🪪 No accounts — your Stellar keypair is your identity.","sourceUrl":"https://github.com/Stellar-IndigoPay/Stellar-IndigoPay/blob/main/README.md"}],"fingerprint":"46cfaa5734282ea3e746e03a8f69ffeb923a6fa7509413ce4eb6645112ffc655","sourceUrl":"https://github.com/Stellar-IndigoPay/Stellar-IndigoPay/blob/main/README.md","checkedAt":"2026-10-16T02:48:36.502Z"},"overviewRepoUpdated":"2026-09-13T19:13:10Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Stellar-IndigoPay/Stellar-IndigoPay/blob/main/README.md","checkedAt":"2026-10-16T02:48:36.504Z","hash":"46cfaa5734282ea3e746e03a8f69ffeb923a6fa7509413ce4eb6645112ffc655","originalBytes":39438,"storedBytes":39438,"truncated":false},"lastDemoCheckedAt":"2026-10-16T02:48:36.382Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Crypto & blockchain","Automation & workflows","Mobile","Streaming","Travel","Browser extensions & PWAs","Data & dashboards","Privacy & security"],"reviewRequired":true},"demoHealth":{"url":