{"full":"hf:ACloudCenter/Conference-Generator-VibeVoice","spaceId":"ACloudCenter/Conference-Generator-VibeVoice","name":"Conference Generator VibeVoice","source":"huggingface","description":"An interactive AI application on Hugging Face Spaces.","category":"AI & machine learning","language":null,"topics":["docker","region:us"],"technologies":[],"likes":34,"created":"2025-09-02T05:52:08.000Z","updated":"2026-09-12T20:23:13.000Z","license":null,"runtime":"RUNNING","appUrl":"https://acloudcenter-conference-generator-vibevoice.hf.space/","demo":"https://huggingface.co/spaces/ACloudCenter/Conference-Generator-VibeVoice","availability":"available","lastCheckedAt":"2026-10-06T06:43:33.382Z","lastAttemptAt":"2026-10-06T06:43:33.382Z","lastAvailableAt":"2026-10-06T06:43:33.382Z","color":"#3c3250","ink":"#e4d4ff","symbol":"⭐","overview":{"kind":"readme","version":1,"paragraphs":["Turn a one-line prompt, or your own script, into a full multi-speaker conversation: meetings, podcasts, interviews, debates, talks. An LLM writes the script to a target length, and a GPU backend renders it with Microsoft's VibeVoice — chunked in parallel, seamed with crossfades, and quality-gated — so a two-hour take renders in about twenty minutes and starts playing while it's still rendering.","VibeVoice is Microsoft's open-source long-form, multi-speaker TTS model. It uses a frozen LLM backbone with acoustic + semantic tokenizers at 7.5 Hz and a diffusion head to produce up to 90 minutes of conversational audio with up to 4 speakers in a single pass. Chorus's chunked pipeline lifts that ceiling."],"features":["Prompt-to-script — describe the scenario (\"a 4-person product meeting about pricing\") and Qwen2.5-Coder-32B writes the full conversation, with a title","Target length — pick 1 to 45 minutes; the script is extended in continuation rounds until it reaches the word budget","Bring your own script — paste or upload text using Speaker N: tags or named characters","Turn editor — reassign speakers or rewrite any line before rendering","Gender-aware casting — characters get a matching voice automatically, with one-click override"],"sourceUrl":"https://huggingface.co/spaces/ACloudCenter/Conference-Generator-VibeVoice/blob/main/README.md","fingerprint":"1e887a4c723de67714a460b675ad2bb75d339c86177fd771626baa9f5d9fba15","extractedAt":"2026-10-06T06:43:33.521Z"},"overviewCheckedAt":"2026-10-06T06:43:33.521Z","projectInsights":{"version":1,"whatItDoes":{"text":"Turn a one-line prompt, or your own script, into a full multi-speaker conversation: meetings, podcasts, interviews, debates, talks. An LLM writes the script to a target length, and a GPU backend renders it with Microsoft's VibeVoice — chunked in parallel, seamed with crossfades, and quality-gated — so a two-hour take renders in about twenty minutes and starts playing while it's still rendering.","sourceUrl":"https://huggingface.co/spaces/ACloudCenter/Conference-Generator-VibeVoice/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"1e887a4c723de67714a460b675ad2bb75d339c86177fd771626baa9f5d9fba15","sourceUrl":"https://huggingface.co/spaces/ACloudCenter/Conference-Generator-VibeVoice/blob/main/README.md","checkedAt":"2026-10-06T06:43:33.521Z"},"overviewRepoUpdated":"2026-09-12T20:23:13.000Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://huggingface.co/spaces/ACloudCenter/Conference-Generator-VibeVoice/blob/main/README.md","checkedAt":"2026-10-06T06:43:33.521Z","hash":"1e887a4c723de67714a460b675ad2bb75d339c86177fd771626baa9f5d9fba15","originalBytes":11178,"storedBytes":11178,"truncated":false,"searchTerms":["modal","script","backend","voices","vibevoice","librivox","voice","audio","chunks","public","gpu","model","original","pre-1923","renders","space","turn","chunk","min","one","own","preset","token","api","docker","domain","face","fastapi","frontend","gate","hugging","inference","live","minutes","multi-speaker","per","progress","realtime","recording","speakers","start","t