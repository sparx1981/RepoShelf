{"availability":"available","full":"ikTheProgrammer1/guide-showcase","name":"guide-showcase","description":"A WebMCP demo where Northstar Health transforms from a dense legacy portal into an interface adapted around the person.","category":"Other","language":"TypeScript","stars":0,"forks":0,"created":"2026-09-03T02:36:53Z","updated":"2026-09-04T00:01:10Z","license":"MIT","branch":"main","homepage":"https://guide-webmcp.vercel.app","topics":["accessibility","human-computer-interaction","react","webmcp"],"demo":"https://guide-webmcp.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-11T22:40:05.621Z","lastAttemptAt":"2026-10-11T22:40:05.621Z","lastAvailableAt":"2026-10-11T22:40:05.621Z","metrics":[{"at":"2026-10-11T22:40:05.621Z","stars":0,"forks":0}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["Describe what you need → the website reshapes itself → complete the task with your agent.","Guide is a WebMCP-native experience inside Northstar Health, a fictional patient-services portal. It demonstrates a website that can become the right interface for a particular person instead of forcing everyone through the same fixed design.","The person uses their preferred client agent. Northstar exposes its real goals, workflow state, adaptation options, prerequisites, decisions, and consequences. The agent requests a bounded website-authored experience, and the same semantic React interface reorganizes immediately around the person and task."],"features":[],"sourceUrl":"https://github.com/ikTheProgrammer1/guide-showcase/blob/main/README.md","fingerprint":"25f3b9ecb612f53468b7ae04952a2b582f1178fc96b211fd2290320fc1b0ec7c","extractedAt":"2026-10-11T22:40:05.800Z"},"overviewCheckedAt":"2026-10-11T22:40:05.800Z","projectInsights":{"version":1,"whatItDoes":{"text":"Describe what you need → the website reshapes itself → complete the task with your agent.","sourceUrl":"https://github.com/ikTheProgrammer1/guide-showcase/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Guide tools require a supported ChatGPT desktop account and model using the built-in browser, or a WebMCP-enabled Chrome environment.","sourceUrl":"https://github.com/ikTheProgrammer1/guide-showcase/blob/main/README.md"}],"fingerprint":"25f3b9ecb612f53468b7ae04952a2b582f1178fc96b211fd2290320fc1b0ec7c","sourceUrl":"https://github.com/ikTheProgrammer1/guide-showcase/blob/main/README.md","checkedAt":"2026-10-11T22:40:05.800Z"},"overviewRepoUpdated":"2026-09-04T00:01:10Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/ikTheProgrammer1/guide-showcase/blob/main/README.md","checkedAt":"2026-10-11T22:40:05.801Z","hash":"25f3b9ecb612f53468b7ae04952a2b582f1178fc96b211fd2290320fc1b0ec7c","originalBytes":11971,"storedBytes":11971,"truncated":false},"lastDemoCheckedAt":"2026-10-11T22:40:05.621Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Simulation & physics","Automation & workflows","Mobile","MCP servers & agents"],"reviewRequired":true},"demoHealth":{"url":"https://guide-webmcp.vercel.app/","attemptedAt":"2026-10-11T22:56:24.436Z","probeVersion":3,"status":"working","checkedAt":"2026-10-11T22:56:24.436Z","lastWorkingAt":"2026-10-11T22:56:24.436Z","target":"https://guide-webmcp.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-18T22:56:24.436Z"},"previewAttemptAt":"2026-10-11T22:56:24.436Z","previewCheck":{"url":"https://guide-webmcp.vercel.app/","attemptedAt":"2026-10-11T22:56:24.436Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-18T22:56:24.436Z"},"screenshots":[{"src":"previews/cf4eac4a2b8dfdd29f5a5b26.jpg","kind":"demo","capturedAt":"2026-10-11T22:56:24.436Z","url":"https://guide-webmcp.v