{"repositoryId":274411806,"availability":"available","full":"snatalenko/morphos","name":"morphos","description":"Declarative JSON data transformation and object mapping library for JavaScript/TypeScript with mapping templates, schema-based helpers, and safe VM execution","category":"Developer tools","language":"TypeScript","stars":6,"forks":1,"created":"2020-06-23T13:23:10Z","updated":"2026-09-12T01:30:24Z","license":"Apache-2.0","branch":"master","homepage":"https://morphosjs.org","topics":["config-driven","declarative","json-mapper","json-to-json","json-transformer","mapping","object-mapper","typescript"],"demo":"https://morphosjs.org/playground/#/bootstrap53","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-16T07:15:26.629Z","lastAttemptAt":"2026-10-16T07:15:26.629Z","lastAvailableAt":"2026-10-16T07:15:26.629Z","metrics":[{"at":"2026-10-16T07:15:26.629Z","stars":6,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["JSON-to-JSON mapper with user-defined JSON mapping specs, plain JS transformation expressions, and isolated VM execution.","Users define the mapping as JSON, so it can be stored, versioned, generated, or edited from a UI. Unlike many transformation tools, it does not invent a custom expression language: field transforms are plain JavaScript expressions, executed in a restricted VM context for predictable behavior without giving mappings access to the host environment."],"features":["JSON-defined - mappings are JSON documents, so they are easy to store, diff, generate, validate, and edit from a UI.","JavaScript-native - transformations use ordinary JavaScript expressions instead of a custom DSL.","Isolated - expressions run in a separate V8 Virtual Machine context with restricted access to the outside environment.","Fast - mapping instructions are compiled once into a reusable mapper; the repository includes simple and complex throughput benchmarks.","Typed - written in TypeScript with declarations for mappings, schemas, editors, and integrations."],"sourceUrl":"https://github.com/snatalenko/morphos/blob/master/README.md","fingerprint":"7e3f5ee4a8d3647f16b03d8946d61d514e5796993e287a97d2aecc1a8eaa5a15","extractedAt":"2026-10-16T07:15:26.720Z"},"overviewCheckedAt":"2026-10-16T07:15:26.720Z","projectInsights":{"version":1,"whatItDoes":{"text":"JSON-to-JSON mapper with user-defined JSON mapping specs, plain JS transformation expressions, and isolated VM execution.","sourceUrl":"https://github.com/snatalenko/morphos/blob/master/README.md"},"audience":[],"requirements":[{"kind":"paid_service","status":"optional","text":"It has a performance cost, so use it only when executing mappings that cannot be trusted.","sourceUrl":"https://github.com/snatalenko/morphos/blob/master/README.md"}],"fingerprint":"7e3f5ee4a8d3647f16b03d8946d61d514e5796993e287a97d2aecc1a8eaa5a15","sourceUrl":"https://github.com/snatalenko/morphos/blob/master/README.md","checkedAt":"2026-10-16T07:15:26.721Z"},"overviewRepoUpdated":"2026-09-12T01:30:24Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/snatalenko/morphos/blob/master/README.md","checkedAt":"2026-10-16T07:15:26.722Z","hash":"7e3f5ee4a8d3647f16b03d8946d61d514e5796993e287a97d2aecc1a8eaa5a15","originalBytes":18567,"storedBytes":18567,"truncated":false,"searchTerms":["json","mapping","map","foreach","mappings","key","context","when","arrays","object","array","input","morphos","current","mapper","result","schema","editor","foo","source","name","objects","react","string","expressions","fields","index","output","same","value","destination","extensions","import","instructions","runtime","users","values","anthropic","arrayinnerproperty","code","createmapper","document","element","extension","field","javascript","keys","only","openai","properties","record","see","selected","available","before","else","inside","instead","mapped","need","plain","still","through","build","collection","conditional","data","editors","entire","example