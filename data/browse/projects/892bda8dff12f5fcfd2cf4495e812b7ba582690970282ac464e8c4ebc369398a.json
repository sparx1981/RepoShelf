{"repositoryId":1374236670,"availability":"available","full":"princehk0101/skilloriya-job-portal","name":"skilloriya-job-portal","description":"Explore this public GitHub project.","category":"Other","language":"JavaScript","stars":1,"forks":0,"created":"2026-09-17T09:57:00Z","updated":"2026-10-12T08:48:35Z","branch":"main","homepage":"https://skilloriya-job-portal.vercel.app","topics":[],"demo":"https://skilloriya-job-portal.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-12T11:45:59.514Z","lastAttemptAt":"2026-10-12T11:45:59.514Z","lastAvailableAt":"2026-10-12T11:45:59.514Z","metrics":[{"at":"2026-10-12T11:45:59.514Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Skilloriya is a production-grade, skill-oriented job portal and recruitment management platform. Traditional recruitment platforms often rely exclusively on static keyword searches and unverified resumes. Skilloriya introduces a competency-first hiring pipeline with automated ATS resume parsing, interactive 7-track skill assessments, seamless direct auto-login on signup, and a centralized recruiter Applicant Tracking System (ATS)."],"features":["Direct Auto-Login on Registration: Stateless SimpleJWT token pair issued immediately upon candidate or recruiter signup — zero redundant login prompts.","Automated ATS Resume Parsing: Dual-engine parsing using PyPDF, Google Gemini 1.5 Flash, and an offline heuristic regex NLP engine to auto-extract name, email, phone, skills, experience, and education.","Cloud CDN Document & Media Storage: All profile photos, company logos, and candidate PDF resumes are offloaded to ImageKit.io Cloud CDN with fast global delivery.","Interactive Skill Assessment Engine: 7 pre-built assessment tracks (React, Django, Full-Stack, ML/GenAI, DevOps, TypeScript, SQL) with 140+ curated questions, timed test runs, auto-grading, and profile score badges.","Recruiter ATS Hiring Funnel: Recruiters review candidate profiles, inspect cloud PDF resumes, and transition applicants across hiring stages: Applied ➔ Screening ➔ Interview ➔ Offered ➔ Rejected."],"sourceUrl":"https://github.com/princehk0101/skilloriya-job-portal/blob/main/README.md","fingerprint":"23d5c414d64a2b5f7fa60e73a8e02eb9c75a8fd07f755e3e83d643f02de3cb95","extractedAt":"2026-10-12T11:45:59.653Z"},"overviewCheckedAt":"2026-10-12T11:45:59.653Z","projectInsights":{"version":1,"whatItDoes":{"text":"Skilloriya is a production-grade, skill-oriented job portal and recruitment management platform. Traditional recruitment platforms often rely exclusively on static keyword searches and unverified resumes. Skilloriya introduces a competency-first hiring pipeline with automated ATS resume parsing, interactive 7-track skill assessments, seamless direct auto-login on signup, and a centralized recruiter Applicant Tracking System (ATS).","sourceUrl":"https://github.com/princehk0101/skilloriya-job-portal/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Skilloriya introduces a competency-first hiring pipeline with automated ATS resume parsing, interactive 7-track skill assessments, seamless direct auto-login on signup, and a centralized recruiter Applicant Tracking System (ATS).","sourceUrl":"https://github.com/princehk0101/skilloriya-job-portal/blob/main/README.md"},{"kind":"account","status":"required","text":"Direct Auto-Login on Registration: Stateless SimpleJWT token pair issued immediately upon candidate or recruiter signup — zero redundant login prompts.","sourceUrl":"https://github.com/princehk0101/skilloriya-job-portal/blob/main/README.md"}],"fingerprint":"23d5c414d64a2b5f7fa60e73a8e02eb9c75a8fd07f755e3e83d643f02de3cb95","sourceUrl":"https://github.com/princehk0101/skilloriya-job-portal/blob/main/README.md","checkedAt":"2026-10-12T11:45:59.654Z"},"overviewRepoUpdated":"2026-10-12T08:48:35Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/princehk010