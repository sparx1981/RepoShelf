{"repositoryId":1323759686,"availability":"available","full":"delta-box/deltabox-lite","name":"deltabox-lite","description":"Lightweight, agent-native sandboxing with diff, commit and abort","category":"Other","language":"Rust","stars":92,"forks":1,"created":"2026-08-05T07:26:07Z","updated":"2026-10-16T15:10:32Z","license":"Apache-2.0","branch":"main","homepage":"https://delta-box.github.io","topics":["agent-sandbox","dsh-plugin","harness","pi-plugin","sandbox"],"demo":"https://delta-box.github.io/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-16T18:01:13.436Z","lastAttemptAt":"2026-10-16T18:01:13.436Z","lastAvailableAt":"2026-10-16T18:01:13.436Z","lastDemoCheckedAt":"2026-10-16T18:01:13.436Z","discoveredVia":[],"metrics":[{"at":"2026-10-15T14:52:34.724Z","stars":13,"forks":1},{"at":"2026-10-16T18:01:13.436Z","stars":92,"forks":1}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["Lightweight, agent-native sandboxing with diff · commit · abort.","Give agents a confined workspace with explicit diff, commit, and abort semantics.","deltabox-lite is a standalone sandbox runtime for AI coding agents. Agents keep full execution freedom inside a confined filesystem view, and every change they make can be reviewed, committed, or aborted - per task or per tool call. Linux defaults to a commit-biased FUSE view; macOS uses native APFS clones and FSEvents. Private modes keep changes hidden from the host until commit."],"features":["Native isolation, not a container - Linux composes Sandlock/Landlock/","seccomp with DeltaFS FUSE; macOS uses Seatbelt plus APFS clones and FSEvents.","Service-free durable sessions - Linux starts a session-scoped filesystem","helper and macOS starts a session-scoped event helper automatically. Durable files remain authoritative across independent CLI processes; no global daemon or manual service startup is required.","Three filesystem modes - cbcow-through makes changes visible"],"sourceUrl":"https://github.com/delta-box/deltabox-lite/blob/main/README.md","fingerprint":"aaca73719e651ddf2d62c3244de04549451d7a0cc2ce88b9075032706b9a6d11","extractedAt":"2026-10-15T14:52:34.724Z"},"overviewCheckedAt":"2026-10-16T18:01:13.532Z","projectInsights":{"version":1,"whatItDoes":{"text":"Lightweight, agent-native sandboxing with diff · commit · abort.","sourceUrl":"https://github.com/delta-box/deltabox-lite/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"aaca73719e651ddf2d62c3244de04549451d7a0cc2ce88b9075032706b9a6d11","sourceUrl":"https://github.com/delta-box/deltabox-lite/blob/main/README.md","checkedAt":"2026-10-16T18:01:13.533Z"},"overviewRepoUpdated":"2026-10-16T15:10:32Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/delta-box/deltabox-lite/blob/main/README.md","checkedAt":"2026-10-16T18:01:13.534Z","hash":"aaca73719e651ddf2d62c3244de04549451d7a0cc2ce88b9075032706b9a6d11","originalBytes":16126,"storedBytes":16126,"truncated":false},"subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","MCP servers & agents"],"reviewRequired":true},"demoHealth":{"url":"https://delta-box.github.io/","attemptedAt":"2026-10-16T18:22:57.425Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T18:22:57.425Z","lastWorkingAt":"2026-10-16T18:22:57.425Z","target":"https://delta-box.github.io/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-23T18:22:57.425Z"},"previewAttemptAt":"2026-10-16T18:22:57.425Z","previewCheck":{"url":"https://delta-box.github.io/","attemptedAt":"2026-10-16T18:22:57.425Z","consecutiveFailures":0,"status":"captured","reason":null,"nextCheckAt":"2026-10-23T18:22:57.425Z"},"screenshots":[{"src":"previews/3359a6ae2ce1a7e625a68b7d.jpg","kind":"demo","capturedAt":"2026-10-16T18:22:57.425Z","url":"https://delta-box.githu