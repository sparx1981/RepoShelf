{"repositoryId":984880737,"availability":"available","full":"felixpalmer/a5-py","name":"a5-py","description":"Pentagonal geospatial indexing system DGGS","category":"Other","language":"Python","stars":22,"forks":0,"created":"2025-05-16T17:03:23Z","updated":"2026-10-15T21:00:42Z","license":"Apache-2.0","branch":"main","homepage":"https://a5geo.org","topics":["a5","data-science","data-visualization","dggs","gis","map-visualization","maps","visualization"],"demo":"https://a5geo.org/examples/duckdb-playground","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-16T15:52:00.789Z","lastAttemptAt":"2026-10-16T15:52:00.789Z","lastAvailableAt":"2026-10-16T15:52:00.789Z","metrics":[{"at":"2026-10-16T15:52:00.789Z","stars":22,"forks":0}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["A5 is a geospatial index that partitions the world into pentagonal cells. The cells are available at 31 resolution levels, from a handful covering the whole world down to less than 30mm², and every cell at a given resolution has exactly the same area. Each cell is identified by a 64-bit integer, which is frozen from v1.0: an A5 cell ID stored today will refer to the same place in the future.","Once data is in cells, very different datasets can be joined, aggregated and compared directly: points can be counted per cell, as with the density of holiday rentals across a city, and regions such as countries or parcels of land become coverings, sets of cells which support union, intersection and difference."],"features":[],"sourceUrl":"https://github.com/felixpalmer/a5-py/blob/main/README.md","fingerprint":"07d665f35e543ab9b5535e2c86c3284be77e8a91075c0e6c3f71553099d2e26f","extractedAt":"2026-10-16T15:52:00.933Z"},"overviewCheckedAt":"2026-10-16T15:52:00.933Z","projectInsights":{"version":1,"whatItDoes":{"text":"A5 is a geospatial index that partitions the world into pentagonal cells. The cells are available at 31 resolution levels, from a handful covering the whole world down to less than 30mm², and every cell at a given resolution has exactly the same area. Each cell is identified by a 64-bit integer, which is frozen from v1.0: an A5 cell ID stored today will refer to the same place in the future.","sourceUrl":"https://github.com/felixpalmer/a5-py/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"07d665f35e543ab9b5535e2c86c3284be77e8a91075c0e6c3f71553099d2e26f","sourceUrl":"https://github.com/felixpalmer/a5-py/blob/main/README.md","checkedAt":"2026-10-16T15:52:00.933Z"},"overviewRepoUpdated":"2026-10-15T21:00:42Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/felixpalmer/a5-py/blob/main/README.md","checkedAt":"2026-10-16T15:52:00.934Z","hash":"07d665f35e543ab9b5535e2c86c3284be77e8a91075c0e6c3f71553099d2e26f","originalBytes":3234,"storedBytes":3234,"truncated":false},"lastDemoCheckedAt":"2026-10-16T15:52:00.789Z","subjects":["Maps & geospatial","Science","Data & dashboards"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Maps & geospatial","Science","Data & dashboards"],"evidence":[{"subject":"Maps & geospatial","source":"metadata","match":"geospatial"},{"subject":"Science","source":"metadata","match":"science"},{"subject":"Data & dashboards","source":"metadata","match":"data visualization"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://a5geo.org/examples/duckdb-playground","attemptedAt":"2026-10-16T16:07:47.470Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T16:07:47.470Z","lastWorkingAt":"2026-10-16T16:07:47.470Z","target":"https://a5geo.org/examples/duckdb-playground","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-23T16:07:47.470Z"},"previewAttemptAt":"2026-10-16T16:07:47.470Z","previewCheck":{"url":"https://a5geo.org/examples/duckdb-playground","attemptedAt":"2026-10-16T16