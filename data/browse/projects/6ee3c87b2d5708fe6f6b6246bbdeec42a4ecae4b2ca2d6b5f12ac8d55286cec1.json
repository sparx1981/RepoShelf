{"repositoryId":1262915654,"availability":"available","full":"metiutek/lithophane-studio","name":"lithophane-studio","description":"Turn any photo into a 3D print that glows in backlight. Free lithophane generator that runs in your browser — print-ready watertight STL/OBJ, live 3D preview, nothing uploaded, no sign-up.","category":"Developer tools","language":"JavaScript","stars":5,"forks":2,"created":"2026-06-08T12:50:47Z","updated":"2026-10-14T09:33:30Z","license":"MIT","branch":"main","homepage":"https://metiutek.github.io/lithophane-studio/","topics":["3d-model","3d-printing","3d-printing-tools","client-side","generator","heightmap","image-to-3d","image-to-stl","javascript","lithophane","lithophane-generator","mesh-generation","no-backend","obj","stl","stl-export","stl-generator","threejs","webapp","webgl"],"demo":"https://metiutek.github.io/lithophane-studio/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-15T19:33:05.519Z","lastAttemptAt":"2026-10-15T19:33:05.519Z","lastAvailableAt":"2026-10-15T19:33:05.519Z","metrics":[{"at":"2026-10-15T19:33:05.519Z","stars":5,"forks":2}],"technologies":["Three.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Drop in a picture, get a file your 3D printer can print.","Hold it up to a light and the photo appears. Free, runs in your browser, nothing is uploaded.","The usual lithophane generators upload your photo to a server, ask you to register, cap the resolution, or hand back a broken mesh. This one runs inside the page: your photo never leaves your computer, because there is nowhere for it to go — there is no backend at all. No account, no limit, no watermark, no cost."],"features":["Image to 3D — JPG / PNG / WEBP, drag & drop anywhere, paste with Ctrl+V, or try the built-in sample","3 shapes — flat panel, curved panel, cylinder lampshade (curved and cylinder are exported standing up, ready to print)","Geometry — width, min/max thickness, frame, curvature, detail level","Image adjustments — brightness, contrast, plus gamma, softness, mirror and invert under Advanced","Live 3D preview — orbit, zoom, wireframe, and a Backlit view that shows how the print glows"],"sourceUrl":"https://github.com/metiutek/lithophane-studio/blob/main/README.md","fingerprint":"792b94a58aed2b86720b6a013f38e045219ff5fb6201ea3ebfd7fd85d92e1d0a","extractedAt":"2026-10-15T19:33:05.680Z"},"overviewCheckedAt":"2026-10-15T19:33:05.680Z","projectInsights":{"version":1,"whatItDoes":{"text":"Drop in a picture, get a file your 3D printer can print.","sourceUrl":"https://github.com/metiutek/lithophane-studio/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"No account, no limit, no watermark, no cost.","sourceUrl":"https://github.com/metiutek/lithophane-studio/blob/main/README.md"}],"fingerprint":"792b94a58aed2b86720b6a013f38e045219ff5fb6201ea3ebfd7fd85d92e1d0a","sourceUrl":"https://github.com/metiutek/lithophane-studio/blob/main/README.md","checkedAt":"2026-10-15T19:33:05.681Z"},"overviewRepoUpdated":"2026-10-14T09:33:30Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/metiutek/lithophane-studio/blob/main/README.md","checkedAt":"2026-10-15T19:33:05.681Z","hash":"792b94a58aed2b86720b6a013f38e045219ff5fb6201ea3ebfd7fd85d92e1d0a","originalBytes":5658,"storedBytes":5658,"truncated":false},"lastDemoCheckedAt":"2026-10-15T19:33:05.519Z","subjects":["3D & graphics"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":["3D & graphics"],"evidence":[{"subject":"3D & graphics","source":"metadata","match":"3D"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Apple","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://metiutek.github.io/lithophane-studio/","attemptedAt":"2026-10-15T19:46:25.318Z","probeVersion":3,"status":"working","checkedAt":"2026-10-15T19:46:25.318Z","lastWorking