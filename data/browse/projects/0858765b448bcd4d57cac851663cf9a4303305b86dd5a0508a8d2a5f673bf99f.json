{"availability":"available","full":"akankshakusf/claude-hackathon-a2ui-demo","name":"claude-hackathon-a2ui-demo","description":"Describe any interface. Claude assembles a live, interactive UI from nothing — generative interfaces powered by Claude + A2UI + A2A","category":"AI & machine learning","language":"TypeScript","stars":1,"forks":0,"created":"2026-02-20T17:53:18Z","updated":"2026-02-21T23:01:55Z","branch":"main","homepage":"https://claude-hackathon-a2ui-demo.vercel.app","topics":["a2ui","anthropic","claude-ai","generative-ui","hackathon","nextjs"],"demo":"https://claude-hackathon-a2ui-demo.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T03:01:51.010Z","lastAttemptAt":"2026-10-18T03:01:51.010Z","lastAvailableAt":"2026-10-18T03:01:51.010Z","metrics":[{"at":"2026-10-11T22:41:01.783Z","stars":1,"forks":0},{"at":"2026-10-18T03:01:51.010Z","stars":1,"forks":0}],"technologies":["Next.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Describe any interface. Claude reasons about your intent and assembles a live, interactive UI from nothing.","Instead of Claude describing a UI in text, Claude is the UI. You type a sentence, and a fully interactive form, dashboard, card, or list materializes on screen — built by the agent at runtime using the A2UI declarative JSON protocol over A2A (Agent-to-Agent) JSON-RPC. Every refinement is saved as a versioned snapshot you can revisit, preview live, and branch from.","The A2UI JSON schema is deeply nested — components reference each other by string ID, data bindings use path expressions, the entire tree must be self-consistent, and surfaceId must stay constant across all 3 messages. Claude's instruction-following capabilities make this reliable where other models fail. The agent validates every response with Python's jsonschema and auto-retries with targeted error messages on failure. Conversation history enables Claude to make surgical refinements — changing one field without rebuilding the entire surface."],"features":[],"sourceUrl":"https://github.com/akankshakusf/claude-hackathon-a2ui-demo/blob/main/README.md","fingerprint":"58b77c1ea8c251e54bdb49f119b93eee1a305c3ad5f49282e793416729a2f793","extractedAt":"2026-10-11T22:41:02.036Z"},"overviewCheckedAt":"2026-10-11T22:41:02.036Z","projectInsights":{"version":1,"whatItDoes":{"text":"Describe any interface. Claude reasons about your intent and assembles a live, interactive UI from nothing.","sourceUrl":"https://github.com/akankshakusf/claude-hackathon-a2ui-demo/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"58b77c1ea8c251e54bdb49f119b93eee1a305c3ad5f49282e793416729a2f793","sourceUrl":"https://github.com/akankshakusf/claude-hackathon-a2ui-demo/blob/main/README.md","checkedAt":"2026-10-11T22:41:02.036Z"},"overviewRepoUpdated":"2026-02-21T23:01:55Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/akankshakusf/claude-hackathon-a2ui-demo/blob/main/README.md","checkedAt":"2026-10-11T22:41:02.037Z","hash":"58b77c1ea8c251e54bdb49f119b93eee1a305c3ad5f49282e793416729a2f793","originalBytes":17083,"storedBytes":17083,"truncated":false},"lastDemoCheckedAt":"2026-10-11T22:41:01.783Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","MCP servers & agents","Templates & UI components","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://claude-hackathon-a2ui-demo.vercel.app/","attemptedAt":"2026-10-11T22:54:53.951Z","probeVersion":3,"status":"working","checkedAt":"2026-10-11T22:54:53.951Z","lastWorkingAt":"2026-10-11T22:54:53.951Z","target":"https://claude-hackathon-a2ui-demo.vercel.app/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-18T22:54:53.951Z"},"previewAttemptAt":"2026-10-11T22:54:53.951Z","previewCheck":{"url":"https://