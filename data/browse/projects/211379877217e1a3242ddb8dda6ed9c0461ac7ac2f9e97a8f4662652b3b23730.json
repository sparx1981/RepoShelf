{"availability":"available","full":"zakgof/korender","name":"korender","description":"3D rendering engine for Kotlin Multiplatform (Desktop, Web, Android)","category":"Design","language":"Kotlin","stars":151,"forks":12,"created":"2024-02-03T14:18:31Z","updated":"2026-10-10T13:05:34Z","license":"Apache-2.0","branch":"main","homepage":"","topics":["3d","compose-multiplatform","game-engine-3d","graphics-engine","kotlin","kotlin-library","kotlin-multiplatform","multiplatform-kotlin-library","opengl","webgl"],"demo":"https://zakgof.github.io/projects/korender/wasm/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T22:46:00.024Z","lastAttemptAt":"2026-10-18T22:46:00.024Z","lastAvailableAt":"2026-10-18T22:46:00.024Z","metrics":[{"at":"2026-10-07T02:53:50.429Z","stars":150,"forks":9},{"at":"2026-10-09T05:49:08.859Z","stars":150,"forks":10},{"at":"2026-10-12T07:58:17.084Z","stars":150,"forks":10},{"at":"2026-10-18T22:46:00.024Z","stars":151,"forks":12}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Kotlin Multiplatform 3D graphics rendering engine based on OpenGL / OpenGL ES / WebGL.","Korender enables you to embed 3D scenes directly into Compose Multiplatform UI, making it an excellent choice for applications that combine standard UI with 3D, such as product, architectural, or scientific visualizations, interactive demos, or cross-platform games.","Korender is designed to be highly developer-friendly: there is no need to manually create scene graph objects, load and initialize assets, or attach them to nodes. Instead, you simply declare scene objects using a straightforward DSL. OpenGL knowledge is not required, although familiarity with GLSL can be helpful when writing shader plugins or custom shaders."],"features":["Physically Based Rendering (PBR) metallic-roughness model","Directional and point lights","Shadows: Variance shadow mapping (VSM), percentage-closer filter (PCF)","Texturing with normal mapping support","Predefined shapes and custom meshes"],"sourceUrl":"https://github.com/zakgof/korender/blob/main/README.md","fingerprint":"9a3a6d20ee379fc3844b5caf820f2d59f3d76dbc7f058bf688c28e24f914dc47","extractedAt":"2026-10-07T02:53:50.601Z"},"overviewCheckedAt":"2026-10-18T22:46:00.074Z","projectInsights":{"version":1,"whatItDoes":{"text":"Kotlin Multiplatform 3D graphics rendering engine based on OpenGL / OpenGL ES / WebGL.","sourceUrl":"https://github.com/zakgof/korender/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"9a3a6d20ee379fc3844b5caf820f2d59f3d76dbc7f058bf688c28e24f914dc47","sourceUrl":"https://github.com/zakgof/korender/blob/main/README.md","checkedAt":"2026-10-18T22:46:00.075Z"},"overviewRepoUpdated":"2026-10-10T13:05:34Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/zakgof/korender/blob/main/README.md","checkedAt":"2026-10-18T22:46:00.075Z","hash":"9a3a6d20ee379fc3844b5caf820f2d59f3d76dbc7f058bf688c28e24f914dc47","originalBytes":3879,"storedBytes":3879,"truncated":false},"lastDemoCheckedAt":"2026-10-18T22:46:00.024Z","subjects":["Games & game development","Android","Mobile","3D & graphics"],"platforms":["Android"],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Games & game development","Android","Mobile","3D & graphics"],"evidence":[{"subject":"Games & game development","source":"metadata","match":"game"},{"subject":"Android","source":"metadata","match":"Android"},{"subject":"Mobile","source":"metadata","match":"Android"},{"subject":"3D & graphics","source":"metadata","match":"3D"}],"platformEvidence":[{"platform":"Android","source":"metadata","match":"Android"}],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Animation & motion","Science"],"reviewRequired":true},"demoHealth":{"url":"https://zakgof.github.io/projects/korender/wasm/","attemptedAt":"2026-10-19T22:40:54.392Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T22:40:54.392Z","lastWorking