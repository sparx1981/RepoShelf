ton365/Conscious-Compass/blob/main/README.md","fingerprint":"67cd3d5fa78cbea1948e78723f169f008bd40e5ffea30ceef607349e01a2eb48","extractedAt":"2026-10-09T19:34:33.369Z"},"overviewCheckedAt":"2026-10-09T19:34:33.369Z","projectInsights":{"version":1,"whatItDoes":{"text":"Brand Consciousness Assessment Framework v2.13 by Antenna Group","sourceUrl":"https://github.com/paulnewton365/Conscious-Compass/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"documented","text":"Share a cleansed, password-protected report with a client who has no account.","sourceUrl":"https://github.com/paulnewton365/Conscious-Compass/blob/main/README.md"},{"kind":"account","status":"not_required","text":"Shared Reports — Share a read-only report via URL (base64-encoded, no login required).","sourceUrl":"https://github.com/paulnewton365/Conscious-Compass/blob/main/README.md"}],"fingerprint":"67cd3d5fa78cbea1948e78723f169f008bd40e5ffea30ceef607349e01a2eb48","sourceUrl":"https://github.com/paulnewton365/Conscious-Compass/blob/main/README.md","checkedAt":"2026-10-09T19:34:33.371Z"},"overviewRepoUpdated":"2026-10-09T18:40:18Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/paulnewton365/Conscious-Compass/blob/main/README.md","checkedAt":"2026-10-09T19:34:33.377Z","hash":"67cd3d5fa78cbea1948e78723f169f008bd40e5ffea30ceef607349e01a2eb48","originalBytes":134551,"storedBytes":134551,"truncated":false},"lastDemoCheckedAt":"2026-10-09T19:34:33.272Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Templates & UI components","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://conscious-compass.vercel.app/","attemptedAt":"2026-10-14T14:24:32.618Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T14:24:32.618Z","lastWorkingAt":"2026-10-14T14