{"repositoryId":1154924468,"availability":"available","full":"SysAdminDoc/Openshop","name":"Openshop","description":"Private browser image editor with layers, PSD interchange, local export, and an installable offline shell. Open it online or keep one HTML file.","category":"Design","language":"HTML","stars":24,"forks":9,"created":"2026-02-10T23:31:27Z","updated":"2026-09-26T18:22:00Z","license":"MIT","branch":"main","homepage":"https://sysadmindoc.github.io/Openshop/","topics":["browser","canvas","html5","image-editor","image-processing","javascript","layers","local-first","offline-first","open-source","openraster","photo-editor","privacy","psd","pwa","raw-image","svg-editor","web-app","webassembly","webgpu"],"demo":"https://sysadmindoc.github.io/Openshop/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-18T11:31:43.056Z","lastAttemptAt":"2026-10-18T11:31:43.056Z","lastAvailableAt":"2026-10-18T11:31:43.056Z","metrics":[{"at":"2026-10-18T11:31:43.056Z","stars":24,"forks":9}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["If OpenShop helps you edit without an account or subscription, a coffee helps me keep the studio maintained.","OpenShop is an open-source browser image editor for layered work, PSD interchange, precise selections, and local export. Open it online, install the hosted app, or keep the single HTML file nearby. There is no account and no editing server.","OpenShop currently exposes 34 editing tools. Heavy filters run off the main thread, and supported operations can use WebGPU or WebGL2 when the browser passes capability checks."],"features":["Your pixels stay in the browser during normal editing. OpenShop has no telemetry, upload endpoint, account system, or credit meter.","Layers are real working structure, not a decorative panel. Groups, masks, adjustment layers, editable text, vectors, and embedded Smart Objects survive in the native project format.","It travels well. Use one HTML file for a portable network-first editor, or install the hosted PWA after its status reads Offline ready."],"sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md","fingerprint":"1e7a6ca52cb486c8bab01ea29b7fb25d775e5daf62114e6d35c5a76f3af083a1","extractedAt":"2026-10-18T11:31:43.119Z"},"overviewCheckedAt":"2026-10-18T11:31:43.119Z","projectInsights":{"version":1,"whatItDoes":{"text":"If OpenShop helps you edit without an account or subscription, a coffee helps me keep the studio maintained.","sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md"},"audience":[],"requirements":[{"kind":"paid_service","status":"not_required","text":"If OpenShop helps you edit without an account or subscription, a coffee helps me keep the studio maintained.","sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md"},{"kind":"account","status":"not_required","text":"If OpenShop helps you edit without an account or subscription, a coffee helps me keep the studio maintained.","sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md"},{"kind":"account","status":"documented","text":"There is no account and no editing server.","sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md"}],"fingerprint":"1e7a6ca52cb486c8bab01ea29b7fb25d775e5daf62114e6d35c5a76f3af083a1","sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md","checkedAt":"2026-10-18T11:31:43.120Z"},"overviewRepoUpdated":"2026-09-26T18:22:00Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/SysAdminDoc/Openshop/blob/main/README.md","checkedAt":"2026-10-18T11:31:43.120Z","hash":"1e7a6ca52cb486c8bab01ea29b7fb25d775e5daf62114e6d35c5a76f3af083a1","originalBytes":9729,"storedBytes":9729,"truncated":false},"lastDemoCheckedAt":"2026-10-18T11:31:43.056Z","subjects":["Photography","Browser extensions & PWAs","3D & graphics"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Photography","Brow