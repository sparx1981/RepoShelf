 AI rewrite, real-time collaboration, and hosted/managed storage."],"features":["✅ Embed it in your SaaS, CRM, marketing tool, or transactional product","✅ Self-host, modify, fork for internal use","✅ Use it commercially without paying anything"],"sourceUrl":"https://github.com/templatical/sdk/blob/main/README.md","fingerprint":"506742b3a155c95691213fb647287b3cad41e17e6e624ddc4415c4293323a78c","extractedAt":"2026-10-10T01:10:19.461Z"},"overviewCheckedAt":"2026-10-18T09:18:12.499Z","overviewRepoUpdated":"2026-10-18T09:13:28Z","lastDemoCheckedAt":"2026-10-18T09:18:12.365Z","overviewAttemptAt":"2026-10-08T16:09:07.416Z","projectInsights":{"version":1,"whatItDoes":{"text":"Drag-and-drop email editor for modern apps — source-available, MIT after two years","sourceUrl":"https://github.com/templatical/sdk/blob/main/README.md"},"audience":[],"requirements":[{"kind":"hosting","status":"documented","text":"✅ Self-host, modify, fork for internal use","sourceUrl":"https://github.com/templatical/sdk/blob/main/README.md"}],"fingerprint":"506742b3a155c95691213fb647287b3cad41e17e6e624ddc4415c4293323a78c","sourceUrl":"https://github.com/templatical/sdk/blob/main/README.md","checkedAt":"2026-10-18T09:18:12.499Z"},"readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/templatical/sdk/blob/main/README.md","checkedAt":"2026-10-18T09:18:12.500Z","hash":"506742b3a155c95691213fb647287b3cad41e17e6e624ddc4415c4293323a78c","originalBytes":15297,"storedBytes":15297,"truncated":false},"enrichmentAttemptAt":"2026-10-03T16:22:59.269Z","latestRelease":{"name":"v0.43.2","tag":"v0.43.2","publishedAt":"2026-10-03T07:58:39Z","url":"https://github.com/templatical/sdk/releases/tag/v0.43.2"},"releaseCheckedAt":"2026-10-03T16:22:59.269Z","screenshots":[{"src":"previews/af9c1bc2aa9a084ab883df4a.jpg","kind":"demo","capturedAt":"2026-10-18T09:35:17.666Z","url":"https://play.templatical.com/"}],"qualityPriority":false,"demoHealth":{"url":"https://play.templatical.com/","attemptedAt":"2