{"availability":"available","full":"gap-packages/AutoDoc","name":"AutoDoc","description":"A GAP Package to produce documentation.","category":"Productivity","language":"GAP","stars":9,"forks":16,"created":"2012-08-06T12:20:54Z","updated":"2026-10-01T21:23:00Z","license":null,"branch":"master","homepage":"https://gap-packages.github.io/AutoDoc/","topics":[],"demo":"https://gap-packages.github.io/AutoDoc/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-09T08:57:22.311Z","lastAttemptAt":"2026-10-09T08:57:22.311Z","lastAvailableAt":"2026-10-09T08:57:22.311Z","metrics":[{"at":"2026-10-07T05:01:25.117Z","stars":9,"forks":16},{"at":"2026-10-09T08:57:22.311Z","stars":9,"forks":16}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["AutoDoc: A GAP package to help creating a GAPDoc documentation.","AutoDoc is a package for the GAP computer algebra system. It is meant to simplify the creation of reference manuals for GAP packages. It makes it possible to create documentation from source code comments, without writing XML files. It is not a substitute for GAPDoc, but rather builds on GAPDoc, by generating XML input for the latter. As such, you can combine an existing GAPDoc manual with AutoDoc."],"features":[],"sourceUrl":"https://github.com/gap-packages/AutoDoc/blob/master/README.md","fingerprint":"e246dc572935449183e9993083a2607245f78d81cd334e0ef507177e0aeee96a","extractedAt":"2026-10-07T05:01:25.214Z"},"overviewCheckedAt":"2026-10-07T05:01:25.214Z","projectInsights":{"version":1,"whatItDoes":{"text":"AutoDoc: A GAP package to help creating a GAPDoc documentation.","sourceUrl":"https://github.com/gap-packages/AutoDoc/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"e246dc572935449183e9993083a2607245f78d81cd334e0ef507177e0aeee96a","sourceUrl":"https://github.com/gap-packages/AutoDoc/blob/master/README.md","checkedAt":"2026-10-07T05:01:25.214Z"},"overviewRepoUpdated":"2026-10-01T21:23:00Z","readmeSnapshot":{"version":1,"st