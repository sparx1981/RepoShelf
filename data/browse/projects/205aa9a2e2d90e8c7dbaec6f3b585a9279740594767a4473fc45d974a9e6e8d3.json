{"availability":"available","full":"taladb/taladb","name":"taladb","description":"TalaDB - An open-source embedded vector and document database for building local-first AI applications.","category":"Developer tools","language":"Rust","stars":6,"forks":1,"created":"2026-03-25T03:03:48Z","updated":"2026-10-14T03:44:33Z","license":"Apache-2.0","branch":"main","homepage":"https://taladb.dev","topics":["document-database","embeded-database","hybrid-search","kotlin","local-first","localstorage","mobile","native-android","native-app","native-ios","native-macos","offline","rag","rust","sematic-search","swift","vector-database","wasm","web","webassembly"],"demo":"https://taladb-playground.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-18T21:01:16.136Z","lastAttemptAt":"2026-10-18T21:01:16.136Z","lastAvailableAt":"2026-10-18T21:01:16.136Z","metrics":[{"at":"2026-10-04T06:52:21.334Z","stars":4,"forks":1},{"at":"2026-10-05T05:50:51.402Z","stars":4,"forks":1},{"at":"2026-10-07T11:15:06.344Z","stars":4,"forks":1},{"at":"2026-10-09T13:18:51.680Z","stars":4,"forks":1},{"at":"2026-10-12T13:35:14.094Z","stars":5,"forks":1},{"at":"2026-10-18T21:01:16.136Z","stars":6,"forks":1}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["An open-source embedded vector and document database for building local-first AI applications.","Store documents, metadata, and vectors together. Query structured data and semantic similarity from one embedded database — across the browser, Node.js, React Native, and native Android (Kotlin) and iOS/macOS (Swift) apps. No cloud required.","Documentation · Web Demo · React Native Demo · Android Demo · iOS Demo"],"features":["Vector search — exact k-NN by default (cosine, dot, euclidean) with no recall trade-off, plus optional HNSW when scale demands it; pairs directly with on-device embedding models (transformers.js, ONNX Runtime Web)","Full-text search — BM25-ranked keyword search (searchText), the same relevance model Elasticsearch and Lucene use, running on-device","Hybrid search — fuse keyword and vector rankings with reciprocal rank fusion (hybridSearch), so an exact SKU and a semantic paraphrase both surface from one query","Filtered similarity search — narrow by metadata before ranking, in one call: the 5 most semantically similar english-language support articles, without two round-trips or a post-filter that silently drops your top-k","MongoDB-like API — familiar filter and update DSL, fully typed with TypeScript generics"],"sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md","fingerprint":"ec77cb9bb34c1565c22df82ab0389d8713f4a872146664898374431629237413","extractedAt":"2026-10-07T11:16:19.945Z"},"overviewCheckedAt":"2026-10-19T06:21:26.405Z","projectInsights":{"version":1,"whatItDoes":{"text":"An open-source embedded vector and document database for building local-first AI applications.","sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"ec77cb9bb34c1565c22df82ab0389d8713f4a872146664898374431629237413","sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md","checkedAt":"2026-10-19T06:21:26.406Z"},"overviewRepoUpdated":"2026-10-14T03:44:33Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md","checkedAt":"2026-10-19T06:21:26.407Z","hash":"ec77cb9bb34c1565c22df82ab0389d8713f4a872146664898374431629237413","originalBytes":16528,"storedBytes":16528,"truncated":false},"lastDemoCheckedAt":"2026-10-04T06:52:21.334Z","qualityPriority":false,"enrichmentAttemptAt":"2026-10-05T06:37:58.729Z","latestRelease":{"name":"TalaDB v0.12.0","tag":"v0.12.0","publishedAt":"2026-10-03T14:42:39Z","url":"https://github.com/taladb/taladb/releases/tag/v0.12.0"},"releaseCheckedAt":"2026-10-05T06:37:58.729Z","screenshots":[{"src":"previews/205aa9a2e2d90e8c7dbaec6f.jpg","kind":"demo","capturedAt":"2026-10-14T14:43:07.129Z","url":"https://taladb