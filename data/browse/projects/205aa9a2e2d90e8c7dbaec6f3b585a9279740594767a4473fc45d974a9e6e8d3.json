{"availability":"available","full":"taladb/taladb","name":"taladb","description":"TalaDB - An open-source embedded vector and document database for building local-first AI applications.","category":"Developer tools","language":"Rust","stars":4,"forks":1,"created":"2026-03-25T03:03:48Z","updated":"2026-10-04T06:46:58Z","license":"Apache-2.0","branch":"main","homepage":"https://taladb.dev","topics":["document-database","embeded-database","hybrid-search","kotlin","local-first","localstorage","mobile","native-android","native-app","native-ios","native-macos","offline","rag","rust","sematic-search","swift","vector-database","wasm","web","webassembly"],"demo":"https://taladb-playground.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-05T05:50:51.402Z","lastAttemptAt":"2026-10-05T05:50:51.402Z","lastAvailableAt":"2026-10-05T05:50:51.402Z","metrics":[{"at":"2026-10-04T06:52:21.334Z","stars":4,"forks":1},{"at":"2026-10-05T05:50:51.402Z","stars":4,"forks":1}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["An open-source embedded vector and document database for building local-first AI applications.","Store documents, metadata, and vectors together. Query structured data and semantic similarity from one embedded database — across the browser, Node.js, React Native, and native Android (Kotlin) and iOS/macOS (Swift) apps. No cloud required.","Documentation · Web Demo · React Native Demo · Android Demo · iOS Demo"],"features":["Vector search — exact k-NN by default (cosine, dot, euclidean) with no recall trade-off, plus optional HNSW when scale demands it; pairs directly with on-device embedding models (transformers.js, ONNX Runtime Web)","Full-text search — BM25-ranked keyword search (searchText), the same relevance model Elasticsearch and Lucene use, running on-device","Hybrid search — fuse keyword and vector rankings with reciprocal rank fusion (hybridSearch), so an exact SKU and a semantic paraphrase both surface from one query","Filtered similarity search — narrow by metadata before ranking, in one call: the 5 most semantically similar english-language support articles, without two round-trips or a post-filter that silently drops your top-k","MongoDB-like API — familiar filter and update DSL, fully typed with TypeScript generics"],"sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md","fingerprint":"54753d5c11856643dde893dbb64092bdfa216c1df20dd877d4fc93e89a65f3dc","extractedAt":"2026-10-04T06:52:21.414Z"},"overviewCheckedAt":"2026-10-04T06:52:21.414Z","projectInsights":{"version":1,"whatItDoes":{"text":"An open-source embedded vector and document database for building local-first AI applications.","sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"54753d5c11856643dde893dbb64092bdfa216c1df20dd877d4fc93e89a65f3dc","sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md","checkedAt":"2026-10-04T06:52:21.414Z"},"overviewRepoUpdated":"2026-10-04T06:46:58Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/taladb/taladb/blob/main/README.md","checkedAt":"2026-10-04T06:52:21.415Z","hash":"54753d5c11856643dde893dbb64092bdfa216c1df20dd877d4fc93e89a65f3dc","originalBytes":16793,"storedBytes":16793,"truncated":false,"searchTerms":["taladb","native","guide","react","await","search","swift","vector","kotlin","rust","api","browser","node.js","pnpm","web","const","filter","one","android","embedding","ios","query","required","build","database","package","same","support","typescript","add","bash","category","document","how","packages","password","reset","apps","articles","documents","macos","node","results","core","docs","engine","filters","keyword","locale","optional","publishedat","stable","string","test","tests","wasm","webhook","binding","body","both","cli","console.log","demo","embed","embedded","every","full-text","get","hooks","index","license","live","metadata","model","most","r