{"availability":"available","full":"dev-formata-io/stof","name":"stof","description":"Run AI-generated logic safely inside your app. Stof is JSON with functions: data and logic in one document, sandboxed, in Rust, JavaScript, and Python.","category":"AI & machine learning","language":"Rust","stars":61,"forks":5,"created":"2024-12-17T22:34:06Z","updated":"2026-10-12T22:12:01Z","license":"Apache-2.0","branch":"main","homepage":"https://stof.dev","topics":["agents","ai-agents","data-format","dsl","embedded-scripting","interpreter","json-data","llm","policy-engine","python-library","runtimes","rust-crate","sandbox-environment","scripting-language","serialization-deserialization","serialization-format","typescript-library","webassemby"],"demo":"https://stof.dev/playground","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-13T07:38:15.313Z","lastAttemptAt":"2026-10-13T07:38:15.313Z","lastAvailableAt":"2026-10-13T07:38:15.313Z","metrics":[{"at":"2026-10-09T13:21:15.684Z","stars":61,"forks":5},{"at":"2026-10-12T19:06:50.461Z","stars":61,"forks":5},{"at":"2026-10-13T07:38:15.313Z","stars":61,"forks":5}],"technologies":["Rust"],"overview":{"kind":"readme","version":1,"paragraphs":["This is a Stof document. The data looks like JSON, and the function next to it works on that data:","Your app loads it and works with it as needed:","A Stof document is data you can store, send, and merge like JSON, and code you can run, safely:"],"features":["It runs in a sandbox. A document can read and change itself and call the functions you give it. Nothing else: no file system, network, or environment unless you turn them on.","It runs in your process. No server, container, or cold start. A small document parses and runs in under a millisecond.","It runs the same everywhere. Rust, Node.js, the browser, and Python give the same result.","Safe by default. A document can only read and change itself and call the functions you give it. Each call has a time limit, too.","Fast and in-process. Parsing and running a small document takes under a millisecond, and each call after that takes microseconds."],"sourceUrl":"https://github.com/dev-formata-io/stof/blob/main/README.md","fingerprint":"1f91ec478f8fa8b79cf0ba70674dc477d3723a609f734316dd1ffd853035810d","extractedAt":"2026-10-13T07:38:15.450Z"},"overviewCheckedAt":"2026-10-13T07:38:15.450Z","projectInsights":{"version":1,"whatItDoes":{"text":"This is a Stof document. The data looks like JSON, and the function next to it works on that data:","sourceUrl":"https://github.com/dev-formata-io/stof/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"1f91ec478f8fa8b79cf0ba70674dc477d3723a609f734316dd1ffd853035810d","sourceUrl":"https://github.com/dev-formata-io/stof/blob/main/README.md","checkedAt":"2026-10-13T07:38:15.450Z"},"overviewRepoUpdated":"2026-10-12T22:12:01Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/dev-formata-io/stof/blob/main/README.md","checkedAt":"2026-10-13T07:38:15.451Z","hash":"1f91ec478f8fa8b79cf0ba70674dc477d3723a609f734316dd1ffd853035810d","originalBytes":13027,"storedBytes":13027,"truncated":false},"lastDemoCheckedAt":"2026-10-13T07:38:15.313Z","subjects":["MCP servers & agents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["MCP servers & agents"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"agents"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Games & game development","Travel"],"reviewRequired":true},"demoHealth":{"url":"https://stof.dev/playground","attemptedAt":"2026-10-14T14:44:17.173Z","probeVersion":3,"status":"working","checkedAt":"2026-10-14T14:44:17.173Z","lastWorkingAt":"2026-10-14T14:44:17.173Z","target":"https://stof.dev/playground/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-21T14:44:17.173Z"},"previewAttemptAt":"2026-10-14T14:44:17.173Z"