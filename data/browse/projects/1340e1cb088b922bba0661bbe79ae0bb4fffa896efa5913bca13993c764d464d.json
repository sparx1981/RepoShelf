sourceUrl":"https://github.com/gojiplus/gringotts/blob/main/README.md"},"audience":[],"requirements":[{"kind":"paid_service","status":"optional","text":"concurrency), automatic refund when your handler raises, idempotent webhook crediting, optional Idempotency-Key so retried charges/grants apply once, refund/dispute clawback (clamped so a balance never goes negative), and an append-only ledger — with a per-row running balance — auditing every credit movement.","sourceUrl":"https://github.com/gojiplus/gringotts/blob/main/README.md"},{"kind":"paid_service","status":"optional","text":"A paid webhook grants only when the Stripe Session matches this row exactly.","sourceUrl":"https://github.com/gojiplus/gringotts/blob/main/README.md"}],"fingerprint":"dc913c25b157ce7435a515aa960c29554658c328abcbc19935b4528fc843643a","sourceUrl":"https://github.com/gojiplus/gringotts/blob/main/README.md","checkedAt":"2026-10-18T07:12:11.282Z"},"overviewRepoUpdated":"2026-10-17T22:40:17Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/gojiplus/gringotts/blob/main/README.md","checkedAt":"2026-10-18T07:12:11.282Z","hash":"dc913c25b157ce7435a515aa960c29554658c328abcbc19935b4528fc843643a","originalBytes":11703,"storedBytes":11703,"truncated":false},"lastDemoCheckedAt":"2026-10-18T07:12:11.196Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["MCP servers & agents","Data & dashboards","Self-hosted apps"],"reviewRequired":true},"demoHealth":{"url":"https://gojiplus.github.io/gringotts/","attemptedAt":"2026-10-18T07:25:35.025Z","probeVersion":3,"status":"working","checkedAt":"2026-10-18T07:25:35.025Z","lastWorkingAt":"2026-10-18T07:25:35.025Z","target":"https://gojiplus.github.io/gringotts/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-25T07:25:35.025Z"