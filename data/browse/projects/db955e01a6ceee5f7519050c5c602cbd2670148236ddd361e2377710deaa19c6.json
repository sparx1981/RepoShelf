{"repositoryId":1077097343,"availability":"available","full":"Levon0Asatryan/gradfolio","name":"gradfolio","description":"A professional Student Portfolio Management System bridging the gap between academia and industry with project-centric evidence and intelligent integrations.","category":"Design","language":"TypeScript","stars":1,"forks":0,"created":"2025-10-15T19:15:59Z","updated":"2026-10-15T15:01:48Z","license":"MIT","branch":"main","homepage":"https://gradfolio-navy.vercel.app","topics":[],"demo":"https://gradfolio-navy.vercel.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-15T15:02:03.533Z","lastAttemptAt":"2026-10-15T15:02:03.533Z","lastAvailableAt":"2026-10-15T15:02:03.533Z","metrics":[{"at":"2026-10-15T15:02:03.533Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Gradfolio is a specialized platform designed to bridge the gap between academic coursework and industry recruitment. It enables students to showcase their academic projects, skills, and achievements in a professional manner, acting as an expanded online resume where every claim is backed by tangible proof.","The goal of Gradfolio is to provide a \"show, don't tell\" platform for students. By combining the structured career timeline of LinkedIn with the project-centric evidence of GitHub, Gradfolio allows graduates to prove their competencies with more than just grades or bullet points on a CV."],"features":["Artifact-Driven Validation: Every skill or experience is backed by proof (code repositories, reports, videos).","Unified Professional Narrative: A longitudinal record of a student's development from freshman year to early career.","Bridging the Academic-Industry Gap: Translating academic rigor into recruiter-friendly highlights with structured templates and AI-assisted summaries.","Multi-Option Sign-Up: Secure registration via Email/Password or OAuth (Google, LinkedIn, GitHub) powered by Auth0.","Profile Initialization: Quick setup for basic info and professional headlines."],"sourceUrl":"https://github.com/Levon0Asatryan/gradfolio/blob/main/README.md","fingerprint":"a24e49e74e18dffece457917a27bebcc4e18983f990ff6206ad7fb8b5a4dcdee","extractedAt":"2026-10-15T11:20:36.142Z"},"overviewCheckedAt":"2026-10-15T15:02:03.941Z","projectInsights":{"version":1,"whatItDoes":{"text":"Gradfolio is a specialized platform designed to bridge the gap between academic coursework and industry recruitment. It enables students to showcase their academic projects, skills, and achievements in a professional manner, acting as an expanded online resume where every claim is backed by tangible proof.","sourceUrl":"https://github.com/Levon0Asatryan/gradfolio/blob/main/README.md"},"audience":[{"text":"Gradfolio is a specialized platform designed to bridge the gap between academic coursework and industry recruitment. It enables students to showcase their academic projects, skills, and achievements in a professional manner, acting as an expanded online resume where every claim is backed by tangible proof.","sourceUrl":"https://github.com/Levon0Asatryan/gradfolio/blob/main/README.md"}],"requirements":[{"kind":"account","status":"required","text":"Set up environment variables (only needed to log in; every page renders","sourceUrl":"https://github.com/Levon0Asatryan/gradfolio/blob/main/README.md"}],"fingerprint":"a24e49e74e18dffece457917a27bebcc4e18983f990ff6206ad7fb8b5a4dcdee","sourceUrl":"https://github.com/Levon0Asatryan/gradfolio/blob/main/README.md","checkedAt":"2026-10-15T15:02:03.941Z"},"overviewRepoUpdated":"2026-10-15T15:01:48Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Levon0Asatryan/gradfolio/blob/main/README.md","checkedAt":"2026-10-15T15:02:03.942Z","hash":"a24e49e74e18dffece457917a27bebcc4e18983f990ff6206ad7fb8b5a4dcdee","originalBytes":6726,"storedBytes":6726,"truncated":false,"searchTerms":["auth0","gradfolio","project","academic","professional","projects","data","every",