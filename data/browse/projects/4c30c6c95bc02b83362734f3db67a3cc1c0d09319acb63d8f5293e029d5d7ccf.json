{"availability":"available","full":"viewflow/django-material","name":"django-material","description":"Material Design for Django","category":"Design","language":"JavaScript","stars":2532,"forks":419,"created":"2015-01-16T07:17:33Z","updated":"2026-05-02T04:00:38Z","license":"AGPL-3.0","branch":"vibe","homepage":"http://viewflow.io/","topics":["admin","crud","django","form","material-design","materializecss"],"demo":"https://material.viewflow.io/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-10T01:07:10.158Z","lastAttemptAt":"2026-10-10T01:07:10.158Z","lastAvailableAt":"2026-10-10T01:07:10.158Z","metrics":[{"at":"2026-10-05T21:32:09.020Z","stars":2539,"forks":419},{"at":"2026-10-07T23:28:56.439Z","stars":2533,"forks":419},{"at":"2026-10-10T01:07:10.158Z","stars":2532,"forks":419}],"technologies":["Python"],"overview":{"kind":"readme","version":1,"paragraphs":["⚠️ IMPORTANT: This project is under active development. APIs, components, and behavior may change between versions. Use for exploration and prototyping; evaluate carefully before production use.","Django Material brings Google's Material Design 3 to Django, offering both low-level UI components and full-featured CRUD/admin interfaces for rapid application development. Built on [TailwindCSS] and [django-cotton], it delivers everything you need — from buttons and cards to list, create, update, and delete views — with minimal setup and zero frontend frameworks.","Our goal is to rethink UI component APIs for AI-assisted development: making them intuitive for developers, predictable for code generation tools, and streamlining the process of crafting interfaces by human or machine."],"features":["🎨 Material Design 3 components: buttons, cards, forms, tables, navigation, and more","🧩 django-cotton integration: intuitive , , and other component tags","🛠️ No build step required: pre-built CSS and JS included for immediate use","📱 Fully responsive & accessible: mobile-first design with ARIA support and keyboard navigation","🔄 SPA-like navigation: powered by [Unpoly.js] for seamless page updates"],"sourceUrl":"https://github.com/viewflow/django-material/blob/vibe/README.md","fingerprint":"c77f1d5a2d6123d12383317895c4e66debef4209f388dfd8a92900951d2641a6","extractedAt":"2026-10-05T21:32:09.150Z"},"overviewCheckedAt":"2026-10-05T21:32:09.150Z","projectInsights":{"version":1,"whatItDoes":{"text":"⚠️ IMPORTANT: This project is under active development. APIs, components, and behavior may change between versions. Use for exploration and prototyping; evaluate carefully before production use.","sourceUrl":"https://github.com/viewflow/django-material/blob/vibe/README.md"},"audience":[],"requirements":[],"fingerprint":"c77f1d5a2d6123d12383317895c4e66debef4209f388dfd8a92900951d2641a6","sourceUrl":"https://github.com/viewflow/django-material/blob/vibe/README.md","checkedAt":"2026-10-05T21:32:09.150Z"},"overviewRepoUpdated":"2026-05-02T04:00:38Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/viewflow/django-material/blob/vibe/README.md","checkedAt":"2026-10-05T21:32:09.150Z","hash":"c77f1d5a2d6123d12383317895c4e66debef4209f388dfd8a92900951d2641a6","originalBytes":3597,"storedBytes":3597,"truncated":false,"searchTerms":["material","bash","design","npm","run","components","django","license","about","admin","apis","build","contributing","crud","django-cotton","features","interfaces","navigation","quickstart","usage","ai-assisted","apps","built","buttons","cards","component","create","css","delete","demo","development.","documentation","format","frontend","full-featured","generation","human","install","installed","intuitive","lint","list","live","pip","production","python","see","tailwindcss","under","unpoly.js","update","views","zero","accessible","active","add","additional","agplv3","ai-first","angular","application","aria","assets","base.html","before","behavior","between","block","both","brings","bug","building","carefully","change","code","coding","