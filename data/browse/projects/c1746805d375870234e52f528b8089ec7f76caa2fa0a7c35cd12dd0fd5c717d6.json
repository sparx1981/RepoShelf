{"availability":"available","full":"mgupta646/vlabcb","name":"vlabcb","description":"AI research assistant for NYU Stern's V-Lab risk platform: Groq Llama 3.3 70B behind a Vercel Edge proxy","category":"Finance","language":"HTML","stars":0,"forks":0,"created":"2026-03-31T15:36:44Z","updated":"2026-10-10T10:25:03Z","branch":"main","homepage":"https://vlabcb.vercel.app","topics":["chatbot","finance","groq","llm","risk-analytics","vercel"],"demo":"https://vlabcb.vercel.app/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-12T07:59:54.839Z","lastAttemptAt":"2026-10-12T07:59:54.839Z","lastAvailableAt":"2026-10-12T07:59:54.839Z","metrics":[{"at":"2026-10-12T07:59:54.839Z","stars":0,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A conversational assistant for V-Lab, NYU Stern's public platform for volatility, correlation and systemic-risk research. Ask about GARCH volatility, SRISK, liquidity, climate risk or COVOL in plain language, or start from a topic, country or analysis shortcut.","About this repo: this is the public demo of the assistant I built as a Graduate Assistant in the VRI Director's Office (Jan–Jun 2026). The production work behind it is written up in my portfolio: a multi-agent design chosen after benchmarking 6 LLM providers on a 40-point rubric, which I rebuilt once I caught it rewarding fluency over correctness, followed by log-driven routing fixes after launch."],"features":["Topic navigation: docs shortcuts for Volatility, Correlation, SRISK, Long-Run VaR, Liquidity, Fixed Income, Climate and COVOL, plus live-data links","Country & analysis pickers: country questions are enriched with live data from the REST Countries API; general topics can pull Wikipedia summaries","Quick-ask chips for common questions, a typing indicator, a stop button and markdown-rendered answers","Rolling context: the last 20 messages go to the model, with a dated system prompt scoped to V-Lab and VRI","VRI events panel with conferences and past themes"],"sourceUrl":"https://github.com/mgupta646/vlabcb/blob/main/README.md","fingerprint":"45bbcbb18742dbc4e25872288646a190623ebd5e47332cd49a8c00b54e9831df","extractedAt":"2026-10-12T07:59:54.983Z"},"overviewCheckedAt":"2026-10-12T07:59:54.983Z","projectInsights":{"version":1,"whatItDoes":{"text":"A conversational assistant for V-Lab, NYU Stern's public platform for volatility, correlation and systemic-risk research. Ask about GARCH volatility, SRISK, liquidity, climate risk or COVOL in plain language, or start from a topic, country or analysis shortcut.","sourceUrl":"https://github.com/mgupta646/vlabcb/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"45bbcbb18742dbc4e25872288646a190623ebd5e47332cd49a8c00b54e9831df","sourceUrl":"https://github.com/mgupta646/vlabcb/blob/main/README.md","checkedAt":"2026-10-12T07:59:54.983Z"},"overviewRepoUpdated":"2026-10-10T10:25:03Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/mgupta646/vlabcb/blob/main/README.md","checkedAt":"2026-10-12T07:59:54.984Z","hash":"45bbcbb18742dbc4e25872288646a190623ebd5e47332cd49a8c00b54e9831df","originalBytes":3013,"storedBytes":3013,"truncated":false,"searchTerms":["api","groq","key","assistant","vercel","volatility","built","country","edge","rest","v-lab","vri","about","after","analysis","climate","correlation","countries","covol","environment","function","html","liquidity","llama","nyu","public","questions","repo","risk","run","srisk","stern","topic","wikipedia","add","answers","architecture","ask","attaches","behind","benchmarking","browser","button","caught","chat","chips","chosen","client","common","conferences","console.groq.com","context","conversational","copy","correctness","css","data","dated","demo","dependency-free","deploy.","design","dev","director","docs","enriched","events","features","file.","fixed","fixes","fluency","followed","fork","frontend","functions","garch","general","graduate","gupta","import","income",