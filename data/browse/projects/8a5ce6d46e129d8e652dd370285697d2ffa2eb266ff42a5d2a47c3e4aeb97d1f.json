{"repositoryId":770358256,"availability":"available","full":"FiligranHQ/filigran-ui","name":"filigran-ui","description":"Filigran-UI: Design System, Component and Icon library","category":"Design","language":"TypeScript","stars":11,"forks":2,"created":"2024-03-11T12:15:59Z","updated":"2026-10-12T20:34:51Z","license":"Apache-2.0","branch":"main","homepage":"https://filigranhq.github.io/filigran-ui/","topics":["components","design-system","filigran","icons","nextjs","react","shadcn-ui","tailwindcss","ui"],"demo":"https://filigranhq.github.io/filigran-ui/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-13T07:38:35.368Z","lastAttemptAt":"2026-10-13T07:38:35.368Z","lastAvailableAt":"2026-10-13T07:38:35.368Z","metrics":[{"at":"2026-10-13T07:38:35.368Z","stars":11,"forks":2}],"technologies":["React","Next.js"],"overview":{"kind":"readme","version":1,"paragraphs":["Welcome to Filigran-UI, an evolving design system and component library built to standardize and unify the design and user experience across products developed by Filigran, a startup focused on cybersecurity solutions.","This project draws inspiration from popular libraries such as Shadcn, RadixUI, and Tailwind CSS, with the aim of offering a versatile set of UI components that can be used both with and without Tailwind CSS. Filigran-UI is designed primarily for React-based applications, but it also functions as a standalone component library for any web project."],"features":["React Components: The core components of Filigran-UI are built on React, providing an intuitive API and easy integration with React projects.","Tailwind-First, but Optional: Although components are styled using Tailwind CSS, they are designed to work independently. This makes it possible to import components into projects that are not using Tailwind.","Inspired by Shadcn and RadixUI: Components follow best practices from modern UI libraries, ensuring accessibility, responsiveness, and flexibility.","Filigran-Icon Library: A growing collection of high-quality icons, designed to seamlessly integrate with Filigran's design system."],"sourceUrl":"https://github.com/FiligranHQ/filigran-ui/blob/main/README.md","fingerprint":"46f2c173cdda507874b9614b77bfbd50295b7d4aaa3599fc008833781532fef1","extractedAt":"2026-10-13T07:38:35.456Z"},"overviewCheckedAt":"2026-10-13T07:38:35.456Z","projectInsights":{"version":1,"whatItDoes":{"text":"Welcome to Filigran-UI, an evolving design system and component library built to standardize and unify the design and user experience across products developed by Filigran, a startup focused on cybersecurity solutions.","sourceUrl":"https://github.com/FiligranHQ/filigran-ui/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"46f2c173cdda507874b9614b77bfbd50295b7d4aaa3599fc008833781532fef1","sourceUrl":"https://github.com/FiligranHQ/filigran-ui/blob/main/README.md","checkedAt":"2026-10-13T07:38:35.456Z"},"overviewRepoUpdated":"2026-10-12T20:34:51Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/FiligranHQ/filigran-ui/blob/main/README.md","checkedAt":"2026-10-13T07:38:35.457Z","hash":"46f2c173cdda507874b9614b77bfbd50295b7d4aaa3599fc008833781532fef1","originalBytes":4001,"storedBytes":4001,"truncated":false,"searchTerms":["components","design","filigran-ui","filigran","library","system","component","tailwind","across","css","react","designed","features","filigran-icon","github","libraries","new","products","project","projects","repository","user","without","work","added","both","built","consistency","cybersecurity","deployment-package.md","documentation","efficiency","ensures","experience","filigran-rich-text-editor","full","how","icon","installation","integration","modern","progress","providing","radixui","scalability","see","shadcn","standalone","tailwind.","under","used","using","website","accessibility","actions","active","aim","although","any","api","applications","automated","available","avoid","behaves","being","best"