{"availability":"available","full":"pradnya-jadhav87/Captone-Project-zeroleak","name":"Captone-Project-zeroleak","description":"Explore this public GitHub project.","category":"Other","language":"TypeScript","stars":0,"forks":1,"created":"2026-10-09T05:18:40Z","updated":"2026-10-12T08:05:06Z","branch":"main","homepage":"https://captone-project-zeroleak.vercel.app","topics":[],"demo":"https://captone-project-zeroleak.vercel.app/","color":"#25392f","ink":"#d1e5c5","lastCheckedAt":"2026-10-19T07:20:03.710Z","lastAttemptAt":"2026-10-19T07:20:03.710Z","lastAvailableAt":"2026-10-19T07:20:03.710Z","metrics":[{"at":"2026-10-09T22:06:20.050Z","stars":0,"forks":0},{"at":"2026-10-13T07:36:08.034Z","stars":0,"forks":1},{"at":"2026-10-19T07:20:03.710Z","stars":0,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A high-assurance platform that eliminates question paper leaks through mathematical cryptography, verified question pools, AI pattern validation, and time-locked delivery.","ZeroLeak is engineered for central examination boards, autonomous universities, and national recruitment commissions to protect the entire lifecycle of an examination paper — from question authoring to secure printing at the exam centre.","Traditional exam workflows leak papers through human touchpoints. ZeroLeak removes that risk by keeping papers encrypted at rest, cryptographically time-locked until the exam moment, and forensically watermarked so any leaked copy can be traced back to a single device, operator, and timestamp."],"features":[],"sourceUrl":"https://github.com/pradnya-jadhav87/Captone-Project-zeroleak/blob/main/README.md","fingerprint":"e55d605b99dd23c072080fa7b42b3eb9f15baeb09d224391d736abc7005a58b4","extractedAt":"2026-10-09T22:06:20.147Z"},"overviewCheckedAt":"2026-10-09T22:06:20.147Z","projectInsights":{"version":1,"whatItDoes":{"text":"A high-assurance platform that eliminates question paper leaks through mathematical cryptography, verified quest