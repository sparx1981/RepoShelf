{"availability":"available","full":"EmenstaNougat/BlueJammer-V2","name":"BlueJammer-V2","description":"BlueJammer-V2 is a two-board RF research platform combining an ESP32 jamming engine with a BW16 5GHz web controller. Features up to 4x NRF24L01 modules, live OLED display, real-time web interface and full UART communication between both boards. Educational purposes only!","category":"Education","language":"Batchfile","stars":292,"forks":26,"created":"2026-03-17T21:52:43Z","updated":"2026-09-12T01:33:47Z","branch":"main","homepage":"https://emensta.pages.dev","topics":["2-4ghz","ble","bluetooth","bw16","educational","esp32","jamming","nrf24l01","oled","rc","research","rf","rtl8720dn","wifi"],"demo":"https://emensta.pages.dev/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-15T18:03:39.044Z","lastAttemptAt":"2026-10-15T18:03:39.044Z","lastAvailableAt":"2026-10-15T18:03:39.044Z","metrics":[{"at":"2026-10-09T08:58:03.770Z","stars":280,"forks":26},{"at":"2026-10-12T09:45:15.861Z","stars":283,"forks":26},{"at":"2026-10-13T04:16:22.174Z","stars":285,"forks":26},{"at":"2026-10-15T18:03:39.044Z","stars":292,"forks":26}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Jamming is ILLEGAL! Educational purposes only!","BlueJammer-V2 is a two-board RF research platform built around the ESP32-WROOM-32U and the Ai-Thinker BW16 (RTL8720DN). It is the direct successor to the original ESP32-BlueJammer, bringing a completely reworked architecture, a live 5GHz web interface, a 128x64 OLED display, a quad NRF24L01 jamming engine, and a robust UART communication layer between both boards.","This project is closed source and provided as pre-compiled firmware only. The source code is not publicly available. If you purchased this device from anyone other than official sources at emensta.pages.dev - you have been scammed."],"features":["Up to 4x NRF24L01+ modules running simultaneously in a dynamic round-robin hop pattern","Modules are hot-pluggable - the probe task detects connect/disconnect every 500ms and redistributes hops automatically so 1, 2, 3, or 4 radios always run at full capacity","Mode 1 - Bluetooth (2.4GHz, CH 0-79)","Mode 2 - BLE (2.4GHz, CH 0-39)","Mode 3 - WiFi (2.4GHz, CH 0-14)"],"sourceUrl":"https://github.com/EmenstaNougat/BlueJammer-V2/blob/main/README.md","fingerprint":"348c03c0ff7852871c52543d21f663f6311e1e622a9c18d7d6365e56e61bfada","extractedAt":"2026-10-09T08:58:03.911Z"},"overviewCheckedAt":"2026-10-13T04:16:22.314Z","projectInsights":{"version":1,"whatItDoes":{"text":"Jamming is ILLEGAL! Educational purposes only!","sourceUrl":"https://github.com/EmenstaNougat/BlueJammer-V2/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"348c03c0ff7852871c52543d21f663f6311e1e622a9c18d7d6365e56e61bfada","sourceUrl":"https://github.com/EmenstaNougat/BlueJammer-V2/blob/main/README.md","checkedAt":"2026-10-13T04:16:22.314Z"},"overviewRepoUpdated":"2026-09-12T01:33:47Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/EmenstaNougat/BlueJammer-V2/blob/main/README.md","checkedAt":"2026-10-13T04:16:22.315Z","hash":"348c03c0ff7852871c52543d21f663f6311e1e622a9c18d7d6365e56e61bfada","originalBytes":12411,"storedBytes":12411,"truncated":false},"lastDemoCheckedAt":"2026-10-13T04:16:22.317Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Education","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Portfolios & personal sites"],"reviewRequired":true},"demoHealth":{"url":"https://emensta.pages.dev/","attemptedAt":"2026-10-16T09:41:21.189Z","probeVersion":3,"status":"working","checkedAt":"2026-10-16T09:41:21.189Z","lastWorkingAt":"2026-10-16T09:41:21.189Z","target":"https://emensta.pages.dev/#home","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-23T09:41:21.189Z"},"previewAttemptAt":"2026-10-16T09:41:21.189Z","previewCheck":{