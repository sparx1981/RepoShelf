ullahdev/vision-paddle-ocr/blob/main/README.md","fingerprint":"47f3f63fe412d52672e8a9b601b9ed448a9e7ce268404d33c9a311aa28575a57","extractedAt":"2026-10-10T03:22:28.329Z"},"overviewCheckedAt":"2026-10-18T09:16:54.793Z","projectInsights":{"version":1,"whatItDoes":{"text":"English | 简体中文 | 繁體中文 | 日本語 | 한국어 | Français | Русский | Español | العربية","sourceUrl":"https://github.com/abidullahdev/vision-paddle-ocr/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"47f3f63fe412d52672e8a9b601b9ed448a9e7ce268404d33c9a311aa28575a57","sourceUrl":"https://github.com/abidullahdev/vision-paddle-ocr/blob/main/README.md","checkedAt":"2026-10-18T09:16:54.793Z"},"overviewRepoUpdated":"2026-07-30T07:06:23Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/abidullahdev/vision-paddle-ocr/blob/main/README.md","checkedAt":"2026-10-18T09:16:54.794Z","hash":"47f3f63fe412d52672e8a9b601b9ed448a9e7ce268404d33c9a311aa28575a57","originalBytes":23379,"storedBytes":23379,"truncated":false},"lastDemoCheckedAt":"2026-10-18T09:16:54.631Z","subjects":["Writing & documents"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Other","subjects":["Writing & documents"],"evidence":[{"subject":"Writing & documents","source":"metadata","match":"ocr"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Photography","MCP servers & agents","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://www.paddleocr.com/","attemptedAt":"2026-10-17T05:33:56.534Z","probeVersion":3,"status":"working","checkedAt":"2026-10-17T05:33:56.534Z","lastWorkingAt":"2026-10-17T05:33:56.534Z","target":"https://aistudio.baidu.com/paddleocr","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-24T05:33:56.534Z"},"previewAttemptAt":"2026-10-17T05:33:56.534Z","previewCheck":{"url":"https://www.paddleocr.com/","attemptedAt":"2026-10-17T05:33:56.534Z","consecutiveFailures":0,"status