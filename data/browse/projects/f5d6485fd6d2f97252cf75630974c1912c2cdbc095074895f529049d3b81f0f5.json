{"repositoryId":1328870717,"availability":"available","full":"kheirparham-eng/Lumina-Studio","name":"Lumina-Studio","description":"Free Open Source Image Editor ","category":"Developer tools","language":"TypeScript","stars":1,"forks":1,"created":"2026-08-09T14:13:42Z","updated":"2026-10-15T14:30:49Z","license":"MIT","branch":"main","homepage":"https://kheirparham-eng.github.io/Lumina-Studio/","topics":["photo","photo-editing","photo-editor","photos","webapp"],"demo":"https://kheirparham-eng.github.io/Lumina-Studio/","color":"#63362a","ink":"#f8c7a8","lastCheckedAt":"2026-10-15T19:32:58.613Z","lastAttemptAt":"2026-10-15T19:32:58.613Z","lastAvailableAt":"2026-10-15T19:32:58.613Z","metrics":[{"at":"2026-10-15T19:32:58.613Z","stars":1,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A high-performance, GPU-accelerated non-destructive photo studio built with React 19, TypeScript, custom GLSL Shaders, and Tailwind CSS.","Lumina Studio is a browser-based, pro-tier photo editing workstation engineered for photographers, digital creators, and designers. Powered by custom WebGL fragment shaders, Lumina Studio processes image transformations directly on the GPU at a buttery smooth 60 FPS without touching original pixel buffers.","Designed with a refined iOS Liquid Glass aesthetic (frosted glassmorphism, 1px refractive highlights, and fluid micro-interactions), Lumina Studio pairs industry-standard photo editing tools with cutting-edge WebGL rendering and Gemini AI smart auto-enhancements."],"features":["Light Controls: Exposure ($\\pm 3$ EV), Contrast, Highlights, Shadows, Whites, and Blacks.","Color Temperature & Tint: Precision White Balance adjustments with kelvin-mapped color shifts.","Vibrance & Saturation: Smart skin-tone-aware color booster and global saturation controls.","8-Channel HSL Color Mixer: Individual Hue, Saturation, and Luminance control for Red, Orange, Yellow, Green, Aqua, Blue, Purple, and Magenta.","3-Way Color Grading: Independent Hue, Saturation, and Balance controls for Shadows, Midtones, and Highlights."],"sourceUrl":"https://github.com/kheirparham-eng/Lumina-Studio/blob/main/README.md","fingerprint":"b23e6f39741f5cebc0fc6e52f4d40f2a0dd27c4f406cd607e0571fb4a68fee3c","extractedAt":"2026-10-15T19:32:58.964Z"},"overviewCheckedAt":"2026-10-15T19:32:58.964Z","projectInsights":{"version":1,"whatItDoes":{"text":"A high-performance, GPU-accelerated non-destructive photo studio built with React 19, TypeScript, custom GLSL Shaders, and Tailwind CSS.","sourceUrl":"https://github.com/kheirparham-eng/Lumina-Studio/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"b23e6f39741f5cebc0fc6e52f4d40f2a0dd27c4f406cd607e0571fb4a68fee3c","sourceUrl":"https://github.com/kheirparham-eng/Lumina-Studio/blob/main/README.md","checkedAt":"2026-10-15T19:32:58.964Z"},"overviewRepoUpdated":"2026-10-15T14:30:49Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/kheirparham-eng/Lumina-Studio/blob/main/README.md","checkedAt":"2026-10-15T19:32:58.965Z","hash":"b23e6f39741f5cebc0fc6e52f4d40f2a0dd27c4f406cd607e0571fb4a68fee3c","originalBytes":7075,"storedBytes":7075,"truncated":false,"searchTerms":["color","studio","custom","lumina","rgb","saturation","bash","blue","license","local","mask","npm","original","photo","red","shadows","webgl","bright","build","channel","clipping","contrast","control","ctrl","editing","film","grain","green","highlight","highlights","hold","interactive","non-destructive","shaders","warm","adjustable","adjustment","adjustments","aesthetic","analog","balance","blacks.","blinks","clarity","clone","controls","dark","desaturated","development","dramatic","engine","exposure","fragment","github","global","glow","glsl","golden","gpu","gradient","greens","highlights.","hue","independent","individual","industry-standard","install","lens","lifted","light","linear","live","luminance","master","noir","pixel","pixels","preset","preview","react","realtim