{"availability":"available","full":"vsxd/afilmory-vercel","name":"afilmory-vercel","description":"Vercel-native. High-performance. Modern. A refined photography gallery.","category":"Design","language":"TypeScript","stars":12,"forks":3,"created":"2025-11-22T13:56:42Z","updated":"2026-10-11T21:53:54Z","license":null,"branch":"main","homepage":"https://afilmory-vercel.vercel.app","topics":["photo-gallery","photography","react","s3","self-hosted","static-site","vercel","webgl"],"demo":"https://afilmory.innei.in/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-16T02:48:23.256Z","lastAttemptAt":"2026-10-16T02:48:23.256Z","lastAvailableAt":"2026-10-16T02:48:23.256Z","metrics":[{"at":"2026-10-12T06:29:09.664Z","stars":12,"forks":3},{"at":"2026-10-16T02:48:23.256Z","stars":12,"forks":3}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["An S3-first photo gallery with a zero-credential local mode and static Vercel deployment","Quick Start • Features • Deployment • Live Demo","This repository is a customized fork of Afilmory, focused on static site deployment. Source photos can stay in S3-compatible object storage (the deployment default) or come from a local directory for a self-contained, zero-credential build. The build produces a static web app, generated thumbnails, RSS, sitemap, Open Graph assets, and a JSON photo manifest."],"features":["🖼️ High-performance WebGL renderer - custom React 19 WebGL viewer with smooth zooming, panning, tiled loading, and fallback error callbacks.","📱 Responsive masonry layout - custom pure-computed virtual masonry with integer-pixel geometry and no scroll-time DOM measurement.","🎨 Modern UI design - glassmorphic interface built with Tailwind CSS 4, Radix UI primitives, and Motion.","⚡ Incremental builds - existing manifest data, thumbnails, EXIF, and tone analysis are reused when source photos have not changed.","🌐 Internationalization - bundled language resources from locales/app/.json."],"sourceUrl":"https://github.com/vsxd/afilmory-vercel/blob/main/README.md","fingerprint":"d4677a605a8ab20c6f74944989999cf0292efad3b840bbeb75b92efe021bbc37","extractedAt":"2026-10-12T06:29:09.799Z"},"overviewCheckedAt":"2026-10-12T06:29:09.799Z","projectInsights":{"version":1,"whatItDoes":{"text":"An S3-first photo gallery with a zero-credential local mode and static Vercel deployment","sourceUrl":"https://github.com/vsxd/afilmory-vercel/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"Sign in to Vercel and fork/import the repository.","sourceUrl":"https://github.com/vsxd/afilmory-vercel/blob/main/README.md"}],"fingerprint":"d4677a605a8ab20c6f74944989999cf0292efad3b840bbeb75b92efe021bbc37","sourceUrl":"https://github.com/vsxd/afilmory-vercel/blob/main/README.md","checkedAt":"2026-10-12T06:29:09.800Z"},"overviewRepoUpdated":"2026-10-11T21:53:54Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/vsxd/afilmory-vercel/blob/main/README.md","checkedAt":"2026-10-12T06:29:09.801Z","hash":"d4677a605a8ab20c6f74944989999cf0292efad3b840bbeb75b92efe021bbc37","originalBytes":27865,"storedBytes":27865,"truncated":false},"lastDemoCheckedAt":"2026-10-12T06:29:09.804Z","subjects":["Photography","3D & graphics","Self-hosted apps"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Design","subjects":["Photography","3D & graphics","Self-hosted apps"],"evidence":[{"subject":"Photography","source":"metadata","match":"photography"},{"subject":"3D & graphics","source":"metadata","match":"webgl"},{"subject":"Self-hosted apps","source":"metadata","match":"self hosted"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Maps & geospatial","Templates & UI components","Maths & algorithms"],"reviewRequired":true},"demoHealth":{"url":"https://afilmory.innei.in/","attemptedAt":"2026-10-19T07:41:46.396Z","probeVersion":3,"status":"working","checkedAt":"2