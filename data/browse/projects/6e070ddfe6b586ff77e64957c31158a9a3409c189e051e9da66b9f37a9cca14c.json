{"repositoryId":1415808506,"availability":"available","full":"cedhuf/mcpyard","name":"mcpyard","description":"Small self-hosted MCP hub: one endpoint, every MCP server behind it, one key per client.","category":"AI & machine learning","language":"TypeScript","stars":1,"forks":0,"created":"2026-10-12T15:46:48Z","updated":"2026-10-15T09:56:07Z","license":"MIT","branch":"main","homepage":"https://cedhuf.github.io/mcpyard/","topics":["homelab","mcp","mcp-gateway","mcp-proxy","model-context-protocol","oidc","self-hosted"],"demo":"https://cedhuf.github.io/mcpyard/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-19T00:42:13.327Z","lastAttemptAt":"2026-10-19T00:42:13.327Z","lastAvailableAt":"2026-10-19T00:42:13.327Z","metrics":[{"at":"2026-10-12T19:08:56.438Z","stars":1,"forks":0},{"at":"2026-10-19T00:42:13.327Z","stars":1,"forks":0}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A small, self-hosted MCP hub. One endpoint, every MCP server behind it, one key per client.","The name comes from a switchyard, where trains are sorted onto the right track and only cleared ones get through. That is the whole job here. Clients (Claude Code, llooma, any MCP-capable agent) connect to a single /mcp endpoint; mcpyard starts and keeps the upstream MCP servers running, merges their tools, and only lets each client reach what its key allows.","Status: early, everything below works; expect rough edges before 1.0. Documentation: cedhuf.github.io/mcpyard"],"features":["One merged endpoint. /mcp serves the tools of every server the key may see.","Known versions, one-click updates. Each server runs a package version installed by the hub,","Keys with scopes from day one. One bearer key per client, each limited to a set of servers","OIDC first. The web UI sits behind your identity provider (PocketID, Authelia, Keycloak...).","Configured by environment and one file. Runtime settings in env vars, servers in a single"],"sourceUrl":"https://github.com/cedhuf/mcpyard/blob/main/README.md","fingerprint":"e415a1e8ffb236ecf24c029718995d7538994cb4e09bb971b56e82a89d53d778","extractedAt":"2026-10-12T19:08:56.539Z"},"overviewCheckedAt":"2026-10-12T19:08:56.539Z","projectInsights":{"version":1,"whatItDoes":{"text":"A small, self-hosted MCP hub. One endpoint, every MCP server behind it, one key per client.","sourceUrl":"https://github.com/cedhuf/mcpyard/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"A local trial, without sign-in and reachable only from your machine:","sourceUrl":"https://github.com/cedhuf/mcpyard/blob/main/README.md"}],"fingerprint":"e415a1e8ffb236ecf24c029718995d7538994cb4e09bb971b56e82a89d53d778","sourceUrl":"https://github.com/cedhuf/mcpyard/blob/main/README.md","checkedAt":"2026-10-12T19:08:56.539Z"},"overviewRepoUpdated":"2026-10-12T18:49:01Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/cedhuf/mcpyard/blob/main/README.md","checkedAt":"2026-10-12T19:08:56.539Z","hash":"e415a1e8ffb236ecf24c029718995d7538994cb4e09bb971b56e82a89d53d778","originalBytes":5384,"storedBytes":5384,"truncated":false},"lastDemoCheckedAt":"2026-10-12T19:08:56.438Z","subjects":["MCP servers & agents","Self-hosted apps"],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"AI & machine learning","subjects":["MCP servers & agents","Self-hosted apps"],"evidence":[{"subject":"MCP servers & agents","source":"metadata","match":"MCP"},{"subject":"Self-hosted apps","source":"metadata","match":"self hosted"}],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":[],"reviewRequired":false},"demoHealth":{"url":"https://cedhuf.github.io/mcpyard/","attemptedAt":"2026-10-19T01:01:30.241Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T01:01:30.241Z","lastWorkingAt":"2026-10-19T01:01:30.241Z","target":"https://cedhuf.github.io/mcpyard/","failureCount":0,"consecutiveTemporaryFailures":0,"n