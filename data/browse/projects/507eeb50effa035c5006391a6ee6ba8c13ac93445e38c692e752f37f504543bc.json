{"full":"janoist1/saga-toolkit","name":"saga-toolkit","description":"An extension for redux-toolkit that allows sagas to resolve async thunk actions.","category":"Developer tools","language":"TypeScript","stars":33,"forks":3,"created":"2021-03-18T08:49:40Z","updated":"2026-07-22T19:10:22Z","branch":"master","homepage":null,"topics":[],"demo":"https://stackblitz.com/github/janoist1/saga-toolkit/tree/master/example","color":"#25392f","ink":"#d1e5c5","availability":"available","lastCheckedAt":"2026-10-17T11:02:33.224Z","lastAttemptAt":"2026-10-17T11:02:33.224Z","lastAvailableAt":"2026-10-17T11:02:33.224Z","lastDemoCheckedAt":"2026-10-11T11:06:14.488Z","metrics":[{"at":"2026-10-03T21:17:54.157Z","stars":33,"forks":3},{"at":"2026-10-04T08:16:48.466Z","stars":33,"forks":3},{"at":"2026-10-06T15:44:45.384Z","stars":33,"forks":3},{"at":"2026-10-08T16:04:31.363Z","stars":33,"forks":3},{"at":"2026-10-10T21:05:48.121Z","stars":33,"forks":3},{"at":"2026-10-11T11:06:14.354Z","stars":33,"forks":3},{"at":"2026-10-17T11:02:33.224Z","stars":33,"forks":3}],"technologies":["React"],"overview":{"kind":"readme","version":1,"paragraphs":["Seamlessly integrate Redux Toolkit with Redux Saga.","saga-toolkit acts as a bridge between Redux Toolkit's createAsyncThunk and Redux Saga. It allows you to dispatch actions that trigger Sagas, while retaining the ability to await the result (promise) directly in your components or thunks.","If you love the \"fire-and-forget\" nature of Sagas for complex flows but miss the convenience of await dispatch(action) for simple request/response patterns (like form submissions), this library is for you."],"features":["🤝 Bridge Pattern: Connects createAsyncThunk (RTK) with takeEvery / takeLatest (Saga).","🔄 Promise Support: await your Saga actions in React components.","⚡ Reduce Boilerplate: Easily handle loading/success/error states in slices using standard RTK patterns.","🛑 Real Cancellation: promise.abort() cancels the running Saga (and takeLatestAsync aborts superseded requests).","🧭 Type-safe: pass the action creator itself to the effects — action and return types are inferred and enforced."],"sourceUrl":"https://github.com/janoist1/saga-toolkit/blob/master/README.md","fingerprint":"a97471fb1e4bc637bf3bb23838e0b6c45f078cfef75cb00c5b75763bad290c30","extractedAt":"2026-10-03T08:24:51.794Z"},"overviewCheckedAt":"2026-10-11T11:06:14.486Z","projectInsights":{"version":1,"whatItDoes":{"text":"Seamlessly integrate Redux Toolkit with Redux Saga.","sourceUrl":"https://github.com/janoist1/saga-toolkit/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"a97471fb1e4bc637bf3bb23838e0b6c45f078cfef75cb00c5b75763bad290c30","sourceUrl":"https://github.com/janoist1/saga-toolkit/blob/master/README.md","checkedAt":"2026-10-11T11:06:14.486Z"},"overviewRepoUpdated":"2026-07-22T19:10:22Z","overviewAttemptAt":"2026-10-03T21:20:06.895Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/janoist1/saga-toolkit/blob/master/README.md","checkedAt":"2026-10-11T11:06:14.487Z","hash":"a97471fb1e4bc637bf3bb23838e0b6c45f078cfef75cb00c5b75763bad290c30","originalBytes":8638,"storedBytes":8638,"truncated":false},"qualityPriority":false,"enrichmentAttemptAt":"2026-10-04T16:45:08.024Z","latestRelease":null,"releaseCheckedAt":"2026-10-04T16:45:08.024Z","screenshots":[{"src":"previews/507eeb50effa035c5006391a.jpg","kind":"demo","capturedAt":"2026-10-12T10:09:10.868Z","url":"https://stackblitz.com/github/janoist1/saga-toolkit/tree/master/example"}],"demoHealth":{"url":"https://stackblitz.com/github/janoist1/saga-toolkit/tree/master/example","attemptedAt":"2026-10-12T10:09:10.867Z","status":"working","checkedAt":"2026-10-12T10:09:10.867Z","lastWorkingAt":"2026-10-12T10:09:10.867Z","target":"https://stackblitz.com/github/janoist1/saga-toolkit/tree/master/example","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-19T10:09:10.867Z","probeVersion":3},"previewAttemptAt":"2026-10-12T10:09:10.868Z",