{"repositoryId":977240554,"availability":"available","full":"notandia/browser-extension","name":"browser-extension","description":"Open-source browser extension for publisher context and explainable post-publication signals across scholarly literature.","category":"Other","language":"JavaScript","stars":1,"forks":1,"created":"2025-05-03T18:36:00Z","updated":"2026-10-15T08:56:46Z","license":"AGPL-3.0","branch":"main","homepage":"https://notandia.pages.dev/","topics":["chrome-extension","europepmc","filter","google","google-scholar","literature-search","pubmed","science","science-research","scientific-literature","search"],"demo":"https://notandia.pages.dev/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-15T11:21:04.637Z","lastAttemptAt":"2026-10-15T11:21:04.637Z","lastAvailableAt":"2026-10-15T11:21:04.637Z","metrics":[{"at":"2026-10-15T11:21:04.637Z","stars":1,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["Notandia is an independent, open-source browser extension that adds configurable publisher context and explainable post-publication signals to scholarly literature. It preserves the mature MDPI-detection capabilities previously distributed as MDPI Filter while generalizing them into user-controlled publisher watchlists. This repository is the canonical source for Chrome, Microsoft Edge, Firefox, and Safari.","Independent project: Notandia is not affiliated with, authorized by, or endorsed by MDPI AG, Frontiers Media SA, Crossref, Retraction Watch, NCBI, browser vendors, or any publisher or data provider. Publisher names and marks belong to their respective owners."],"features":["Identify enabled publisher profiles in article pages, reference lists, and supported search-result pages.","Ship built-in MDPI and Frontiers profiles, both enabled and highlighted by default on fresh installations.","Distinguish MDPI in amber and Frontiers in violet, with visible publisher names as well as color. Existing saved colors and actions are preserved.","Allow every publisher profile—including MDPI—to be independently enabled or disabled.","Apply a per-publisher action: context only, badge, highlight, dim, or hide."],"sourceUrl":"https://github.com/notandia/browser-extension/blob/main/README.md","fingerprint":"52ccb28c190441e7ec97283a4dd647f1c849501f396c536dff73991f9a974207","extractedAt":"2026-10-15T11:21:04.765Z"},"overviewCheckedAt":"2026-10-15T11:21:04.765Z","projectInsights":{"version":1,"whatItDoes":{"text":"Notandia is an independent, open-source browser extension that adds configurable publisher context and explainable post-publication signals to scholarly literature. It preserves the mature MDPI-detection capabilities previously distributed as MDPI Filter while generalizing them into user-controlled publisher watchlists. This repository is the canonical source for Chrome, Microsoft Edge, Firefox, and Safari.","sourceUrl":"https://github.com/notandia/browser-extension/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"52ccb28c190441e7ec97283a4dd647f1c849501f396c536dff73991f9a974207","sourceUrl":"https://github.com/notandia/browser-extension/blob/main/README.md","checkedAt":"2026-10-15T11:21:04.766Z"},"overviewRepoUpdated":"2026-10-15T08:56:46Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/notandia/browser-extension/blob/main/README.md","checkedAt":"2026-10-15T11:21:04.767Z","hash":"52ccb28c190441e7ec97283a4dd647f1c849501f396c536dff73991f9a974207","originalBytes":11877,"storedBytes":11877,"truncated":false,"searchTerms":["publisher","mdpi","browser","edge","chrome","crossref","extension","build","firefox","frontiers","release","source","dist","existing","store","checks","doi","enabled","metadata","microsoft","npm","see","article","current","docs","identifiers","includes","integrity","journal","notandia","reference","safari","settings","target","uses","both","compatibility","context","coverage","data","formal","generated","ncbi","open"