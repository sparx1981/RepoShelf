ence on large datasets."],"sourceUrl":"https://github.com/aldebarankwsuperrr/KTP-Data-Extractor/blob/main/README.md","fingerprint":"5bfbb23360fa104a2986b7c7330c36d0a0849a3576deb2e6ef3412a4c1ff45c0","extractedAt":"2026-10-10T17:29:43.163Z"},"overviewCheckedAt":"2026-10-10T17:29:43.163Z","projectInsights":{"version":1,"whatItDoes":{"text":"The KTP Data Extractor is an advanced machine learning-powered application that extracts critical information from Indonesian KTP (Kartu Tanda Penduduk) images. Using object detection, segmentation, and document parsing technology, the application efficiently detects the KTP area, crops it, and reads the text fields.","sourceUrl":"https://github.com/aldebarankwsuperrr/KTP-Data-Extractor/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"5bfbb23360fa104a2986b7c7330c36d0a0849a3576deb2e6ef3412a4c1ff45c0","sourceUrl":"https://github.com/aldebarankwsuperrr/KTP-Data-Extractor/blob/main/README.md","checkedAt":"2026-10-10T17:29:43.163Z"},"overviewRepoUpdated":"2024-10-02T05:05:35Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/aldebarankwsuperrr/KTP-Data-Extractor/blob/main/README.md","checkedAt":"2026-10-10T17:29:43.164Z","hash":"5bfbb23360fa104a2986b7c7330c36d0a0849a3576deb2e6ef3412a4c1ff45c0","originalBytes":6077,"storedBytes":6077,"truncated":false,"searchTerms":["ktp","data","image","detection","project","donut","model","install","models","streamlit","text","bash","document","obb","segmentation","application","bounding","extraction","extractor","following","gpu","image.","information","oriented","processing","using","app","app.py","box","demo","dependencies","detects","extracted","extracts","file","git","license","live","object","parsing","pip","processed","pytorch","support","upload","web","yolo","aligned","any","area","batch","card","clone","command","correct","create","display","displayed","download","easier","extract","extraction.","fahrul","firmansyah","free","functions","future",