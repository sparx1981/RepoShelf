{"repositoryId":216339559,"availability":"available","full":"DriveQuantPublic/drivekit-ui-android","name":"drivekit-ui-android","description":"Explore this public GitHub project.","category":"Other","language":"Kotlin","stars":12,"forks":3,"created":"2019-10-20T09:49:53Z","updated":"2026-10-15T13:49:22Z","license":"Apache-2.0","branch":"develop","homepage":null,"topics":[],"demo":"https://www.loom.com/share/fdc75d440476492eaddab3d278f77299","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-15T15:01:21.135Z","lastAttemptAt":"2026-10-15T15:01:21.135Z","lastAvailableAt":"2026-10-15T15:01:21.135Z","metrics":[{"at":"2026-10-15T15:01:21.135Z","stars":12,"forks":3}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["The DriveKit SDK is a mobile telematics technology developed by DriveQuant based on smartphone sensors to analyze vehicle trips and evaluate the influence of driving style on safety, fuel consumption, distraction and speeding. The DriveKit SDK also uses the phone's sensors to detect car accidents.","The DriveKit SDK is a flexible software suite for creating mobile applications to engage, coach and improve drivers. The DriveKit SDK includes open source graphics libraries for trip data display, gamification and driver coaching features.","To integrate the DriveKit SDK in your application, follow the installation guidelines: docs.drivequant.com"],"features":["Trip Analysis It is the heart of the reactor that allows access to the phone's sensors and contains autostart mechanisms to analyse trips while your app runs in background ;","Permissions Utils is used to get user's permissions that allow the SDK to access the smartphone's sensors while running in background ;","Driver Data manages the driver’s data synchronisation and display. Available screens within this component include:","Trips list and details ;","Ready to use widgets to display information about user's last trips ;"],"sourceUrl":"https://github.com/DriveQuantPublic/drivekit-ui-android/blob/develop/README.md","fingerprint":"335221b275d93f698ee976753b7709d157307efe227a1c96e7d5a6dbd191eaf8","extractedAt":"2026-10-15T15:01:21.311Z"},"overviewCheckedAt":"2026-10-15T15:01:21.311Z","projectInsights":{"version":1,"whatItDoes":{"text":"The DriveKit SDK is a mobile telematics technology developed by DriveQuant based on smartphone sensors to analyze vehicle trips and evaluate the influence of driving style on safety, fuel consumption, distraction and speeding. The DriveKit SDK also uses the phone's sensors to detect car accidents.","sourceUrl":"https://github.com/DriveQuantPublic/drivekit-ui-android/blob/develop/README.md"},"audience":[],"requirements":[],"fingerprint":"335221b275d93f698ee976753b7709d157307efe227a1c96e7d5a6dbd191eaf8","sourceUrl":"https://github.com/DriveQuantPublic/drivekit-ui-android/blob/develop/README.md","checkedAt":"2026-10-15T15:01:21.311Z"},"overviewRepoUpdated":"2026-10-15T13:49:22Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/DriveQuantPublic/drivekit-ui-android/blob/develop/README.md","checkedAt":"2026-10-15T15:01:21.312Z","hash":"335221b275d93f698ee976753b7709d157307efe227a1c96e7d5a6dbd191eaf8","originalBytes":8336,"storedBytes":8336,"truncated":false,"searchTerms":["drivekit","demo","application","sdk","app","smartphone","driver","trip","android","application.","data","display","user","access","api","key","run","sensors","telematics","been","details","following","how","information","mobile","phone","set","some","trips","unique","vehicle","allows","analysis","background","car","challenge","contains","each","feature","get","list","mode","permissions","required","save","screens","sdk.","tutorial","understand","used","video","watch","which","about","add","allow","autostart","available","because","before","choose","component","components","configured","contact","cycle","developed","discover","drivequant","especially","features","follow","help","id.","illustrations","includes","instal