{"availability":"available","full":"vincenzo-afk/XOTrix","name":"XOTrix","description":"A browser-native Tic-Tac-Toe game with configurable minimax AI, local statistics, replay sharing, themes, and responsive UI.","category":"Design","language":"JavaScript","stars":36,"forks":1,"created":"2026-05-03T17:43:06Z","updated":"2026-08-24T01:39:01Z","license":"MIT","branch":"main","homepage":"https://xo-trix.vercel.app","topics":["alpha-beta-pruning","artificial-intelligence","browser-game","css3","frontend","html5","javascript","javascript-game","localstorage","minimax","minimax-algorithm","responsive-design","static-site","tic-tac-toe","vanilla-javascript","vercel","web-audio-api","web-share-api"],"demo":"https://xo-trix.vercel.app/","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-06T09:43:42.996Z","lastAttemptAt":"2026-10-06T09:43:42.996Z","lastAvailableAt":"2026-10-06T09:43:42.996Z","metrics":[{"at":"2026-10-06T09:43:42.996Z","stars":36,"forks":1}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A polished, browser-native Tic-Tac-Toe game with configurable AI, replays, statistics, themes, and shareable matches.","XOTrix is a client-side Tic-Tac-Toe game that runs directly in a modern web browser. It is designed as a small, dependency-light static project: the HTML document provides the interface, app.js manages gameplay and persistence, and style.css provides themes, responsive layout, animation, and visual states.","The game supports local two-player sessions, human-versus-bot play, and bot-versus-bot demonstrations. The bot uses minimax with alpha-beta pruning, difficulty-specific search depths, and a small opening book for Master difficulty. Match state, personal statistics, settings, themes, achievements, and scores are stored in the browser under the xotrix-data localStorage key; there is no server-side account or database."],"features":["Human vs Human, Human vs Bot, and Bot vs Bot modes.","Beginner, Intermediate, Advanced, and Master bot difficulty levels.","Minimax with alpha-beta pruning, plus Master-level opening responses.","Undo, reset, move history, replay navigation, and replay URLs using the ?replay= query parameter.","Local statistics including games played, wins, losses, draws, win rate, streaks, fastest win, and Elo rating."],"sourceUrl":"https://github.com/vincenzo-afk/XOTrix/blob/main/README.md","fingerprint":"b3a86857a8fdfd791627b1c35a899530d64a2e89e217f0546c070db5922f0bdc","extractedAt":"2026-10-06T09:43:43.169Z"},"overviewCheckedAt":"2026-10-06T09:43:43.169Z","projectInsights":{"version":1,"whatItDoes":{"text":"A polished, browser-native Tic-Tac-Toe game with configurable AI, replays, statistics, themes, and shareable matches.","sourceUrl":"https://github.com/vincenzo-afk/XOTrix/blob/main/README.md"},"audience":[],"requirements":[{"kind":"api_key","status":"required","text":"No Node.js installation, package manager, API key, database, or environment variable is required by the application.","sourceUrl":"https://github.com/vincenzo-afk/XOTrix/blob/main/README.md"}],"fingerprint":"b3a86857a8fdfd791627b1c35a899530d64a2e89e217f0546c070db5922f0bdc","sourceUrl":"https://github.com/vincenzo-afk/XOTrix/blob/main/README.md","checkedAt":"2026-10-06T09:43:43.170Z"},"overviewRepoUpdated":"2026-08-24T01:39:01Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/vincenzo-afk/XOTrix/blob/main/README.md","checkedAt":"2026-10-06T09:43:43.171Z","hash":"b3a86857a8fdfd791627b1c35a899530d64a2e89e217f0546c070db5922f0bdc","originalBytes":14359,"storedBytes":14359,"truncated":false,"searchTerms":["repository","api","browser","replay","bot","web","xotrix","license","project","app.js","github","index.html","local","static","game","audio","statistics","board","style.css","cell","deployment","interface","share","themes","through","undo","xotrix-data","browser.","clipboard","key","minimax","mode","move","opening","reset","security","storage","test","validation","vibration"