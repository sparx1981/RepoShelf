 wiped at any time.","Text-to-speech. Corrected sentences are read aloud with the browser's"],"sourceUrl":"https://github.com/olivierluethy/Grammar-Mentor-Frontend/blob/main/README.md","fingerprint":"c594c83758700aefefb1005bed180ab35fdf0f4957a0745d31521b70f46066ba","extractedAt":"2026-10-10T07:02:03.506Z"},"overviewCheckedAt":"2026-10-10T07:02:03.506Z","projectInsights":{"version":1,"whatItDoes":{"text":"The grammar checker that teaches you, not just fixes your text. Next.js frontend for a grammar-checking SaaS that turns every mistake into a lesson.","sourceUrl":"https://github.com/olivierluethy/Grammar-Mentor-Frontend/blob/main/README.md"},"audience":[],"requirements":[{"kind":"account","status":"required","text":"dedicated sign-in / sign-up routes; next-auth v5 is also included in the stack.","sourceUrl":"https://github.com/olivierluethy/Grammar-Mentor-Frontend/blob/main/README.md"},{"kind":"paid_service","status":"required","text":"This is the frontend, so it only needs auth keys — the checker and billing talk to a hosted backend.","sourceUrl":"https://github.com/olivierluethy/Grammar-Mentor-Frontend/blob/main/README.md"}],"fingerprint":"c594c83758700aefefb1005bed180ab35fdf0f4957a0745d31521b70f46066ba","sourceUrl":"https://github.com/olivierluethy/Grammar-Mentor-Frontend/blob/main/README.md","checkedAt":"2026-10-10T07:02:03.506Z"},"overviewRepoUpdated":"2026-09-12T10:59:30Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/olivierluethy/Grammar-Mentor-Frontend/blob/main/README.md","checkedAt":"2026-10-10T07:02:03.507Z","hash":"c594c83758700aefefb1005bed180ab35fdf0f4957a0745d31521b70f46066ba","originalBytes":4461,"storedBytes":4461,"truncated":false,"searchTerms":["clerk","pnpm","checker","key","frontend","grammar","keys","license","mistake","next-auth","secret","auth","browser","build","aloud","analytics","app","backend.","billing","built","clerkprovider","corrections","css","deploy","env.local","environment","errors","every","get",