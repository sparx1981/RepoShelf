{"availability":"available","full":"nickprotop/ConsoleEx","name":"ConsoleEx","description":"SharpConsoleUI — A reactive terminal UI framework for .NET with a robust async model, per-window threads, a real compositor engine, 30+ controls, and NativeAOT support.","category":"Developer tools","language":"C#","stars":283,"forks":15,"created":"2025-02-11T15:36:40Z","updated":"2026-10-18T20:23:49Z","license":"MIT","branch":"master","homepage":"https://nickprotop.github.io/ConsoleEx/","topics":["console","csharp","developer-tools","dotnet","linux","terminal","terminal-ui","tui","windows"],"demo":"https://nickprotop.github.io/ConsoleEx/","color":"#323057","ink":"#d6caff","lastCheckedAt":"2026-10-19T18:04:57.951Z","lastAttemptAt":"2026-10-19T18:04:57.951Z","lastAvailableAt":"2026-10-19T18:04:57.951Z","metrics":[{"at":"2026-10-09T03:37:03.935Z","stars":278,"forks":14},{"at":"2026-10-12T06:26:50.863Z","stars":279,"forks":14},{"at":"2026-10-18T11:28:56.478Z","stars":282,"forks":15},{"at":"2026-10-19T18:04:57.951Z","stars":283,"forks":15}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["A Terminal Application Framework for .NET — the terminal, as an application surface.","Build complete applications with overlapping windows, a real compositor, and reactive component UI, rendered efficiently to any modern terminal. (The runtime ships as the SharpConsoleUI NuGet package.)","Each window runs on its own async thread, with built-in marshalling back to the UI thread. A DOM-based layout engine measures, arranges, and paints a tree of controls, including responsive panes and flexible grids with fixed, auto-sized, and proportional tracks, spans, and splitters. The compositor merges per-window buffers with per-cell alpha blending, so overlapping windows, animated backgrounds, and tween/easing animations all composite cleanly. A portal system for dropdowns, overlays, and toast notifications. 30+ controls (including an embedded PTY terminal that runs a real shell, a video…"],"features":[],"sourceUrl":"https://github.com/nickprotop/ConsoleEx/blob/master/README.md","fingerprint":"f218d24597c54904141cce081c3b6240bde35dece5337b6fc003a461005c0ff2","extractedAt":"2026-10-19T18:04:58.043Z"},"overviewCheckedAt":"2026-10-19T18:04:58.043Z","projectInsights":{"version":1,"whatItDoes":{"text":"A Terminal Application Framework for .NET — the terminal, as an application surface.","sourceUrl":"https://github.com/nickprotop/ConsoleEx/blob/master/README.md"},"audience":[],"requirements":[],"fingerprint":"f218d24597c54904141cce081c3b6240bde35dece5337b6fc003a461005c0ff2","sourceUrl":"https://github.com/nickprotop/ConsoleEx/blob/master/README.md","checkedAt":"2026-10-19T18:04:58.043Z"},"overviewRepoUpdated":"2026-10-18T20:23:49Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/nickprotop/ConsoleEx/blob/master/README.md","checkedAt":"2026-10-19T18:04:58.044Z","hash":"f218d24597c54904141cce081c3b6240bde35dece5337b6fc003a461005c0ff2","originalBytes":22944,"storedBytes":22944,"truncated":false},"lastDemoCheckedAt":"2026-10-19T18:04:57.951Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Apple","MCP servers & agents","Templates & UI components","Data & dashboards"],"reviewRequired":true},"demoHealth":{"url":"https://nickprotop.github.io/ConsoleEx/","attemptedAt":"2026-10-19T18:21:32.712Z","probeVersion":3,"status":"working","checkedAt":"2026-10-19T18:21:32.712Z","lastWorkingAt":"2026-10-19T18:21:32.712Z","target":"https://nickprotop.github.io/ConsoleEx/","failureCount":0,"consecutiveTemporaryFailures":0,"nextCheckAt":"2026-10-26T18:21:32.712Z"},"previewAttemptAt":"2026-10-19T18:21:32.713Z","previewCheck":{"url":"https://nickprotop.github.io/ConsoleEx/","attemptedAt":"2026-10-19T18:21:32.713Z","consecutiveFailures":0,"status":"capture