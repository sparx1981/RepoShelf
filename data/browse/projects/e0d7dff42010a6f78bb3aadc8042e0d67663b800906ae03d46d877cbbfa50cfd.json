{"availability":"available","full":"Automattic/vip-governance-plugin","name":"vip-governance-plugin","description":"WordPress plugin that adds additional governance capabilities to the block editor.","category":"Developer tools","language":"PHP","stars":27,"forks":6,"created":"2023-07-21T01:30:31Z","updated":"2026-10-19T22:32:53Z","license":"GPL-3.0","branch":"trunk","homepage":"https://wpvip.com","topics":["wordpress","wordpress-plugin","wpvip-plugin"],"demo":"https://playground.wordpress.net/?blueprint-url=https://raw.githubusercontent.com/Automattic/vip-governance-plugin/trunk/blueprint.json","color":"#302e55","ink":"#dbd2ff","lastCheckedAt":"2026-10-20T05:26:27.237Z","lastAttemptAt":"2026-10-20T05:26:27.237Z","lastAvailableAt":"2026-10-20T05:26:27.237Z","metrics":[{"at":"2026-10-08T02:36:21.180Z","stars":27,"forks":6},{"at":"2026-10-10T09:03:54.340Z","stars":27,"forks":6},{"at":"2026-10-16T00:54:38.271Z","stars":27,"forks":6},{"at":"2026-10-20T05:26:27.237Z","stars":27,"forks":6}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["This WordPress plugin adds additional governance capabilities to the block editor. This is accomplished via three dimensions:","We have approached this plugin from an opt-in standpoint. An empty effective rule set severely limits the editing experience, although the plugin ships with a permissive fallback rule set. The goal is to create a stable editor with new blocks and features being enabled explicitly via rules, rather than implicitly via updates.","This plugin is currently developed for use on WordPress sites hosted on the VIP Platform."],"features":["Insertion: restricts what kind of blocks can be inserted into the block editor. Only what’s allowed can be inserted, and nothing else. This means that even if new core blocks are introduced they would not be permitted.","Interaction: This adds the ability to control the styling available for blocks at any level.","Features: controls access to the code editor and block locking.","Default Rule Set With Restrictions","Default and User Role Rule Set"],"sourceUrl":"https://github.com/Automattic/vip-governance-plugin/blob/trunk/README.md","fingerprint":"30add6f6f5af1e8223bc1c44b6b5b19b615c92bd61ac72fd79c1d3cd9b4a0a32","extractedAt":"2026-10-08T02:36:21.307Z"},"overviewCheckedAt":"2026-10-08T02:36:21.307Z","projectInsights":{"version":1,"whatItDoes":{"text":"This WordPress plugin adds additional governance capabilities to the block editor. This is accomplished via three dimensions:","sourceUrl":"https://github.com/Automattic/vip-governance-plugin/blob/trunk/README.md"},"audience":[],"requirements":[],"fingerprint":"30add6f6f5af1e8223bc1c44b6b5b19b615c92bd61ac72fd79c1d3cd9b4a0a32","sourceUrl":"https://github.com/Automattic/vip-governance-plugin/blob/trunk/README.md","checkedAt":"2026-10-08T02:36:21.308Z"},"overviewRepoUpdated":"2026-10-02T18:26:05Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/Automattic/vip-governance-plugin/blob/trunk/README.md","checkedAt":"2026-10-08T02:36:21.310Z","hash":"30add6f6f5af1e8223bc1c44b6b5b19b615c92bd61ac72fd79c1d3cd9b4a0a32","originalBytes":40529,"storedBytes":40529,"truncated":false},"lastDemoCheckedAt":"2026-10-08T02:36:21.180Z","subjects":[],"platforms":[],"classification":{"version":4,"method":"local_rules","category":"Developer tools","subjects":[],"evidence":[],"platformEvidence":[],"platformSupport":"author_metadata_not_runtime_tested","suggestedSubjects":["Templates & UI components"],"reviewRequired":true},"demoHealth":{"url":"https://playground.wordpress.net/?blueprint-url=https://raw.githubusercontent.com/Automattic/vip-governance-plugin/trunk/blueprint.json","attemptedAt":"2026-10-15T07:57:55.439Z","probeVersion":3,"status":"unknown","consecutiveTemporaryFailures":4,"error":{"reason":"unsafe_target","at":"2026-10-15T07:57:55.439Z"},"nextCheckAt":"2026-10-22T07:57:55.439Z"},"previewAttemptAt":"2026-10-15T07:57:55.439Z","previewCheck":{"url":"https://play