ository are known to work with p5.js v.1.11.13.","Single-line font (left) versus outline font (right)."],"features":[],"sourceUrl":"https://github.com/golanlevin/p5-single-line-font-resources/blob/main/README.md","fingerprint":"7ab530c0819407e979b5c24f559e009d3757397167c46b103256af8850528144","extractedAt":"2026-10-18T22:45:50.520Z"},"overviewCheckedAt":"2026-10-18T22:45:50.520Z","projectInsights":{"version":1,"whatItDoes":{"text":"This is a repository of p5.js (JavaScript) programs for loading and displaying single-line vector fonts (also called single-stroke fonts, technical lettering fonts, stick fonts, skeleton fonts, engraving fonts, or monoline fonts) in a variety of formats — including TTF, SVG 1.1 Font, Hershey Font, SHX, and others. This repository also attempts to present an authoritative archive of single-line fonts (and procedural fonts) recovered or extracted from a wide range of creative projects, vintage and obsolete technologies, and other sources. The archive contains more than 150 unique single-stroke…","sourceUrl":"https://github.com/golanlevin/p5-single-line-font-resources/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"7ab530c0819407e979b5c24f559e009d3757397167c46b103256af8850528144","sourceUrl":"https://github.com/golanlevin/p5-single-line-font-resources/blob/main/README.md","checkedAt":"2026-10-18T22:45:50.520Z"},"overviewRepoUpdated":"2026-10-15T07:15:08Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://github.com/golanlevin/p5-single-line-font-resources/blob/main/README.md","checkedAt":"2026-10-18T22:45:50.523Z","hash":"7ab530c0819407e979b5c24f559e009d3757397167c46b103256af8850528144","originalBytes":50238,"storedBytes":50238,"truncated":false},"lastDemoCheckedAt":"2026-10-18T22:45:50.461Z","enrichmentAttemptAt":"2026-10-18T22:46:29.440Z","latestRelease":null,"releaseCheckedAt":"2026-10-18T22:46:29.440Z","screenshots":[{"src":"previews/d6496c0f106e37f349be82c9.jpg","kind":"demo","capturedAt":"2026-10-