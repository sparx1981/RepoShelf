{"full":"hf:zamal/Pdf-2-Summary","spaceId":"zamal/Pdf-2-Summary","name":"Pdf 2 Summary","source":"huggingface","description":"An interactive AI application on Hugging Face Spaces.","category":"AI & machine learning","language":"Python","topics":["streamlit","region:us"],"technologies":["Python"],"likes":30,"created":"2024-03-04T02:12:32.000Z","updated":"2024-03-04T02:25:45.000Z","license":"mit","runtime":"RUNNING","appUrl":"https://zamal-pdf-2-summary.hf.space/","demo":"https://huggingface.co/spaces/zamal/Pdf-2-Summary","availability":"available","lastCheckedAt":"2026-10-06T07:20:22.258Z","lastAttemptAt":"2026-10-06T07:20:22.258Z","lastAvailableAt":"2026-10-06T07:20:22.258Z","color":"#3c3250","ink":"#e4d4ff","symbol":"🌍","overview":{"kind":"readme","version":1,"paragraphs":["The Advanced NLP PDF Summarizer is a cutting-edge tool designed to process and condense lengthy PDF documents into concise, informative summaries. Leveraging state-of-the-art Natural Language Processing (NLP) techniques, this application extracts key information, presenting it in an easily digestible format. This README provides an overview of the advanced NLP methodologies employed by our application and guidance on how to utilize its features effectively."],"features":["PDF Text Extraction: Utilizes PyPDF2 for efficient text extraction from PDF files, ensuring no content is overlooked during summarization.","Advanced Text Preprocessing: Employs spaCy for sophisticated text preprocessing, including tokenization, lemmatization, and removal of stopwords, to refine the text for analysis.","Key Phrase Extraction: Harnesses spaCy's NLP capabilities to identify and extract key phrases and named entities, pinpointing the most relevant information within the text.","Sentence Importance Scoring: Implements a custom scoring algorithm based on the presence of key phrases and their centrality to the document's overall theme, highlighting sentences that encapsulate core ideas.","Dynamic Summarization: Offers users the flexibility to adjust the extent of summarization, dynamically altering the summary's length based on user preference."],"sourceUrl":"https://huggingface.co/spaces/zamal/Pdf-2-Summary/blob/main/README.md","fingerprint":"6cc3c5690f62559950b2b5f3976d5681e3b8a45fbe690a6457722f8cf8f067ba","extractedAt":"2026-10-06T07:20:22.349Z"},"overviewCheckedAt":"2026-10-06T07:20:22.349Z","projectInsights":{"version":1,"whatItDoes":{"text":"The Advanced NLP PDF Summarizer is a cutting-edge tool designed to process and condense lengthy PDF documents into concise, informative summaries. Leveraging state-of-the-art Natural Language Processing (NLP) techniques, this application extracts key information, presenting it in an easily digestible format. This README provides an overview of the advanced NLP methodologies employed by our application and guidance on how to utilize its features effectively.","sourceUrl":"https://huggingface.co/spaces/zamal/Pdf-2-Summary/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"6cc3c5690f62559950b2b5f3976d5681e3b8a45fbe690a6457722f8cf8f067ba","sourceUrl":"https://huggingface.co/spaces/zamal/Pdf-2-Summary/blob/main/README.md","checkedAt":"2026-10-06T07:20:22.349Z"},"overviewRepoUpdated":"2024-03-04T02:25:45.000Z","readmeSnapshot":{"version":1,"status":"saved","sourceUrl":"https://huggingface.co/spaces/zamal/Pdf-2-Summary/blob/main/README.md","checkedAt":"2026-10-06T07:20:22.349Z","hash":"6cc3c5690f62559950b2b5f3976d5681e3b8a45fbe690a6457722f8cf8f067ba","originalBytes":4139,"storedBytes":4139,"truncated":false,"searchTerms":["pdf","text","application","key","nlp","summary","advanced","their","extraction","license","spacy","document","length","phrases","scoring","streamlit","summarization","text.","based","document.","entities","named","preprocessing","process","pypdf2","sentence","sentences","summarizer","adjust","algorithm","app","app.py","content","ensuring","features","file","highlighting","how","identify","including","info