{"repositoryId":1335236473,"availability":"available","full":"aloshdenny/claude-awm","name":"claude-awm","description":"claude anti-watermarking","category":"Developer tools","language":"HTML","stars":89,"forks":9,"created":"2026-08-15T16:22:14Z","updated":"2026-09-03T12:53:56Z","branch":"main","homepage":"https://aloshdenny.com/claude-awm/","topics":["gumbel-softmax","illegal-activities","tournament-sampling","watermark-detection","watermark-tools","watermarking"],"demo":"https://aloshdenny.com/claude-awm/","color":"#193546","ink":"#a6d6e8","lastCheckedAt":"2026-10-18T21:03:10.451Z","lastAttemptAt":"2026-10-18T21:03:10.451Z","lastAvailableAt":"2026-10-18T21:03:10.451Z","metrics":[{"at":"2026-10-15T13:02:11.606Z","stars":84,"forks":9},{"at":"2026-10-18T21:03:10.451Z","stars":89,"forks":9}],"technologies":[],"overview":{"kind":"readme","version":1,"paragraphs":["claude-awm: can you scrub a SynthID text watermark by editing the text?","Yes, but only one family of attack works, and it isn't the one everyone assumes.","Unicode variation selectors (category Mn, U+FE00 to U+FE0F and U+E0100 to U+E01EF) drive the detector below threshold and stay there. Every other invisible-character attack I tried gets fully reverted by one line of input normalization. Variation selectors don't, because they're meaningful codepoints (emoji presentation, CJK variants) that NFKC will not and should not fold away."],"features":[],"sourceUrl":"https://github.com/aloshdenny/claude-awm/blob/main/README.md","fingerprint":"85127b40114557ba8284173d1b8bb22cf521cf9af7f997a7dafe5427af10f068","extractedAt":"2026-10-15T13:02:11.778Z"},"overviewCheckedAt":"2026-10-15T13:02:11.778Z","projectInsights":{"version":1,"whatItDoes":{"text":"claude-awm: can you scrub a SynthID text watermark by editing the text?","sourceUrl":"https://github.com/aloshdenny/claude-awm/blob/main/README.md"},"audience":[],"requirements":[],"fingerprint":"85127b40114557ba8284173d1b8bb22cf521cf9af7f997a7dafe5427af10f068","sourceUrl"