{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/auth.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/**}",
      "maxDuration": 30
    },
    "api/admin-users.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/**}",
      "maxDuration": 30
    },
    "api/forks.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/**}",
      "maxDuration": 30
    },
    "api/open.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/**}",
      "maxDuration": 30
    },
    "api/submissions.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/**}",
      "maxDuration": 30
    },
    "api/collection.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json,data/runtime/projects.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/{*.gz,browse-projects/**,identities.json,sync-runs.json}}",
      "maxDuration": 30
    },
    "api/analytics.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json,data/runtime/identities.json,data/admin-summary.json,dist/growth.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/{*.gz,browse-projects/**,projects.json,sync-runs.json}}",
      "maxDuration": 30
    },
    "api/promotions.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json,data/runtime/projects.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/{*.gz,browse-projects/**,identities.json,sync-runs.json}}",
      "maxDuration": 60
    },
    "api/sync-log.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json,data/runtime/sync-runs.json,data/{publication,launch-cadence}.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,readmes,context,sync-runs}/**,data/runtime/{*.gz,browse-projects/**,identities.json,projects.json}}",
      "maxDuration": 30
    },
    "api/editorial.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config,browse}.js,data/listing-controls.json,data/browse/{index,search,community,identities}.json,data/runtime/browse-projects/**,dist/growth.json}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse/projects,readmes,context,sync-runs}/**,data/runtime/{*.gz,*.json}}",
      "maxDuration": 30
    },
    "api/agent.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json,data/runtime/{catalog,spaces}.json.gz,dist/community.json,data/readmes/**,data/context/**}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,sync-runs}/**,data/runtime/{browse-projects/**,*.json}}",
      "maxDuration": 30
    },
    "api/mcp.mjs": {
      "includeFiles": "{dist/{taxonomy,providers,quality,community,editorial,storefront,discovery,picks,viewer-config}.js,data/listing-controls.json,data/runtime/{catalog,spaces}.json.gz,dist/community.json,data/readmes/**,data/context/**}",
      "excludeFiles": "{tests/**,node_modules/{sharp,@img,*esbuild*,@vercel/nft}/**,dist/{catalog*,spaces*,assets/**,.asset-html/**,previews/**},data/{browse,sync-runs}/**,data/runtime/{browse-projects/**,*.json}}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/agent?path=:path*"
    },
    {
      "source": "/api/publication",
      "destination": "/api/sync-log?action=publication-status"
    },
    {
      "source": "/api/maintenance",
      "destination": "/api/sync-log?action=maintenance"
    },
    {
      "source": "/api/viewer",
      "destination": "/api/editorial?area=viewer"
    }
  ],
  "ignoreCommand": "node scripts/deployment-policy.mjs",
  "git": {
    "deploymentEnabled": {
      "reposhelf-checkpoints": false,
      "reposhelf-progress": false
    }
  }
}
