# Server environment only. Never commit actual credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REPOSHELF_PUBLIC_URL=https://reposhelf.vercel.app
# Independent read-only agent API / MCP credential:
REPOSHELF_API_KEY=

# Public legal identity and contact details. RepoShelf is the service brand, not an established company.
# Country defaults to United Kingdom. Keep operator name empty while the legal identity is unresolved.
# Reminder: create a dedicated, monitored RepoShelf email before completing these settings.
# Legal acceptance activates only when all three effective values are valid.
REPOSHELF_OPERATOR_NAME=
REPOSHELF_OPERATOR_COUNTRY=
REPOSHELF_CONTACT_EMAIL=
